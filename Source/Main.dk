// Hellfeather supplies the game. Quaxel owns the main loop.
//
//     Hellfeather.exe --start mill    starts somewhere else, for looking at it:
//                                     matthew, edda, hospice, marsh, mill, undercroft or deep
//     Hellfeather.exe --talk          talks to the first person in reach once they appear
Main(string [] args)
{
    Print("Hellfeather / Quaxel")
    HellfeatherGame game()
    for i : 0; i < args.Len; i++ {
        if args[i] == "--ddgi" { game.UseDdgi = true }
        if args[i] == "--ddgi-uniform" {
            game.UseDdgi = true
            game.UniformProbeUpdates = true
        }
        if args[i] == "--no-ddgi" { game.UseDdgi = false }
        if args[i] == "--benchmark" { game.Benchmark.Enabled = true }
        if args[i] == "--unshadowed-test-lights" { game.Benchmark.LightShadows = false }
        if args[i] == "--benchmark-lights" {
            if i + 1 >= args.Len {
                Print("Expected --benchmark-lights 0, 1 or 12")
                return
            }
            i++
            if args[i] == "0" { game.Benchmark.LightCount = 0 }
            else if args[i] == "1" { game.Benchmark.LightCount = 1 }
            else if args[i] == "12" { game.Benchmark.LightCount = 12 }
            else {
                Print("Expected --benchmark-lights 0, 1 or 12")
                return
            }
            game.Benchmark.Enabled = true
        }
        if args[i] == "--frame-times" {
            game.Benchmark.Enabled = true
            game.Benchmark.RecordFrameTimes = true
        }
        if args[i] == "--start" && i + 1 < args.Len { game.StartAt = args[i + 1] }
        if args[i] == "--talk" { game.TalkOnStart = true }
    }
    if game.Benchmark.Enabled {
        if !QuaxelPlatform.SupportsWindowing() {
            Print("The Ravenford benchmark requires the Windows build")
            return
        }
        QuaxelRenderer.PreferUncappedPresentation()
        game.StartAt = ""
    }
    if !QuaxelEngine.Run(game) { return }
    if game.Benchmark.Enabled { game.Benchmark.Report() }
    if !QuaxelPlatform.SupportsWindowing() {
        Print("Frames")
        Print(game.StepsSimulated)
        Print("Simulated seconds")
        Print((double)game.StepsSimulated * Quaxel.FixedDeltaSeconds())
    }
}
