// Hellfeather supplies the game. Quaxel owns the main loop.
//
//     Hellfeather.exe --start mill    starts somewhere else, for looking at it:
//                                     matthew, edda, hospice, marsh, mill, undercroft or deep
//     Hellfeather.exe --talk          talks to the first person in reach once they appear
//     Hellfeather.exe --featherfall   starts a Featherfall a few seconds in, out in the wild
//     Hellfeather.exe --start edda --hoard   13 feathers and the ravens' hoard open
//     Hellfeather.exe --no-menu       skips the main menu
// Any of the options that start somewhere also skip the main menu.
Main(string [] args)
{
    Print("Hellfeather / Quaxel")
    HellfeatherGame game()
    bool skipMenu = false
    for i : 0; i < args.Len; i++ {
        if args[i] == "--probe-debug" {
            game.UseDdgi = true
            game.DebugProbePositions = true
            skipMenu = true
        }
        if args[i] == "--ddgi" { game.UseDdgi = true }
        if args[i] == "--ddgi-uniform" {
            game.UseDdgi = true
            game.UniformProbeUpdates = true
        }
        if args[i] == "--no-ddgi" { game.UseDdgi = false }
        if args[i] == "--benchmark" { game.Benchmark.Enabled = true }
        if args[i] == "--unshadowed-test-lights" { game.Benchmark.LightShadows = false }
        if args[i] == "--benchmark-lights" {
            if i + 1 >= args.Len {
                Print("Expected --benchmark-lights 0, 1 or 12")
                return
            }
            i++
            if args[i] == "0" { game.Benchmark.LightCount = 0 }
            else if args[i] == "1" { game.Benchmark.LightCount = 1 }
            else if args[i] == "12" { game.Benchmark.LightCount = 12 }
            else {
                Print("Expected --benchmark-lights 0, 1 or 12")
                return
            }
            game.Benchmark.Enabled = true
        }
        if args[i] == "--frame-times" {
            game.Benchmark.Enabled = true
            game.Benchmark.RecordFrameTimes = true
        }
        if args[i] == "--start" && i + 1 < args.Len {
            game.StartAt = args[i + 1]
            skipMenu = true
        }
        if args[i] == "--talk" {
            game.TalkOnStart = true
            skipMenu = true
        }
        if args[i] == "--featherfall" {
            game.Featherfall.Timer = 4.0
            skipMenu = true
        }
        if args[i] == "--hoard" {
            game.HoardOnStart = true
            skipMenu = true
        }
        if args[i] == "--no-menu" { skipMenu = true }
        // A rare axe with fire, cold and lightning on it, to see the statuses.
        if args[i] == "--elements" { game.ElementsOnStart = true }
    }
    if game.Benchmark.Enabled {
        if !QuaxelPlatform.SupportsWindowing() {
            Print("The Ravenford benchmark requires the Windows build")
            return
        }
        QuaxelRenderer.PreferUncappedPresentation()
        game.StartAt = ""
        skipMenu = true
    }
    // Only a window can show the menu; headless runs go straight into the game
    // and do not save. The menu opens with the newest character already
    // loaded, so continuing her is instant.
    if !skipMenu && QuaxelPlatform.SupportsWindowing() {
        game.Screen = HellfeatherScreen.MainMenu
        game.ActiveSlot = HellfeatherSaves.MostRecent()
        game.LoadSlot = game.ActiveSlot
    }
    // Each run lays out a new world, except the benchmark, which needs the same one.
    bool newWorld = !game.Benchmark.Enabled
    game.NewWorldEachRun = newWorld
    if !QuaxelEngine.Run(game) { return }
    if game.Benchmark.Enabled { game.Benchmark.Report() }
    if !QuaxelPlatform.SupportsWindowing() {
        Print("Frames")
        Print(game.StepsSimulated)
        Print("Simulated seconds")
        Print((double)game.StepsSimulated * Quaxel.FixedDeltaSeconds())
    }
    // Picking another character in the menu rebuilds the game around her, in
    // the same window, straight into play.
    bool again = game.Restart
    int slot = game.NextSlot
    bool fresh = game.NextIsNew
    bool ddgi = game.UseDdgi
    bool uniform = game.UniformProbeUpdates
    while again {
        HellfeatherGame next()
        next.UseDdgi = ddgi
        next.UniformProbeUpdates = uniform
        next.NewWorldEachRun = newWorld
        next.ActiveSlot = slot
        next.LoadSlot = fresh ? 0 | slot
        // A new character wakes in her house in Ravenford.
        if fresh { next.StartAt = "in-home" }
        if !QuaxelEngine.Run(next) { return }
        again = next.Restart
        slot = next.NextSlot
        fresh = next.NextIsNew
    }
}
