HellfeatherGame : QuaxelGameInstance
{
    PlayerController [] Controllers
    EnemyController [] Enemies
    HellfeatherEnemySpawner Spawner
    int PlayerNode
    int CameraNode
    HellfeatherBenchmark Benchmark
    int StepsSimulated
    int PlayerHealth
    int PlayerMana
    -float FallenSeconds
    -bool SwingLanded
    -bool MouseHeld
    -bool RightMouseHeld
    -bool [5] SlotKeysHeld
    // The action a click or key asked for this step, or None.
    -HellfeatherAction RequestedAction
    // The swing in progress, which decides its reach and damage.
    -HellfeatherAction SwingAction
    -float WarCrySeconds
    -float DashSeconds
    -vec3 DashDirection
    -float ManaRegen
    -bool InventoryKeyHeld
    -bool StatsKeyHeld
    -bool PassivesKeyHeld
    -bool RunesKeyHeld
    -bool QuestKeyHeld
    -bool LabelKeyHeld
    // The rune board's Version when the known skills last matched it.
    -int RunesSynced
    HellfeatherInventoryScreen Inventory
    // Shows her armor, helmet, weapon and shield on her model.
    HellfeatherWardrobe Wardrobe
    HellfeatherStatsScreen StatsScreen
    HellfeatherPassiveScreen Passives
    HellfeatherRuneScreen Runes
    HellfeatherQuestLog QuestLog
    HellfeatherActionBar Actions
    HellfeatherFpsCounter Fps
    HellfeatherTerrain Terrain
    HellfeatherGlobes Globes
    HellfeatherGroundItems Ground
    HellfeatherFires Fires
    HellfeatherShopKeeper Keeper
    HellfeatherShopScreen Shop

    int WindowWidth() { return Benchmark.Enabled ? 1920 | 960 }
    int WindowHeight() { return Benchmark.Enabled ? 1080 | 540 }

    string WindowTitle() { return "Hellfeather" }

    // World units shown each way from the player along the ground.
    float ViewHalfExtent() { return 10.0 }

    int TerrainSeed() { return 7 }

    // Generation budget per fixed step, in columns. A chunk needs about 60,000.
    int TerrainColumnsPerStep() { return 3000 }

    float PlayerRadius() { return 0.5 }

    float PlayerSpeed() { return 4.0 }

    float EnemyPeckCooldown() { return 1.2 }

    // Her attributes and everything she wears, worked out fresh each time.
    // Her attributes, everything she wears and every passive she has taken.
    HellfeatherStats Stats()
    {
        stats : Inventory.Items.Stats()
        Passives.Tree.ApplyTo(stats)
        return stats
    }

    int PlayerMaxHealth()
    {
        stats : Stats()
        return stats.MaxHealth
    }

    int PlayerMaxMana()
    {
        stats : Stats()
        return stats.MaxMana
    }

    // A plain swing with whatever weapon she holds.
    int AxeDamage()
    {
        stats : Stats()
        return stats.Damage()
    }

    float AxeReach() { return 1.6 }

    int CleaveDamage()
    {
        stats : Stats()
        return stats.CleaveDamage() * RunePower(HellfeatherAction.Cleave) / 100
    }

    // How strong a rune skill is, as a percent. A skill known without a rune on
    // the board, as tests arrange, works at its base strength.
    int RunePower(HellfeatherAction skill) { return Math.Max(100, Runes.Board.PowerOf(skill)) }

    float CleaveReach() { return 2.4 }

    // A war cry doubles damage for this long and staggers enemies this close.
    float WarCrySecondsTotal() { return 8.0 * (float)RunePower(HellfeatherAction.WarCry) / 100.0 }

    float WarCryRadius() { return 4.0 }

    // A dash covers DashSpeed * DashSecondsTotal world units.
    float DashSpeed() { return 18.0 }

    float DashSecondsTotal() { return 0.18 * (float)RunePower(HellfeatherAction.Dash) / 100.0 }

    float ManaPerSecond()
    {
        stats : Stats()
        return stats.ManaPerSecond
    }

    int HealthPotionHeal() { return 40 }

    int ManaPotionRestore() { return 30 }

    // A peck misses a target that has backed this far past the duck's reach.
    float PeckDodgeMargin() { return 0.3 }

    float RespawnSeconds() { return 3.0 }

    float ItemRestRadius() { return 0.4 }

    // The warrior and duck strike on these frames of their attack clips.
    -int AxeStrikeFrame() { return 3 }

    -int PeckStrikeFrame() { return 3 }

    bool Prepare(QuaxelWorld& world)
    {
        Inventory.Stock()
        Actions.Stock()
        Runes.Stock()
        long clock = 0
        QuaxelPlatform.ReadClock(clock)
        Shop.Shop.RestockSeeded((uint)(clock & (long)0x7FFFFFFF))
        return SpawnTerrain(world) && SpawnPlayer(world) && SpawnKeeper(world) && SpawnEnemies(world) && SpawnCamera(world) && SpawnGlobes(world) && Ground.Build(world) && GoToStart(world)
    }

    -bool SpawnKeeper(QuaxelWorld& world)
    {
        float x = HellfeatherShopKeeper.StandX
        float z = HellfeatherShopKeeper.StandZ
        return Keeper.Spawn(world, vec3(x, Terrain.GroundY(x, z), z))
    }

    // Opens the shop on the right with the inventory beside it on the left.
    OpenShop()
    {
        Shop.Open = true
        ShopIsMoth = false
        // The inventory takes the left side while trading.
        StatsScreen.Open = false
        Passives.Open = false
        Runes.Open = false
        QuestLog.Open = false
        Inventory.OnLeft = true
        if !Inventory.Open { Inventory.Toggle() }
    }

    // The two windows open and close together. Walking away closes both.
    SyncShop(QuaxelWorld& world)
    {
        if Shop.Open && (!Inventory.Open || FarFromKeeper(world)) { Shop.Open = false }
        if !Shop.Open && Inventory.OnLeft {
            Inventory.OnLeft = false
            if Inventory.Open { Inventory.Toggle() }
        }
    }

    // Carries out the buy or sell the shop window asked for this frame.
    ApplyShopRequests()
    {
        int index = Shop.BuyRequest
        bool sell = Shop.SellRequest
        Shop.BuyRequest = -1
        Shop.SellRequest = false
        if index >= 0 {
            HellfeatherShopResult quote = Shop.Shop.Quote(index, Inventory.Items.Gold)
            if quote == HellfeatherShopResult.TooPoor { Shop.Say("Not enough gold") }
            else if quote == HellfeatherShopResult.Done {
                item : Shop.Shop.Stock[index].Item
                // Portals go to their count, not the bag.
                if item == HellfeatherItems.RavenPortal {
                    if Inventory.Items.AddPortals(1) {
                        Inventory.Items.Gold -= Shop.Shop.PriceOf(index)
                        Shop.Shop.Take(index)
                    } else {
                        Shop.Say("You carry all the portals you can")
                    }
                } else if Inventory.Items.AddWith(item, Shop.Shop.Stock[index].Mods) {
                    Inventory.Items.Gold -= Shop.Shop.PriceOf(index)
                    Shop.Shop.Take(index)
                } else {
                    Shop.Say("No room in your bag")
                }
            }
        }
        if sell {
            int paid = Shop.Shop.ReceiveWith(Inventory.Items.Held, Inventory.Items.HeldMods)
            if paid > 0 {
                Inventory.Items.Gold += paid
                Inventory.Items.ClearHeld()
            }
        }
    }

    // Moth keeps a shop too; it closes when she walks away from him instead.
    bool ShopIsMoth

    -bool FarFromKeeper(QuaxelWorld& world)
    {
        vec3 feet = Keeper.Feet(world)
        int moth = People.FindPerson(HellfeatherPerson.Moth)
        if ShopIsMoth && moth >= 0 { feet = People.Spots[moth].Feet }
        vec3 player = world.GetPosition(PlayerNode)
        return Math.Hypot(feet.X - player.X, feet.Z - player.Z) > HellfeatherShopKeeper.LeaveReach
    }

    // The Fenmarch's terrain. The Undercroft's levels have their own.
    QuaxelTerrainConfig FenmarchConfig()
    {
        QuaxelTerrainConfig config
        config.Seed = (uint)TerrainSeed()
        config.RoadWidth = 1.6
        config.GroundRoughness = 1
        config.TerraceStep = 5
        config.EntryRadius = Ravenford.Radius
        return config
    }

    -bool SpawnTerrain(QuaxelWorld& world)
    {
        Terrain.House.Volume = HellfeatherHouse.Build(world)
        Terrain.Town.Church = HellfeatherChurch.Build(world)
        Landmarks = HellfeatherLandmarks.Load(world)
        Terrain.Town.Landmarks = Landmarks
        Terrain.Hall.Landmarks = Landmarks
        // The code-built church and cottage stand in for missing models.
        Terrain.Hill.Hospice = Landmarks.OrrasHospice
        if Landmarks.OrrasHospice < 0 {
            Terrain.Hill.Hospice = Terrain.Town.Church
            Terrain.Hill.HospiceHalf = HellfeatherChurch.Half
            Terrain.Hill.HospiceHeight = HellfeatherChurch.Height
            Terrain.Hill.HospiceSight = HellfeatherChurch.Sight
        }
        Terrain.Mill.Mill = Landmarks.HobbsMill
        if Landmarks.HobbsMill < 0 {
            Terrain.Mill.Mill = Terrain.House.Volume
            Terrain.Mill.MillHalf = HellfeatherHouse.Half
            Terrain.Mill.MillHeight = HellfeatherHouse.Height
            Terrain.Mill.MillSight = HellfeatherHouse.Height
            Terrain.Mill.MillVoxel = 0.125
        }
        Terrain.Town.Volumes = RavenfordVolumes.Build(world)
        if Terrain.House.Volume < 0 || Terrain.Town.Church < 0 || !Terrain.Town.Volumes.Complete { return false }
        HellfeatherProps props = HellfeatherProps.Build(world)
        Terrain.Valley.Props = props
        Terrain.River.Props = props
        Terrain.House.Props = props
        Terrain.Town.Props = props
        Terrain.Marsh.Props = props
        Terrain.Hill.Props = props
        Terrain.Mill.Props = props
        Terrain.Hall.Props = props
        Terrain.Landing.Props = props
        if !Terrain.Configure(FenmarchConfig()) || !Terrain.Start(world, vec3(0.0, 0.0, 0.0)) { return false }
        SetUpCast()
        SetUpRavens(world)
        return true
    }

    // Where a walker of this radius stands at a point on the ground.
    -vec3 StandingAt(float x, float z, float radius)
    {
        return vec3(x, Terrain.GroundY(x, z) + radius, z)
    }

    // Moves a walker over the terrain and eases its feet onto the ground.
    -vec3 Walk(vec3 position, vec3 direction, float speed, float radius, float deltaSeconds)
    {
        vec3 moved = Terrain.MoveCircle(position, direction * (speed * deltaSeconds), radius)
        moved.Y = Math.Lerp(position.Y, Terrain.GroundY(moved.X, moved.Z) + radius, Math.Min(1.0, deltaSeconds * 14.0))
        return moved
    }

    // Shows what she has equipped on her model.
    -bool DressPlayer(QuaxelWorld& world, int visual)
    {
        HellfeatherItems body = Inventory.Items.Equipped[HellfeatherSlot.Body]
        HellfeatherItems mainHand = Inventory.Items.Equipped[HellfeatherSlot.MainHand]
        HellfeatherItems offHand = Inventory.Items.Equipped[HellfeatherSlot.OffHand]
        HellfeatherItems head = Inventory.Items.Equipped[HellfeatherSlot.Head]
        return Wardrobe.Dress(world, visual, body, mainHand, offHand, head)
    }

    -bool SpawnPlayer(QuaxelWorld& world)
    {
        PlayerNode = world.CreateNode()
        world.AttachTransform(PlayerNode, QuaxelTransform.Make(
            StandingAt(0.0, 0.0, PlayerRadius()), vec3(1.0, 1.0, 1.0)))
        // She moves, so stains would be left hanging where she stood.
        world.SetCatchesEffects(PlayerNode, false)

        int visual = world.CreateChild(PlayerNode)
        float cell = HellfeatherWarrior.VoxelSize
        float halfHeight = HellfeatherWarrior.Height * cell * 0.5
        QuaxelTransform pose = QuaxelTransform.Make(
            vec3(0.0, halfHeight - PlayerRadius(), 0.0), vec3(cell, cell, cell))
        // Start facing the isometric camera.
        pose.FacingX = 0.70710678
        pose.FacingZ = 0.70710678
        world.AttachTransform(visual, pose)
        if !DressPlayer(world, visual) { return false }

        PlayerController controller
        controller.VisualNode = visual
        controller.Node = PlayerNode
        controller.Speed = PlayerSpeed()
        Controllers += controller
        PlayerHealth = PlayerMaxHealth()
        PlayerMana = PlayerMaxMana()
        return true
    }

    -bool SpawnEnemies(QuaxelWorld& world)
    {
        if Spawner.Data.Len == 0 { Spawner.Data = HellfeatherEnemyData.Build() }
        if !Spawner.Load(world) { return false }
        long now = 0
        QuaxelPlatform.ReadClock(now)
        Spawner.LootRandom.Begin((uint)(now & (long)0x7FFFFFFF))
        PopulateEnemies()
        AddUniques()
        return UpdateSpawns(world, world.GetPosition(PlayerNode))
    }

    // A child of the player, so it follows the player and keeps it centered.
    // Equal offsets give a 45-degree yaw and about 35.3 degrees of elevation.
    -bool SpawnCamera(QuaxelWorld& world)
    {
        CameraNode = world.CreateChild(PlayerNode)
        world.AttachTransform(CameraNode, QuaxelTransform.Make(vec3(20.0, 20.0, 20.0), vec3(1.0, 1.0, 1.0)))
        float extent = ViewHalfExtent()
        float playerTop = HellfeatherWarrior.Height * HellfeatherWarrior.VoxelSize
        float margin = 1.05
        QuaxelCamera camera
        camera.Direction = vec3(-1.0, -1.0, -1.0)
        camera.Up = vec3(0.0, 1.0, 0.0)
        // Shows a square of ground centered on the player.
        camera.FrameHalfWidth = extent * Math.Sqrt(2.0) * margin
        camera.FrameHalfHeight = (extent + playerTop) * 2.0 / Math.Sqrt(6.0) * margin
        // Well behind the eye, to leave room for the globes in front of the world.
        camera.Near = -40.0
        camera.Far = 80.0
        world.AttachCamera(CameraNode, camera)
        return world.SetActiveCamera(CameraNode)
    }

    -bool SpawnGlobes(QuaxelWorld& world)
    {
        if !Globes.Spawn(world, CameraNode) { return false }
        Globes.Anchor(world, WindowWidth(), WindowHeight(), WindowWidth())
        return true
    }

    FixedStep(QuaxelWorld& world, QuaxelInputState& input, float deltaSeconds)
    {
        StepsSimulated++
        if Benchmark.Enabled { Benchmark.Step(input) }
        int activeCamera = world.ActiveCamera
        if activeCamera == 0 { return }
        // Puts on whatever she equipped since the last step.
        for controller : Controllers { DressPlayer(world, controller.VisualNode) }
        bool inventoryKey = input.IsDown(QuaxelKey.I)
        if inventoryKey && !InventoryKeyHeld { Inventory.Toggle() }
        InventoryKeyHeld = inventoryKey
        // The shop puts the inventory on the left, where the stats would go.
        bool statsKey = input.IsDown(QuaxelKey.C)
        if statsKey && !StatsKeyHeld && !Shop.Open {
            StatsScreen.Toggle()
            if StatsScreen.Open {
                Passives.Open = false
                Runes.Open = false
                QuestLog.Open = false
            }
        }
        StatsKeyHeld = statsKey
        // The passive tree shares the left side with the stats, so one closes the other.
        bool passivesKey = input.IsDown(QuaxelKey.P)
        if passivesKey && !PassivesKeyHeld && !Shop.Open {
            Passives.Toggle()
            if Passives.Open {
                StatsScreen.Open = false
                Runes.Open = false
                QuestLog.Open = false
            }
        }
        PassivesKeyHeld = passivesKey
        // The rune board opens with the bag beside it, since runes come from there.
        bool runesKey = input.IsDown(QuaxelKey.R)
        if runesKey && !RunesKeyHeld && !Shop.Open {
            Runes.Toggle()
            if Runes.Open {
                StatsScreen.Open = false
                Passives.Open = false
                QuestLog.Open = false
                if !Inventory.Open { Inventory.Toggle() }
            }
        }
        RunesKeyHeld = runesKey
        // The quest log takes the left side too.
        bool questKey = input.IsDown(QuaxelKey.L)
        if questKey && !QuestKeyHeld && !Shop.Open {
            QuestLog.Toggle()
            if QuestLog.Open {
                StatsScreen.Open = false
                Passives.Open = false
                Runes.Open = false
            }
        }
        QuestKeyHeld = questKey
        // Alt shows or hides the titles of items on the ground.
        bool labelKey = input.IsDown(QuaxelKey.Alt)
        if labelKey && !LabelKeyHeld { Ground.ShowLabels = !Ground.ShowLabels }
        LabelKeyHeld = labelKey
        StepPortalKey(world, input)
        SyncRuneSkills()
        // Taking off gear can lower her maximums below what she has.
        PlayerHealth = Math.Min(PlayerHealth, PlayerMaxHealth())
        PlayerMana = Math.Min(PlayerMana, PlayerMaxMana())
        SampleSlotKeys(input)
        Actions.Slots.Tick(deltaSeconds)
        WarCrySeconds = Math.Max(0.0, WarCrySeconds - deltaSeconds)
        if !Terrain.Stream(world, world.GetPosition(PlayerNode), TerrainColumnsPerStep()) { Print("Terrain streaming failed") }
        Fires.Step(world, Terrain.Valley.Props.Brazier, Terrain.Town.Volumes.Campfire, world.GetPosition(PlayerNode), deltaSeconds)
        if !UpdateSpawns(world, world.GetPosition(PlayerNode)) { Print("Enemy spawning failed") }
        Globes.Step(world, (float)PlayerHealth / (float)PlayerMaxHealth(), (float)PlayerMana / (float)PlayerMaxMana(), deltaSeconds)
        StepAct(world, deltaSeconds)
        if PlayerHealth <= 0 {
            StepFallenPlayer(world, deltaSeconds)
            RequestedAction = HellfeatherAction.None
            UpdateEnemies(world, deltaSeconds)
            return
        }
        RegenerateMana(deltaSeconds)
        vec3 direction = HellfeatherMovement.Direction(world.GetCamera(activeCamera), input)
        UseRequested(world, direction)
        for controller : Controllers {
            if world.Has(controller.Node, QuaxelComponents.Transform) {
                QuaxelTransform transform = world.GetTransform(controller.Node)
                vec3 before = transform.Position
                if DashSeconds > 0.0 {
                    transform.Position = Walk(transform.Position, DashDirection, DashSpeed(), PlayerRadius(), Math.Min(deltaSeconds, DashSeconds))
                    DashSeconds -= deltaSeconds
                }
                else {
                    stats : Stats()
                    controller.Speed = PlayerSpeed() * (float)stats.MoveSpeed / 100.0
                    transform.Position = Walk(transform.Position, direction, controller.Speed, PlayerRadius(), deltaSeconds)
                }
                world.SetTransform(controller.Node, transform)
                bool moving = transform.Position.X != before.X || transform.Position.Z != before.Z
                int visual = controller.VisualNode
                QuaxelAnimator animator = world.GetAnimator(visual)
                bool swinging = world.CurrentClipName(visual) == "attack" && animator.Playing
                if swinging && !SwingLanded && animator.Frame >= AxeStrikeFrame() {
                    SwingLanded = true
                    StrikeEnemies(world, transform.Position, SwingAction)
                }
                bool startingSwing = !swinging && HellfeatherAction.IsSwing(RequestedAction) && Perform(RequestedAction)
                if !swinging {
                    if startingSwing {
                        world.PlayClip(visual, "attack")
                        SwingLanded = false
                        SwingAction = RequestedAction
                    }
                    else { world.PlayClip(visual, moving ? "walk" | "idle") }
                }
                vec3 facing = Math.Normalize(vec3(transform.Position.X - before.X, 0.0, transform.Position.Z - before.Z))
                if (facing.X != 0.0 || facing.Z != 0.0) && world.Has(controller.VisualNode, QuaxelComponents.Transform) {
                    QuaxelTransform pose = world.GetTransform(controller.VisualNode)
                    pose.FacingX = facing.X
                    pose.FacingZ = facing.Z
                    world.SetTransform(controller.VisualNode, pose)
                }
                if swinging || startingSwing { AimAtNearestEnemy(world, visual, transform.Position) }
            }
        }
        RequestedAction = HellfeatherAction.None
        UpdateEnemies(world, deltaSeconds)
    }

    // Q, E and F use their slots once per press.
    -SampleSlotKeys(QuaxelInputState& input)
    {
        QuaxelKey [5] keys = {QuaxelKey.Q, QuaxelKey.Q, QuaxelKey.Q, QuaxelKey.E, QuaxelKey.F}
        for slot : HellfeatherActionSlot {
            if slot < HellfeatherActionSlot.Q { continue }
            bool down = input.IsDown(keys[slot])
            if down && !SlotKeysHeld[slot] { RequestSlot(slot) }
            SlotKeysHeld[slot] = down
        }
    }

    // Asks for whatever action sits in a slot, to be used on the next step.
    RequestSlot(HellfeatherActionSlot slot)
    {
        if PlayerHealth <= 0 { return }
        action : Actions.Slots.Assigned[slot]
        if action != HellfeatherAction.None { RequestedAction = action }
    }

    -RegenerateMana(float deltaSeconds)
    {
        if PlayerMana >= PlayerMaxMana() {
            ManaRegen = 0.0
            return
        }
        ManaRegen += deltaSeconds * ManaPerSecond()
        while ManaRegen >= 1.0 && PlayerMana < PlayerMaxMana() {
            PlayerMana++
            ManaRegen -= 1.0
        }
    }

    // Her mana, and how many potions each drinking action could use.
    HellfeatherActionMeans Means()
    {
        HellfeatherActionMeans means
        means.Mana = PlayerMana
        for action : HellfeatherAction {
            HellfeatherActionKind kind = HellfeatherAction.Get(action)
            if kind.Item != HellfeatherItems.None { means.Stock[action] = Inventory.Items.CountOf(kind.Item) }
        }
        return means
    }

    // Pays for an action if it is ready: its mana, its cooldown and any potion it drinks.
    bool Perform(HellfeatherAction action)
    {
        if !Actions.Slots.Ready(action, Means()) { return false }
        HellfeatherActionKind kind = HellfeatherAction.Get(action)
        PlayerMana -= kind.Mana
        if kind.Item != HellfeatherItems.None { Inventory.Items.Consume(kind.Item) }
        Actions.Slots.Spend(action)
        return true
    }

    // Actions that are not swings take effect at once, even mid-swing.
    -UseRequested(QuaxelWorld& world, vec3 direction)
    {
        action : RequestedAction
        if action == HellfeatherAction.None || HellfeatherAction.IsSwing(action) { return }
        RequestedAction = HellfeatherAction.None
        if !Perform(action) { return }
        if action == HellfeatherAction.HealthPotion { PlayerHealth = Math.Min(PlayerMaxHealth(), PlayerHealth + HealthPotionHeal()) }
        else if action == HellfeatherAction.ManaPotion { PlayerMana = Math.Min(PlayerMaxMana(), PlayerMana + ManaPotionRestore()) }
        else if action == HellfeatherAction.WarCry { Shout(world) }
        else if action == HellfeatherAction.Dash { StartDash(world, direction) }
    }

    -Shout(QuaxelWorld& world)
    {
        WarCrySeconds = WarCrySecondsTotal()
        vec3 origin = world.GetPosition(PlayerNode)
        for i : 0; i < Enemies.Len; i++ {
            if !Enemies[i].Awake || Enemies[i].Health <= 0 { continue }
            if GroundDistance(origin, world.GetPosition(Enemies[i].Node)) > WarCryRadius() { continue }
            world.PlayClip(Enemies[i].VisualNode, "hit")
        }
    }

    // Along the keys held, or straight ahead when none are.
    -StartDash(QuaxelWorld& world, vec3 direction)
    {
        DashDirection = direction
        if direction.X == 0.0 && direction.Z == 0.0 && Controllers.Len > 0 {
            QuaxelTransform pose = world.GetTransform(Controllers[0].VisualNode)
            DashDirection = Math.Normalize(vec3(pose.FacingX, 0.0, pose.FacingZ))
        }
        DashSeconds = DashSecondsTotal()
        vec3 feet = world.GetPosition(PlayerNode)
        feet.Y = Terrain.GroundY(feet.X, feet.Z)
        world.StartEffect(QuaxelEffectStyle.Dust(), feet, vec3(0.0, 1.0, 0.0) - DashDirection)
    }

    -FaceAlong(QuaxelWorld& world, int visual, vec3 direction)
    {
        if direction.X == 0.0 && direction.Z == 0.0 { return }
        QuaxelTransform pose = world.GetTransform(visual)
        pose.FacingX = direction.X
        pose.FacingZ = direction.Z
        world.SetTransform(visual, pose)
    }

    // Length of the XZ offset from a to b.
    -float GroundDistance(vec3 a, vec3 b)
    {
        return vec3(b.X - a.X, 0.0, b.Z - a.Z).Length()
    }

    // Swings turn toward the closest living enemy within axe reach.
    -AimAtNearestEnemy(QuaxelWorld& world, int visual, vec3 origin)
    {
        float closest = AxeReach()
        vec3 aim = vec3(0.0, 0.0, 0.0)
        for i : 0; i < Enemies.Len; i++ {
            if !Enemies[i].Awake || Enemies[i].Health <= 0 { continue }
            vec3 enemy = world.GetPosition(Enemies[i].Node)
            float distance = GroundDistance(origin, enemy)
            if distance <= closest {
                closest = distance
                aim = vec3(enemy.X - origin.X, 0.0, enemy.Z - origin.Z)
            }
        }
        FaceAlong(world, visual, Math.Normalize(aim))
    }

    -StrikeEnemies(QuaxelWorld& world, vec3 origin, HellfeatherAction action)
    {
        bool cleave = action == HellfeatherAction.Cleave
        float reach = cleave ? CleaveReach() | AxeReach()
        int damage = cleave ? CleaveDamage() | AxeDamage()
        if WarCrySeconds > 0.0 { damage *= 2 }
        bool shards = Inventory.Items.Equipped[HellfeatherSlot.Neck] == HellfeatherItems.MardrasRingShards
        for i : 0; i < Enemies.Len; i++ {
            if !Enemies[i].Awake || Enemies[i].Health <= 0 { continue }
            if GroundDistance(origin, world.GetPosition(Enemies[i].Node)) > reach { continue }
            Enemies[i].Health -= Taken(world, i, origin, damage)
            Enemies[i].Provoked = true
            if shards { PlayerHealth = Math.Min(PlayerMaxHealth(), PlayerHealth + 2) }
            bool slain = Enemies[i].Health <= 0
            Bleed(world, Enemies[i].Node, origin, slain)
            if slain {
                Actions.Slots.CountKill()
                GainExperience(Spawner.Table.Kinds[Enemies[i].Kind].Experience)
                Enemies[i].Health = 0
                Enemies[i].RespawnTimer = RespawnSeconds()
                DropLoot(world, i)
                DropFeathers(world, i)
                CountKill(world, i)
            }
            world.PlayClip(Enemies[i].VisualNode, slain ? "death" | "hit")
        }
    }

    // What a blow does to an enemy. A shield turns half of a blow from the front,
    // and a blow while Mardra channels her ring staggers her and lands twice over.
    -int Taken(QuaxelWorld& world, int i, vec3 origin, int damage)
    {
        HellfeatherMove move = Enemies[i].Move
        if move == HellfeatherMove.Shield && Enemies[i].VisualNode != 0 {
            QuaxelTransform pose = world.GetTransform(Enemies[i].VisualNode)
            vec3 at = world.GetPosition(Enemies[i].Node)
            vec3 toward = Math.Normalize(vec3(origin.X - at.X, 0.0, origin.Z - at.Z))
            if pose.FacingX * toward.X + pose.FacingZ * toward.Z > 0.5 { return damage / 2 }
        }
        if move == HellfeatherMove.Brood && Enemies[i].Phase == 1 {
            Enemies[i].Stagger = 2.5
            NextPhase(i, 0)
            Banner.Show("The ring flares. Mardra staggers", 2.0)
            return damage * 2
        }
        return damage
    }

    // Black feathers from a slain bird of the Moult, more in a Featherfall.
    -DropFeathers(QuaxelWorld& world, int index)
    {
        int most = Spawner.Table.Kinds[Enemies[index].Kind].Feathers
        if most <= 0 { return }
        int amount = 1 + Spawner.LootRandom.Below(most)
        if Featherfall.Active { amount += 2 }
        Ground.PlaceFeathers(world, amount, DropSpotAround(world.GetPosition(Enemies[index].Node)))
    }

    // Rolls the enemy's loot onto the ground around it, the first time it falls.
    -DropLoot(QuaxelWorld& world, int index)
    {
        int loot = Spawner.Table.Kinds[Enemies[index].Kind].LootIndex
        if loot < 0 || Enemies[index].LootDropped { return }
        Enemies[index].LootDropped = true
        vec3 corpse = world.GetPosition(Enemies[index].Node)
        for roll : 0; roll < Spawner.Table.Loots[loot].Rolls; roll++ {
            item : Spawner.RollLoot(loot)
            if item == HellfeatherItems.None { continue }
            mods : Spawner.RollMods(item)
            Ground.PlaceWith(world, item, mods, DropSpotAround(corpse))
            int gold = Spawner.RollGold(loot)
            if gold > 0 { Ground.PlaceGold(world, gold, DropSpotAround(corpse)) }
        }
    }

    // Blood flies from the wound away from the attacker, and more of it on a kill.
    -Bleed(QuaxelWorld& world, int node, vec3 attacker, bool heavy)
    {
        vec3 wound = world.GetPosition(node)
        vec3 away = Math.Normalize(vec3(wound.X - attacker.X, 0.0, wound.Z - attacker.Z))
        QuaxelEffectStyle style = heavy ? QuaxelEffectStyle.BloodSplatter() | QuaxelEffectStyle.BloodSplash()
        world.StartEffectIgnoring(style, wound, away + vec3(0.0, 0.8, 0.0), node)
    }

    // Skills are known while a rune granting them is on the board.
    SyncRuneSkills()
    {
        if Runes.Board.Version == RunesSynced { return }
        RunesSynced = Runes.Board.Version
        for action : HellfeatherAction {
            if HellfeatherRunes.IsRuneSkill(action) { Actions.Slots.SetKnown(action, Runes.Board.PowerOf(action) > 0) }
        }
    }

    // A new level brings a passive point and refills her health and mana.
    GainExperience(int amount)
    {
        if Passives.Level.Gain(amount) == 0 { return }
        PlayerHealth = PlayerMaxHealth()
        PlayerMana = PlayerMaxMana()
    }

    -DamagePlayer(QuaxelWorld& world, int amount)
    {
        if PlayerHealth <= 0 { return }
        PlayerHealth -= amount
        Bleed(world, PlayerNode, world.GetPosition(PlayerNode), PlayerHealth <= 0)
        if PlayerHealth > 0 { return }
        PlayerHealth = 0
        FallenSeconds = 0.0
        WarCrySeconds = 0.0
        DashSeconds = 0.0
        for controller : Controllers { world.PlayClip(controller.VisualNode, "idle") }
    }

    // Fall is 0 standing and 1 flat on her back.
    -SetFall(QuaxelWorld& world, int visual, float fall)
    {
        float standing = HellfeatherWarrior.Height * HellfeatherWarrior.VoxelSize * 0.5 - PlayerRadius()
        float lying = HellfeatherWarrior.LyingCenterHeight(Inventory.Items.Equipped[HellfeatherSlot.Body]) - PlayerRadius()
        QuaxelTransform pose = world.GetTransform(visual)
        pose.Rotation = QuaxelRotation.FromDegrees(0.0, -90.0 * fall, 0.0)
        pose.Position = vec3(0.0, standing + (lying - standing) * fall, 0.0)
        world.SetTransform(visual, pose)
    }

    -StepFallenPlayer(QuaxelWorld& world, float deltaSeconds)
    {
        FallenSeconds += deltaSeconds
        if FallenSeconds >= RespawnSeconds() {
            RevivePlayer(world)
            return
        }
        float fall = Math.Clamp(FallenSeconds / 0.35, 0.0, 1.0)
        for controller : Controllers { SetFall(world, controller.VisualNode, fall) }
    }

    -RevivePlayer(QuaxelWorld& world)
    {
        PlayerHealth = PlayerMaxHealth()
        PlayerMana = PlayerMaxMana()
        FallenSeconds = 0.0
        // Back to Ravenford, or to the landing of the level she fell on.
        vec3 home = vec3(0.0, 0.0, 0.0)
        if Terrain.Realm != HellfeatherRealm.Fenmarch { home = HellfeatherRealm.Landing(Terrain.Realm) + vec3(0.0, 0.0, 1.5) }
        QuaxelTransform transform = world.GetTransform(PlayerNode)
        transform.Position = StandingAt(home.X, home.Z, PlayerRadius())
        world.SetTransform(PlayerNode, transform)
        ClearShots(world)
        for controller : Controllers { SetFall(world, controller.VisualNode, 0.0) }
        for i : 0; i < Enemies.Len; i++ {
            if Enemies[i].Health > 0 || Enemies[i].Respawns { RespawnEnemy(world, i) }
        }
    }

    -RespawnEnemy(QuaxelWorld& world, int index)
    {
        Enemies[index].Health = Enemies[index].MaxHealth
        Enemies[index].Cooldown = 0.0
        Enemies[index].Phase = 0
        Enemies[index].PhaseTime = 0.0
        Enemies[index].Stagger = 0.0
        if !Enemies[index].Awake { return }
        QuaxelTransform transform = world.GetTransform(Enemies[index].Node)
        transform.Position = Enemies[index].Home
        world.SetTransform(Enemies[index].Node, transform)
        world.PlayClip(Enemies[index].VisualNode, "idle")
    }

    -UpdateEnemies(QuaxelWorld& world, float deltaSeconds)
    {
        vec3 player = world.GetPosition(PlayerNode)
        for i : 0; i < Enemies.Len; i++ {
            if !Enemies[i].Awake { continue }
            if Enemies[i].Health <= 0 {
                if Enemies[i].Respawns {
                    Enemies[i].RespawnTimer -= deltaSeconds
                    if Enemies[i].RespawnTimer <= 0.0 { RespawnEnemy(world, i) }
                }
                continue
            }
            if PlayerHealth <= 0 {
                if Enemies[i].Cooldown > 0.0 { Enemies[i].Cooldown -= deltaSeconds }
                world.SetAnimationSpeed(Enemies[i].VisualNode, 1.0)
                world.PlayClip(Enemies[i].VisualNode, "idle")
                continue
            }
            StepEnemy(world, i, player, deltaSeconds)
        }
    }

    markup BuildUi() { return HellfeatherHud.Build() }

    ConfigureUi(QuaxelUi& ui) { ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight) }

    // The left button uses the Left slot, unless the click belongs to a panel or an item.
    SampleAttack(int mouseX, int mouseY, bool held)
    {
        if held && !MouseHeld && !ClickTaken(mouseX, mouseY) { RequestSlot(HellfeatherActionSlot.Left) }
        MouseHeld = held
    }

    SampleRightClick(int mouseX, int mouseY, bool held)
    {
        if held && !RightMouseHeld && !ClickTaken(mouseX, mouseY) { RequestSlot(HellfeatherActionSlot.Right) }
        RightMouseHeld = held
    }

    -bool ClickTaken(int mouseX, int mouseY)
    {
        return Inventory.Captures(mouseX, mouseY) || StatsScreen.Captures(mouseX, mouseY) || Passives.Captures(mouseX, mouseY) || Runes.Captures(mouseX, mouseY) || QuestLog.Captures(mouseX, mouseY) || Shop.Captures(mouseX, mouseY) || Actions.Captures(mouseX, mouseY) || Ground.Hovered >= 0 || Keeper.Hovered || People.Hovered >= 0 || Talk.Captures(mouseX, mouseY)
    }

    // Moves the item on the cursor to the ground beside the warrior.
    bool DropHeld(QuaxelWorld& world)
    {
        item : Inventory.Items.Held
        if item == HellfeatherItems.None || !Ground.PlaceWith(world, item, Inventory.Items.HeldMods, DropSpotAround(world.GetPosition(PlayerNode))) { return false }
        Inventory.Items.ClearHeld()
        return true
    }

    // The nearest open ground around a point, working outward in rings.
    -vec3 DropSpotAround(vec3 center)
    {
        for ring : 1; ring <= 4; ring++ {
            float distance = 0.4 + (float)ring * 0.5
            for step : 0; step < 12; step++ {
                float angle = ((float)step + (float)ring * 0.5) * 0.5235988
                float x = center.X + Math.Cos(angle) * distance
                float z = center.Z + Math.Sin(angle) * distance
                if !Terrain.CircleBlocked(x, z, 0.2) && Ground.IsClear(x, z) { return vec3(x, RestingY(x, z), z) }
            }
        }
        return vec3(center.X, RestingY(center.X, center.Z), center.Z)
    }

    // The highest ground under an item, since the terrain is rougher than a flat item is tall.
    float RestingY(float x, float z)
    {
        float highest = Terrain.GroundY(x, z)
        int reach = (int)Math.Ceil(ItemRestRadius() / QuaxelTerrain.Cell)
        int column = Terrain.ColumnAt(x)
        int row = Terrain.ColumnAt(z)
        for a : -reach; a <= reach; a++ {
            for b : -reach; b <= reach; b++ {
                if !Terrain.IsBlockedColumn(column + a, row + b) { highest = Math.Max(highest, Terrain.SurfaceY(Terrain.ColumnHeight(column + a, row + b))) }
            }
        }
        return highest
    }

    // Fails if the item is out of reach or the bag has no room for it.
    bool TakeFromGround(QuaxelWorld& world, int index)
    {
        if !Ground.InReach(index, world.GetPosition(PlayerNode)) { return false }
        if Ground.Entries[index].Item == HellfeatherItems.Gold { Inventory.Items.Gold += Ground.Entries[index].Amount }
        else if Ground.Entries[index].Item == HellfeatherItems.BlackFeather { Inventory.Items.Feathers += Ground.Entries[index].Amount }
        else if Ground.Entries[index].Item == HellfeatherItems.RavenPortal {
            if !Inventory.Items.AddPortals(Math.Max(1, Ground.Entries[index].Amount)) { return false }
        }
        else if !Inventory.Items.AddWith(Ground.Entries[index].Item, Ground.Entries[index].Mods) { return false }
        Ground.Remove(world, index)
        return true
    }

    // Decides what a click on the world means. Holding an item drops it, and a
    // click on an item takes it, so neither of them also swings the axe.
    ClickWorld(QuaxelWorld& world, int mouseX, int mouseY, bool held)
    {
        bool pressed = held && !MouseHeld
        SampleAttack(mouseX, mouseY, held)
        if !pressed || PlayerHealth <= 0 { return }
        if Inventory.Items.Held != HellfeatherItems.None {
            if !Inventory.OverPanel(mouseX, mouseY) && !StatsScreen.OverPanel(mouseX, mouseY) && !Passives.OverPanel(mouseX, mouseY) && !Runes.OverPanel(mouseX, mouseY) && !QuestLog.OverPanel(mouseX, mouseY) && !Shop.OverPanel(mouseX, mouseY) && !Actions.OverBar(mouseX, mouseY) { DropHeld(world) }
            return
        }
        if Talk.Captures(mouseX, mouseY) { return }
        if Ground.Hovered >= 0 { TakeFromGround(world, Ground.Hovered) }
        else if Keeper.Hovered && Keeper.InReach(world, world.GetPosition(PlayerNode)) { OpenShop() }
        else if People.Hovered >= 0 && People.InReach(People.Hovered, world.GetPosition(PlayerNode)) { Use(world, People.Hovered) }
    }

    UpdateUi(QuaxelUi& ui, QuaxelWorld& world)
    {
        int mouseX = 0
        int mouseY = 0
        QuaxelPlatform.GetMousePosition(mouseX, mouseY)
        bool mouseDown = QuaxelPlatform.IsMouseButtonDown()
        bool rightDown = QuaxelPlatform.IsRightMouseButtonDown()
        int windowWidth = 0
        int windowHeight = 0
        bool hasWindow = QuaxelPlatform.GetWindowSize(windowWidth, windowHeight) && windowWidth > 0 && windowHeight > 0
        if Benchmark.Enabled { Benchmark.Frame(StepsSimulated, world.GetPosition(PlayerNode), windowWidth, windowHeight) }
        ui.ClearOverlay()
        // Drawn first, so that the inventory panel covers the titles.
        if hasWindow {
            bool panelsFree = !Inventory.Captures(mouseX, mouseY) && !StatsScreen.Captures(mouseX, mouseY) && !Passives.Captures(mouseX, mouseY) && !Runes.Captures(mouseX, mouseY) && !QuestLog.Captures(mouseX, mouseY) && !Shop.Captures(mouseX, mouseY) && !Actions.Captures(mouseX, mouseY)
            Keeper.DrawLabel(ui, world, CameraNode, world.GetPosition(PlayerNode), windowWidth, windowHeight, mouseX, mouseY, panelsFree)
            DrawPeople(ui, world, windowWidth, windowHeight, mouseX, mouseY, panelsFree && !Keeper.Hovered && !Talk.Captures(mouseX, mouseY))
            Ground.DrawLabels(ui, world, CameraNode, world.GetPosition(PlayerNode), windowWidth, windowHeight, mouseX, mouseY, panelsFree)
            // An item's title wins over the shopkeeper behind it.
            if Ground.Hovered >= 0 {
                Keeper.Hovered = false
                People.Hovered = -1
            }
            DrawAimLines(ui, world, windowWidth, windowHeight)
            Talk.Update(ui, windowWidth, windowHeight, mouseX, mouseY, mouseDown)
            if Talk.Chosen != HellfeatherReply.None { Answer(world, Talk.Chosen) }
            Banner.Draw(ui, windowWidth, windowHeight)
            // A copy, since the game's own fields cannot be lent by reference.
            HellfeatherQuests quests = Quests
            QuestLog.Notice(quests)
            // Where she is, in the corner the open panels on the left would cover.
            if !StatsScreen.Open && !Passives.Open && !Runes.Open && !QuestLog.Open && !Shop.Open { HellfeatherZoneNames.Draw(ui, ZoneName()) }
        }
        // Before the panels handle this click, so closing one cannot also swing the axe.
        ClickWorld(world, mouseX, mouseY, mouseDown)
        SampleRightClick(mouseX, mouseY, rightDown)
        if hasWindow {
            // Under the inventory, which covers it when the window is too narrow for both.
            int clearWidth = Inventory.Open ? Inventory.PanelLeft * Inventory.PanelScale | windowWidth
            if Shop.Open { clearWidth = Shop.PanelLeft * Shop.PanelScale }
            // Worked out here, since the stats panel places itself after the bar.
            int coveredLeft = StatsScreen.Open || Passives.Open || Runes.Open || QuestLog.Open ? (HellfeatherStatsScreen.Margin + HellfeatherInventoryArt.PanelWidth) * ui.ScaleFor(windowWidth, windowHeight) | 0
            Actions.CoveredLeft = coveredLeft
            Actions.ExperienceShare = Passives.Level.Share()
            Actions.UnspentPoints = Passives.Open ? 0 | Passives.Points()
            Actions.Portals = Inventory.Items.Portals
            Globes.CoveredLeft = coveredLeft
            Actions.Update(ui, windowWidth, windowHeight, mouseX, mouseY, mouseDown, clearWidth, Inventory.OverPanel(mouseX, mouseY) || StatsScreen.OverPanel(mouseX, mouseY) || Passives.OverPanel(mouseX, mouseY) || Runes.OverPanel(mouseX, mouseY) || QuestLog.OverPanel(mouseX, mouseY) || Shop.OverPanel(mouseX, mouseY), Means())
            if Actions.PortalRequest {
                Actions.PortalRequest = false
                OpenPortal(world)
            }
            // Before the inventory, which draws the item on the cursor over every panel.
            Shop.HeldMods = Inventory.Items.HeldMods
            Shop.Update(ui, windowWidth, windowHeight, mouseX, mouseY, mouseDown, Inventory.Items.Gold, Inventory.Items.Held)
            ApplyShopRequests()
            stats : Stats()
            StatsScreen.Level = Passives.Level.Level
            StatsScreen.Experience = Passives.Level.Experience
            StatsScreen.ToNext = Passives.Level.ToNext()
            StatsScreen.Update(ui, windowWidth, windowHeight, mouseX, mouseY, mouseDown, stats, PlayerHealth, PlayerMana)
            Passives.Update(ui, windowWidth, windowHeight, mouseX, mouseY, mouseDown, rightDown)
            HellfeatherQuests progress = Quests
            QuestLog.Update(ui, windowWidth, windowHeight, mouseX, mouseY, mouseDown, progress)
            // The board and the bag share the cursor's item.
            Runes.Level = Passives.Level.Level
            Runes.Held = Inventory.Items.Held
            Runes.Update(ui, windowWidth, windowHeight, mouseX, mouseY, mouseDown)
            Inventory.Items.ReplaceHeld(Runes.Held)
            Inventory.Update(ui, windowWidth, windowHeight, mouseX, mouseY, mouseDown)
            // Without the bag beside it the board has nowhere to put a lifted rune.
            if !Inventory.Open { Runes.Open = false }
            SyncShop(world)
            // An item the bag had no room for when the panel closed goes on the ground.
            if !Inventory.Open { DropHeld(world) }
            Globes.Anchor(world, windowWidth, windowHeight, clearWidth)
        }
        // The open panel covers the corner the counter sits in.
        ui.SetVisible("fps", !Inventory.Open)
        long frequency = 0
        long now = 0
        if QuaxelPlatform.GetClockFrequency(frequency) && QuaxelPlatform.ReadClock(now) && Fps.Tick(now, frequency) {
            HellfeatherHud.ShowFps(ui, Fps.Value)
        }
    }

    // Advances the simulation as the engine does. Used by the headless tests.
    vec3 Simulate(QuaxelWorld& world, QuaxelInputState& input, int steps)
    {
        for i : 0; i < steps; i++ {
            world.BeginStep()
            world.AdvanceAnimations((float)Quaxel.FixedDeltaSeconds())
            FixedStep(world, input, (float)Quaxel.FixedDeltaSeconds())
            world.AdvanceEffects((float)Quaxel.FixedDeltaSeconds())
            world.UpdateSockets()
            world.EndStep()
        }
        return world.GetPosition(PlayerNode)
    }

    // Maps world points to the screen: X right and Y down, both -1..1 inside the window.
    mat4 ScreenMatrix(QuaxelWorld& world)
    {
        QuaxelCamera camera = world.GetCamera(CameraNode)
        camera.UpdateBounds(960, 540)
        return camera.ViewProjection(world.WorldPosition(CameraNode))
    }
}
T{
    TerrainRoutesRiversAndHousesAwayFromTheSpawn()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int rivers = 0
        int houses = 0
        for i : 0; i < game.Terrain.Layout.Sites.Len; i++ {
            if game.Terrain.Layout.Sites[i].Module == HellfeatherZone.FordRoad + 0 {
                rivers++
                T.IsTrue(game.Terrain.Layout.Sites[i].PortCount >= 2)
            }
            if game.Terrain.Layout.Sites[i].Module == HellfeatherZone.Croft + 0 { houses++ }
        }
        T.IsTrue(rivers > 0 && houses > 0)
        T.AreEqual(game.Terrain.Layout.Sites[game.Terrain.SpawnSiteIndex].Module, HellfeatherZone.Ravenford + 0)
        int buildings = 0
        for i : 0; i < game.Terrain.Placements.Len; i++ {
            if !game.Terrain.Placements[i].Prop { buildings++ }
        }
        // Ravenford's buildings, at most one cottage per house clearing, and at
        // most the hospice and the mill.
        T.IsTrue(buildings >= 15 && buildings <= houses + 17)
    }

    TheIKeyTogglesTheInventoryOncePerPress()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        T.IsFalse(game.Inventory.Open)
        QuaxelInputState input
        input.SetDown(QuaxelKey.I, true)
        game.Simulate(world, input, 10)
        T.IsTrue(game.Inventory.Open)
        input.SetDown(QuaxelKey.I, false)
        game.Simulate(world, input, 2)
        T.IsTrue(game.Inventory.Open)
        input.SetDown(QuaxelKey.I, true)
        game.Simulate(world, input, 2)
        T.IsFalse(game.Inventory.Open)
    }

    TheCKeyTogglesTheStatsOncePerPressButNotWhileTrading()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        T.IsFalse(game.StatsScreen.Open)
        QuaxelInputState input
        input.SetDown(QuaxelKey.C, true)
        game.Simulate(world, input, 10)
        T.IsTrue(game.StatsScreen.Open)
        input.SetDown(QuaxelKey.C, false)
        game.Simulate(world, input, 2)
        T.IsTrue(game.StatsScreen.Open)
        // Opening the shop gives the left side to the inventory.
        game.OpenShop()
        T.IsFalse(game.StatsScreen.Open)
        input.SetDown(QuaxelKey.C, true)
        game.Simulate(world, input, 2)
        T.IsFalse(game.StatsScreen.Open)
    }

    ThePKeyOpensThePassivesInPlaceOfTheStats()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        QuaxelInputState input
        input.SetDown(QuaxelKey.C, true)
        game.Simulate(world, input, 2)
        T.IsTrue(game.StatsScreen.Open)
        input.Clear()
        input.SetDown(QuaxelKey.P, true)
        game.Simulate(world, input, 2)
        T.IsTrue(game.Passives.Open)
        T.IsFalse(game.StatsScreen.Open)
        input.Clear()
        game.Simulate(world, input, 1)
        input.SetDown(QuaxelKey.P, true)
        game.Simulate(world, input, 2)
        T.IsFalse(game.Passives.Open)
    }

    TheLKeyOpensTheQuestLogInPlaceOfTheStats()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        QuaxelInputState input
        input.SetDown(QuaxelKey.C, true)
        game.Simulate(world, input, 2)
        T.IsTrue(game.StatsScreen.Open)
        input.Clear()
        input.SetDown(QuaxelKey.L, true)
        game.Simulate(world, input, 2)
        T.IsTrue(game.QuestLog.Open)
        T.IsFalse(game.StatsScreen.Open)
        input.Clear()
        game.Simulate(world, input, 1)
        input.SetDown(QuaxelKey.L, true)
        game.Simulate(world, input, 2)
        T.IsFalse(game.QuestLog.Open)
    }

    SlayingEnemiesLevelsTheWarriorUpAndRefillsHer()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.PlayerHealth = 10
        game.GainExperience(30)
        T.AreEqual(game.Passives.Level.Level, 1)
        T.AreEqual(game.PlayerHealth, 10)
        game.GainExperience(10)
        T.AreEqual(game.Passives.Level.Level, 2)
        T.AreEqual(game.Passives.Points(), 1)
        T.AreEqual(game.PlayerHealth, game.PlayerMaxHealth())
    }

    TakenPassivesChangeTheLiveStats()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int before = game.PlayerMaxHealth()
        game.GainExperience(40)
        T.IsTrue(game.Passives.Tree.Allocate(1, game.Passives.Points()))
        T.AreEqual(game.PlayerMaxHealth(), before + 8)
        int strength = 1 + 3 * HellfeatherPassiveTree.PerQuadrant
        game.GainExperience(80)
        T.IsTrue(game.Passives.Tree.Allocate(strength, game.Passives.Points()))
        T.AreEqual(game.AxeDamage(), 20 + HellfeatherStats.BaseStrength + 2)
    }

    SwingsHitWithTheWeaponPlusStrength()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        T.AreEqual(game.AxeDamage(), 20 + HellfeatherStats.BaseStrength)
        game.Inventory.Items.Equipped[HellfeatherSlot.MainHand] = HellfeatherItems.ShortSword
        T.AreEqual(game.AxeDamage(), 12 + HellfeatherStats.BaseStrength)
    }

    TheStatsPanelPushesTheBarAndHealthGlobeRight()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        mat4 matrix = game.ScreenMatrix(world)
        game.Globes.Anchor(world, 960, 540, 960)
        vec4 before = matrix * vec4(world.WorldPosition(game.Globes.Health.Root), 1.0)
        int covered = (HellfeatherStatsScreen.Margin + HellfeatherInventoryArt.PanelWidth) * 2
        game.Globes.CoveredLeft = covered
        game.Globes.Anchor(world, 960, 540, 960)
        vec4 placed = matrix * vec4(world.WorldPosition(game.Globes.Health.Root), 1.0)
        float after = placed.X
        T.IsTrue(after > before.X)
        T.IsTrue((after + 1.0) * 480.0 > (float)covered)
        QuaxelUi ui()
        game.ConfigureUi(ui)
        game.Actions.CoveredLeft = covered
        game.Actions.Update(ui, 960, 540, 0, 0, false, 960, false, game.Means())
        ui.Layout(960, 540, 0, 0, false)
        QuaxelUiCommand bar = ui.GetCommand(0)
        T.IsTrue(bar.X >= covered)
    }

    TheWarriorStartsWithHerAxeEquipped()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        T.AreEqual(game.Inventory.Items.Equipped[HellfeatherSlot.MainHand], HellfeatherItems.BattleAxe)
        T.AreEqual(game.Inventory.Items.Bag.Len, 1)
        T.AreEqual(game.Inventory.Items.CountOf(HellfeatherItems.RuneCleave), 1)
        T.IsFalse(game.Actions.Slots.Known[HellfeatherAction.Cleave])
    }

    ModsSurviveTheGroundAndDropsRollThem()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.Inventory.Items.Held = HellfeatherItems.Boots
        game.Inventory.Items.HeldMods.Rarity = HellfeatherRarity.Magic
        game.Inventory.Items.HeldMods.Add(HellfeatherModKind.MoveSpeed, 8)
        T.IsTrue(game.DropHeld(world))
        T.AreEqual(game.Inventory.Items.HeldMods.Count, 0)
        T.AreEqual(game.Ground.Entries[0].Mods.Rarity, HellfeatherRarity.Magic)
        T.IsTrue(game.TakeFromGround(world, 0))
        int boots = (int)game.Inventory.Items.Bag.Len - 1
        T.AreEqual(game.Inventory.Items.Bag[boots].Item, HellfeatherItems.Boots)
        T.AreEqual(game.Inventory.Items.Bag[boots].Mods.Values[0], 8)
        // Rolled drops: gear sometimes comes magic or rare, potions never do.
        int special = 0
        for i : 0; i < 300; i++ {
            gloves : game.Spawner.RollMods(HellfeatherItems.Gloves)
            if gloves.Rarity != HellfeatherRarity.Common { special++ }
            potion : game.Spawner.RollMods(HellfeatherItems.HealthPotion)
            T.AreEqual(potion.Rarity, HellfeatherRarity.Common)
        }
        T.IsTrue(special > 30 && special < 180)
    }

    TheRKeyOpensTheRunesBesideTheBag()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        QuaxelInputState input
        input.SetDown(QuaxelKey.R, true)
        game.Simulate(world, input, 2)
        T.IsTrue(game.Runes.Open)
        T.IsTrue(game.Inventory.Open)
        input.Clear()
        input.SetDown(QuaxelKey.P, true)
        game.Simulate(world, input, 2)
        T.IsFalse(game.Runes.Open)
        T.IsTrue(game.Passives.Open)
    }

    SocketingARuneTeachesItsSkillAndStackingStrengthensIt()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        QuaxelInputState input
        game.Runes.Board.Place(HellfeatherItems.RuneCleave, 4, 4)
        game.Simulate(world, input, 1)
        T.IsTrue(game.Actions.Slots.Known[HellfeatherAction.Cleave])
        T.AreEqual(game.Actions.Slots.Assigned[HellfeatherActionSlot.Right], HellfeatherAction.Cleave)
        int single = game.CleaveDamage()
        game.Runes.Board.Place(HellfeatherItems.RuneCleave, 4, 5)
        stats : game.Stats()
        T.AreEqual(game.CleaveDamage(), stats.CleaveDamage() * (100 + HellfeatherRuneBoard.PerRune) / 100)
        T.IsTrue(game.CleaveDamage() > single)
        game.Runes.Board.Lift(4, 4)
        game.Runes.Board.Lift(4, 5)
        game.Simulate(world, input, 1)
        T.IsFalse(game.Actions.Slots.Known[HellfeatherAction.Cleave])
    }

    WarCryRunesStretchTheCry()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        float base = game.WarCrySecondsTotal()
        game.Runes.Board.Place(HellfeatherItems.RuneWarCry, 4, 4)
        game.Runes.Board.Expand(3, 4, 1)
        game.Runes.Board.Expand(2, 4, 1)
        game.Runes.Board.Place(HellfeatherItems.RuneCleave, 2, 4)
        T.AreEqual(game.WarCrySecondsTotal(), base * (float)(100 + HellfeatherRuneBoard.PerKin) / 100.0)
    }

    ClicksOnTheOpenInventoryDoNotSwingButClicksBesideItDo()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int visual = game.Controllers[0].VisualNode
        QuaxelUi ui()
        ui.Content = game.BuildUi()
        game.ConfigureUi(ui)
        game.Inventory.Toggle()
        game.Inventory.Update(ui, 960, 540, 0, 0, false)
        ui.Layout(960, 540, 0, 0, false)
        QuaxelInputState input
        game.SampleAttack(700, 200, true)
        game.Simulate(world, input, 1)
        T.IsTrue(world.CurrentClipName(visual) != "attack")
        game.SampleAttack(700, 200, false)
        game.SampleAttack(300, 400, true)
        game.Simulate(world, input, 1)
        T.IsTrue(world.CurrentClipName(visual) == "attack")
    }

    RavenfordIsBuiltWholeAndLeavesTheSpawnClear()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        T.IsFalse(game.Terrain.CircleBlocked(0.0, 0.0, game.PlayerRadius()))
        int spawn = game.Terrain.SpawnSiteIndex
        int buildings = 0
        int fixtures = 0
        bool foundChurch = false
        for i : 0; i < game.Terrain.Placements.Len; i++ {
            if game.Terrain.Placements[i].Site != spawn { continue }
            if game.Terrain.Placements[i].Half == 0 { fixtures++ }
            if !game.Terrain.Placements[i].Prop {
                buildings++
                // The Rookery Tower stands on the church's corner.
                if game.Terrain.Placements[i].Volume == game.Landmarks.RookeryTower { foundChurch = true }
            }
        }
        T.IsTrue(foundChurch)
        T.AreEqual(buildings, 15)
        // Every wall run, the gatehouse, the four corners and the bridge rails.
        T.AreEqual(fixtures, 37)
    }

    RavenfordIsWalledExceptAtItsGate()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        for step : -22; step <= 22; step++ {
            float along = (float)step
            T.IsTrue(game.Terrain.IsBlocked(along, -Ravenford.Wall))
            T.IsTrue(game.Terrain.IsBlocked(-Ravenford.Wall, along))
            T.IsTrue(game.Terrain.IsBlocked(Ravenford.Wall, along))
            if Math.Abs(along) > Ravenford.GateHalf { T.IsTrue(game.Terrain.IsBlocked(along, Ravenford.Wall)) }
        }
    }

    TheRoadLeavesThroughTheGateAndOverTheBridge()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        for step : 0; step <= 76; step++ {
            float z = (float)step * 0.5
            T.IsFalse(game.Terrain.CircleBlocked(0.0, z, game.PlayerRadius()))
        }
        T.AreEqual(game.Terrain.ColumnKind(game.Terrain.ColumnAt(0.0), game.Terrain.ColumnAt(Ravenford.RiverZ)), QuaxelTerrainKind.Open)
        T.AreEqual(game.Terrain.ColumnKind(game.Terrain.ColumnAt(8.0), game.Terrain.ColumnAt(Ravenford.RiverZ)), QuaxelTerrainKind.Water)
    }

    RavenfordStandsOnLevelGround()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        for step : -9; step <= 9; step++ {
            float spot = (float)step
            T.AreEqual(game.Terrain.GroundY(spot * 0.5, spot * 0.5), 0.0)
        }
    }

    ARiverClearingCanBeCrossedOnItsBridge()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        for i : 0; i < game.Terrain.Layout.Sites.Len; i++ {
            if game.Terrain.Layout.Sites[i].Module != HellfeatherZone.FordRoad + 0 { continue }
            QuaxelTerrainSite site = game.Terrain.Layout.Sites[i]
            vec3 center = game.Terrain.WorldPoint(site.X, site.Z)
            int calls = 0
            while !game.Terrain.IsReady(center) && calls < 2000 {
                T.IsTrue(game.Terrain.Stream(world, center, 100000))
                calls++
            }
            T.IsTrue(game.Terrain.IsReady(center))
            // The center is on a reserved path, and water exists across the axis.
            T.AreEqual(game.Terrain.ColumnKind(game.Terrain.ColumnAt(center.X), game.Terrain.ColumnAt(center.Z)), QuaxelTerrainKind.Open)
            int water = 0
            for step : -80; step <= 80; step++ {
                vec3 point = game.Terrain.WorldPoint(site.X - site.AxisZ * (float)step * 0.125, site.Z + site.AxisX * (float)step * 0.125)
                if game.Terrain.ColumnKind(game.Terrain.ColumnAt(point.X), game.Terrain.ColumnAt(point.Z)) == QuaxelTerrainKind.Water { water++ }
            }
            T.IsTrue(water > 0)
            return
        }
        T.IsTrue(false)
    }

    WarriorStartsOnTheGround()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int mask = QuaxelComponents.Transform | QuaxelComponents.Voxels
        int visual = game.Controllers[0].VisualNode
        int axe = world.NextWith(visual, mask)
        T.IsTrue(axe != 0 && world.Has(axe, QuaxelComponents.SocketFollower))
        T.AreEqual(world.ParentOf(axe), visual)
        T.IsFalse(world.IsHidden(axe))
        T.AreEqual(world.ParentOf(visual), game.PlayerNode)
        T.AreEqual(world.MeshCount, 0)
        mat4 warriorModel = world.VolumeModel(visual)
        vec4 feet = warriorModel * vec4(0.5, -0.5, 0.5, 1.0)
        T.IsTrue(Math.Abs(feet.Y - game.Terrain.GroundY(0.0, 0.0)) < 0.001)
        T.AreEqual(world.ActiveCamera, game.CameraNode)
        T.AreEqual(game.Controllers[0].Node, game.PlayerNode)
        T.AreEqual(game.Controllers[0].Speed, game.PlayerSpeed())
    }

    EvilDuckStartsIdleOnTheGround()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        int visual = game.Enemies[0].VisualNode
        T.AreEqual(world.ParentOf(visual), game.Enemies[0].Node)
        T.IsTrue(world.CurrentClipName(visual) == "idle")
        vec4 feet = world.VolumeModel(visual) * vec4(0.5, -0.5, 0.5, 1.0)
        T.IsTrue(Math.Abs(feet.Y - game.Terrain.GroundY(3.0, -3.0)) < 0.001)
    }

    EvilDuckChasesThenPecksThenRests()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        int node = game.Enemies[0].Node
        int visual = game.Enemies[0].VisualNode
        QuaxelInputState input
        vec3 player = world.GetPosition(game.PlayerNode)
        float start = (world.GetPosition(node) - player).Length()
        game.Simulate(world, input, 2)
        T.IsTrue(world.CurrentClipName(visual) == "walk")
        game.Simulate(world, input, 58)
        float closer = (world.GetPosition(node) - player).Length()
        T.IsTrue(closer < start - 1.5)
        mat4 model = world.ModelMatrix(visual)
        vec3 front = Math.Normalize(vec3(model[2][0], model[2][1], model[2][2]))
        T.IsTrue(front.Dot(Math.Normalize(player - world.GetPosition(node))) > 0.99)
        // Reaches the warrior at about step 92. A peck lasts 0.58 seconds.
        game.Simulate(world, input, 36)
        T.IsTrue(world.CurrentClipName(visual) == "attack")
        game.Simulate(world, input, 40)
        T.IsTrue(world.CurrentClipName(visual) == "idle")
        T.IsTrue((world.GetPosition(node) - player).Length() > game.Enemies[0].Reach - 0.05)
        game.Simulate(world, input, 40)
        T.IsTrue(world.CurrentClipName(visual) == "attack")
    }

    EvilDuckStaysOnOpenGround()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        QuaxelInputState input
        input.SetDown(QuaxelKey.D, true)
        game.Simulate(world, input, 600)
        vec3 duck = world.GetPosition(game.Enemies[0].Node)
        T.IsFalse(game.Terrain.CircleBlocked(duck.X, duck.Z, game.Enemies[0].Radius))
        T.IsTrue(Math.Abs(duck.Y - game.Enemies[0].Radius - game.Terrain.GroundY(duck.X, duck.Z)) < 0.25)
    }

    ThreeAxeHitsSlayTheDuckAndItReturns()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        int node = game.Enemies[0].Node
        int visual = game.Enemies[0].VisualNode
        QuaxelTransform placed = world.GetTransform(node)
        placed.Position = vec3(1.0, game.Enemies[0].Radius, 0.0)
        world.SetTransform(node, placed)
        QuaxelInputState input
        for swing : 1; swing <= 3; swing++ {
            game.SampleAttack(480, 270, false)
            game.SampleAttack(480, 270, true)
            game.Simulate(world, input, 20)
            T.AreEqual(game.Enemies[0].Health, Math.Max(0, game.Enemies[0].MaxHealth - swing * game.AxeDamage()))
            game.Simulate(world, input, 12)
        }
        // The first swing lands while she turns to face the duck.
        mat4 model = world.ModelMatrix(game.Controllers[0].VisualNode)
        vec3 front = Math.Normalize(vec3(model[2][0], model[2][1], model[2][2]))
        T.IsTrue(front.X > 0.99)
        T.IsTrue(world.CurrentClipName(visual) == "death")
        vec3 corpse = world.GetPosition(node)
        game.Simulate(world, input, 60)
        vec3 stillThere = world.GetPosition(node)
        T.AreEqual(stillThere.X, corpse.X)
        game.Simulate(world, input, 110)
        T.AreEqual(game.Enemies[0].Health, game.Enemies[0].MaxHealth)
        T.IsTrue(world.CurrentClipName(visual) != "death")
    }

    AxeHitsDrawBlood()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        int node = game.Enemies[0].Node
        QuaxelTransform placed = world.GetTransform(node)
        placed.Position = vec3(1.0, game.Enemies[0].Radius, 0.0)
        world.SetTransform(node, placed)
        QuaxelInputState input
        game.Simulate(world, input, 2)
        int before = world.PlayingEffectCount()
        game.SampleAttack(480, 270, false)
        game.SampleAttack(480, 270, true)
        game.Simulate(world, input, 20)
        T.AreEqual(game.Enemies[0].Health, game.Enemies[0].MaxHealth - game.AxeDamage())
        T.IsTrue(world.PlayingEffectCount() > before)
    }

    BraziersBurnOnlyNearThePlayer()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        QuaxelInputState input
        game.Simulate(world, input, 2)
        int already = game.Fires.Burning()
        vec3 player = world.GetPosition(game.PlayerNode)
        int brazier = world.CreateNode()
        float cell = HellfeatherArt.FineVoxel
        world.AttachTransform(brazier, QuaxelTransform.Make(player + vec3(2.0, 0.75, 0.0), vec3(cell, cell, cell)))
        world.AttachVoxels(brazier, game.Terrain.Valley.Props.Brazier)
        game.Simulate(world, input, 20)
        T.AreEqual(game.Fires.Burning(), already + 1)
        world.SetTransform(brazier, QuaxelTransform.Make(player + vec3(60.0, 0.75, 0.0), vec3(cell, cell, cell)))
        game.Simulate(world, input, 20)
        T.AreEqual(game.Fires.Burning(), already)
    }

    AxeMissesADuckOutOfReach()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        QuaxelInputState input
        game.SampleAttack(480, 270, true)
        game.Simulate(world, input, 20)
        T.AreEqual(game.Enemies[0].Health, game.Enemies[0].MaxHealth)
    }

    PecksHurtTheWarrior()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        QuaxelInputState input
        game.Simulate(world, input, 88)
        T.AreEqual(game.PlayerHealth, game.PlayerMaxHealth())
        game.Simulate(world, input, 42)
        T.AreEqual(game.PlayerHealth, game.PlayerMaxHealth() - game.Enemies[0].Damage)
    }

    WarriorOutrunsAPeckWithoutDamage()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        int node = game.Enemies[0].Node
        QuaxelTransform placed = world.GetTransform(node)
        placed.Position = vec3(1.0, game.Enemies[0].Radius, 0.0)
        world.SetTransform(node, placed)
        QuaxelInputState input
        // She walks away from the duck during its wind-up.
        input.SetDown(QuaxelKey.A, true)
        game.Simulate(world, input, 30)
        T.AreEqual(game.PlayerHealth, game.PlayerMaxHealth())
    }

    FallenWarriorLiesStillThenEverythingResets()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        game.PlayerHealth = game.Enemies[0].Damage
        QuaxelInputState input
        game.Simulate(world, input, 130)
        T.AreEqual(game.PlayerHealth, 0)
        input.SetDown(QuaxelKey.W, true)
        vec3 held = game.Simulate(world, input, 30)
        T.AreEqual(held.X, 0.0)
        T.AreEqual(held.Z, 0.0)
        int visual = game.Controllers[0].VisualNode
        mat4 flat = world.ModelMatrix(visual)
        T.IsTrue(Math.Abs(flat[1][1]) < 0.0001)
        // Her back is at depth 26 of the 70 cells, and the unit cube is centered.
        vec4 back = world.VolumeModel(visual) * vec4(0.0, 0.0, 26.0 / 70.0 - 0.5, 1.0)
        T.IsTrue(Math.Abs(back.Y - game.Terrain.GroundY(0.0, 0.0)) < 0.001)
        input.Clear()
        game.Simulate(world, input, 170)
        T.AreEqual(game.PlayerHealth, game.PlayerMaxHealth())
        mat4 upright = world.ModelMatrix(visual)
        T.AreEqual(upright[1][1], HellfeatherWarrior.VoxelSize)
        T.AreEqual(game.Enemies[0].Health, game.Enemies[0].MaxHealth)
    }

    TheAxeHangsHeadDownWithTheBigBladeBack()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        // The axe is her first socket follower. Its volume is 29 x 59 x 7 cells:
        // the grip at cell (18, 21, 3), the head on the haft around (17, 52, 3)
        // and the tip of its big blade at (1, 52, 3).
        int axe = world.NextWith(0, QuaxelComponents.SocketFollower)
        mat4 model = world.VolumeModel(axe)
        vec4 grip = model * vec4(18.5 / 29.0 - 0.5, 21.5 / 59.0 - 0.5, 3.5 / 7.0 - 0.5, 1.0)
        vec4 head = model * vec4(17.5 / 29.0 - 0.5, 52.5 / 59.0 - 0.5, 3.5 / 7.0 - 0.5, 1.0)
        vec4 blade = model * vec4(1.5 / 29.0 - 0.5, 52.5 / 59.0 - 0.5, 3.5 / 7.0 - 0.5, 1.0)
        T.IsTrue(head.Y < grip.Y - 0.3)
        // She spawns facing (0.7071, 0.7071); the big blade points away from that.
        float back = (blade.X - head.X) * 0.70710678 + (blade.Z - head.Z) * 0.70710678
        T.IsTrue(back < -0.2)
    }

    WhatSheEquipsShowsOnHer()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int visual = game.Controllers[0].VisualNode
        // The nodes riding sockets: her weapon, shield and helmet.
        func int() followers = @ int()
        {
            int count = 0
            for id : world.NextWith(0, QuaxelComponents.SocketFollower); id != 0; id = world.NextWith(id, QuaxelComponents.SocketFollower) { count++ }
            return count
        }
        // The axe and the Miner's Helmet ride her sockets, the armor is her body.
        T.AreEqual(followers(), 2)
        QuaxelAnimator dressed = world.GetAnimator(visual)
        int armored = dressed.Animation
        QuaxelInputState input
        game.Inventory.Items.Equipped[HellfeatherSlot.Body] = HellfeatherItems.None
        game.Inventory.Items.Equipped[HellfeatherSlot.Head] = HellfeatherItems.None
        game.Inventory.Items.Equipped[HellfeatherSlot.OffHand] = HellfeatherItems.RoundShield
        game.Simulate(world, input, 1)
        QuaxelAnimator bare = world.GetAnimator(visual)
        T.IsTrue(bare.Animation != armored)
        T.IsTrue(world.CurrentClipName(visual) == "idle")
        T.AreEqual(followers(), 2)
        game.Inventory.Items.Equipped[HellfeatherSlot.MainHand] = HellfeatherItems.None
        game.Simulate(world, input, 1)
        T.AreEqual(followers(), 1)
        // Putting the armor back on finds the model already read.
        game.Inventory.Items.Equipped[HellfeatherSlot.Body] = HellfeatherItems.LeatherArmor
        game.Simulate(world, input, 1)
        QuaxelAnimator again = world.GetAnimator(visual)
        T.AreEqual(again.Animation, armored)
    }

    WalkingAndClickingDriveTheArmedWarrior()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int visual = game.Controllers[0].VisualNode
        int axe = world.NextWith(0, QuaxelComponents.SocketFollower)
        QuaxelInputState input
        input.SetDown(QuaxelKey.W, true)
        game.Simulate(world, input, 2)
        T.IsTrue(world.CurrentClipName(visual) == "walk")
        int first = world.VolumeOf(visual)
        game.Simulate(world, input, 5)
        T.IsTrue(world.VolumeOf(visual) != first)
        game.SampleAttack(480, 270, false)
        game.SampleAttack(480, 270, true)
        game.Simulate(world, input, 1)
        T.IsTrue(world.CurrentClipName(visual) == "attack")
        vec3 windup = world.GetPosition(axe)
        game.Simulate(world, input, 12)
        T.IsFalse(world.IsHidden(axe))
        T.IsTrue((world.GetPosition(axe) - windup).Length() > 1.0)
        game.Simulate(world, input, 30)
        game.SampleAttack(480, 270, true)
        game.Simulate(world, input, 1)
        T.IsTrue(world.CurrentClipName(visual) == "walk")
        input.Clear()
        game.Simulate(world, input, 1)
        T.IsTrue(world.CurrentClipName(visual) == "idle")
    }

    NoInputLeavesPlayerStill()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Prepare(world)
        QuaxelInputState input
        vec3 position = game.Simulate(world, input, 30)
        T.AreEqual(position.X, 0.0)
        T.IsTrue(Math.Abs(position.Y - game.PlayerRadius() - game.Terrain.GroundY(0.0, 0.0)) < 0.001)
        T.AreEqual(position.Z, 0.0)
    }

    OppositeKeysCancel()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Prepare(world)
        QuaxelInputState input
        input.SetDown(QuaxelKey.W, true)
        input.SetDown(QuaxelKey.S, true)
        input.SetDown(QuaxelKey.A, true)
        input.SetDown(QuaxelKey.D, true)
        vec3 position = game.Simulate(world, input, 30)
        T.AreEqual(position.X, 0.0)
        T.AreEqual(position.Z, 0.0)
    }

    KeysMoveInScreenDirections()
    {
        QuaxelKey [4] keys = {QuaxelKey.W, QuaxelKey.S, QuaxelKey.D, QuaxelKey.A}
        // Screen Y grows downward, so W must reduce it.
        float [4] screenX = {0.0, 0.0, 1.0, -1.0}
        float [4] screenY = {-1.0, 1.0, 0.0, 0.0}
        for i : 0; i < 4; i++ {
            HellfeatherGame game()
            QuaxelWorld world()
            game.Prepare(world)
            // The view from before the move, as the camera travels with the player.
            mat4 screen = game.ScreenMatrix(world)
            vec4 before = screen * vec4(world.GetPosition(game.PlayerNode), 1.0)
            QuaxelInputState input
            input.SetDown(keys[i], true)
            vec4 after = screen * vec4(game.Simulate(world, input, 20), 1.0)
            float movedX = after.X - before.X
            float movedY = after.Y - before.Y
            T.IsTrue(movedX * screenX[i] >= 0.0)
            T.IsTrue(movedY * screenY[i] >= 0.0)
            T.IsTrue(Math.Abs(movedX) + Math.Abs(movedY) > 0.01)
            if screenX[i] == 0.0 { T.IsTrue(Math.Abs(movedX) < 0.0001) }
            // Ground height shifts the screen vertically, by at most a few cells here.
            if screenY[i] == 0.0 { T.IsTrue(Math.Abs(movedY) < 0.06) }
        }
    }

    CameraFollowsPlayerAndKeepsItCentered()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Prepare(world)
        T.AreEqual(world.ParentOf(game.CameraNode), game.PlayerNode)
        QuaxelInputState input
        input.SetDown(QuaxelKey.W, true)
        input.SetDown(QuaxelKey.D, true)
        vec3 player = game.Simulate(world, input, 45)
        T.IsTrue(Math.Abs(player.X) + Math.Abs(player.Z) > 0.5)
        vec3 eye = world.WorldPosition(game.CameraNode)
        T.AreEqual(eye.X, player.X + 20.0)
        T.AreEqual(eye.Z, player.Z + 20.0)
        mat4 screen = game.ScreenMatrix(world)
        vec4 center = screen * vec4(player, 1.0)
        T.IsTrue(Math.Abs(center.X) < 0.0001)
        T.IsTrue(Math.Abs(center.Y) < 0.0001)
    }

    WarriorFacesTravelAndHoldsHeadingAtRest()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        QuaxelKey [4] keys = {QuaxelKey.W, QuaxelKey.A, QuaxelKey.S, QuaxelKey.D}
        for key : keys {
            QuaxelInputState input
            input.SetDown(key, true)
            vec3 before = world.GetPosition(game.PlayerNode)
            vec3 after = game.Simulate(world, input, 1)
            vec3 travel = Math.Normalize(vec3(after.X - before.X, 0.0, after.Z - before.Z))
            input.SetDown(key, false)
            game.Simulate(world, input, 1)
            mat4 model = world.ModelMatrix(game.Controllers[0].VisualNode)
            vec3 front = Math.Normalize(vec3(model[2][0], model[2][1], model[2][2]))
            T.IsTrue(front.Dot(travel) > 0.9999)
        }
    }
    DiagonalMatchesSingleKeySpeed()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Prepare(world)
        QuaxelInputState input
        input.SetDown(QuaxelKey.W, true)
        input.SetDown(QuaxelKey.D, true)
        vec3 position = game.Simulate(world, input, 30)
        float travelled = vec3(position.X, 0.0, position.Z).Length()
        T.IsTrue(Math.Abs(travelled - game.PlayerSpeed() * 0.5) < 0.001)
    }

    OneSecondCoversSpeedInWorldUnits()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Prepare(world)
        QuaxelInputState input
        input.SetDown(QuaxelKey.W, true)
        vec3 position = game.Simulate(world, input, 60)
        float travelled = vec3(position.X, 0.0, position.Z).Length()
        T.IsTrue(Math.Abs(travelled - game.PlayerSpeed()) < 0.001)
    }

    MountainsStopThePlayerOnWalkableGround()
    {
        QuaxelKey [4] keys = {QuaxelKey.W, QuaxelKey.S, QuaxelKey.D, QuaxelKey.A}
        for i : 0; i < 4; i++ {
            HellfeatherGame game()
            QuaxelWorld world()
            game.Prepare(world)
            QuaxelInputState input
            input.SetDown(keys[i], true)
            vec3 position = game.Simulate(world, input, 600)
            T.IsTrue(Math.Abs(position.X) + Math.Abs(position.Z) > 3.0)
            T.IsFalse(game.Terrain.CircleBlocked(position.X, position.Z, game.PlayerRadius()))
            T.IsTrue(Math.Abs(position.Y - game.PlayerRadius() - game.Terrain.GroundY(position.X, position.Z)) < 0.25)
        }
    }

    GroundAroundThePlayerIsInFrameAtAnyWindowShape()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Prepare(world)
        int [4] widths = {960, 500, 1800, 300}
        int [4] heights = {540, 900, 300, 300}
        float limit = game.ViewHalfExtent()
        vec3 start = world.GetPosition(game.PlayerNode)
        float ground = start.Y - game.PlayerRadius()
        for shape : 0; shape < 4; shape++ {
            QuaxelCamera camera = world.GetCamera(game.CameraNode)
            camera.UpdateBounds(widths[shape], heights[shape])
            mat4 matrix = camera.ViewProjection(world.WorldPosition(game.CameraNode))
            for corner : 0; corner < 8; corner++ {
                float x = (corner & 1) != 0 ? limit | -limit
                float z = (corner & 2) != 0 ? limit | -limit
                float y = ground + ((corner & 4) != 0 ? game.PlayerRadius() * 2.0 | 0.0)
                vec4 point = matrix * vec4(x, y, z, 1.0)
                T.IsTrue(Math.Abs(point.X) <= 1.0)
                T.IsTrue(Math.Abs(point.Y) <= 1.0)
                T.IsTrue(point.Z >= 0.0 && point.Z <= 1.0)
            }
        }
    }

    RightClickCleavesWithTheActionInTheRightSlot()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        game.Actions.Slots.Known[HellfeatherAction.Cleave] = true
        T.IsTrue(game.Actions.Slots.Assign(HellfeatherActionSlot.Right, HellfeatherAction.Cleave))
        QuaxelTransform placed = world.GetTransform(game.Enemies[0].Node)
        placed.Position = vec3(1.0, game.Enemies[0].Radius, 0.0)
        world.SetTransform(game.Enemies[0].Node, placed)
        QuaxelInputState input
        game.SampleRightClick(480, 270, true)
        game.Simulate(world, input, 20)
        T.AreEqual(game.Enemies[0].Health, game.Enemies[0].MaxHealth - game.CleaveDamage())
        T.AreEqual(game.PlayerMana, game.PlayerMaxMana() - 8)
    }

    AnEmptySlotDoesNothing()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int visual = game.Controllers[0].VisualNode
        QuaxelInputState input
        game.SampleRightClick(480, 270, true)
        game.Simulate(world, input, 2)
        T.IsTrue(world.CurrentClipName(visual) != "attack")
    }

    TheQKeyDrinksOneHealthPotionPerPress()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.Inventory.Items.Add(HellfeatherItems.HealthPotion)
        game.Inventory.Items.Add(HellfeatherItems.HealthPotion)
        game.PlayerHealth = 20
        QuaxelInputState input
        input.SetDown(QuaxelKey.Q, true)
        game.Simulate(world, input, 1)
        T.AreEqual(game.PlayerHealth, 20 + game.HealthPotionHeal())
        game.Simulate(world, input, 90)
        T.AreEqual(game.PlayerHealth, 20 + game.HealthPotionHeal())
        T.AreEqual(game.Inventory.Items.CountOf(HellfeatherItems.HealthPotion), 1)
        input.SetDown(QuaxelKey.Q, false)
        game.Simulate(world, input, 1)
        input.SetDown(QuaxelKey.Q, true)
        game.Simulate(world, input, 1)
        T.AreEqual(game.PlayerHealth, game.PlayerMaxHealth())
        T.AreEqual(game.Inventory.Items.CountOf(HellfeatherItems.HealthPotion), 0)
    }

    ManaComesBackOverTime()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.PlayerMana = 10
        QuaxelInputState input
        game.Simulate(world, input, 60)
        T.AreEqual(game.PlayerMana, 10 + (int)game.ManaPerSecond())
    }

    AWarCryDoublesTheNextSwing()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        game.Actions.Slots.Known[HellfeatherAction.WarCry] = true
        T.IsTrue(game.Actions.Slots.Assign(HellfeatherActionSlot.F, HellfeatherAction.WarCry))
        QuaxelTransform placed = world.GetTransform(game.Enemies[0].Node)
        placed.Position = vec3(1.0, game.Enemies[0].Radius, 0.0)
        world.SetTransform(game.Enemies[0].Node, placed)
        QuaxelInputState input
        input.SetDown(QuaxelKey.F, true)
        game.Simulate(world, input, 1)
        T.AreEqual(game.PlayerMana, game.PlayerMaxMana() - 15)
        T.IsTrue(world.CurrentClipName(game.Enemies[0].VisualNode) == "hit")
        input.Clear()
        game.SampleAttack(480, 270, true)
        game.Simulate(world, input, 20)
        T.AreEqual(game.Enemies[0].Health, game.Enemies[0].MaxHealth - game.AxeDamage() * 2)
    }

    ADashLeapsAheadAndCoolsDown()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.Actions.Slots.Known[HellfeatherAction.Dash] = true
        T.IsTrue(game.Actions.Slots.Assign(HellfeatherActionSlot.F, HellfeatherAction.Dash))
        vec3 start = world.GetPosition(game.PlayerNode)
        QuaxelInputState input
        input.SetDown(QuaxelKey.F, true)
        vec3 after = game.Simulate(world, input, 15)
        float travelled = vec3(after.X - start.X, 0.0, after.Z - start.Z).Length()
        T.IsTrue(Math.Abs(travelled - game.DashSpeed() * game.DashSecondsTotal()) < 0.05)
        // She starts facing the camera, so the dash goes that way.
        T.IsTrue(after.X > start.X && after.Z > start.Z)
        T.IsTrue(game.Actions.Slots.Cooldowns[HellfeatherAction.Dash] > 0.0)
    }

    SlayingADuckCountsTowardAgilities()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        game.Enemies[0].Health = 1
        QuaxelTransform placed = world.GetTransform(game.Enemies[0].Node)
        placed.Position = vec3(1.0, game.Enemies[0].Radius, 0.0)
        world.SetTransform(game.Enemies[0].Node, placed)
        QuaxelInputState input
        game.SampleAttack(480, 270, true)
        game.Simulate(world, input, 20)
        T.AreEqual(game.Actions.Slots.Kills, 1)
    }

    ClicksOnTheActionBarDoNotSwing()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int visual = game.Controllers[0].VisualNode
        QuaxelUi ui()
        ui.Content = game.BuildUi()
        game.ConfigureUi(ui)
        game.Actions.Update(ui, 960, 540, 0, 0, false, 960, false, game.Means())
        int x = (game.Actions.BarLeft + 30) * 2
        int y = (game.Actions.BarTop + 20) * 2
        QuaxelInputState input
        game.SampleAttack(x, y, true)
        game.Simulate(world, input, 1)
        T.IsTrue(world.CurrentClipName(visual) != "attack")
    }
}
