// Featherfall: every few minutes in the wild, black feathers rain down for a
// short while. It is heralded: a flock of ravens flies low over her first,
// shedding the first few feathers as they pass, and the fall starts once they
// have gone. Birds of the Moult grow frenzied
// as long as it lasts, and slain ones drop more feathers for Edda. With Edda's
// Quill Charm on, the falling feathers heal instead. Mardra's Moult is the same
// storm, gathered around her.
HellfeatherFeatherfall
{
    bool Active
    // True while the heralding ravens cross, before the feathers fall.
    bool Heralding
    // Seconds until the next one starts, until the feathers fall, or until
    // this one ends.
    float Timer = 150.0
    // Where feathers start falling this step, in world units. The game lets
    // them fall (FallingFeathers.dk) and clears the list.
    vec3 [] Drops
    -float PourCarry
    -bool Seeded
    -float HealCarry
    // The heralds in the air: a node each and the line it flies along, in
    // world units.
    -int [] Heralds
    -vec3 [] HeraldFrom
    -vec3 [] HeraldTo
    -float HeraldTime
    -bool HeraldsShed
    -int RavenAnimation = -1
    -QuaxelRandom Random

    // Runs the clock. Wild is false in Ravenford and below ground, where no
    // feathers fall and a fall under way stops. Returns health to give back.
    int Step(QuaxelWorld& world, vec3 player, bool wild, bool charm, float deltaSeconds)
    {
        if !wild {
            if Active || Heralding { Stop(world) }
            return 0
        }
        Timer -= deltaSeconds
        if Heralding {
            HeraldTime += deltaSeconds
            FlyHeralds(world)
            // Past halfway each raven drops a few feathers behind it.
            if !HeraldsShed && HeraldTime > HeraldSeconds * 0.45 {
                HeraldsShed = true
                for node : Heralds { Shed(world.GetPosition(node)) }
            }
            if Timer > 0.0 { return 0 }
            ClearHeralds(world)
            Heralding = false
            Active = true
            Timer = Seconds
            PourCarry = 0.0
            return 0
        }
        if !Active {
            if Timer <= 0.0 {
                Heralding = true
                Timer = HeraldSeconds
                SendHeralds(world, player)
            }
            return 0
        }
        if Timer <= 0.0 {
            Stop(world)
            return 0
        }
        // Feathers start over her as she goes, so the storm follows her, and
        // none in the last seconds so it thins out as it ends.
        if Timer > TailSeconds { Pour(player, deltaSeconds) }
        if !charm { return 0 }
        HealCarry += deltaSeconds * HealPerSecond
        int heal = (int)HealCarry
        HealCarry -= (float)heal
        return heal
    }

    Stop(QuaxelWorld& world)
    {
        Active = false
        Heralding = false
        Timer = Between
        Drops.Clear()
        ClearHeralds(world)
    }

    -Seed()
    {
        if Seeded { return }
        Random.Begin((uint)0x0FEA7FA1)
        Seeded = true
    }

    // Starting points over a wide disc above her, at PourRate a second.
    -Pour(vec3 player, float deltaSeconds)
    {
        Seed()
        PourCarry += PourRate * deltaSeconds
        while PourCarry >= 1.0 {
            PourCarry -= 1.0
            float angle = Random.Range(0.0, 6.2831853)
            float distance = PourRadius * Math.Sqrt(Random.Unit())
            Drops += player + vec3(Math.Cos(angle) * distance, PourHeight + Random.Range(0.0, 1.5), Math.Sin(angle) * distance)
        }
    }

    // A few feathers dropped behind a passing raven.
    -Shed(vec3 raven)
    {
        Seed()
        for n : 0; n < 3; n++ { Drops += raven + vec3(Random.Range(-0.5, 0.5), -0.3 * (float)n, Random.Range(-0.5, 0.5)) }
    }

    // How many heralds are in the air.
    int HeraldCount() { return (int)Heralds.Len }

    // A flock of ravens in a loose wedge, crossing low over her from one side
    // of the screen to the other. Without the raven model the fall is heralded by the pause alone.
    -SendHeralds(QuaxelWorld& world, vec3 player)
    {
        ClearHeralds(world)
        HeraldTime = 0.0
        HeraldsShed = false
        Seed()
        if RavenAnimation < 0 {
            RavenAnimation = QuaxelAssets.LoadVoxelAnimation(world, "Assets/Raven.qvox")
            if RavenAnimation < 0 { return }
        }
        float heading = Random.Range(0.0, 6.2831853)
        vec3 along = vec3(Math.Cos(heading), 0.0, Math.Sin(heading))
        vec3 side = vec3(-along.Z, 0.0, along.X)
        float half = HeraldSpeed * HeraldSeconds * 0.5
        int count = 5 + Random.Below(4)
        for n : 0; n < count; n++ {
            // A wedge: the leader in front, the rest to either side and behind.
            float wing = (float)((n + 1) / 2) * (n % 2 == 0 ? 1.0 | -1.0)
            float offset = wing * Random.Range(0.9, 1.4) + Random.Range(-0.3, 0.3)
            float behind = Math.Abs(wing) * Random.Range(0.9, 1.3)
            float height = HeraldHeight + Random.Range(-0.8, 0.8)
            vec3 from = player + side * offset - along * (half + behind) + vec3(0.0, height, 0.0)
            vec3 to = from + along * (half * 2.0 + 2.0)
            int node = world.CreateNode()
            world.AttachTransform(node, QuaxelTransform.Make(from, vec3(1.0, 1.0, 1.0)))
            world.SetCatchesEffects(node, false)
            int visual = world.CreateChild(node)
            float cell = HellfeatherRavens.Voxel
            QuaxelTransform pose = QuaxelTransform.Make(vec3(0.0, (float)HellfeatherRavens.Height * cell * 0.5, 0.0), vec3(cell, cell, cell))
            pose.FacingX = along.X
            pose.FacingZ = along.Z
            world.AttachTransform(visual, pose)
            if !world.AttachAnimator(visual, RavenAnimation) || !world.PlayClip(visual, "fly") {
                world.DestroyNode(node)
                continue
            }
            Heralds += node
            HeraldFrom += from
            HeraldTo += to
        }
    }

    // Moves each herald along its line by the time since they set out.
    -FlyHeralds(QuaxelWorld& world)
    {
        float share = Math.Clamp(HeraldTime / HeraldSeconds, 0.0, 1.0)
        for i : 0; i < Heralds.Len; i++ {
            QuaxelTransform transform = world.GetTransform(Heralds[i])
            transform.Position = HeraldFrom[i].Lerp(HeraldTo[i], share)
            world.SetTransform(Heralds[i], transform)
        }
    }

    -ClearHeralds(QuaxelWorld& world)
    {
        for node : Heralds { world.DestroyNode(node) }
        Heralds.Clear()
        HeraldFrom.Clear()
        HeraldTo.Clear()
    }
}
#{
    // Seconds: the ravens' crossing, the fall itself and the wait between falls.
    // The fall's last seconds start no new bursts, so it thins out.
    #float HeraldSeconds = 6.0
    #float Seconds = 10.0
    #float TailSeconds = 3.0
    #float Between = 210.0
    // How fast and how high above her the heralds fly, in world units.
    #float HeraldSpeed = 5.0
    #float HeraldHeight = 3.5
    // Speed and pace of a frenzied bird, against its usual.
    #float Frenzy = 1.35
    // The share of common birds of the Moult that drop any feathers when slain.
    #float DropChance = 0.3
    #float HealPerSecond = 2.0

    // Feathers a second over the storm, across a disc this wide around her,
    // starting this high above her.
    #float PourRate = 10.0
    #float PourRadius = 7.0
    #float PourHeight = 5.5
}

// Goodwife Mardra Hobb, Brood-Mother of the Millpond, at the bottom of the
// Undercroft. She stalks and buffets, and every few seconds either channels
// her ring to drag the warrior in, or calls ducklings that grow into drakes if
// left alive. Below half health she moults: feathers storm the hall and she
// quickens. Striking her while the ring channels staggers her.
HellfeatherGame : QuaxelGameInstance
{
    -float MardraEffectTimer

    -StepMardra(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        int visual = Enemies[i].VisualNode
        float pace = Enemies[i].Health * 2 < Enemies[i].MaxHealth ? 1.3 | 1.0
        if Enemies[i].Health * 2 < Enemies[i].MaxHealth {
            if !Quests.MardraMoulted {
                Quests.MardraMoulted = true
                Banner.Show("The Moult", 3.0)
            }
            MardraEffectTimer -= deltaSeconds
            if MardraEffectTimer <= 0.0 {
                ShedFeathers(world, world.GetPosition(Enemies[i].Node), 5.0, 4.0, 3)
                MardraEffectTimer = 0.25
            }
        }
        int phase = Enemies[i].Phase
        if phase == 1 {
            // Ring Pull, channelled. A hit now staggers her; see StrikeEnemies.
            FaceAlong(world, visual, direction)
            if Enemies[i].PhaseTime < 1.6 { return }
            Knock(world, world.GetPosition(Enemies[i].Node), -Math.Max(0.0, Math.Min(4.0, distance - Enemies[i].Reach * 0.8)))
            NextPhase(i, 0)
            WindUp(world, i, 0.35)
            return
        }
        if phase == 2 {
            // Brood Call.
            if Enemies[i].PhaseTime < 1.0 { return }
            vec3 at = world.GetPosition(Enemies[i].Node)
            for n : 0; n < 3; n++ {
                float angle = (float)n * 2.094 + Enemies[i].PhaseTime
                int duckling = AddScripted(world, "Duckling", at.X + Math.Cos(angle) * 2.5, at.Z + Math.Sin(angle) * 2.5)
                if duckling >= 0 { Enemies[duckling].GrowTimer = 12.0 }
            }
            NextPhase(i, 0)
            return
        }
        Enemies[i].Strikes++
        if Enemies[i].PhaseTime > 7.0 / pace && !Attacking(world, i) {
            // Alternates between the ring and the brood.
            bool ring = (Enemies[i].Aim.X == 0.0)
            Enemies[i].Aim = ring ? vec3(1.0, 0.0, 0.0) | vec3(0.0, 0.0, 0.0)
            if ring {
                NextPhase(i, 1)
                WindUp(world, i, 1.6)
                world.StartEffect(QuaxelEffectStyle.Sparks(), world.GetPosition(Enemies[i].Node) + vec3(0.0, 1.0, 0.0), vec3(0.0, 1.0, 0.0))
                Banner.Show("Mardra pulls at the ring", 1.5)
            } else {
                NextPhase(i, 2)
                world.PlayClip(visual, "idle")
                Banner.Show("Mardra calls her brood", 1.5)
            }
            return
        }
        if Attacking(world, i) {
            if StrikeNow(world, i) { Land(world, i, Enemies[i].Reach, Enemies[i].Damage, 1.0) }
            return
        }
        FaceAlong(world, visual, direction)
        if distance > Enemies[i].Reach {
            Stride(world, i, direction, Enemies[i].Speed * pace, deltaSeconds)
            world.PlayClip(visual, "walk")
        } else if Enemies[i].Cooldown > 0.0 {
            world.PlayClip(visual, "idle")
        } else {
            WindUp(world, i, 0.55)
            Enemies[i].Cooldown = 1.4
        }
    }

    // A duckling of the brood left alive too long becomes a Brood Drake.
    -GrowDuckling(QuaxelWorld& world, int i)
    {
        if Enemies[i].Health <= 0 || !Enemies[i].Awake { return }
        vec3 at = world.GetPosition(Enemies[i].Node)
        Enemies[i].Health = 0
        Enemies[i].LootDropped = true
        world.DestroyNode(Enemies[i].Node)
        Enemies[i].Awake = false
        Enemies[i].Node = 0
        Enemies[i].VisualNode = 0
        AddScripted(world, "BroodDrake", at.X, at.Z)
    }

    // Adds one enemy of a kind at a world point, outside the rolled groups, and
    // wakes it at once. Returns its index, or -1.
    int AddScripted(QuaxelWorld& world, string kindName, float x, float z)
    {
        int kind = Spawner.Table.KindNamed(kindName)
        if kind < 0 { return -1 }
        EnemyEncounter encounter
        encounter.Center = vec3(x, 0.0, z)
        encounter.First = (int)Enemies.Len
        encounter.Count = 1
        encounter.Group = -1
        Enemies += MakeEnemy(kind, x, z)
        int index = (int)Enemies.Len - 1
        Spawner.Encounters += encounter
        int encounterIndex = (int)Spawner.Encounters.Len - 1
        if GroundReady(encounterIndex) && WakeEncounter(world, encounterIndex) { Spawner.Encounters[encounterIndex].Awake = true }
        return index
    }

    // Whether every enemy added by AddScripted from index on is dead or gone.
    bool AllFallenFrom(int first)
    {
        for i : first; i < Enemies.Len; i++ {
            if Enemies[i].Health > 0 { return false }
        }
        return true
    }
}
