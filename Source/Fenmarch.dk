// Act I's zones, laid out from Ravenford outward as the story walks them: the
// Ford Road just past the gate, the reed marsh of Fennick Water beyond it, the
// pilgrim path up Orra's Hill, and Hobb's Mill farthest out. Each zone is a
// terrain module, and its value is the module's ID in HellfeatherTerrain's
// router. Unclaimed clearings are plain Fenmarch lowland.
//
// The router hands clearings to the lowest ID first, so the zones there must be
// exactly once come first. Any is for data that fits every zone.
HellfeatherZone : int
#@{
    Any: -1,
    Fenmarch,
    HobbsMill,
    OrrasHill,
    FordRoad,
    FennickWater,
    Croft,
    Ravenford,
    // The two levels of the Millrace Undercroft, and the landing of each.
    Undercroft,
    UndercroftDeep,
    UndercroftLanding,
    // The room of a building's interior.
    Interior
}

// Reed marsh and duck ponds. Ponds and the mud around them follow one noise
// field, so Place can find the pond edges that Column painted.
FennickWater : QuaxelTerrainModule
{
    HellfeatherProps Props

    QuaxelTerrainModuleRules Rules()
    {
        QuaxelTerrainModuleRules rules
        rules.MinRadius = 13.0
        rules.MinDepth = 2
        rules.MaxDepth = 9
        rules.Share = 0.3
        return rules
    }

    -float Wetness(QuaxelTerrainSite site, float x, float z)
    {
        return QuaxelNoise.Fbm(site.Seed, x / 6.0, z / 6.0, 2)
    }

    Column(QuaxelTerrainSite site, float x, float z, QuaxelTerrainColumn& column)
    {
        if Math.Hypot(x, z) >= site.Radius + 2.0 { return }
        float wet = Wetness(site, x, z)
        if wet > FennickWater.Pond { column.MakeWater(3) }
        else if wet > FennickWater.Mud { column.Surface = HellfeatherSurface.Mud }
    }

    // Reeds along the pond edges, then a few dead trees and stones on dry ground.
    Place(QuaxelTerrainSite site, QuaxelTerrainPlacer& placer)
    {
        QuaxelRandom random
        random.Begin(site.Seed ^ (uint)0x6E1D4C2B)
        int group = 100
        int reeds = 0
        for attempt : 0; attempt < 160 && reeds < 22; attempt++ {
            float angle = random.Range(0.0, 6.2831853)
            float distance = random.Range(3.0, site.Radius - 1.0)
            float x = Math.Cos(angle) * distance
            float z = Math.Sin(angle) * distance
            float wet = Wetness(site, x, z)
            if wet <= FennickWater.Mud - 0.03 || wet > FennickWater.Pond { continue }
            placer.OfferProp(group, Props.Reeds[reeds % 2], x, z, 3, FenmarchArt.ReedsHeight / 2, HellfeatherArt.FineVoxel)
            group++
            reeds++
        }
        for n : 0; n < 8; n++ {
            float angle = random.Range(0.0, 6.2831853)
            float distance = random.Range(6.0, site.Radius - 1.5)
            float x = Math.Cos(angle) * distance
            float z = Math.Sin(angle) * distance
            if Wetness(site, x, z) > FennickWater.Mud { continue }
            if n < 4 { placer.OfferProp(group, Props.Trees[n % 3], x, z, 5, 40, HellfeatherArt.FineVoxel) }
            else { placer.OfferProp(group, Props.Rocks[n % 3], x, z, 7, 10, HellfeatherArt.FineVoxel) }
            group++
        }
    }
}
#{
    // Wetness above which the ground is pond, and above which it is mud.
    #float Pond = 0.6
    #float Mud = 0.53
}

// The pilgrim path up to Saint Orra's Hospice. Feather-hung shrines and the odd
// gibbet line every road through the clearing, and the hospice stands off to
// one side. Half and height are in columns, and fit Assets/OrrasHospice.qvox.
OrrasHill : QuaxelTerrainModule
{
    HellfeatherProps Props
    int Hospice
    int HospiceHalf = 34
    int HospiceHeight = 50
    // How tall it counts when working out what it hides. Its strip of hidden
    // ground behind it must fit in the clearing too.
    int HospiceSight = 30

    QuaxelTerrainModuleRules Rules()
    {
        QuaxelTerrainModuleRules rules
        rules.MinRadius = 17.0
        rules.Isolated = true
        rules.Share = 0.01
        rules.MaxCount = 1
        rules.MinDepth = 3
        rules.MaxDepth = 6
        return rules
    }

    Place(QuaxelTerrainSite site, QuaxelTerrainPlacer& placer)
    {
        HellfeatherRoads.OfferBetween(placer, 0, site, Hospice, HospiceHalf, HospiceHeight, HospiceSight, HellfeatherArt.FineVoxel)
        // Shrines in pairs along each road, just off the reserved path.
        int group = 1
        for port : 0; port < site.PortCount; port++ {
            float alongX = site.PortX[port]
            float alongZ = site.PortZ[port]
            for step : 1; step <= 3; step++ {
                float along = (float)step * 4.0
                for side : 0; side < 2; side++ {
                    float off = side == 0 ? -OrrasHill.ShrineOffset | OrrasHill.ShrineOffset
                    float x = alongX * along - alongZ * off
                    float z = alongZ * along + alongX * off
                    // Every third post is a gibbet, where the Gallows Rooks perch.
                    int post = step == 2 && side == 1 ? Props.Gibbet | Props.Shrine
                    placer.OfferProp(group, post, x, z, 2, FenmarchArt.ShrineHeight / 2, HellfeatherArt.FineVoxel)
                    group++
                }
            }
        }
        HellfeatherScatter.Place(Props, site, placer)
    }
}
#{
    // World units from a road's centerline to its shrines.
    #float ShrineOffset = 3.4
}

// The watermill on the Fen River, farthest from Ravenford. Its undershot wheel
// is on the model's +X side, so the river follows the mill: once the mill is
// placed, the river runs along Z just past its +X wall, straight beside the
// wheel and wandering away from it, across the whole clearing, and widens into
// the millpond upstream of the mill, toward -Z. Water blocks walking, and the
// generator turns the water on every road into a bridge. Half and height are
// in columns; the mill's voxels are a sixteenth.
HobbsMill : QuaxelTerrainModule
{
    HellfeatherProps Props
    int Mill
    // The model is 32 by 35 columns, so 18 holds it with a little to spare.
    // The square is levelled for it, water and all.
    int MillHalf = 18
    int MillHeight = 48
    float MillVoxel = 0.0625
    // Low enough that the generator blocks no strip of hidden ground behind the
    // mill (that strip is Sight - Lip + 2 columns deep): it blocks only the
    // ground its own voxels cover.
    int MillSight = 4
    // The clearing the river was laid out for and the mill's anchor there, as
    // a layout-space offset from the clearing's center. The Inv fields undo
    // the warp around the mill, taking layout offsets from the anchor to world
    // ones, so the river runs straight along world Z past the wheel. RiverSite
    // is -1 until the mill is placed; with no mill the river runs WheelSide
    // past the clearing's center.
    int RiverSite = -1
    float RiverX
    float RiverZ
    float InvXX = 1.0
    float InvXZ
    float InvZX
    float InvZZ = 1.0

    QuaxelTerrainModuleRules Rules()
    {
        QuaxelTerrainModuleRules rules
        rules.MinRadius = 17.0
        rules.Isolated = true
        rules.Share = 0.01
        rules.MaxCount = 1
        rules.MinDepth = 5
        return rules
    }

    // A layout-space offset from the clearing's center as world units from the
    // river's anchor, WheelSide to the mill's +X: X across the river, Y along it.
    -vec2 FromRiver(QuaxelTerrainSite site, float x, float z)
    {
        if RiverSite != site.Index { return vec2(x - HobbsMill.WheelSide, z) }
        float dx = x - RiverX
        float dz = z - RiverZ
        return vec2(InvXX * dx + InvXZ * dz - HobbsMill.WheelSide, InvZX * dx + InvZZ * dz)
    }

    // The river's centerline at a distance along it, as an offset across:
    // straight past the mill, bending away from its front, where its door is,
    // and meandering more the farther it gets.
    -float Meander(QuaxelTerrainSite site, float along)
    {
        float calm = Math.Clamp((Math.Abs(along) - HobbsMill.Straight) / 4.0, 0.0, 1.0)
        float t = Math.Clamp((along - HobbsMill.BendFrom) / 2.3, 0.0, 1.0)
        float bend = t * t * (3.0 - 2.0 * t) * HobbsMill.Bend
        return bend + QuaxelNoise.SignedFbm(site.Seed, along / 9.0, 0.0, 2) * 2.4 * calm
    }

    // True where the river or the millpond lies, at a layout-space offset from
    // the clearing's center. Margin widens both, to keep props clear.
    bool IsWater(QuaxelTerrainSite site, float x, float z, float margin)
    {
        vec2 local = FromRiver(site, x, z)
        if Math.Abs(local.X - Meander(site, local.Y)) < HobbsMill.RiverHalf + margin { return true }
        return PondReach(site, local) < HobbsMill.PondRadius + margin
    }

    // Distance from the pond's middle, upstream of the mill and a little out
    // from its wall; under PondRadius is pond.
    -float PondReach(QuaxelTerrainSite site, vec2 local)
    {
        float wobble = QuaxelNoise.SignedFbm(site.Seed + (uint)3, local.X / 4.0, local.Y / 4.0, 2) * 0.8
        return Math.Hypot(local.X - HobbsMill.PondAcross, local.Y - HobbsMill.PondAlong) + wobble
    }

    Column(QuaxelTerrainSite site, float x, float z, QuaxelTerrainColumn& column)
    {
        if Math.Hypot(x, z) >= site.Radius + 3.0 { return }
        if PondReach(site, FromRiver(site, x, z)) < HobbsMill.PondRadius {
            column.MakeWater(HobbsMill.PondDepth)
            column.Surface = HellfeatherSurface.Millpond
            return
        }
        if IsWater(site, x, z, 0.0) { column.MakeWater(HobbsMill.RiverDepth) }
    }

    // How far a point in the clearing is from the nearest road, which runs
    // from the clearing's center out through each port.
    -float RoadClearance(QuaxelTerrainSite site, float x, float z)
    {
        float nearest = 1000.0
        for port : 0; port < site.PortCount; port++ {
            float t = Math.Max(0.0, x * site.PortX[port] + z * site.PortZ[port])
            nearest = Math.Min(nearest, Math.Hypot(x - site.PortX[port] * t, z - site.PortZ[port] * t))
        }
        return nearest
    }

    // True if a mill here keeps its square off the roads and neither its
    // wheel's stretch of river nor the pond is on one, so they never bridge.
    -bool FitsBesideRiver(QuaxelTerrainSite site, float x, float z)
    {
        float body = (float)MillHalf * QuaxelTerrain.Cell * 1.42 + 3.2
        if RoadClearance(site, x, z) < body { return false }
        float river = x + HobbsMill.WheelSide
        float wheel = HobbsMill.RiverHalf + 2.6
        for step : -2; step <= 2; step++ {
            if RoadClearance(site, river, z + (float)step * 1.2) < wheel { return false }
        }
        float pond = HobbsMill.PondRadius + 2.6
        if RoadClearance(site, river + HobbsMill.PondAcross, z + HobbsMill.PondAlong) < pond { return false }
        return true
    }

    // How many half-unit steps of the river a mill here would send across a
    // road, where they become bridge. A road the river crosses costs a few; one
    // it runs beside costs many.
    -int BridgedSteps(QuaxelTerrainSite site, float x, float z)
    {
        float river = x + HobbsMill.WheelSide
        float limit = HobbsMill.RiverHalf + HobbsMill.Reserved
        int steps = 0
        for step : -40; step <= 40; step++ {
            float along = (float)step * 0.5
            if Math.Abs(along) > site.Radius + 3.0 { continue }
            float meander = Meander(site, along - z)
            if Math.Hypot(river + meander, along) >= site.Radius + 3.0 { continue }
            if RoadClearance(site, river + meander, along) < limit { steps++ }
        }
        return steps
    }

    Place(QuaxelTerrainSite site, QuaxelTerrainPlacer& placer)
    {
        // The mill where its square, its wheel's water and the millpond keep
        // off the roads, and its river crosses them least, nearest the middle
        // first; failing that anywhere the generator takes it.
        float reach = (float)MillHalf * QuaxelTerrain.Cell * 1.45
        float far = site.Radius - reach - 0.5
        float [] fitX
        float [] fitZ
        int [] fitCost
        float [] restX
        float [] restZ
        for ring : 0; ring < 12; ring++ {
            float distance = (float)ring * 1.5
            if distance > far { continue }
            int steps = ring == 0 ? 1 | 24
            for step : 0; step < steps; step++ {
                float angle = ((float)step + (float)(ring & 1) * 0.5) * 6.2831853 / (float)steps
                float x = Math.Cos(angle) * distance
                float z = Math.Sin(angle) * distance
                // The pond, upstream, must stay inside the clearing.
                if Math.Hypot(x + HobbsMill.WheelSide + HobbsMill.PondAcross, z + HobbsMill.PondAlong) + HobbsMill.PondRadius > site.Radius { continue }
                if FitsBesideRiver(site, x, z) {
                    fitX += x
                    fitZ += z
                    // A road crossed squarely, about 12 steps, is better than none,
                    // which leaves the far bank without a bridge; a long run beside
                    // a road is worse than either.
                    int bridged = BridgedSteps(site, x, z)
                    fitCost += bridged == 0 ? 16 | bridged
                } else {
                    restX += x
                    restZ += z
                }
            }
        }
        // Cheapest first; among equals, the order found.
        for i : 1; i < fitCost.Len; i++ {
            for j : i; j > 0 && fitCost[j] < fitCost[j - 1]; j-- {
                int cost = fitCost[j]
                fitCost[j] = fitCost[j - 1]
                fitCost[j - 1] = cost
                float swapX = fitX[j]
                fitX[j] = fitX[j - 1]
                fitX[j - 1] = swapX
                float swapZ = fitZ[j]
                fitZ[j] = fitZ[j - 1]
                fitZ[j - 1] = swapZ
            }
        }
        for i : 0; i < fitX.Len; i++ { placer.OfferBuilding(0, Mill, fitX[i], fitZ[i], MillHalf, MillHeight, MillSight, MillVoxel) }
        for i : 0; i < restX.Len; i++ { placer.OfferBuilding(0, Mill, restX[i], restZ[i], MillHalf, MillHeight, MillSight, MillVoxel) }
        HellfeatherRoads.OfferBetween(placer, 0, site, Mill, MillHalf, MillHeight, MillSight, MillVoxel)
        // Reeds, trees and rocks. Those that land in the water are dropped once
        // the mill is placed and the river known (HellfeatherTerrain.Configure).
        QuaxelRandom random
        random.Begin(site.Seed ^ (uint)0x3B11D0A5)
        int group = 100
        for n : 0; n < 14; n++ {
            float angle = random.Range(0.0, 6.2831853)
            float distance = random.Range(5.0, site.Radius - 1.5)
            float x = Math.Cos(angle) * distance
            float z = Math.Sin(angle) * distance
            if n < 6 { placer.OfferProp(group, Props.Reeds[n % 2], x, z, 3, FenmarchArt.ReedsHeight / 2, HellfeatherArt.FineVoxel) }
            else if n < 10 { placer.OfferProp(group, Props.Trees[n % 3], x, z, 5, 40, HellfeatherArt.FineVoxel) }
            else { placer.OfferProp(group, Props.Rocks[n % 3], x, z, 7, 10, HellfeatherArt.FineVoxel) }
            group++
        }
    }
}
#{
    // World units from the mill's center to the river's centerline, toward +X.
    // The mill's +X wall is 1.06 out and its wheel turns between 1.31 and 1.81,
    // so the river's near bank runs under the wheel.
    #float WheelSide = 2.3
    #float RiverHalf = 1.1
    // The half width of the path the generator keeps open, and bridges, along
    // every road: QuaxelTerrainConfig.ReservedPath.
    #float Reserved = 2.0
    // World units along the river either side of the mill that it runs straight.
    #float Straight = 5.0
    // Past the mill's front, 2.16 out, the river bends this far toward +X,
    // clear of the door and of the player arriving there.
    #float BendFrom = 2.2
    #float Bend = 1.0
    // The pond's middle from the river's anchor: a little out and upstream.
    #float PondAcross = 0.8
    #float PondAlong = -5.2
    #float PondRadius = 2.4
    // Cells below the floor. Shallow, so the water beside the wheel, which the
    // mill's levelled square raises to the ground, steps down only a little.
    #int RiverDepth = 2
    #int PondDepth = 3
}

// Code-built props of the Fenmarch. They join the shared HellfeatherProps.
FenmarchArt
#{
    #int ReedsWidth = 28
    #int ReedsHeight = 40
    #int ShrineWidth = 32
    #int ShrineHeight = 64

    // A clump of reeds, stalk by stalk: thin single-voxel stalks gathered
    // toward the middle on a little mound of mud, tallest in the middle, each
    // curving more toward its tip, splayed outward and leaning together with
    // the wind off the water. Dark olive at the waterline, green-olive up the
    // stalk and dry straw at the tips. A third are broader leaf blades that
    // bend further. Variant 0 is common reed with pale feathery plumes,
    // variant 1 cattails with brown heads and a spike. A black feather is
    // caught in each.
    BuildReeds(QuaxelWorld& world, int volume, int variant)
    {
        QuaxelRandom random
        random.Begin((uint)(variant + 11) * (uint)7919)
        float middle = (float)ReedsWidth * 0.5
        float spread = (float)ReedsWidth * 0.5 - 4.0
        float windX = variant == 0 ? 0.55 | -0.35
        float windZ = variant == 0 ? 0.3 | 0.55
        // Mud and old roots at the foot, a little higher in the middle.
        for x : 0; x < ReedsWidth; x++ {
            for z : 0; z < ReedsWidth; z++ {
                float d = Math.Hypot((float)x + 0.5 - middle, (float)z + 0.5 - middle)
                float edge = spread * 0.75 + (float)(HellfeatherArt.Hash(x, 5, z) % 3)
                if d > edge { continue }
                int mud = HellfeatherArt.Rgb(HellfeatherArt.Shade(0x2e2619, 80 + HellfeatherArt.Hash(x, 1, z) % 35))
                world.SetVoxel(volume, x, 0, z, mud)
                if d < edge * 0.5 { world.SetVoxel(volume, x, 1, z, mud) }
            }
        }
        int stalks = variant == 0 ? 56 | 44
        for stalk : 0; stalk < stalks; stalk++ {
            float angle = random.Range(0.0, 6.2831853)
            float r = spread * Math.Sqrt(random.Unit()) * random.Range(0.55, 1.0)
            float bx = middle + Math.Cos(angle) * r
            float bz = middle + Math.Sin(angle) * r
            float near = 1.0 - r / spread
            int height = (int)((float)(ReedsHeight - 3) * (0.42 + 0.42 * near + random.Range(0.0, 0.16)))
            bool blade = random.Unit() < 0.33
            float bend = blade ? random.Range(4.0, 7.0) | random.Range(1.0, 3.0)
            // Outward from the middle, and with the wind.
            float outX = Math.Cos(angle) * (0.4 + r / spread) + windX
            float outZ = Math.Sin(angle) * (0.4 + r / spread) + windZ
            float length = Math.Max(0.001, Math.Hypot(outX, outZ))
            outX = outX / length
            outZ = outZ / length
            int tone = 0x5f6a2e
            int pick = random.Below(3)
            if pick == 1 { tone = 0x6e7336 }
            if pick == 2 { tone = 0x857a3c }
            int lastX = -1
            int lastZ = -1
            for y : 1; y < height; y++ {
                float t = (float)y / (float)height
                float off = bend * t * t
                int vx = Math.Clamp((int)Math.Round(bx + outX * off), 0, ReedsWidth - 1)
                int vz = Math.Clamp((int)Math.Round(bz + outZ * off), 0, ReedsWidth - 1)
                int color = ReedColor(tone, t)
                int shade = 88 + HellfeatherArt.Hash(vx, y, vz) % 22
                world.SetVoxel(volume, vx, y, vz, HellfeatherArt.Rgb(HellfeatherArt.Shade(color, shade)))
                // A blade is two voxels wide through its middle.
                if blade && t > 0.2 && t < 0.7 {
                    int wx = Math.Clamp(vx + (outZ > 0.0 ? 1 | -1), 0, ReedsWidth - 1)
                    world.SetVoxel(volume, wx, y, vz, HellfeatherArt.Rgb(HellfeatherArt.Shade(color, shade - 12)))
                }
                lastX = vx
                lastZ = vz
            }
            if blade { continue }
            if variant == 1 && stalk % 4 == 0 && height > 14 {
                // A cattail head below the tip: a 2 by 2 brown sausage, darker
                // on one side, with the bare spike of the stalk above it.
                int top = height - 3
                for y : top - 7; y < top; y++ {
                    for a : 0; a < 2; a++ {
                        for b : 0; b < 2; b++ {
                            int hx = Math.Clamp(lastX + a, 0, ReedsWidth - 1)
                            int hz = Math.Clamp(lastZ + b, 0, ReedsWidth - 1)
                            int brown = HellfeatherArt.Shade(0x5a3820, (a + b == 0 ? 112 | 88) + HellfeatherArt.Hash(hx, y, hz) % 12)
                            world.SetVoxel(volume, hx, y, hz, HellfeatherArt.Rgb(brown))
                        }
                    }
                }
            } else if variant == 0 && stalk % 3 == 0 && height > 14 {
                // A loose plume of pale seed around the tip.
                for n : 0; n < 9; n++ {
                    int px = Math.Clamp(lastX + random.Below(3) - 1, 0, ReedsWidth - 1)
                    int pz = Math.Clamp(lastZ + random.Below(3) - 1, 0, ReedsWidth - 1)
                    int py = Math.Clamp(height - 1 - random.Below(5), 0, ReedsHeight - 1)
                    world.SetVoxel(volume, px, py, pz, HellfeatherArt.Rgb(HellfeatherArt.Shade(0xcdbb8c, 85 + random.Below(25))))
                }
            }
        }
        // A black feather snagged across the stalks.
        int fx = 7 + variant * 5
        for n : 0; n < 6; n++ {
            int color = n == 0 ? 0x2a2540 | 0x121016
            world.SetVoxel(volume, fx + n, 16 + n / 2, (int)middle, HellfeatherArt.Rgb(color))
        }
    }

    // A reed's color up its length, T from 0 at the mud to 1 at the tip.
    -int ReedColor(int tone, float t)
    {
        if t < 0.15 { return MixColor(0x3a3820, tone, t / 0.15) }
        if t < 0.7 { return tone }
        return MixColor(tone, 0xb7a25c, (t - 0.7) / 0.3)
    }

    -int MixColor(int from, int to, float t)
    {
        int red = (int)((float)((from >> 16) & 255) + (float)(((to >> 16) & 255) - ((from >> 16) & 255)) * t)
        int green = (int)((float)((from >> 8) & 255) + (float)(((to >> 8) & 255) - ((from >> 8) & 255)) * t)
        int blue = (int)((float)(from & 255) + (float)((to & 255) - (from & 255)) * t)
        return (red << 16) | (green << 8) | blue
    }

    // A wooden shrine post with a little slate roof, hung with grey cloth and
    // black feathers. The beam runs along X.
    BuildShrine(QuaxelWorld& world, int volume)
    {
        int wood = HellfeatherArt.Rgb(0x2e2117)
        HellfeatherArt.Box(world, volume, 14, 0, 4, 18, 52, 8, wood)
        HellfeatherArt.Box(world, volume, 3, 44, 5, 29, 47, 7, wood)
        // Roof over the post top.
        for y : 52; y < 60; y++ {
            int inset = (y - 52)
            for x : 10 + inset; x < 22 - inset; x++ {
                for z : 2; z < 10; z++ { world.SetVoxel(volume, x, y, z, HellfeatherArt.SlateColor(x * 2, (y - 52) * 5 + 1)) }
            }
        }
        // Strings from the beam, alternately a grey cloth strip and a feather.
        for n : 0; n < 6; n++ {
            int x = 5 + n * 4
            int length = 6 + HellfeatherArt.Hash(n, 3, 9) % 8
            for y : 44 - length; y < 44; y++ {
                int color = 0x8a857c
                if n % 2 == 1 {
                    color = y < 44 - length + 5 ? 0x121016 | 0x3b3730
                    if y == 44 - length + 2 { color = 0x2a2540 }
                }
                world.SetVoxel(volume, x, y, 6, HellfeatherArt.Rgb(HellfeatherArt.Shade(color, 85 + HellfeatherArt.Hash(x, y, 2) % 25)))
            }
        }
        // Offerings at its foot: a grey stone and a tallow stub.
        HellfeatherArt.StoneBox(world, volume, 10, 0, 1, 14, 3, 4)
        HellfeatherArt.Box(world, volume, 19, 0, 2, 21, 4, 4, HellfeatherArt.Rgb(0xc9bfa3))
    }
}
T{
    // Reeds are stalks with air between them, not a solid block: halfway up a
    // clump most of its square is empty, and the cattails carry brown heads.
    ReedsAreStalksNotABlock()
    {
        QuaxelWorld world()
        for variant : 0; variant < 2; variant++ {
            int volume = world.CreateVolume(FenmarchArt.ReedsWidth, FenmarchArt.ReedsHeight, FenmarchArt.ReedsWidth)
            FenmarchArt.BuildReeds(world, volume, variant)
            int filled = 0
            int y = FenmarchArt.ReedsHeight / 3
            for x : 0; x < FenmarchArt.ReedsWidth; x++ {
                for z : 0; z < FenmarchArt.ReedsWidth; z++ {
                    if world.GetVoxel(volume, x, y, z) >= 0 { filled++ }
                }
            }
            T.IsTrue(filled > 10)
            T.IsTrue(filled * 5 < FenmarchArt.ReedsWidth * FenmarchArt.ReedsWidth)
        }
    }

    // The story's order: the Ford Road is just outside, the mill is farthest out,
    // and the hill and the mill are each a single clearing.
    ActOneZonesLieInStoryOrder()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int mills = 0
        int hills = 0
        int marshes = 0
        int roads = 0
        int millDepth = 0
        int roadDepth = 1000
        int deepest = 0
        for site : game.Terrain.Layout.Sites {
            deepest = Math.Max(deepest, site.Depth)
            if site.Module == HellfeatherZone.HobbsMill + 0 {
                mills++
                millDepth = site.Depth
            }
            if site.Module == HellfeatherZone.OrrasHill + 0 { hills++ }
            if site.Module == HellfeatherZone.FennickWater + 0 { marshes++ }
            if site.Module == HellfeatherZone.FordRoad + 0 {
                roads++
                roadDepth = Math.Min(roadDepth, site.Depth)
            }
        }
        T.AreEqual(mills, 1)
        T.AreEqual(hills, 1)
        T.IsTrue(marshes >= 2)
        T.IsTrue(roads >= 1)
        T.IsTrue(roadDepth <= 2)
        T.IsTrue(millDepth >= 5)
        T.AreEqual(game.Terrain.Layout.Sites[game.Terrain.SpawnSiteIndex].Module, HellfeatherZone.Ravenford + 0)
    }

    // The mill blocks only the ground its own voxels cover, with no strip of
    // hidden ground behind it, so the player can walk right up to every wall.
    TheMillBlocksOnlyItsOwnFootprint()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int mill = -1
        for i : 0; i < game.Terrain.Placements.Len; i++ {
            if game.Terrain.Placements[i].Volume == game.Terrain.Mill.Mill { mill = (int)i }
        }
        T.IsTrue(mill >= 0)
        vec3 at = game.Terrain.PlacementPosition(mill)
        int calls = 0
        while !game.Terrain.IsReady(at) && calls < 4000 {
            T.IsTrue(game.Terrain.Stream(world, at, 100000))
            calls++
        }
        T.IsTrue(game.Terrain.IsReady(at))
        // No hidden strip, and a ground plan no bigger than the model.
        T.AreEqual(game.Terrain.Placements[mill].Reach, 0)
        ivec3 cells = world.VolumeCells(game.Terrain.Mill.Mill)
        float voxel = game.Terrain.Placements[mill].VoxelSize
        int wide = (int)Math.Ceil((float)cells.X * voxel / QuaxelTerrain.Cell) + 1
        int deep = (int)Math.Ceil((float)cells.Z * voxel / QuaxelTerrain.Cell) + 1
        T.IsTrue(game.Terrain.Placements[mill].FootWide <= wide)
        T.IsTrue(game.Terrain.Placements[mill].FootDeep <= deep)
        T.IsTrue(game.Terrain.Placements[mill].FootLeft >= -wide / 2 - 1)
        T.IsTrue(game.Terrain.Placements[mill].FootTop >= -deep / 2 - 1)
        // Solid in the middle; the player fits right against its back and its
        // -X wall, where the hidden strip used to block.
        float halfX = (float)cells.X * voxel * 0.5
        float halfZ = (float)cells.Z * voxel * 0.5
        float radius = game.PlayerRadius()
        T.IsTrue(game.Terrain.IsBlocked(at.X, at.Z))
        T.IsFalse(game.Terrain.CircleBlocked(at.X, at.Z - halfZ - radius - 0.15, radius))
        T.IsFalse(game.Terrain.CircleBlocked(at.X - halfX - radius - 0.15, at.Z - 1.2, radius))
        T.IsFalse(game.Terrain.CircleBlocked(at.X - 1.0, at.Z - halfZ - radius - 0.15, radius))
    }

    // The river runs past the mill's +X wall, under its wheel, and on past it
    // both ways; the mill's door and its arrival spot stay on dry ground.
    TheMillWheelTurnsInTheRiver()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int mill = -1
        for i : 0; i < game.Terrain.Placements.Len; i++ {
            if game.Terrain.Placements[i].Volume == game.Terrain.Mill.Mill { mill = (int)i }
        }
        T.IsTrue(mill >= 0)
        T.AreEqual(game.Terrain.Mill.RiverSite, game.Terrain.Placements[mill].Site)
        vec3 at = game.Terrain.PlacementPosition(mill)
        int calls = 0
        while !game.Terrain.IsReady(at) && calls < 4000 {
            T.IsTrue(game.Terrain.Stream(world, at, 100000))
            calls++
        }
        ivec3 cells = world.VolumeCells(game.Terrain.Mill.Mill)
        float halfX = (float)cells.X * game.Terrain.Placements[mill].VoxelSize * 0.5
        // Just past the wheel, beside it from back to front, is water.
        for step : -3; step <= 1; step++ {
            float z = at.Z + (float)step * 0.5
            T.AreEqual(game.Terrain.ColumnKind(game.Terrain.ColumnAt(at.X + halfX + 0.4), game.Terrain.ColumnAt(z)), QuaxelTerrainKind.Water)
        }
        // And on past the mill both ways, upstream and downstream.
        int upstream = 0
        int downstream = 0
        for step : 0; step < 40; step++ {
            float x = at.X + HobbsMill.WheelSide - 2.0 + (float)(step % 8) * 0.5
            float z = (float)(step / 8) * 0.5 + 3.0
            if game.Terrain.ColumnKind(game.Terrain.ColumnAt(x), game.Terrain.ColumnAt(at.Z - z - 4.0)) == QuaxelTerrainKind.Water { upstream++ }
            if game.Terrain.ColumnKind(game.Terrain.ColumnAt(x), game.Terrain.ColumnAt(at.Z + z)) == QuaxelTerrainKind.Water { downstream++ }
        }
        T.IsTrue(upstream > 5)
        T.IsTrue(downstream > 5)
        float radius = game.PlayerRadius()
        T.IsFalse(game.Terrain.CircleBlocked(game.MillDoor.X, game.MillDoor.Z + 1.6, radius))
        T.IsFalse(game.Terrain.IsBlocked(game.MillDoor.X, game.MillDoor.Z))
    }

    // Every road through the mill's clearing can be walked end to end, and
    // where the river crosses one it does so on a bridge.
    TheMillRiverIsBridgedWhereRoadsCrossIt()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int index = game.Terrain.Mill.RiverSite
        T.IsTrue(index >= 0)
        QuaxelTerrainSite site = game.Terrain.Layout.Sites[index]
        vec3 center = game.Terrain.WorldPoint(site.X, site.Z)
        int calls = 0
        while !game.Terrain.IsReady(center) && calls < 4000 {
            T.IsTrue(game.Terrain.Stream(world, center, 100000))
            calls++
        }
        T.IsTrue(game.Terrain.IsReady(center))
        float radius = game.PlayerRadius()
        int bridged = 0
        for port : 0; port < site.PortCount; port++ {
            float px = site.PortX[port]
            float pz = site.PortZ[port]
            for step : 0; step <= (int)(site.Radius * 4.0); step++ {
                float t = (float)step * 0.25
                vec3 point = game.Terrain.WorldPoint(site.X + px * t, site.Z + pz * t)
                T.IsFalse(game.Terrain.CircleBlocked(point.X, point.Z, radius))
                // Where the river runs under the road, the road is a bridge:
                // open to walk on, with the river's water just off it.
                if !game.Terrain.Mill.IsWater(site, px * t, pz * t, 0.0) { continue }
                T.AreEqual(game.Terrain.ColumnKind(game.Terrain.ColumnAt(point.X), game.Terrain.ColumnAt(point.Z)), QuaxelTerrainKind.Open)
                bridged++
                int water = 0
                for a : -14; a <= 14; a++ {
                    for b : -14; b <= 14; b++ {
                        float x = point.X + (float)a * 0.25
                        float z = point.Z + (float)b * 0.25
                        if game.Terrain.ColumnKind(game.Terrain.ColumnAt(x), game.Terrain.ColumnAt(z)) == QuaxelTerrainKind.Water { water++ }
                    }
                }
                T.IsTrue(water > 0)
            }
        }
        // The river crosses at least one road, so there is a bridge to cross.
        T.IsTrue(bridged > 0)
    }

    // No reed, tree or rock of the mill's clearing stands in its water.
    NoPropStandsInTheMillRiver()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int index = game.Terrain.Mill.RiverSite
        T.IsTrue(index >= 0)
        QuaxelTerrainSite site = game.Terrain.Layout.Sites[index]
        vec3 center = game.Terrain.WorldPoint(site.X, site.Z)
        int calls = 0
        while !game.Terrain.IsReady(center) && calls < 4000 {
            T.IsTrue(game.Terrain.Stream(world, center, 100000))
            calls++
        }
        int props = 0
        for i : 0; i < game.Terrain.Placements.Len; i++ {
            if !game.Terrain.Placements[i].Prop || game.Terrain.Placements[i].Site != index { continue }
            props++
            vec3 at = game.Terrain.PlacementPosition((int)i)
            T.AreNotEqual(game.Terrain.ColumnKind(game.Terrain.ColumnAt(at.X), game.Terrain.ColumnAt(at.Z)), QuaxelTerrainKind.Water)
        }
        T.IsTrue(props > 0)
    }
}

// Where a big building can stand in a clearing without sitting on a road.
HellfeatherRoads
#{
    // Offers a building in the widest gap between the clearing's roads, as far
    // out as it fits first, then nearer the middle and to either side.
    OfferBetween(QuaxelTerrainPlacer& placer, int group, QuaxelTerrainSite site, int volume, int half, int height, int sight, float voxel)
    {
        float [] angles
        for port : 0; port < site.PortCount; port++ { angles += Math.Atan2(site.PortZ[port], site.PortX[port]) }
        // Sorted, so neighbors in the list are neighbors around the circle.
        for i : 1; i < angles.Len; i++ {
            for j : i; j > 0 && angles[j] < angles[j - 1]; j-- {
                float swap = angles[j]
                angles[j] = angles[j - 1]
                angles[j - 1] = swap
            }
        }
        float middle = 0.0
        float widest = 6.2831853
        if angles.Len > 0 {
            widest = -1.0
            for i : 0; i < angles.Len; i++ {
                float next = i + 1 < angles.Len ? angles[i + 1] | angles[0] + 6.2831853
                if next - angles[i] > widest {
                    widest = next - angles[i]
                    middle = angles[i] + widest * 0.5
                }
            }
        }
        float corner = (float)half * QuaxelTerrain.Cell * 1.42
        for ring : 0; ring < 12; ring++ {
            float distance = site.Radius - corner - 0.6 - (float)ring * 0.7
            if distance < 0.0 { continue }
            for side : 0; side < 7; side++ {
                float angle = middle + (float)(side - 3) * widest * 0.06
                placer.OfferBuilding(group, volume, Math.Cos(angle) * distance, Math.Sin(angle) * distance, half, height, sight, voxel)
            }
        }
    }
}
