// The warrior's numbers: her base attributes plus everything she wears.
// Chances, resistances and move speed are whole percents.
HellfeatherStats
{
    int Strength
    int Agility
    int MaxHealth
    int MaxMana
    // The equipped weapon's own damage range, before any attribute adds to it.
    int WeaponMin
    int WeaponMax
    bool Ranged
    int Defense
    int FireResist
    int ColdResist
    int LightningResist
    // Percent of normal walking speed.
    int MoveSpeed = 100
    float ManaPerSecond
    // Percent more damage on top of the flat amount, from passives.
    int DamagePercent
    // Accuracy from mods and passives, on top of what agility gives.
    int HitBonus

    // Strength adds to both ends of every weapon's range, and agility to ranged
    // weapons as well. Percent bonuses apply after the flat ones.
    HellfeatherDamageRange Damage() { return WeaponRange(100) }

    // Cleave hits half as hard again as the weapon, and attributes add the same.
    HellfeatherDamageRange CleaveDamage() { return WeaponRange(150) }

    -HellfeatherDamageRange WeaponRange(int weaponPercent)
    {
        int flat = Strength + (Ranged ? Agility | 0)
        return HellfeatherDamageRange.Make(Scaled(WeaponMin * weaponPercent / 100 + flat), Scaled(WeaponMax * weaponPercent / 100 + flat))
    }

    -int Scaled(int flat) { return flat * (100 + DamagePercent) / 100 }

    // Accuracy cancels an enemy's armor (see HellfeatherCombat); agility gives
    // AccuracyPerAgility for each point.
    int Accuracy() { return Agility * HellfeatherStats.AccuracyPerAgility + HitBonus }

    // Percent chance her defense turns aside a blow of this accuracy.
    float DodgeChance(int accuracy) { return HellfeatherCombat.DodgeChance(Defense, accuracy) }

    // Adds flat damage to both ends of the weapon's range.
    AddWeaponDamage(int low, int high)
    {
        WeaponMin += low
        WeaponMax += high
    }
}
#{
    #int BaseStrength = 5
    #int BaseAgility = 5
    #int BaseHealth = 100
    #int BaseMana = 60
    #float BaseManaPerSecond = 2.0
    #int AccuracyPerAgility = 2

    // What the warrior has with nothing on.
    HellfeatherStats Base()
    {
        HellfeatherStats stats
        stats.Strength = BaseStrength
        stats.Agility = BaseAgility
        stats.MaxHealth = BaseHealth
        stats.MaxMana = BaseMana
        stats.ManaPerSecond = BaseManaPerSecond
        return stats
    }

    // What one worn item gives. These match the items' detail lines.
    AddItem(HellfeatherStats& stats, HellfeatherItems item)
    {
        if item == HellfeatherItems.BattleAxe { stats.AddWeaponDamage(16, 24) }
        if item == HellfeatherItems.ShortSword { stats.AddWeaponDamage(9, 15) }
        if item == HellfeatherItems.RoundShield { stats.Defense += 8 }
        if item == HellfeatherItems.IronHelm { stats.Defense += 5 }
        if item == HellfeatherItems.MinersHelmet { stats.Defense += 2 }
        if item == HellfeatherItems.LeatherArmor { stats.Defense += 12 }
        if item == HellfeatherItems.Gloves { stats.Defense += 2 }
        if item == HellfeatherItems.Boots { stats.Defense += 2 }
        if item == HellfeatherItems.Belt { stats.Defense += 1 }
        if item == HellfeatherItems.Amulet { stats.FireResist += 3 }
        if item == HellfeatherItems.EddasQuillCharm {
            stats.MaxHealth += 15
            stats.Defense += 3
        }
        if item == HellfeatherItems.JessasWaterwalkers {
            stats.Defense += 4
            stats.MoveSpeed += 15
        }
        if item == HellfeatherItems.MarrasThimble {
            stats.Defense += 6
            stats.Strength += 3
        }
        if item == HellfeatherItems.GreyneckQuill { stats.Agility += 6 }
        if item == HellfeatherItems.MillstoneMaul { stats.AddWeaponDamage(24, 40) }
        if item == HellfeatherItems.HandAxe { stats.AddWeaponDamage(10, 14) }
        if item == HellfeatherItems.Falchion { stats.AddWeaponDamage(12, 20) }
        if item == HellfeatherItems.FlangedMace { stats.AddWeaponDamage(20, 32) }
        if item == HellfeatherItems.KiteShield { stats.Defense += 14 }
        if item == HellfeatherItems.ChainCoif { stats.Defense += 8 }
        if item == HellfeatherItems.GreatHelm { stats.Defense += 12 }
        if item == HellfeatherItems.RingMail { stats.Defense += 20 }
        if item == HellfeatherItems.ScaleMail { stats.Defense += 30 }
        if item == HellfeatherItems.ChainGloves || item == HellfeatherItems.ChainBoots { stats.Defense += 5 }
        if item == HellfeatherItems.Gauntlets || item == HellfeatherItems.PlateBoots { stats.Defense += 9 }
        if item == HellfeatherItems.HeavyBelt { stats.Defense += 4 }
        if item == HellfeatherItems.PlatedBelt { stats.Defense += 7 }
        if item == HellfeatherItems.GarnetRing { stats.Strength += 2 }
        if item == HellfeatherItems.RavenAmulet { stats.MaxMana += 15 }
        if item == HellfeatherItems.WarHammer { stats.AddWeaponDamage(26, 42) }
        if item == HellfeatherItems.TowerShield { stats.Defense += 22 }
        if item == HellfeatherItems.VisoredHelm { stats.Defense += 17 }
        if item == HellfeatherItems.PlateMail { stats.Defense += 42 }
        if item == HellfeatherItems.SpikedGauntlets { stats.Defense += 13 }
    }

    // A rate with one decimal, such as "2.0".
    string FormatTenths(float value)
    {
        int tenths = (int)(value * 10.0 + 0.5)
        return QuaxelUi.FormatInt(tenths / 10) + "." + QuaxelUi.FormatInt(tenths % 10)
    }
}

HellfeatherInventory
{
    // What the warrior has with this gear on. The bag gives nothing.
    HellfeatherStats Stats()
    {
        stats : HellfeatherStats.Base()
        for slot : HellfeatherSlot {
            HellfeatherStats.AddItem(stats, Equipped[slot])
            if Equipped[slot] != HellfeatherItems.None { EquippedMods[slot].ApplyTo(stats) }
        }
        return stats
    }
}
T{
    // Every weapon deals a range, and its detail line shows the same range
    // its stats give.
    EveryWeaponShowsTheRangeItDeals()
    {
        int weapons = 0
        for item : HellfeatherItems {
            HellfeatherItemKind kind = HellfeatherItems.Get(item)
            if kind.Gear != HellfeatherGear.Weapon { continue }
            HellfeatherStats stats
            HellfeatherStats.AddItem(stats, item)
            T.IsTrue(stats.WeaponMax > stats.WeaponMin)
            T.AreEqual(kind.Detail,"Damage " + QuaxelUi.FormatInt(stats.WeaponMin) + "-" + QuaxelUi.FormatInt(stats.WeaponMax))
            weapons++
        }
        T.IsTrue(weapons >= 6)
    }

    TheWarriorStartsWithHerBaseAttributes()
    {
        HellfeatherInventory items
        stats : items.Stats()
        T.AreEqual(stats.Strength, HellfeatherStats.BaseStrength)
        T.AreEqual(stats.Agility, HellfeatherStats.BaseAgility)
        T.AreEqual(stats.MaxHealth, 100)
        T.AreEqual(stats.MaxMana, 60)
        T.AreEqual(stats.Defense, 0)
        T.AreEqual(stats.MoveSpeed, 100)
        // Bare hands still hit with her strength.
        bare : stats.Damage()
        T.AreEqual(bare.Min, HellfeatherStats.BaseStrength)
        T.AreEqual(bare.Max, HellfeatherStats.BaseStrength)
    }

    StrengthAddsFlatDamageToTheWeapon()
    {
        HellfeatherInventory items
        items.Equipped[HellfeatherSlot.MainHand] = HellfeatherItems.BattleAxe
        stats : items.Stats()
        axe : stats.Damage()
        T.AreEqual(axe.Min, 16 + stats.Strength)
        T.AreEqual(axe.Max, 24 + stats.Strength)
        cleave : stats.CleaveDamage()
        T.AreEqual(cleave.Min, 24 + stats.Strength)
        T.AreEqual(cleave.Max, 36 + stats.Strength)
        stats.Strength += 4
        stronger : stats.Damage()
        T.AreEqual(stronger.Max, 28 + HellfeatherStats.BaseStrength)
    }

    AgilityAddsToRangedDamageAndToAccuracy()
    {
        HellfeatherInventory items
        stats : items.Stats()
        stats.AddWeaponDamage(8, 12)
        melee : stats.Damage()
        T.AreEqual(melee.Min, 8 + stats.Strength)
        stats.Ranged = true
        ranged : stats.Damage()
        T.AreEqual(ranged.Max, 12 + stats.Strength + stats.Agility)
        T.AreEqual(stats.Accuracy(), stats.Agility * HellfeatherStats.AccuracyPerAgility)
        stats.HitBonus = 7
        T.AreEqual(stats.Accuracy(), stats.Agility * HellfeatherStats.AccuracyPerAgility + 7)
    }

    DefenseDodgesBlowsLikeEnemyArmor()
    {
        HellfeatherInventory items
        stats : items.Stats()
        T.AreEqual(stats.DodgeChance(0), 0.0)
        stats.Defense = 100
        T.AreEqual(stats.DodgeChance(0), 20.0)
        T.AreEqual(stats.DodgeChance(100), 0.0)
    }

    WornArmorAndWardsAddUp()
    {
        HellfeatherInventory items
        items.Equipped[HellfeatherSlot.Body] = HellfeatherItems.LeatherArmor
        items.Equipped[HellfeatherSlot.Head] = HellfeatherItems.IronHelm
        items.Equipped[HellfeatherSlot.Neck] = HellfeatherItems.Amulet
        stats : items.Stats()
        T.AreEqual(stats.Defense, 17)
        T.AreEqual(stats.FireResist, 3)
        T.AreEqual(stats.ColdResist, 0)
        T.AreEqual(stats.LightningResist, 0)
        // Items in the bag give nothing.
        items.Equipped[HellfeatherSlot.Body] = HellfeatherItems.None
        T.IsTrue(items.Add(HellfeatherItems.LeatherArmor))
        after : items.Stats()
        T.AreEqual(after.Defense, 5)
    }

    RatesShowOneDecimal()
    {
        T.AreEqual(HellfeatherStats.FormatTenths(2.0), "2.0")
        T.AreEqual(HellfeatherStats.FormatTenths(1.25), "1.3")
        T.AreEqual(HellfeatherStats.FormatTenths(0.0), "0.0")
    }
}
