// Paints the quest log into the sprite atlas below the rune board: the shared
// stone and frame, six carved niches for the quests of an act, a band for the
// chosen quest's title and a recess for its journal. Each quest's icon is
// painted twice beside the panel, lit for a quest under way and grey for one
// that is done. The niche and the icons come from Source/QuestPictures.dk,
// generated by Tools/QuestArt. Coordinates are logical pixels.
HellfeatherQuestLogArt
#{
    #int Top = 1536
    #int NicheSize = 48
    #int NicheLeft = 8
    #int NicheTop = 26
    // From one niche to the next, across and down.
    #int NicheStepX = 56
    #int NicheStepY = 54
    #int Columns = 3
    // Icons are drawn at one pixel per cell, centered in the niche's opening
    // and standing near its sill.
    #int IconSize = 32
    #int IconInsetX = 8
    #int IconInsetY = 12
    // Lit icons sit in a row to the right of the panel, grey ones below them.
    #int IconAtlasX = 184
    #int IconStride = 34
    #int WellX = 8
    #int WellWidth = 160
    #int TitleY = 134
    #int TitleHeight = 14
    #int TextY = 152
    #int TextHeight = 93
    #int Line = 10
    // A journal line fits the recess at six pixels a character. The row below
    // the last line says whether the quest is done.
    #int LineChars = 25
    #int LineCount = 8

    int NicheX(int quest) { return NicheLeft + (quest % Columns) * NicheStepX }

    int NicheY(int quest) { return NicheTop + (quest / Columns) * NicheStepY }

    int IconX(int quest) { return IconAtlasX + quest * IconStride }

    // The top of a journal line, on the panel.
    int LineY(int line) { return TextY + 4 + line * Line }

    Paint(QuaxelUi& ui)
    {
        HellfeatherInventoryArt.PaintStone(ui, Top)
        HellfeatherInventoryArt.PaintFrame(ui, Top)
        HellfeatherInventoryArt.PaintClose(ui, Top)
        HellfeatherItemPicture niche
        HellfeatherQuestPictures.Niche(niche)
        for quest : 0; quest < HellfeatherQuests.PerAct; quest++ {
            // The stone shows through the empty corners above the arch.
            Cells(ui, niche, NicheX(quest), Top + NicheY(quest), false)
            HellfeatherItemPicture icon
            HellfeatherQuestPictures.Draw(quest, icon)
            Cells(ui, icon, IconX(quest), Top, false)
            Cells(ui, icon, IconX(quest), Top + IconStride, true)
        }
        HellfeatherInventoryArt.Well(ui, WellX, Top + TitleY, WellWidth, TitleHeight)
        HellfeatherInventoryArt.Well(ui, WellX, Top + TextY, WellWidth, TextHeight)
    }

    // Paints a picture at one pixel per cell, in color or in grey.
    -Cells(QuaxelUi& ui, HellfeatherItemPicture& picture, int x, int y, bool grey)
    {
        for row : 0; row < picture.Rows.Len; row++ {
            for column : 0; column < Length(picture.Rows[row]); column++ {
                int rgb = HellfeatherItemArt.ColorOf(picture.Code(column, (int)row))
                if rgb < 0 { continue }
                if grey { rgb = Grey(rgb) }
                HellfeatherInventoryArt.Put(ui, x + column, y + (int)row, rgb)
            }
        }
    }

    // Brightness only, a little dimmer and warmer, like old paper.
    int Grey(int rgb)
    {
        int light = (((rgb >> 16) & 255) * 30 + ((rgb >> 8) & 255) * 59 + (rgb & 255) * 11) / 100
        light = light * 70 / 100
        return (light << 16) | (light << 8) | (light * 85 / 100)
    }
}
T{
    TheLogFitsItsPanelAndTheAtlas()
    {
        int last = HellfeatherQuests.PerAct - 1
        T.IsTrue(HellfeatherQuestLogArt.NicheY(last) + HellfeatherQuestLogArt.NicheSize < HellfeatherQuestLogArt.TitleY)
        T.IsTrue(HellfeatherQuestLogArt.NicheX(last) + HellfeatherQuestLogArt.NicheSize <= HellfeatherInventoryArt.PanelWidth - 6)
        T.IsTrue(HellfeatherQuestLogArt.IconInsetX + HellfeatherQuestLogArt.IconSize <= HellfeatherQuestLogArt.NicheSize)
        T.IsTrue(HellfeatherQuestLogArt.IconInsetY + HellfeatherQuestLogArt.IconSize <= HellfeatherQuestLogArt.NicheSize)
        T.IsTrue(HellfeatherQuestLogArt.TextY + HellfeatherQuestLogArt.TextHeight <= HellfeatherInventoryArt.PanelHeight - 6)
        T.IsTrue(HellfeatherQuestLogArt.LineY(HellfeatherQuestLogArt.LineCount) + 8 <= HellfeatherQuestLogArt.TextY + HellfeatherQuestLogArt.TextHeight)
        T.IsTrue(HellfeatherQuestLogArt.LineChars * 6 <= HellfeatherQuestLogArt.WellWidth - 8)
        T.IsTrue(HellfeatherQuestLogArt.IconX(last) + HellfeatherQuestLogArt.IconSize <= HellfeatherInventoryArt.AtlasWidth)
        T.IsTrue(HellfeatherQuestLogArt.Top + HellfeatherInventoryArt.PanelHeight <= HellfeatherInventoryArt.AtlasHeight)
    }

    TheGeneratedPicturesHaveTheirSizes()
    {
        HellfeatherItemPicture niche
        HellfeatherQuestPictures.Niche(niche)
        T.AreEqual(niche.Width(), HellfeatherQuestLogArt.NicheSize)
        T.AreEqual(niche.Rows.Len, (long)HellfeatherQuestLogArt.NicheSize)
        for quest : 0; quest < HellfeatherQuests.PerAct; quest++ {
            HellfeatherItemPicture icon
            HellfeatherQuestPictures.Draw(quest, icon)
            T.AreEqual(icon.Width(), HellfeatherQuestLogArt.IconSize)
            T.AreEqual(icon.Rows.Len, (long)HellfeatherQuestLogArt.IconSize)
            // The clear margin the shader's outline needs.
            T.IsTrue(icon.RowIsEmpty(0))
            T.IsTrue(icon.RowIsEmpty(HellfeatherQuestLogArt.IconSize - 1))
        }
    }

    EveryQuestHasItsOwnIcon()
    {
        for quest : 0; quest < HellfeatherQuests.PerAct; quest++ {
            HellfeatherItemPicture icon
            HellfeatherQuestPictures.Draw(quest, icon)
            for other : 0; other < quest; other++ {
                HellfeatherItemPicture earlier
                HellfeatherQuestPictures.Draw(other, earlier)
                bool same = true
                for row : 0; row < HellfeatherQuestLogArt.IconSize; row++ {
                    if icon.Rows[row] != earlier.Rows[row] { same = false }
                }
                T.IsFalse(same)
            }
        }
    }

    LitAndGreyIconsArePaintedBesideThePanel()
    {
        QuaxelUi ui()
        HellfeatherInventoryArt.EnsurePainted(ui)
        // The middle of the journal's pages, lit and then grey.
        int x = HellfeatherQuestLogArt.IconX(2) + 16
        int y = HellfeatherQuestLogArt.Top + 16
        int lit = (int)ui.AtlasTexel(x, y) & 0xFFFFFF
        int grey = (int)ui.AtlasTexel(x, y + HellfeatherQuestLogArt.IconStride) & 0xFFFFFF
        T.AreNotEqual(lit, 0)
        T.AreNotEqual(lit, grey)
        T.AreEqual((grey >> 16) & 255, (grey >> 8) & 255)
        // The niche covers its slot below the arch.
        T.IsTrue(ui.AtlasTexel(HellfeatherQuestLogArt.NicheX(0) + 24, HellfeatherQuestLogArt.Top + HellfeatherQuestLogArt.NicheY(0) + 30) != (uint)0)
    }
}

// The quest log: opens with the L key against the left edge. The act's six
// quests have a niche each, empty until the quest is taken or something points
// to it. Clicking a quest shows what is known of it in the recess below.
HellfeatherQuestLog
{
    bool Open
    // The quest whose journal shows, or -1 before any is known.
    int Selected = -1
    -bool [6] Known
    // Known, but not yet looked at in the log.
    -bool [6] Fresh
    -bool MouseWasDown
    -int Scale = 1
    -int PanelX
    -int PanelY
    -int Hovered = -1

    Toggle() { Open = !Open }

    // Takes note of quests that have just shown up. Each is marked as new and
    // the latest is selected. Returns how many showed up.
    int Notice(HellfeatherQuests& quests)
    {
        int found = 0
        for quest : 0; quest < HellfeatherQuests.PerAct; quest++ {
            if Known[quest] || quests.State(quest) == HellfeatherQuestState.Unknown { continue }
            Known[quest] = true
            Fresh[quest] = true
            Selected = quest
            found++
        }
        return found
    }

    bool IsKnown(int quest) { return Known[quest] }

    bool IsFresh(int quest) { return Fresh[quest] }

    bool AnyFresh()
    {
        for fresh : Fresh {
            if fresh { return true }
        }
        return false
    }

    // True when the mouse is over the panel, so the world should ignore its clicks.
    bool Captures(int mouseX, int mouseY) { return OverPanel(mouseX, mouseY) }

    bool OverPanel(int mouseX, int mouseY)
    {
        if !Open { return false }
        int x = mouseX / Scale
        int y = mouseY / Scale
        return x >= PanelX && y >= PanelY && x < PanelX + HellfeatherInventoryArt.PanelWidth && y < PanelY + HellfeatherInventoryArt.PanelHeight
    }

    // Runs once per frame after the overlay is cleared.
    Update(QuaxelUi& ui, int width, int height, int mouseX, int mouseY, bool down, HellfeatherQuests& quests)
    {
        HellfeatherInventoryArt.EnsurePainted(ui)
        bool pressed = down && !MouseWasDown
        MouseWasDown = down
        Notice(quests)
        if !Open { return }
        Scale = ui.ScaleFor(width, height)
        PanelX = HellfeatherQuestLog.Margin
        PanelY = Math.Max(0, (height / Scale - HellfeatherInventoryArt.PanelHeight) / 2)
        int pointerX = mouseX / Scale - PanelX
        int pointerY = mouseY / Scale - PanelY
        if pressed && OnClose(pointerX, pointerY) {
            Open = false
            return
        }
        Hovered = NicheAt(pointerX, pointerY)
        if Hovered >= 0 && !Known[Hovered] { Hovered = -1 }
        if pressed && Hovered >= 0 { Selected = Hovered }
        if Selected >= 0 { Fresh[Selected] = false }
        Draw(ui, quests)
    }

    -bool OnClose(int pointerX, int pointerY)
    {
        return pointerX >= HellfeatherInventoryArt.CloseX && pointerY >= HellfeatherInventoryArt.CloseY && pointerX < HellfeatherInventoryArt.CloseX + HellfeatherInventoryArt.CloseSize && pointerY < HellfeatherInventoryArt.CloseY + HellfeatherInventoryArt.CloseSize
    }

    // The niche under a point on the panel, or -1.
    int NicheAt(int pointerX, int pointerY)
    {
        for quest : 0; quest < HellfeatherQuests.PerAct; quest++ {
            int x = HellfeatherQuestLogArt.NicheX(quest)
            int y = HellfeatherQuestLogArt.NicheY(quest)
            if pointerX >= x && pointerY >= y && pointerX < x + HellfeatherQuestLogArt.NicheSize && pointerY < y + HellfeatherQuestLogArt.NicheSize { return quest }
        }
        return -1
    }

    -Draw(QuaxelUi& ui, HellfeatherQuests& quests)
    {
        ui.OverlaySprite(PanelX, PanelY, 0, HellfeatherQuestLogArt.Top, HellfeatherInventoryArt.PanelWidth, HellfeatherInventoryArt.PanelHeight)
        Centered(ui, PanelY + 9, "ACT I - THE MOULT", 0xFFE8B070)
        for quest : 0; quest < HellfeatherQuests.PerAct; quest++ {
            if !Known[quest] { continue }
            int x = PanelX + HellfeatherQuestLogArt.NicheX(quest)
            int y = PanelY + HellfeatherQuestLogArt.NicheY(quest)
            bool done = quests.State(quest) == HellfeatherQuestState.Done
            ui.OverlayOutlinedSprite(x + HellfeatherQuestLogArt.IconInsetX, y + HellfeatherQuestLogArt.IconInsetY, HellfeatherQuestLogArt.IconX(quest), HellfeatherQuestLogArt.Top + (done ? HellfeatherQuestLogArt.IconStride | 0), HellfeatherQuestLogArt.IconSize, HellfeatherQuestLogArt.IconSize, HellfeatherInventoryArt.IconOutline)
            if quest == Selected { Outline(ui, x - 1, y - 1, HellfeatherQuestLogArt.NicheSize + 2, 0xFFDCAE3E) }
            else if quest == Hovered { Outline(ui, x - 1, y - 1, HellfeatherQuestLogArt.NicheSize + 2, 0xFF8C8880) }
            if Fresh[quest] { ui.OverlayText(x + HellfeatherQuestLogArt.NicheSize - 10, y + 6, "!", 0xFFFFD27A) }
        }
        int shown = Hovered >= 0 ? Hovered | Selected
        int titleY = PanelY + HellfeatherQuestLogArt.TitleY + 4
        if shown < 0 {
            Centered(ui, titleY, "No quests yet", 0xFF8C8880)
            return
        }
        Centered(ui, titleY, HellfeatherQuests.Title(shown), 0xFFE8B070)
        lines : quests.Journal(shown)
        for n : 0; n < lines.Len && n < HellfeatherQuestLogArt.LineCount; n++ {
            ui.OverlayText(PanelX + HellfeatherQuestLogArt.WellX + 5, PanelY + HellfeatherQuestLogArt.LineY((int)n), lines[n], 0xFFC8CCD4)
        }
        if quests.State(shown) == HellfeatherQuestState.Done {
            Centered(ui, PanelY + HellfeatherQuestLogArt.LineY(HellfeatherQuestLogArt.LineCount), "Completed", 0xFFDCAE3E)
        }
    }

    -Centered(QuaxelUi& ui, int y, string text, uint color)
    {
        ui.OverlayText(PanelX + (HellfeatherInventoryArt.PanelWidth - (int)Length(text) * 6) / 2, y, text, color)
    }

    // A one-pixel square ring.
    -Outline(QuaxelUi& ui, int x, int y, int size, uint color)
    {
        ui.OverlayRect(x, y, size, 1, color)
        ui.OverlayRect(x, y + size - 1, size, 1, color)
        ui.OverlayRect(x, y + 1, 1, size - 2, color)
        ui.OverlayRect(x + size - 1, y + 1, 1, size - 2, color)
    }
}
@{
    PanelScale: Scale
    PanelLeft: PanelX
    PanelTop: PanelY
}
#{
    // UI pixels between the panel and the left edge of the window.
    #int Margin = 4
}
T{
    QuestsShowUpWhenTakenOrPointedTo()
    {
        HellfeatherQuests quests
        for quest : 0; quest < HellfeatherQuests.PerAct; quest++ { T.AreEqual(quests.State(quest), HellfeatherQuestState.Unknown) }
        quests.Moult = 1
        T.AreEqual(quests.State(0), HellfeatherQuestState.Active)
        quests.Moult = 3
        T.AreEqual(quests.State(3), HellfeatherQuestState.Active)
        // Jessa's token, found in the garret, points to Moth.
        quests.Rooms = 2
        T.AreEqual(quests.State(4), HellfeatherQuestState.Active)
        T.AreEqual(quests.State(5), HellfeatherQuestState.Unknown)
        // Moth's grey ring points to the millrace door.
        quests.Dark = 3
        T.AreEqual(quests.State(4), HellfeatherQuestState.Done)
        T.AreEqual(quests.State(5), HellfeatherQuestState.Active)
        quests.Moult = 4
        T.AreEqual(quests.State(0), HellfeatherQuestState.Done)
    }

    EveryJournalFitsItsRecess()
    {
        HellfeatherQuests quests
        for stage : 0; stage <= 5; stage++ {
            quests.Moult = Math.Min(stage, 4)
            quests.Ford = Math.Min(stage, 2)
            quests.Rooms = Math.Min(stage, 4)
            quests.Seamstress = Math.Min(stage, 1)
            quests.Dark = Math.Min(stage, 3)
            quests.Millrace = stage
            quests.BearersFreed = stage
            quests.FeathersGiven = stage % 2 == 1
            quests.ReevePaid = stage % 3 == 1
            quests.DucksCleared = stage * 4
            for quest : 0; quest < HellfeatherQuests.PerAct; quest++ {
                T.IsTrue(Length(HellfeatherQuests.Title(quest)) * 6 <= HellfeatherQuestLogArt.WellWidth - 8)
                lines : quests.Journal(quest)
                T.IsTrue(lines.Len <= HellfeatherQuestLogArt.LineCount)
                for line : lines { T.IsTrue(Length(line) <= HellfeatherQuestLogArt.LineChars) }
                if quests.State(quest) != HellfeatherQuestState.Unknown { T.IsTrue(lines.Len > 0) }
            }
        }
    }

    ClosedLogDrawsNothingAndIgnoresTheMouse()
    {
        HellfeatherQuestLog log
        HellfeatherQuests quests
        QuaxelUi ui()
        log.Update(ui, 960, 540, 100, 100, true, quests)
        ui.Layout(960, 540, 0, 0, false)
        T.AreEqual(ui.CommandCount, 0)
        T.IsFalse(log.Captures(100, 100))
    }

    ANewQuestIsSelectedAndMarkedUntilSeen()
    {
        HellfeatherQuestLog log
        HellfeatherQuests quests
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        log.Update(ui, 960, 540, 0, 0, false, quests)
        T.AreEqual(log.Selected, -1)
        T.IsFalse(log.AnyFresh())
        quests.Moult = 1
        log.Update(ui, 960, 540, 0, 0, false, quests)
        T.AreEqual(log.Selected, 0)
        T.IsTrue(log.IsFresh(0))
        quests.Ford = 1
        log.Update(ui, 960, 540, 0, 0, false, quests)
        T.AreEqual(log.Selected, 1)
        log.Toggle()
        log.Update(ui, 960, 540, 0, 0, false, quests)
        T.IsFalse(log.IsFresh(1))
        T.IsTrue(log.IsFresh(0))
        T.IsTrue(log.AnyFresh())
    }

    ClickingAKnownQuestSelectsIt()
    {
        HellfeatherQuestLog log
        HellfeatherQuests quests
        quests.Moult = 1
        quests.Rooms = 1
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        log.Toggle()
        log.Update(ui, 960, 540, 0, 0, false, quests)
        T.AreEqual(log.Selected, 2)
        int s = log.PanelScale
        // The first niche, then the empty second one, which keeps the selection.
        int x = (log.PanelLeft + HellfeatherQuestLogArt.NicheX(0) + 20) * s
        int y = (log.PanelTop + HellfeatherQuestLogArt.NicheY(0) + 20) * s
        log.Update(ui, 960, 540, x, y, true, quests)
        T.AreEqual(log.Selected, 0)
        T.IsFalse(log.IsFresh(0))
        log.Update(ui, 960, 540, x, y, false, quests)
        x = (log.PanelLeft + HellfeatherQuestLogArt.NicheX(1) + 20) * s
        log.Update(ui, 960, 540, x, y, true, quests)
        T.AreEqual(log.Selected, 0)
    }

    OpenLogHugsTheLeftEdgeOnThePixelGrid()
    {
        HellfeatherQuestLog log
        HellfeatherQuests quests
        quests.Moult = 4
        quests.Ford = 1
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        log.Toggle()
        log.Update(ui, 1920, 1080, 100, 300, false, quests)
        ui.Layout(1920, 1080, 100, 300, false)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.X, HellfeatherQuestLog.Margin * 4)
        T.AreEqual(panel.Width, HellfeatherInventoryArt.PanelWidth * 4)
        T.IsTrue(ui.CommandCount > 10)
        for i : 0; i < ui.CommandCount; i++ {
            QuaxelUiCommand command = ui.GetCommand(i)
            T.AreEqual(command.X % 4, 0)
            T.AreEqual(command.Y % 4, 0)
        }
        T.IsTrue(log.Captures(40, 200))
        T.IsFalse(log.Captures(1800, 200))
    }

    TheCloseButtonClosesTheLog()
    {
        HellfeatherQuestLog log
        HellfeatherQuests quests
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        log.Toggle()
        log.Update(ui, 960, 540, 0, 0, false, quests)
        int x = (log.PanelLeft + HellfeatherInventoryArt.CloseX + 2) * log.PanelScale
        int y = (log.PanelTop + HellfeatherInventoryArt.CloseY + 2) * log.PanelScale
        log.Update(ui, 960, 540, x, y, true, quests)
        T.IsFalse(log.Open)
    }
}
