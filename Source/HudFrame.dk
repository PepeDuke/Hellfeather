// Indexed ornamental HUD artwork from Pixelový HUD s havrany a portálem.
// Empty action wells are populated by HellfeatherActionBar at draw time.
HellfeatherHudFrame
#{
    #int CrownHeight = 25
    #int CrownAtlasX = 224
    #int CrownAtlasY = 485
    #int Height = 84
    // The painting's own width, wider than the compact bar it was made for.
    #int Width = 272
    // Where the painting's key plates were, to move its mice onto the new ones.
    #int PaintedKeyY = 46

    // The frame itself is voxels now (HellfeatherHudVoxels). Only the small
    // icons are kept from this painting, at their places on the bar's sprite:
    // the panel buttons down the left and the mice on the two mouse plates.
    Paint(QuaxelUi& ui)
    {
        pixels : Decode()
        int down = HellfeatherActionArt.KeyY - PaintedKeyY
        for y : 0; y < HellfeatherActionArt.BarHeight; y++ {
            for x : 0; x < Width; x++ {
                // The top rows of the rail hold stray rivet light, not the rune icon.
                bool rail = x >= 24 && x < 40 && y >= 3 && y < 57
                bool left = y >= 45 && y < 55 && x >= 68 && x < 80
                bool right = y >= 45 && y < 55 && x >= 109 && x < 121
                if !rail && !left && !right { continue }
                int rgb = pixels[(y + CrownHeight) * Width + x]
                if !IsIcon(rgb) { continue }
                // The mice follow their plates, which moved with the compact layout.
                int toX = x
                // The painting's buttons were eleven pixels apart; the compact rail's are ten.
                int toY = y - y / 11 * (11 - HellfeatherActionArt.PanelStep)
                if left {
                    toX = x - 68 + HellfeatherActionArt.KeyX(HellfeatherActionSlot.Left)
                    toY = y + down
                }
                if right {
                    toX = x - 108 + HellfeatherActionArt.KeyX(HellfeatherActionSlot.Right)
                    toY = y + down
                }
                HellfeatherInventoryArt.Put(ui, toX, HellfeatherActionArt.BarAtlasY + toY, rgb)
            }
        }
    }

    // Pixels of the painting that are icon rather than iron: light, or clearly
    // colored. Lightness and saturation are as in HLS.
    bool IsIcon(int rgb)
    {
        if rgb < 0 { return false }
        float red = (float)((rgb >> 16) & 255) / 255.0
        float green = (float)((rgb >> 8) & 255) / 255.0
        float blue = (float)(rgb & 255) / 255.0
        float high = Math.Max(red, Math.Max(green, blue))
        float low = Math.Min(red, Math.Min(green, blue))
        float lightness = (high + low) * 0.5
        float saturation = 0.0
        if high > low { saturation = lightness <= 0.5 ? (high - low) / (high + low) | (high - low) / (2.0 - high - low) }
        return lightness > 0.4 || (saturation > 0.35 && lightness > 0.22)
    }

    // Every pixel of the artwork, row by row from the top of the crown, as RGB or
    // -1 where it is empty. The voxel frame takes its small icons from here.
    int [] Decode()
    {
        string symbols = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&()*+,-/:;<=>?"
        int [128] colors
        int [80] palette = {0x141316, 0xfffbdb, 0x6324a0, 0xdb67f3, 0x35185d, 0x6e5239, 0x4c423d, 0xb441e1, 0x2b2627, 0xa4ac91, 0x617284, 0xb57ce4, 0x4d5666, 0x4c3a2a, 0x968e86, 0xfa773a, 0x332d2d, 0xf0b9f5, 0xe7b67f, 0x09090d, 0x766a60, 0x7c6d74, 0xd5c5aa, 0x6f4383, 0x1e1b1f, 0x5d534f, 0x56412f, 0x501e88, 0xeedbb8, 0x401a73, 0x2b2e39, 0x6e8393, 0x7e29bd, 0xcc4df4, 0x8b5da5, 0x343743, 0xc658e5, 0x564d4b, 0x977c5e, 0x524844, 0x261f1d, 0x7f98ac, 0x9f896d, 0x212027, 0x4a4245, 0x434a58, 0x1a171a, 0x252730, 0xf2cd96, 0xc1f1f9, 0x3d2e23, 0x8eb1c4, 0x030307, 0xbfaf9a, 0x644a34, 0xaa9988, 0x3a404e, 0x453c3e, 0x3b3434, 0xffa763, 0x593e66, 0x645957, 0xef8ef5, 0xb49672, 0x463424, 0x33271e, 0xa6d1e4, 0x0f0e12, 0x413938, 0xb1cda2, 0xcaa77c, 0x251345, 0x100a28, 0x983ccd, 0x7d593e, 0x21150c, 0x576474, 0x040515, 0x857c6c, 0x6b6158}
