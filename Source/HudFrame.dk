        int [] pixels
        for y : 0; y < Height; y++ {
            for x : 0; x < Width; x++ {
                int symbol = (int)CodeUnitAt(rows[y], x)
                pixels += symbol == 46 ? -1 | colors[symbol]
            }
        }
        return pixels
    }
