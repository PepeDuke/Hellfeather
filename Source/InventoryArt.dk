// Paints the inventory into the sprite atlas: a wall of stone blocks and item
// icons drawn as flat pixel art. Coordinates are logical pixels.
HellfeatherInventoryArt
#{
    #int AtlasWidth = 512
    // The inventory uses the top rows, the action bar the next, then the shop
    // panel, the character panel, the passive tree, the rune board and the quest
    // log, then the personal chest at the bottom.
    #int AtlasHeight = 2048
    #int PanelWidth = 176
    #int PanelHeight = 256
    #int Cell = 16
    #int GridX = 8
    #int GridY = 160
    #int GoldX = 52
    #int GoldY = 232
    #int GoldWidth = 72
    #int GoldHeight = 16
    // The close button sits in its own socket at the right end of the title
    // band, which runs from 13 to PanelWidth - 13 and from 6 to 19, clear of
    // the corner stud.
    #int CloseX = 150
    #int CloseY = 7
    #int CloseSize = 11
    // Each cell of the coin and action art is two logical pixels wide. Item
    // pictures are drawn at twice that detail, one logical pixel per cell.
    #int VoxelPixels = 2
    #int ItemPixels = 1
    // Item pictures carry only their colors. The UI shader draws this one-pixel
    // border around them, in the clear margin each picture keeps.
    #uint IconOutline = 0xFF15110E

    int IconX(int item) { return 190 + ((item - 1) % 9) * 34 }

    int IconY(int item) { return 2 + (item - 1) / 9 * 50 }

    Put(QuaxelUi& ui, int x, int y, int rgb) { ui.SetAtlasTexel(x, y, (uint)0xFF000000 | (uint)rgb) }

    Paint(QuaxelUi& ui)
    {
        ui.ConfigureAtlas(AtlasWidth, AtlasHeight)
        PaintStone(ui, 0)
        PaintFrame(ui, 0)
        PaintWells(ui)
        PaintClose(ui, 0)
        PaintCoins(ui, GoldX + 3, GoldY + 3)
        HellfeatherShopArt.Paint(ui)
        HellfeatherStatsArt.Paint(ui)
        HellfeatherPassiveArt.Paint(ui)
        HellfeatherRuneArt.Paint(ui)
        HellfeatherQuestLogArt.Paint(ui)
        HellfeatherChestArt.Paint(ui)
        HellfeatherStatusArt.Paint(ui)
        for item : HellfeatherItems { if item != HellfeatherItems.None { PaintIcon(ui, item, IconX(item), IconY(item)) } }
        HellfeatherActionArt.Paint(ui)
        // The potions shrunk to fit a belt pocket.
        PaintPocketIcon(ui, HellfeatherItems.HealthPotion)
        PaintPocketIcon(ui, HellfeatherItems.ManaPotion)
    }

    // Belt pockets under the waist slot, PocketSize square, and where their
    // shrunken potion icons sit in the atlas, beside the number-key icons.
    #int PocketSize = 12
    #int PocketY = 146
    #int PocketAtlasX = 120
    #int PocketAtlasY = 492

    int PocketIconX(HellfeatherItems potion) { return PocketAtlasX + (potion == HellfeatherItems.ManaPotion ? PocketSize | 0) }

    -PaintPocketIcon(QuaxelUi& ui, HellfeatherItems potion)
    {
        for y : 0; y < PocketSize; y++ {
            for x : 0; x < PocketSize; x++ {
                uint pixel = ui.AtlasTexel(IconX(potion) + x * Cell / PocketSize, IconY(potion) + y * Cell / PocketSize)
                ui.SetAtlasTexel(PocketIconX(potion) + x, PocketAtlasY + y, pixel)
            }
        }
    }

    // The left edge of a pocket on the panel, centered under the waist slot.
    int PocketX(int pocket, int count) { return 88 - (count * (PocketSize + 1) - 1) / 2 + pocket * (PocketSize + 1) }

    // Paints the whole atlas the first time any screen needs it.
    EnsurePainted(QuaxelUi& ui)
    {
        if ui.AtlasWords != AtlasWidth * AtlasHeight { Paint(ui) }
    }

    // Courses of six-pixel blocks, each lit from the top left like a voxel.
    // A panel's stone background, with its top row at `top` in the atlas.
    PaintStone(QuaxelUi& ui, int top)
    {
        for y : 0; y < PanelHeight; y++ {
            int course = y / 6
            for x : 0; x < PanelWidth; x++ {
                int along = x + (course & 1) * 3
                int ex = along % 6
                int ey = y % 6
                int tone = HellfeatherArt.Shade(0x34302b, 84 + HellfeatherArt.Hash(along / 6, course, 17) % 32)
                if ex == 5 || ey == 5 { tone = HellfeatherArt.Shade(tone, 52) }
                else if ex == 0 || ey == 0 { tone = HellfeatherArt.Shade(tone, 128) }
                Put(ui, x, top + y, tone)
            }
        }
    }

    Fill(QuaxelUi& ui, int x0, int y0, int width, int height, int rgb)
    {
        for y : y0; y < y0 + height; y++ {
            for x : x0; x < x0 + width; x++ { Put(ui, x, y, rgb) }
        }
    }

    // A raised block, bright along its top and left edges.
    Raised(QuaxelUi& ui, int x, int y, int width, int height, int rgb)
    {
        Fill(ui, x, y, width, height, rgb)
        Fill(ui, x, y, width, 1, HellfeatherArt.Shade(rgb, 150))
        Fill(ui, x, y, 1, height, HellfeatherArt.Shade(rgb, 130))
        Fill(ui, x, y + height - 1, width, 1, HellfeatherArt.Shade(rgb, 50))
        Fill(ui, x + width - 1, y, 1, height, HellfeatherArt.Shade(rgb, 60))
    }

    // A panel's metal frame and title band, with its top row at `top` in the atlas.
    PaintFrame(QuaxelUi& ui, int top)
    {
        int metal = 0x4b3b2d
        for i : 0; i < PanelWidth / 8; i++ {
            Raised(ui, i * 8, top, 8, 5, HellfeatherArt.Shade(metal, 88 + HellfeatherArt.Hash(i, 1, 2) % 26))
            Raised(ui, i * 8, top + PanelHeight - 5, 8, 5, HellfeatherArt.Shade(metal, 88 + HellfeatherArt.Hash(i, 2, 2) % 26))
        }
        for i : 0; i < PanelHeight / 8; i++ {
            Raised(ui, 0, top + i * 8, 5, 8, HellfeatherArt.Shade(metal, 88 + HellfeatherArt.Hash(i, 3, 2) % 26))
            Raised(ui, PanelWidth - 5, top + i * 8, 5, 8, HellfeatherArt.Shade(metal, 88 + HellfeatherArt.Hash(i, 4, 2) % 26))
        }
        Stud(ui, 0, top)
        Stud(ui, PanelWidth - 13, top)
        Stud(ui, 0, top + PanelHeight - 13)
        Stud(ui, PanelWidth - 13, top + PanelHeight - 13)
        // The title band, closed off by a line of ember.
        Fill(ui, 13, top + 6, PanelWidth - 26, 13, 0x1a1715)
        Fill(ui, 13, top + 19, PanelWidth - 26, 1, 0x8a2f12)
        Fill(ui, 13, top + 20, PanelWidth - 26, 1, 0x3c170b)
    }

    -Stud(QuaxelUi& ui, int x, int y)
    {
        Raised(ui, x, y, 13, 13, 0x6b4f2c)
        Raised(ui, x + 3, y + 3, 7, 7, 0xa87a3a)
        Fill(ui, x + 5, y + 5, 3, 3, 0xd8a93a)
    }

    // A recess: dark along the top and left, catching light at the bottom and right.
    Well(QuaxelUi& ui, int x, int y, int width, int height)
    {
        Fill(ui, x - 1, y - 1, width + 2, height + 2, 0x0a0908)
        Fill(ui, x, y, width, height, 0x171412)
        Fill(ui, x, y, width, 1, 0x070606)
        Fill(ui, x, y, 1, height, 0x070606)
        Fill(ui, x - 1, y + height, width + 2, 1, 0x625749)
        Fill(ui, x + width, y - 1, 1, height + 2, 0x524839)
    }

    -PaintWells(QuaxelUi& ui)
    {
        for slot : HellfeatherSlot {
            int x = 0
            int y = 0
            int width = 0
            int height = 0
            HellfeatherInventoryLayout.SlotRect(slot, x, y, width, height)
            Well(ui, x, y, width, height)
        }
        Well(ui, GridX, GridY, HellfeatherInventory.Columns * Cell, HellfeatherInventory.Rows * Cell)
        for row : 0; row < HellfeatherInventory.Rows; row++ {
            for column : 0; column < HellfeatherInventory.Columns; column++ {
                int x = GridX + column * Cell
                int y = GridY + row * Cell
                Fill(ui, x, y, Cell, 1, 0x2d2823)
                Fill(ui, x, y, 1, Cell, 0x2d2823)
                Fill(ui, x + 1, y + 1, Cell - 1, Cell - 1, (column + row) % 2 == 0 ? 0x151210 | 0x181513)
            }
        }
        Well(ui, GoldX, GoldY, GoldWidth, GoldHeight)
    }

    // A recess cut into the title band, set off from the title by a groove, with
    // a raised ember-red button in it. Every panel paints the same one.
    PaintClose(QuaxelUi& ui, int top)
    {
        int bandTop = top + 6
        int bandHeight = 13
        Fill(ui, CloseX - 4, bandTop, 1, bandHeight, 0x0a0908)
        Fill(ui, CloseX - 3, bandTop, 1, bandHeight, 0x4b3b2d)
        Fill(ui, CloseX - 1, bandTop, CloseSize + 2, bandHeight, 0x0a0908)
        Fill(ui, CloseX - 1, bandTop + bandHeight - 1, CloseSize + 2, 1, 0x3c3229)
        Raised(ui, CloseX, top + CloseY, CloseSize, CloseSize, 0x6b1c12)
        for i : 2; i < CloseSize - 2; i++ {
            Put(ui, CloseX + i, top + CloseY + i, 0xe8c9a0)
            Put(ui, CloseX + CloseSize - 1 - i, top + CloseY + i, 0xe8c9a0)
        }
    }

    PaintCoins(QuaxelUi& ui, int x, int y)
    {
        V(ui, x, y, 0, "..kkkk..")
        V(ui, x, y, 1, ".kgggGk.")
        V(ui, x, y, 2, "kggGggGk")
        V(ui, x, y, 3, "kgGggGGk")
        V(ui, x, y, 4, ".kgGGGk.")
        V(ui, x, y, 5, "..kkkk..")
    }

    // One row of art. Each cell is a flat square of its color, so the drawing reads
    // as clean pixel art; the shading lives in the drawing itself.
    V(QuaxelUi& ui, int x, int y, int row, string text) { Cells(ui, x, y, row, text, VoxelPixels) }

    // One row of art with cells of the given size in logical pixels.
    Cells(QuaxelUi& ui, int x, int y, int row, string text, int size)
    {
        for i : (long)0; i < Length(text); i++ {
            int rgb = HellfeatherItemArt.ColorOf((int)CodeUnitAt(text, i))
            if rgb < 0 { continue }
            Fill(ui, x + (int)i * size, y + row * size, size, size, rgb)
        }
    }

    // Paints an item's picture at one logical pixel per cell.
    Picture(QuaxelUi& ui, HellfeatherItems item, int x, int y)
    {
        HellfeatherItemPicture picture
        HellfeatherItemArt.Picture(item, picture)
        for row : 0; row < picture.Rows.Len; row++ { Cells(ui, x, y, row, picture.Rows[row], ItemPixels) }
    }

    -PaintIcon(QuaxelUi& ui, HellfeatherItems item, int x, int y) { Picture(ui, item, x, y) }
}

// Where things sit on the panel, in logical pixels. The arrangement is weapon and
// shield on the sides, head and body up the middle, smaller pieces along the bottom.
HellfeatherInventoryLayout
#{
    SlotRect(int slot, int& x, int& y, int& width, int& height)
    {
        x = 0
        y = 0
        width = 0
        height = 0
        if slot == HellfeatherSlot.MainHand { Set(10, 30, 36, 72, x, y, width, height) }
        if slot == HellfeatherSlot.OffHand { Set(130, 30, 36, 72, x, y, width, height) }
        if slot == HellfeatherSlot.Head { Set(70, 24, 36, 36, x, y, width, height) }
        if slot == HellfeatherSlot.Neck { Set(110, 32, 18, 18, x, y, width, height) }
        if slot == HellfeatherSlot.Body { Set(70, 64, 36, 52, x, y, width, height) }
        if slot == HellfeatherSlot.Hands { Set(10, 112, 36, 36, x, y, width, height) }
        if slot == HellfeatherSlot.LeftRing { Set(50, 126, 18, 18, x, y, width, height) }
        if slot == HellfeatherSlot.Waist { Set(70, 126, 36, 18, x, y, width, height) }
        if slot == HellfeatherSlot.RightRing { Set(108, 126, 18, 18, x, y, width, height) }
        if slot == HellfeatherSlot.Feet { Set(130, 112, 36, 36, x, y, width, height) }
    }

    -Set(int a, int b, int c, int d, int& x, int& y, int& width, int& height)
    {
        x = a
        y = b
        width = c
        height = d
    }

    // The equipment slot under a logical point, or -1.
    int SlotAt(int px, int py)
    {
        for slot : HellfeatherSlot {
            int x = 0
            int y = 0
            int width = 0
            int height = 0
            SlotRect(slot, x, y, width, height)
            if px >= x && py >= y && px < x + width && py < y + height { return slot }
        }
        return -1
    }
}
T{
    SlotsDoNotOverlapAndStayOnThePanel()
    {
        for a : HellfeatherSlot {
            int ax = 0
            int ay = 0
            int aw = 0
            int ah = 0
            HellfeatherInventoryLayout.SlotRect(a, ax, ay, aw, ah)
            T.IsTrue(aw > 0 && ah > 0)
            T.IsTrue(ax + aw <= HellfeatherInventoryArt.PanelWidth - 5)
            T.IsTrue(ay + ah <= HellfeatherInventoryArt.GridY)
            T.AreEqual(HellfeatherInventoryLayout.SlotAt(ax + 1, ay + 1), a)
        }
    }

    SlotsAreLargeEnoughForTheirGear()
    {
        int [10] cellsWide = {2, 1, 2, 2, 2, 2, 1, 2, 1, 2}
        int [10] cellsTall = {2, 1, 3, 3, 2, 2, 1, 1, 1, 2}
        for slot : HellfeatherSlot {
            int x = 0
            int y = 0
            int width = 0
            int height = 0
            HellfeatherInventoryLayout.SlotRect(slot, x, y, width, height)
            T.IsTrue(width >= cellsWide[slot] * HellfeatherInventoryArt.Cell)
            T.IsTrue(height >= cellsTall[slot] * HellfeatherInventoryArt.Cell)
        }
    }
}

// The window itself: opens with the I key against the right edge, draws over the
// world and takes clicks. All its coordinates are on the UI pixel grid.
HellfeatherInventoryScreen
{
    HellfeatherInventory Items
    bool Open
    // While a shop is open, item tooltips say what a merchant pays for them.
    bool Trading
    // Set by the game: whether the open shop pays gold, and whether Shift is
    // held. Together a click on an item it buys sells it at once.
    bool CanSell
    bool ShiftHeld
    // Set when such a click has put the item on the cursor to be sold; the
    // game sells it and clears this.
    bool QuickSellRequest
    // Set by the game while her chest is open: a Shift-click stores an item
    // there instead. The click lifts it and sets QuickStoreRequest; the game stores it.
    bool CanStore
    bool QuickStoreRequest
    // Set by the game: whether the open shop takes black feathers.
    bool BuysFeathers
    // Set by the game each frame: whether the right mouse button is down.
    // Held over an unidentified find, it fills the identify bar.
    bool RightDown
    // Set when a find has just been identified; the game plays its sound and clears this.
    bool IdentifiedRequest
    // Game seconds since the last Update, added up by Tick.
    -float Pending
    // The find being identified, as a target (see TargetAt), and how long the
    // button has been held on it.
    -int Identifying = -1
    -float IdentifyHeld
    // The find just identified, as a target, and how long ago, for the reveal.
    -int Revealing = -1
    -float RevealSeconds
    -long RevealBagSize
    -bool MouseWasDown
    -int Scale = 1
    -int PanelX
    -int PanelY

    Toggle()
    {
        Open = !Open
        if !Open { Items.StowHeld() }
    }

    // Game time passing, for the identify bar and the reveal.
    Tick(float deltaSeconds) { Pending += deltaSeconds }

    // The bag entry under the pointer as itself, a worn slot as -2 - slot,
    // or -1 for nothing.
    -int TargetAt(int pointerX, int pointerY)
    {
        if Items.Held != HellfeatherItems.None { return -1 }
        int slot = HellfeatherInventoryLayout.SlotAt(pointerX, pointerY)
        if slot >= 0 { return Items.Equipped[slot] == HellfeatherItems.None ? -1 | -2 - slot }
        if !InGrid(pointerX, pointerY) { return -1 }
        return Items.EntryAt((pointerX - HellfeatherInventoryArt.GridX) / HellfeatherInventoryArt.Cell, (pointerY - HellfeatherInventoryArt.GridY) / HellfeatherInventoryArt.Cell)
    }

    -bool TargetUnidentified(int target)
    {
        if target >= 0 { return target < Items.Bag.Len && Items.Bag[target].Mods.Unidentified }
        if target <= -2 { return Items.EquippedMods[-2 - target].Unidentified }
        return false
    }

    -Identify(int target)
    {
        if target >= 0 { Items.Bag[target].Mods.Unidentified = false }
        else if target <= -2 { Items.EquippedMods[-2 - target].Unidentified = false }
    }

    // Fills the bar while the right button is held over an unidentified find,
    // and identifies it once full. Letting go or moving off empties the bar.
    StepIdentify(int pointerX, int pointerY, float seconds)
    {
        if Revealing != -1 {
            RevealSeconds += seconds
            // Items moving in the bag would shift the reveal onto another one.
            if RevealSeconds > HellfeatherInventoryScreen.RevealLength || Items.Bag.Len != RevealBagSize { Revealing = -1 }
        }
        int target = RightDown ? TargetAt(pointerX, pointerY) | -1
        if target == -1 || !TargetUnidentified(target) {
            Identifying = -1
            IdentifyHeld = 0.0
            return
        }
        if target != Identifying {
            Identifying = target
            IdentifyHeld = 0.0
        }
        IdentifyHeld += seconds
        if IdentifyHeld < HellfeatherInventoryScreen.IdentifySeconds { return }
        Identify(target)
        Identifying = -1
        IdentifyHeld = 0.0
        Revealing = target
        RevealSeconds = 0.0
        RevealBagSize = Items.Bag.Len
        IdentifiedRequest = true
    }

    // How full the identify bar is for a target, 0 to 1.
    float IdentifyShare(int target)
    {
        if target != Identifying || target == -1 { return 0.0 }
        return Math.Clamp(IdentifyHeld / HellfeatherInventoryScreen.IdentifySeconds, 0.0, 1.0)
    }

    // How far into its reveal a target is in seconds, or -1 when it is not revealing.
    float RevealAge(int target)
    {
        if target != Revealing || target == -1 { return -1.0 }
        return RevealSeconds
    }

    // The warrior's starting kit: her hand axe, her Leather Armor and Miner's Helmet,
    // all plain, one raven portal home, two health potions and a mana potion.
    // Her Cleave rune starts on the rune board.
    Stock()
    {
        Items.Portals = 1
        Items.Add(HellfeatherItems.HealthPotion)
        Items.Add(HellfeatherItems.HealthPotion)
        Items.Add(HellfeatherItems.ManaPotion)
        Items.Equipped[HellfeatherSlot.MainHand] = HellfeatherItems.HandAxe
        Items.Equipped[HellfeatherSlot.Body] = HellfeatherItems.LeatherArmor
        Items.Equipped[HellfeatherSlot.Head] = HellfeatherItems.MinersHelmet
        for slot : HellfeatherSlot { Items.EquippedMods[slot].Clear() }
    }

    // True when the mouse is over the panel or carrying an item, so the world
    // should ignore its clicks.
    bool Captures(int mouseX, int mouseY)
    {
        if !Open { return false }
        return Items.Held != HellfeatherItems.None || OverPanel(mouseX, mouseY)
    }

    bool OverPanel(int mouseX, int mouseY)
    {
        if !Open { return false }
        int x = mouseX / Scale
        int y = mouseY / Scale
        return x >= PanelX && y >= PanelY && x < PanelX + HellfeatherInventoryArt.PanelWidth && y < PanelY + HellfeatherInventoryArt.PanelHeight
    }

    // Runs once per frame. Takes this frame's mouse and draws over whatever the
    // overlay already holds, so the game clears the overlay first.
    Update(QuaxelUi& ui, int width, int height, int mouseX, int mouseY, bool down)
    {
        HellfeatherInventoryArt.EnsurePainted(ui)
        bool pressed = down && !MouseWasDown
        MouseWasDown = down
        float seconds = Pending
        Pending = 0.0
        if !Open {
            Identifying = -1
            IdentifyHeld = 0.0
            return
        }
        Scale = ui.ScaleFor(width, height)
        PanelX = Math.Max(0, width / Scale - HellfeatherInventoryArt.PanelWidth - Margin)
        PanelY = Math.Max(0, (height / Scale - HellfeatherInventoryArt.PanelHeight) / 2)
        int gridMouseX = mouseX / Scale
        int gridMouseY = mouseY / Scale
        int pointerX = gridMouseX - PanelX
        int pointerY = gridMouseY - PanelY
        if pressed {
            Revealing = -1
            Click(pointerX, pointerY)
        }
        StepIdentify(pointerX, pointerY, seconds)
        if Open { Draw(ui, gridMouseX, gridMouseY, pointerX, pointerY) }
    }

    -int HeldCellX(int pointerX)
    {
        HellfeatherItemKind kind = HellfeatherItems.Get(Items.Held)
        return QuaxelNoise.FloorDiv(pointerX - HellfeatherInventoryArt.GridX - (kind.Width - 1) * HellfeatherInventoryArt.Cell / 2, HellfeatherInventoryArt.Cell)
    }

    -int HeldCellY(int pointerY)
    {
        HellfeatherItemKind kind = HellfeatherItems.Get(Items.Held)
        return QuaxelNoise.FloorDiv(pointerY - HellfeatherInventoryArt.GridY - (kind.Height - 1) * HellfeatherInventoryArt.Cell / 2, HellfeatherInventoryArt.Cell)
    }

    -bool InGrid(int pointerX, int pointerY)
    {
        return pointerX >= HellfeatherInventoryArt.GridX && pointerY >= HellfeatherInventoryArt.GridY && pointerX < HellfeatherInventoryArt.GridX + HellfeatherInventory.Columns * HellfeatherInventoryArt.Cell && pointerY < HellfeatherInventoryArt.GridY + HellfeatherInventory.Rows * HellfeatherInventoryArt.Cell
    }

    -bool OnClose(int pointerX, int pointerY)
    {
        return pointerX >= HellfeatherInventoryArt.CloseX && pointerY >= HellfeatherInventoryArt.CloseY && pointerX < HellfeatherInventoryArt.CloseX + HellfeatherInventoryArt.CloseSize && pointerY < HellfeatherInventoryArt.CloseY + HellfeatherInventoryArt.CloseSize
    }

    // The belt pocket under a panel point, or -1.
    -int PocketAt(int pointerX, int pointerY)
    {
        int count = Items.BeltSlots()
        if pointerY < HellfeatherInventoryArt.PocketY || pointerY >= HellfeatherInventoryArt.PocketY + HellfeatherInventoryArt.PocketSize { return -1 }
        for pocket : 0; pocket < count; pocket++ {
            int x = HellfeatherInventoryArt.PocketX(pocket, count)
            if pointerX >= x && pointerX < x + HellfeatherInventoryArt.PocketSize { return pocket }
        }
        return -1
    }

    -Click(int pointerX, int pointerY)
    {
        if OnClose(pointerX, pointerY) {
            Toggle()
            return
        }
        int pocket = PocketAt(pointerX, pointerY)
        if pocket >= 0 {
            Items.ClickPocket(pocket)
            return
        }
        int slot = HellfeatherInventoryLayout.SlotAt(pointerX, pointerY)
        if slot >= 0 {
            Items.ClickSlot((HellfeatherSlot)slot)
            return
        }
        if !InGrid(pointerX, pointerY) { return }
        if Items.Held != HellfeatherItems.None {
            Items.Drop(HeldCellX(pointerX), HeldCellY(pointerY))
            return
        }
        int cellX = (pointerX - HellfeatherInventoryArt.GridX) / HellfeatherInventoryArt.Cell
        int cellY = (pointerY - HellfeatherInventoryArt.GridY) / HellfeatherInventoryArt.Cell
        // Shift-click while trading sells what the merchant will buy, without
        // carrying it over. Anything else is picked up as usual.
        int entry = Items.EntryAt(cellX, cellY)
        bool quick = CanSell && ShiftHeld && entry >= 0 && (HellfeatherShop.Buys(Items.Bag[entry].Item) || (BuysFeathers && Items.Bag[entry].Item == HellfeatherItems.BlackFeather))
        bool store = CanStore && ShiftHeld && entry >= 0
        bool lifted = Items.PickUp(cellX, cellY)
        if lifted && quick { QuickSellRequest = true }
        if lifted && store { QuickStoreRequest = true }
    }

    -Icon(QuaxelUi& ui, HellfeatherItems item, int x, int y)
    {
        HellfeatherItemKind kind = HellfeatherItems.Get(item)
        ui.OverlayOutlinedSprite(x, y, HellfeatherInventoryArt.IconX(item), HellfeatherInventoryArt.IconY(item), kind.Width * HellfeatherInventoryArt.Cell, kind.Height * HellfeatherInventoryArt.Cell, HellfeatherInventoryArt.IconOutline)
    }

    // From panel coordinates to the UI pixel grid.
    -int OnGridX(int x) { return PanelX + x }

    -int OnGridY(int y) { return PanelY + y }

    -Highlight(QuaxelUi& ui, int x, int y, int width, int height, uint color)
    {
        ui.OverlayRect(OnGridX(x), OnGridY(y), width, height, color)
    }

    // Mouse values are on the UI pixel grid, and pointer values relative to the panel.
    -Draw(QuaxelUi& ui, int mouseX, int mouseY, int pointerX, int pointerY)
    {
        ui.OverlaySprite(PanelX, PanelY, 0, 0, HellfeatherInventoryArt.PanelWidth, HellfeatherInventoryArt.PanelHeight)
        string title = "INVENTORY"
        ui.OverlayText(OnGridX((HellfeatherInventoryArt.PanelWidth - (int)Length(title) * 6) / 2), OnGridY(9), title, 0xFFE8B070)
        for slot : HellfeatherSlot { DrawSlot(ui, slot, pointerX, pointerY) }
        DrawPockets(ui, pointerX, pointerY)
        DrawBag(ui, pointerX, pointerY)
        string gold = QuaxelUi.FormatInt(Items.Gold)
        ui.OverlayText(OnGridX(HellfeatherInventoryArt.GoldX + HellfeatherInventoryArt.GoldWidth - 4 - (int)Length(gold) * 6), OnGridY(HellfeatherInventoryArt.GoldY + 5), gold, 0xFFDCAE3E)
        DrawTooltip(ui, mouseX, mouseY, pointerX, pointerY)
        if Items.Held != HellfeatherItems.None {
            HellfeatherItemKind kind = HellfeatherItems.Get(Items.Held)
            int heldX = mouseX - kind.Width * HellfeatherInventoryArt.Cell / 2
            int heldY = mouseY - kind.Height * HellfeatherInventoryArt.Cell / 2
            Icon(ui, Items.Held, heldX, heldY)
            if HellfeatherItems.StackMost(Items.Held) > 1 { StackCount(ui, Items.HeldMods.Amount(), heldX, heldY) }
        }
    }

    // The belt's pockets: a dark well each, its potion small inside, lit
    // under the pointer and glowing where a held potion could go.
    -DrawPockets(QuaxelUi& ui, int pointerX, int pointerY)
    {
        int count = Items.BeltSlots()
        int hovered = PocketAt(pointerX, pointerY)
        int size = HellfeatherInventoryArt.PocketSize
        bool potionHeld = HellfeatherItems.IsPotion(Items.Held)
        for pocket : 0; pocket < count; pocket++ {
            int x = HellfeatherInventoryArt.PocketX(pocket, count)
            int y = HellfeatherInventoryArt.PocketY
            Highlight(ui, x - 1, y - 1, size + 2, size + 2, 0xFF625749)
            Highlight(ui, x, y, size, size, 0xFF14110E)
            potion : Items.BeltPotion(pocket)
            if potion != HellfeatherItems.None { ui.OverlaySprite(OnGridX(x), OnGridY(y), HellfeatherInventoryArt.PocketIconX(potion), HellfeatherInventoryArt.PocketAtlasY, size, size) }
            if pocket == hovered { Highlight(ui, x, y, size, size, potionHeld || Items.Held == HellfeatherItems.None ? 0x40FFFFFF | 0x50C04030) }
            else if potionHeld { Highlight(ui, x, y, size, size, 0x30E8B070) }
        }
    }

    -DrawSlot(QuaxelUi& ui, HellfeatherSlot slot, int pointerX, int pointerY)
    {
        int x = 0
        int y = 0
        int slotWidth = 0
        int slotHeight = 0
        HellfeatherInventoryLayout.SlotRect(slot, x, y, slotWidth, slotHeight)
        bool hovered = HellfeatherInventoryLayout.SlotAt(pointerX, pointerY) == slot
        if hovered && Items.Held != HellfeatherItems.None {
            Highlight(ui, x, y, slotWidth, slotHeight, Items.Accepts(slot, Items.Held) ? 0x5040C060 | 0x50C04030)
        } else if hovered {
            Highlight(ui, x, y, slotWidth, slotHeight, 0x30FFFFFF)
        } else if Items.Held != HellfeatherItems.None && Items.Accepts(slot, Items.Held) {
            // The slot the held item would go in glows softly, with a brighter rim.
            Highlight(ui, x, y, slotWidth, slotHeight, 0x22E8B070)
            Highlight(ui, x, y, slotWidth, 1, 0x90E8B070)
            Highlight(ui, x, y + slotHeight - 1, slotWidth, 1, 0x90E8B070)
            Highlight(ui, x, y + 1, 1, slotHeight - 2, 0x90E8B070)
            Highlight(ui, x + slotWidth - 1, y + 1, 1, slotHeight - 2, 0x90E8B070)
        }
        item : Items.Equipped[slot]
        if item == HellfeatherItems.None { return }
        HellfeatherItemKind kind = HellfeatherItems.Get(item)
        int iconX = x + (slotWidth - kind.Width * HellfeatherInventoryArt.Cell) / 2
        int iconY = y + (slotHeight - kind.Height * HellfeatherInventoryArt.Cell) / 2
        Icon(ui, item, OnGridX(iconX), OnGridY(iconY))
    }

    -DrawBag(QuaxelUi& ui, int pointerX, int pointerY)
    {
        int cell = HellfeatherInventoryArt.Cell
        int gridX = HellfeatherInventoryArt.GridX
        int gridY = HellfeatherInventoryArt.GridY
        if Items.Held != HellfeatherItems.None && InGrid(pointerX, pointerY) {
            HellfeatherItemKind held = HellfeatherItems.Get(Items.Held)
            int x = HeldCellX(pointerX)
            int y = HeldCellY(pointerY)
            Highlight(ui, gridX + x * cell, gridY + y * cell, held.Width * cell, held.Height * cell, Items.CanDrop(x, y) ? 0x5040C060 | 0x50C04030)
        }
        for i : 0; i < Items.Bag.Len; i++ {
            item : Items.Bag[i].Item
            int x = gridX + Items.Bag[i].X * cell
            int y = gridY + Items.Bag[i].Y * cell
            HellfeatherItemKind kind = HellfeatherItems.Get(item)
            bool hovered = Items.Held == HellfeatherItems.None && InGrid(pointerX, pointerY) && Items.EntryAt((pointerX - gridX) / cell, (pointerY - gridY) / cell) == i
            // A soft tint marks which cells an item fills.
            Highlight(ui, x + 1, y + 1, kind.Width * cell - 1, kind.Height * cell - 1, hovered ? 0x40FFFFFF | HellfeatherItemMods.CellTint(item, Items.Bag[i].Mods.Rarity))
            Icon(ui, item, OnGridX(x), OnGridY(y))
            if HellfeatherItems.StackMost(item) > 1 { StackCount(ui, Items.Bag[i].Mods.Amount(), OnGridX(x), OnGridY(y)) }
            uint rarityColor = HellfeatherItemMods.ColorOf(Items.Bag[i].Mods.Rarity)
            // An unidentified find carries a question mark, and fills with light while identified.
            if Items.Bag[i].Mods.Unidentified {
                ui.OverlayText(OnGridX(x) + 2, OnGridY(y) + 1, "?", rarityColor)
                float share = IdentifyShare(i)
                if share > 0.0 {
                    int filled = (int)((float)(kind.Height * cell - 2) * share)
                    Highlight(ui, x + 1, y + kind.Height * cell - 1 - filled, kind.Width * cell - 1, filled, HellfeatherInventoryScreen.Glow(rarityColor, 0.35))
                }
            }
            float age = RevealAge(i)
            if age >= 0.0 { Highlight(ui, x + 1, y + 1, kind.Width * cell - 1, kind.Height * cell - 1, HellfeatherInventoryScreen.Glow(rarityColor, HellfeatherInventoryScreen.RevealFade(age) * 0.5)) }
        }
    }

    // How many a stack holds, small in the bottom right of its cell.
    -StackCount(QuaxelUi& ui, int amount, int x, int y)
    {
        string count = QuaxelUi.FormatInt(amount)
        int cell = HellfeatherInventoryArt.Cell
        ui.OverlayText(x + cell - (int)Length(count) * 6, y + cell - 8, count, 0xFFF0E6D2)
    }

    -DrawTooltip(QuaxelUi& ui, int mouseX, int mouseY, int pointerX, int pointerY)
    {
        if Items.Held != HellfeatherItems.None { return }
        int pocket = PocketAt(pointerX, pointerY)
        if pocket >= 0 {
            potion : Items.BeltPotion(pocket)
            HellfeatherItemKind inside = HellfeatherItems.Get(potion)
            string first = potion == HellfeatherItems.None ? "Empty pocket" | inside.Name
            string second = potion == HellfeatherItems.None ? "Drop a potion here" | "In your belt"
            int wide = (int)Math.Max(Length(first), Length(second)) * 6 + 12
            int px = Math.Max(2, mouseX - wide - 6)
            int py = Math.Max(2, mouseY - 29)
            ui.OverlayRect(px - 1, py - 1, wide + 2, 28, 0xFF625749)
            ui.OverlayRect(px, py, wide, 26, 0xF0120F0D)
            ui.OverlayText(px + 6, py + 4, first, 0xFFEDE6D8)
            ui.OverlayText(px + 6, py + 15, second, 0xFF8C8880)
            return
        }
        item : HellfeatherItems.None
        HellfeatherItemMods mods
        mods.Clear()
        int target = TargetAt(pointerX, pointerY)
        int slot = HellfeatherInventoryLayout.SlotAt(pointerX, pointerY)
        if slot >= 0 {
            item = Items.Equipped[slot]
            mods = Items.EquippedMods[slot]
        }
        else if InGrid(pointerX, pointerY) {
            int entry = Items.EntryAt((pointerX - HellfeatherInventoryArt.GridX) / HellfeatherInventoryArt.Cell, (pointerY - HellfeatherInventoryArt.GridY) / HellfeatherInventoryArt.Cell)
            if entry >= 0 {
                item = Items.Bag[entry].Item
                mods = Items.Bag[entry].Mods
            }
        }
        if item == HellfeatherItems.None { return }
        HellfeatherItemKind kind = HellfeatherItems.Get(item)
        // A stack says how full it is, out of how many a cell holds.
        int most = HellfeatherItems.StackMost(item)
        if most > 1 {
            kind.Name = QuaxelUi.FormatInt(mods.Amount()) + " " + kind.Name + (mods.Amount() == 1 ? "" | "s")
            kind.Detail = "Stack " + QuaxelUi.FormatInt(mods.Amount()) + " of " + QuaxelUi.FormatInt(most) + ". " + kind.Detail
        }
        // A belt says how many pockets it opens and what it carries.
        int pockets = HellfeatherItems.BeltPockets(item)
        if pockets > 0 {
            kind.Detail = kind.Detail + ", " + QuaxelUi.FormatInt(pockets) + " pockets"
            if mods.PotionCount() > 0 { kind.Detail = kind.Detail + " (" + QuaxelUi.FormatInt(mods.PotionCount()) + " full)" }
        }
        // The name in its rarity's color, the base stat, then one line per mod.
        // An unidentified find hides its mods behind a hint and the identify bar;
        // one just identified shows them one after another.
        bool hidden = mods.Unidentified
        float age = RevealAge(target)
        string hint = "Hold right click to identify"
        int modLines = hidden ? 2 | mods.Count
        int barHeight = hidden ? 6 | 0
        int characters = (int)Math.Max(Length(kind.Name), Length(kind.Detail))
        for i : 0; i < mods.Count; i++ { characters = Math.Max(characters, (int)Length(mods.Line(i))) }
        if hidden { characters = Math.Max(characters, (int)Length(hint)) }
        string price = Trading ? "Sells for " + QuaxelUi.FormatInt(HellfeatherShop.SellValue(item, mods)) + " gold" | ""
        if Trading && !HellfeatherShop.Buys(item) && !(BuysFeathers && item == HellfeatherItems.BlackFeather) { price = "Merchants don't buy these" }
        if Trading && HellfeatherItems.IsQuest(item) { price = "Not for sale" }
        // A quest item or a valuable says so under its name.
        bool quest = HellfeatherItems.IsQuest(item)
        bool valuable = HellfeatherItems.IsValuable(item)
        int below = quest || valuable ? 11 | 0
        characters = Math.Max(characters, (int)Length(price))
        int boxWidth = characters * 6 + 12
        int boxHeight = 26 + below + modLines * 11 + barHeight + (Trading ? 13 | 0)
        // Toward the middle of the window, away from the edge the panel sits on.
        int x = Math.Max(2, mouseX - boxWidth - 6)
        int y = Math.Max(2, mouseY - boxHeight - 3)
        uint rarityColor = HellfeatherItemMods.ColorOf(mods.Rarity)
        // A halo in the rarity's color: rising while identifying, bright at the
        // reveal and fading as the last mod settles.
        float halo = 0.0
        if hidden { halo = IdentifyShare(target) * 0.6 }
        else if age >= 0.0 { halo = HellfeatherInventoryScreen.RevealFade(age) }
        if halo > 0.0 {
            for ring : 1; ring <= 4; ring++ { ui.OverlayRect(x - 1 - ring, y - 1 - ring, boxWidth + 2 + ring * 2, boxHeight + 2 + ring * 2, HellfeatherInventoryScreen.Glow(rarityColor, halo * (0.5 - (float)ring * 0.1))) }
        }
        ui.OverlayRect(x - 1, y - 1, boxWidth + 2, boxHeight + 2, halo > 0.0 ? rarityColor | 0xFF625749)
        ui.OverlayRect(x, y, boxWidth, boxHeight, 0xF0120F0D)
        ui.OverlayText(x + 6, y + 4, kind.Name, HellfeatherItemMods.NameColor(item, mods.Rarity))
        if quest { ui.OverlayText(x + 6, y + 15, "Quest item", HellfeatherItemMods.QuestColor) }
        if valuable { ui.OverlayText(x + 6, y + 15, "Valuable", HellfeatherItemMods.ValuableColor) }
        ui.OverlayText(x + 6, y + 15 + below, kind.Detail, 0xFFC8CCD4)
        int modsY = y + 26 + below
        if hidden {
            ui.OverlayText(x + 6, modsY, "Unidentified", rarityColor)
            ui.OverlayText(x + 6, modsY + 11, hint, 0xFF8C8880)
            int barWidth = boxWidth - 12
            ui.OverlayRect(x + 6, modsY + 22, barWidth, 4, 0xFF2A241E)
            int filled = (int)((float)barWidth * IdentifyShare(target))
            if filled > 0 { ui.OverlayRect(x + 6, modsY + 22, filled, 4, rarityColor) }
        }
        else {
            for i : 0; i < mods.Count; i++ {
                // During a reveal each mod arrives in turn with a flash behind it.
                float since = age >= 0.0 ? age - (float)i * HellfeatherInventoryScreen.RevealStep | 1.0
                if since < 0.0 { continue }
                if since < 0.5 { ui.OverlayRect(x + 3, modsY + i * 11 - 1, boxWidth - 6, 10, HellfeatherInventoryScreen.Glow(rarityColor, (0.5 - since) * 0.9)) }
                ui.OverlayText(x + 6, modsY + i * 11, mods.Line(i), since < 0.2 ? 0xFFFFF6DC | 0xFF8FB4FF)
            }
        }
        if Trading {
            int priceY = modsY + modLines * 11 + barHeight
            ui.OverlayRect(x + 4, priceY, boxWidth - 8, 1, 0xFF3A3128)
            ui.OverlayText(x + 6, priceY + 3, price, 0xFFDCAE3E)
        }
    }
}
@{
    PanelScale: Scale
    PanelLeft: PanelX
    PanelTop: PanelY
}
#{
    // UI pixels between the panel and the right edge of the window.
    #int Margin = 4
    // Seconds the right button is held to identify a find, then the gap
    // between its mods appearing, and how long the whole reveal glows.
    #float IdentifySeconds = 1.0
    #float RevealStep = 0.35
    #float RevealLength = 3.0

    // A color at a share of full opacity.
    uint Glow(uint color, float share)
    {
        int alpha = (int)(Math.Clamp(share, 0.0, 1.0) * 255.0)
        return (uint)(alpha << 24) | (color & (uint)0x00FFFFFF)
    }

    // How bright the reveal's glow is, at its age in seconds.
    float RevealFade(float age) { return Math.Clamp(1.0 - age / RevealLength, 0.0, 1.0) }
}
T{
    ClosedInventoryDrawsNothingAndIgnoresTheMouse()
    {
        HellfeatherInventoryScreen screen
        QuaxelUi ui()
        screen.Update(ui, 960, 540, 100, 100, true)
        ui.Layout(960, 540, 0, 0, false)
        T.AreEqual(ui.CommandCount, 0)
        T.IsFalse(screen.Captures(100, 100))
    }

    OpenPanelHugsTheRightEdgeAndFitsTheWindow()
    {
        HellfeatherInventoryScreen screen
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        screen.Toggle()
        screen.Update(ui, 960, 540, 0, 0, false)
        ui.Layout(960, 540, 0, 0, false)
        QuaxelUiCommand panel = ui.GetCommand(0)
        T.AreEqual(panel.X + panel.Width, 960 - 8)
        T.AreEqual(panel.Width, 352)
        T.IsTrue(panel.Y >= 0 && panel.Y + panel.Height <= 540)
        T.AreEqual(panel.Cell, -2)
        T.IsTrue(screen.Captures(800, 100))
        T.IsFalse(screen.Captures(20, 100))
    }

    EveryInventoryPixelMatchesTheFontPixel()
    {
        HellfeatherInventoryScreen screen
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        screen.Stock()
        screen.Toggle()
        screen.Items.Held = HellfeatherItems.Ring
        // The mouse is over the bag, which also draws the drop highlight.
        screen.Update(ui, 1920, 1080, 1500, 800, false)
        ui.Layout(1920, 1080, 1500, 800, false)
        T.IsTrue(ui.CommandCount > 10)
        for i : 0; i < ui.CommandCount; i++ {
            QuaxelUiCommand command = ui.GetCommand(i)
            T.IsTrue(command.Cell == 0 || command.Cell == 4 || command.Cell == -4)
            T.AreEqual(command.X % 4, 0)
            T.AreEqual(command.Y % 4, 0)
        }
    }

    HoldingTheRightButtonIdentifiesAFindAndHidesItsModsUntilThen()
    {
        HellfeatherInventoryScreen screen
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        mods : HellfeatherItemMods.RollAs(HellfeatherItems.Boots, HellfeatherRarity.Rare, 3)
        mods.Unidentified = true
        T.IsTrue(screen.Items.AddWith(HellfeatherItems.Boots, mods))
        // Hidden mods add nothing to her stats.
        HellfeatherStats stats
        HellfeatherStats before = stats
        screen.Items.Bag[0].Mods.ApplyTo(stats)
        T.AreEqual(stats.MoveSpeed, before.MoveSpeed)
        T.AreEqual(stats.MaxHealth, before.MaxHealth)
        screen.Toggle()
        screen.Update(ui, 960, 540, 0, 0, false)
        int mouseX = (screen.PanelLeft + HellfeatherInventoryArt.GridX + 2) * screen.PanelScale
        int mouseY = (screen.PanelTop + HellfeatherInventoryArt.GridY + 2) * screen.PanelScale
        // Letting go part way empties the bar again.
        screen.RightDown = true
        screen.Tick(0.6)
        screen.Update(ui, 960, 540, mouseX, mouseY, false)
        screen.RightDown = false
        screen.Tick(0.1)
        screen.Update(ui, 960, 540, mouseX, mouseY, false)
        screen.RightDown = true
        screen.Tick(0.6)
        screen.Update(ui, 960, 540, mouseX, mouseY, false)
        T.IsTrue(screen.Items.Bag[0].Mods.Unidentified)
        T.IsFalse(screen.IdentifiedRequest)
        screen.Tick(0.5)
        screen.Update(ui, 960, 540, mouseX, mouseY, false)
        T.IsFalse(screen.Items.Bag[0].Mods.Unidentified)
        T.IsTrue(screen.IdentifiedRequest)
        T.AreEqual(screen.Items.Bag[0].Mods.Count, mods.Count)
        // The reveal draws while the mods come in.
        screen.Tick(0.4)
        screen.Update(ui, 960, 540, mouseX, mouseY, false)
    }

    ABeltCarriesPotionsAndTheyTravelWithIt()
    {
        HellfeatherInventory items
        T.AreEqual(items.BeltSlots(), 0)
        items.Equipped[HellfeatherSlot.Waist] = HellfeatherItems.HeavyBelt
        items.EquippedMods[HellfeatherSlot.Waist].Clear()
        T.AreEqual(items.BeltSlots(), 3)
        // Picked up or bought, potions fill the pockets before the bag.
        T.IsTrue(items.Add(HellfeatherItems.HealthPotion))
        T.IsTrue(items.Add(HellfeatherItems.ManaPotion))
        T.IsTrue(items.Add(HellfeatherItems.HealthPotion))
        T.AreEqual(items.Bag.Len, (long)0)
        T.IsTrue(items.Add(HellfeatherItems.HealthPotion))
        T.AreEqual(items.CountOf(HellfeatherItems.HealthPotion), 1)
        T.AreEqual(items.UsableCount(HellfeatherItems.HealthPotion), 3)
        // Drinking takes the bag's first, then the belt's.
        T.IsTrue(items.Consume(HellfeatherItems.HealthPotion))
        T.AreEqual(items.CountOf(HellfeatherItems.HealthPotion), 0)
        T.AreEqual(items.BeltCount(HellfeatherItems.HealthPotion), 2)
        T.IsTrue(items.Consume(HellfeatherItems.HealthPotion))
        T.AreEqual(items.BeltCount(HellfeatherItems.HealthPotion), 1)
        // A pocket's potion can be lifted out and put back.
        T.IsTrue(items.ClickPocket(1))
        T.IsTrue(items.Held == HellfeatherItems.ManaPotion)
        T.IsTrue(items.ClickPocket(1))
        T.IsTrue(items.Held == HellfeatherItems.None)
        T.AreEqual(items.BeltCount(HellfeatherItems.ManaPotion), 1)
        // Only potions go in.
        items.Held = HellfeatherItems.Ring
        T.IsFalse(items.ClickPocket(2))
        items.ClearHeld()
        // Taken off, the belt keeps its potions.
        T.IsTrue(items.ClickSlot(HellfeatherSlot.Waist))
        T.IsTrue(items.Held == HellfeatherItems.HeavyBelt)
        T.AreEqual(items.HeldMods.PotionCount(), 2)
        T.AreEqual(items.BeltSlots(), 0)
        T.AreEqual(items.UsableCount(HellfeatherItems.ManaPotion), 0)
        // Worn again, they are there to drink.
        T.IsTrue(items.ClickSlot(HellfeatherSlot.Waist))
        T.AreEqual(items.UsableCount(HellfeatherItems.ManaPotion), 1)
        T.AreEqual(HellfeatherItems.BeltPockets(HellfeatherItems.Belt), 2)
        T.AreEqual(HellfeatherItems.BeltPockets(HellfeatherItems.PlatedBelt), 4)
    }

    ABeltsPotionsAreSavedWithIt()
    {
        HellfeatherItemMods mods
        mods.Clear()
        mods.Potions[0] = HellfeatherItems.HealthPotion
        mods.Potions[2] = HellfeatherItems.ManaPotion
        QuaxelJsonWriter out
        out.BeginObject("")
        HellfeatherSaves.WriteItem(out, "belt", HellfeatherItems.HeavyBelt, mods, false, 0, 0)
        out.EndObject()
        QuaxelJson json
        T.IsTrue(json.Parse(out.Bytes))
        HellfeatherItems item = HellfeatherItems.None
        HellfeatherItemMods read
        T.IsTrue(HellfeatherSaves.ReadItem(json, json.Find(0, "belt"), item, read))
        T.IsTrue(read.Potions[0] == HellfeatherItems.HealthPotion)
        T.IsTrue(read.Potions[1] == HellfeatherItems.None)
        T.IsTrue(read.Potions[2] == HellfeatherItems.ManaPotion)
    }

    OnlyRareDropsComeUnidentified()
    {
        T.IsTrue(HellfeatherItemMods.DropsUnidentified(HellfeatherRarity.Rare))
        T.IsFalse(HellfeatherItemMods.DropsUnidentified(HellfeatherRarity.Magic))
        T.IsFalse(HellfeatherItemMods.DropsUnidentified(HellfeatherRarity.Common))
    }

    PanelGrowsWithALargerWindow()
    {
        HellfeatherInventoryScreen screen
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        screen.Toggle()
        screen.Update(ui, 1920, 1080, 0, 0, false)
        T.AreEqual(screen.PanelScale, 4)
        screen.Update(ui, 300, 200, 0, 0, false)
        T.AreEqual(screen.PanelScale, 1)
    }

    ClickingMovesAnItemFromBagToSlot()
    {
        HellfeatherInventoryScreen screen
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        screen.Items.PutAt(HellfeatherItems.IronHelm, 0, 0)
        screen.Toggle()
        screen.Update(ui, 960, 540, 0, 0, false)
        int s = screen.PanelScale
        int left = screen.PanelLeft
        int top = screen.PanelTop
        // Click the helm in the first cell.
        int bagX = (left + HellfeatherInventoryArt.GridX + 4) * s
        int bagY = (top + HellfeatherInventoryArt.GridY + 4) * s
        screen.Update(ui, 960, 540, bagX, bagY, true)
        T.AreEqual(screen.Items.Held, HellfeatherItems.IronHelm)
        screen.Update(ui, 960, 540, bagX, bagY, false)
        // Holding down does not click twice.
        int headX = (left + 80) * s
        int headY = (top + 30) * s
        screen.Update(ui, 960, 540, headX, headY, true)
        screen.Update(ui, 960, 540, headX, headY, true)
        T.AreEqual(screen.Items.Held, HellfeatherItems.None)
        T.AreEqual(screen.Items.Equipped[HellfeatherSlot.Head], HellfeatherItems.IronHelm)
    }

    TheCloseButtonSitsInsideTheTitleBand()
    {
        // Inside the band, left of the corner stud, on every panel since they share it.
        T.IsTrue(HellfeatherInventoryArt.CloseX - 4 >= 13)
        T.IsTrue(HellfeatherInventoryArt.CloseX + HellfeatherInventoryArt.CloseSize + 1 <= HellfeatherInventoryArt.PanelWidth - 13)
        T.IsTrue(HellfeatherInventoryArt.CloseY >= 6 && HellfeatherInventoryArt.CloseY + HellfeatherInventoryArt.CloseSize <= 19)
    }

    TheCloseButtonClosesAndStowsTheHeldItem()
    {
        HellfeatherInventoryScreen screen
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        screen.Toggle()
        screen.Items.Held = HellfeatherItems.Ring
        screen.Update(ui, 960, 540, 0, 0, false)
        int x = (screen.PanelLeft + HellfeatherInventoryArt.CloseX + 2) * screen.PanelScale
        int y = (screen.PanelTop + HellfeatherInventoryArt.CloseY + 2) * screen.PanelScale
        screen.Update(ui, 960, 540, x, y, true)
        T.IsFalse(screen.Open)
        T.AreEqual(screen.Items.Held, HellfeatherItems.None)
        T.AreEqual(screen.Items.Bag.Len, 1)
    }

    TheWarriorStartsInHerArmorWithHerAxeAndThreePotions()
    {
        HellfeatherInventoryScreen screen
        screen.Stock()
        // Two health potions and one mana potion are all the bag holds.
        T.AreEqual(screen.Items.CountOf(HellfeatherItems.HealthPotion), 2)
        T.AreEqual(screen.Items.CountOf(HellfeatherItems.ManaPotion), 1)
        T.AreEqual(screen.Items.Bag.Len, 3)
        // Her Cleave rune starts on the rune board, not in the bag.
        T.AreEqual(screen.Items.CountOf(HellfeatherItems.RuneCleave), 0)
        T.AreEqual(screen.Items.Gold, 0)
        for slot : HellfeatherSlot {
            HellfeatherItems expected = HellfeatherItems.None
            if slot == HellfeatherSlot.MainHand { expected = HellfeatherItems.HandAxe }
            if slot == HellfeatherSlot.Body { expected = HellfeatherItems.LeatherArmor }
            if slot == HellfeatherSlot.Head { expected = HellfeatherItems.MinersHelmet }
            T.AreEqual(screen.Items.Equipped[slot], expected)
            T.AreEqual(screen.Items.EquippedMods[slot].Rarity, HellfeatherRarity.Common)
        }
    }

    AHeldItemFollowsTheMouseAsTheLastThingDrawn()
    {
        HellfeatherInventoryScreen screen
        QuaxelUi ui()
        ui.FitPixels(HellfeatherHud.GridWidth, HellfeatherHud.GridHeight)
        screen.Toggle()
        screen.Items.Held = HellfeatherItems.BattleAxe
        screen.Update(ui, 960, 540, 500, 300, false)
        ui.Layout(960, 540, 0, 0, false)
        QuaxelUiCommand last = ui.GetCommand(ui.CommandCount - 1)
        T.IsTrue(last.Cell < 0)
        T.AreEqual(last.X, 500 - 32)
        T.AreEqual(last.Y, 300 - 48)
    }
}
