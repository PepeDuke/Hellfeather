// Act II's enemies and the soft control they bring (Story.md, the difficulty
// curve): short slows, roots of two seconds or less, bleeding, the clerk's
// DECEASED mark and the Lattice Host's rot. Every move still winds up where
// she can see it. Bosses: the Swan Matriarch, the Failed Loom, Orderly Brann
// and Sister Carmine, the Red Warden.

// What Act II's enemies leave on her. Each runs down in seconds.
HellfeatherHindrance
{
    float SlowSeconds
    int SlowPercent
    float RootSeconds
    float BleedSeconds
    int BleedPerSecond
    float MarkSeconds
    float RotSeconds
    -float Carry

    Slow(float seconds, int percent)
    {
        SlowSeconds = Math.Max(SlowSeconds, seconds)
        SlowPercent = Math.Max(SlowPercent, percent)
    }

    // A root never holds longer than two seconds, as the act promises.
    Root(float seconds) { RootSeconds = Math.Max(RootSeconds, Math.Min(2.0, seconds)) }

    Bleed(float seconds, int perSecond)
    {
        BleedSeconds = Math.Max(BleedSeconds, seconds)
        BleedPerSecond = Math.Max(BleedPerSecond, perSecond)
    }

    bool Rooted() { return RootSeconds > 0.0 }

    // Percent off her speed.
    int SlowNow() { return SlowSeconds > 0.0 ? SlowPercent | 0 }

    // A blow that lands on her marked lands a quarter harder.
    int Worsen(int amount) { return MarkSeconds > 0.0 ? amount * 5 / 4 | amount }

    // Runs everything down by a step. Returns the damage bleeding and rot did.
    int Step(float deltaSeconds)
    {
        SlowSeconds = Math.Max(0.0, SlowSeconds - deltaSeconds)
        if SlowSeconds <= 0.0 { SlowPercent = 0 }
        RootSeconds = Math.Max(0.0, RootSeconds - deltaSeconds)
        MarkSeconds = Math.Max(0.0, MarkSeconds - deltaSeconds)
        float perSecond = 0.0
        if BleedSeconds > 0.0 { perSecond += (float)BleedPerSecond }
        if RotSeconds > 0.0 { perSecond += (float)HellfeatherHindrance.RotPerSecond }
        BleedSeconds = Math.Max(0.0, BleedSeconds - deltaSeconds)
        if BleedSeconds <= 0.0 { BleedPerSecond = 0 }
        RotSeconds = Math.Max(0.0, RotSeconds - deltaSeconds)
        Carry += perSecond * deltaSeconds
        int dealt = (int)Carry
        Carry -= (float)dealt
        return dealt
    }

    Clear()
    {
        SlowSeconds = 0.0
        SlowPercent = 0
        RootSeconds = 0.0
        BleedSeconds = 0.0
        BleedPerSecond = 0
        MarkSeconds = 0.0
        RotSeconds = 0.0
        Carry = 0.0
    }
}
#{
    #int RotPerSecond = 4
}

// What a shot does besides its damage.
HellfeatherShotEffect : int
#@{
    None,
    Slow,
    Mark,
    Root,
    Bleed
}

HellfeatherShot
{
    HellfeatherShotEffect Effect
}

HellfeatherMoves
#{
    bool IsActTwo(HellfeatherMove move) { return move >= HellfeatherMove.Lash }
}

HellfeatherGame : QuaxelGameInstance
{
    HellfeatherHindrance Hindrance

    // Her speed after Act II's slows and roots, as a share.
    float HinderedPace() { return Hindrance.Rooted() ? 0.0 | (float)(100 - Hindrance.SlowNow()) / 100.0 }

    StepHindrance(QuaxelWorld& world, float deltaSeconds)
    {
        if PlayerHealth <= 0 {
            Hindrance.Clear()
            return
        }
        int dealt = Hindrance.Step(deltaSeconds)
        if dealt > 0 { DamagePlayer(world, dealt) }
        if Hindrance.Rooted() { DashSeconds = 0.0 }
    }

    // What a blow that landed leaves on her.
    -Hinder(HellfeatherShotEffect effect)
    {
        if effect == HellfeatherShotEffect.Slow { Hindrance.Slow(2.0, 40) }
        else if effect == HellfeatherShotEffect.Root { Hindrance.Root(1.5) }
        else if effect == HellfeatherShotEffect.Bleed { Hindrance.Bleed(4.0, 3) }
        else if effect == HellfeatherShotEffect.Mark {
            Hindrance.MarkSeconds = 6.0
            Banner.Show("DECEASED", 1.5)
        }
    }

    // A blow from enemy i in reach that leaves an effect on her if it lands.
    -LandWith(QuaxelWorld& world, int i, float reach, int damage, float knock, HellfeatherShotEffect effect)
    {
        if PlayerGap(world, i) > reach + PeckDodgeMargin() { return }
        if !HitPlayerAs(world, Enemies[i].Kind, damage) { return }
        if knock > 0.0 { Knock(world, world.GetPosition(Enemies[i].Node), knock) }
        Hinder(effect)
    }

    // A shot that leaves an effect on whom it hits.
    -FireWith(QuaxelWorld& world, vec3 from, vec3 direction, bool bolt, int kind, HellfeatherShotEffect effect)
    {
        long before = Shots.Len
        Fire(world, from, direction, bolt, kind)
        if Shots.Len > before { Shots[(int)Shots.Len - 1].Effect = effect }
    }

    // A shot's effect, once it has hit her.
    ShotLanded(HellfeatherShotEffect effect) { Hinder(effect) }

    // Turns a direction on the ground by an angle in radians.
    -vec3 Turned(vec3 direction, float angle)
    {
        float c = Math.Cos(angle)
        float s = Math.Sin(angle)
        return vec3(direction.X * c - direction.Z * s, 0.0, direction.X * s + direction.Z * c)
    }

    // One step of an Act II move for a living, awake enemy that has noticed her.
    StepActTwoMove(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        HellfeatherMove move = Enemies[i].Move
        if move == HellfeatherMove.Lash { StepStrike(world, i, direction, distance, deltaSeconds, 0.9, 0.0, HellfeatherShotEffect.Slow) }
        else if move == HellfeatherMove.Bite { StepStrike(world, i, direction, distance, deltaSeconds, 0.35, 0.0, HellfeatherShotEffect.Bleed) }
        else if move == HellfeatherMove.Horn { StepHorn(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Fan || move == HellfeatherMove.Matriarch { StepFan(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Drag { StepDrag(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Loom { StepLoom(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Dart { StepDart(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Watch { StepWatch(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Stamp { StepVolley(world, i, direction, distance, deltaSeconds, 3.5, 7.5, 1, HellfeatherShotEffect.Mark) }
        else if move == HellfeatherMove.FrameSlam { StepStrike(world, i, direction, distance, deltaSeconds, 1.1, 0.8, HellfeatherShotEffect.None) }
        else if move == HellfeatherMove.Scream { StepScream(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Pin { StepPin(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Rot { StepRot(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Weave { StepWeave(world, i, direction, distance, deltaSeconds) }
        else if move == HellfeatherMove.Warden { StepWarden(world, i, direction, distance, deltaSeconds) }
    }

    // Closes in, winds up, and a blow that leaves an effect.
    -StepStrike(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds, float windup, float knock, HellfeatherShotEffect effect)
    {
        int visual = Enemies[i].VisualNode
        if Attacking(world, i) {
            if StrikeNow(world, i) { LandWith(world, i, Enemies[i].Reach, Enemies[i].Damage, knock, effect) }
            return
        }
        FaceAlong(world, visual, direction)
        if distance > Enemies[i].Reach {
            Stride(world, i, direction, Enemies[i].Speed * Pace(i), deltaSeconds)
            world.PlayClip(visual, "walk")
        } else if Enemies[i].Cooldown > 0.0 {
            world.PlayClip(visual, "idle")
        } else {
            WindUp(world, i, windup)
            Enemies[i].Cooldown = EnemyPeckCooldown() + windup
        }
    }

    // Holds a band of distance and shoots `count` shots fanned out.
    -StepVolley(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds, float nearest, float farthest, int count, HellfeatherShotEffect effect)
    {
        int visual = Enemies[i].VisualNode
        FaceAlong(world, visual, direction)
        if Enemies[i].Phase == 1 {
            if Enemies[i].PhaseTime < 0.4 { Enemies[i].Aim = direction }
            if Enemies[i].PhaseTime < 0.6 { return }
            vec3 from = world.GetPosition(Enemies[i].Node)
            for n : 0; n < count; n++ {
                float spread = count > 1 ? ((float)n / (float)(count - 1) - 0.5) * 0.7 | 0.0
                vec3 line = Turned(Enemies[i].Aim, spread)
                FireWith(world, from + line * 0.6, line, false, Enemies[i].Kind, effect)
            }
            world.SetAnimationSpeed(visual, 1.0)
            NextPhase(i, 0)
            Enemies[i].Cooldown = 2.4
            return
        }
        if distance < nearest {
            Stride(world, i, direction * -1.0, Enemies[i].Speed, deltaSeconds)
            world.PlayClip(visual, "walk")
        } else if distance > farthest {
            Stride(world, i, direction, Enemies[i].Speed, deltaSeconds)
            world.PlayClip(visual, "walk")
        } else if Enemies[i].Cooldown > 0.0 {
            world.PlayClip(visual, "idle")
        } else {
            NextPhase(i, 1)
            Enemies[i].Aim = direction
            WindUp(world, i, 0.6)
        }
    }

    // The Highway Cuff: the horn once he sees her, then cuts that take coin.
    -StepHorn(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        int visual = Enemies[i].VisualNode
        if Enemies[i].Phase == 1 {
            FaceAlong(world, visual, direction)
            if Enemies[i].PhaseTime < 1.2 { return }
            vec3 at = world.GetPosition(Enemies[i].Node)
            AddScripted(world, "BladelockArbalist", at.X - direction.X * 3.0 + direction.Z * 2.0, at.Z - direction.Z * 3.0 - direction.X * 2.0)
            AddScripted(world, "BladelockArbalist", at.X - direction.X * 3.0 - direction.Z * 2.0, at.Z - direction.Z * 3.0 + direction.X * 2.0)
            Banner.Show("A horn on the road", 2.0)
            world.SetAnimationSpeed(visual, 1.0)
            NextPhase(i, 2)
            return
        }
        if Enemies[i].Phase == 0 && Enemies[i].Strikes == 0 && distance < 9.0 {
            Enemies[i].Strikes = 1
            NextPhase(i, 1)
            WindUp(world, i, 1.2)
            return
        }
        if Attacking(world, i) {
            if StrikeNow(world, i) && PlayerGap(world, i) <= Enemies[i].Reach + PeckDodgeMargin() && HitPlayer(world, i) {
                int taken = Math.Min(Inventory.Items.Gold, 5 + Spawner.LootRandom.Below(11))
                Inventory.Items.Gold -= taken
            }
            return
        }
        StepStrike(world, i, direction, distance, deltaSeconds, 0.5, 0.0, HellfeatherShotEffect.None)
    }

    // The swans: a fan of razor feathers from a few steps off, and every third
    // time a gust that throws her back. The matriarch calls cygnets too.
    -StepFan(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        int visual = Enemies[i].VisualNode
        if Enemies[i].Move == HellfeatherMove.Matriarch {
            Enemies[i].MoveTimer += deltaSeconds
            if Enemies[i].MoveTimer > 14.0 {
                Enemies[i].MoveTimer = 0.0
                vec3 at = world.GetPosition(Enemies[i].Node)
                for n : 0; n < 3; n++ { AddScripted(world, "CygnetBrood", at.X + Math.Cos((float)n * 2.1) * 2.0, at.Z + Math.Sin((float)n * 2.1) * 2.0) }
                Banner.Show("The matriarch calls her brood", 2.0)
            }
        }
        if Enemies[i].Strikes >= 2 && distance < 3.2 {
            if Attacking(world, i) {
                if StrikeNow(world, i) {
                    LandWith(world, i, 3.0, Enemies[i].Damage, 2.5, HellfeatherShotEffect.None)
                    Enemies[i].Strikes = 0
                }
                return
            }
            FaceAlong(world, visual, direction)
            if Enemies[i].Cooldown <= 0.0 {
                WindUp(world, i, 0.8)
                Enemies[i].Cooldown = 2.0
            }
            return
        }
        bool fired = Enemies[i].Phase == 1 && Enemies[i].PhaseTime >= 0.6
        StepVolley(world, i, direction, distance, deltaSeconds, 2.5, 6.5, 3, HellfeatherShotEffect.None)
        if fired { Enemies[i].Strikes++ }
    }

    // The Reed Drowner waits under the water, a pale hand showing, until she is close.
    -StepDrag(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        int visual = Enemies[i].VisualNode
        if !Enemies[i].Provoked && distance > 3.5 {
            world.PlayClip(visual, "idle")
            return
        }
        Enemies[i].Provoked = true
        StepStrike(world, i, direction, distance, deltaSeconds, 0.6, 0.0, HellfeatherShotEffect.Root)
    }

    // The Loom-Wight's chest glows before each blow: blue, a push; red, a burst.
    -StepLoom(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        int visual = Enemies[i].VisualNode
        bool red = Enemies[i].Strikes % 2 == 1
        if Attacking(world, i) {
            if StrikeNow(world, i) {
                if red { LandWith(world, i, Enemies[i].Reach + 0.6, Enemies[i].Damage * 3 / 2, 0.0, HellfeatherShotEffect.None) }
                else { LandWith(world, i, Enemies[i].Reach, Enemies[i].Damage / 2, 2.4, HellfeatherShotEffect.None) }
                Enemies[i].Strikes++
            }
            return
        }
        FaceAlong(world, visual, direction)
        if distance > Enemies[i].Reach {
            Stride(world, i, direction, Enemies[i].Speed * Pace(i), deltaSeconds)
            world.PlayClip(visual, "walk")
        } else if Enemies[i].Cooldown > 0.0 {
            world.PlayClip(visual, "idle")
        } else {
            vec3 chest = world.GetPosition(Enemies[i].Node) + vec3(0.0, 0.9, 0.0)
            world.StartEffect(red ? QuaxelEffectStyle.Fire() | QuaxelEffectStyle.Sparks(), chest, vec3(0.0, 1.0, 0.0))
            WindUp(world, i, 0.8)
            Enemies[i].Cooldown = EnemyPeckCooldown() + 0.8
        }
    }

    // The Novice Weaver keeps away and darts; every third time it chalks a
    // circle where she stands, which roots her if she is still in it.
    -StepDart(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        if Enemies[i].Phase == 3 {
            if Enemies[i].PhaseTime < 1.2 { return }
            vec3 player = world.GetPosition(PlayerNode)
            if Math.Hypot(player.X - Enemies[i].Aim.X, player.Z - Enemies[i].Aim.Z) < 1.2 { Hinder(HellfeatherShotEffect.Root) }
            NextPhase(i, 0)
            Enemies[i].Cooldown = 1.5
            return
        }
        if Enemies[i].Phase == 0 && Enemies[i].Cooldown <= 0.0 && Enemies[i].Strikes >= 2 && distance < 8.0 {
            vec3 player = world.GetPosition(PlayerNode)
            Enemies[i].Aim = vec3(player.X, 0.0, player.Z)
            world.StartEffect(QuaxelEffectStyle.Dust(), player, vec3(0.0, 1.0, 0.0))
            Enemies[i].Strikes = 0
            NextPhase(i, 3)
            WindUp(world, i, 0.6)
            return
        }
        bool fired = Enemies[i].Phase == 1 && Enemies[i].PhaseTime >= 0.6
        StepVolley(world, i, direction, distance, deltaSeconds, 4.0, 8.0, 1, HellfeatherShotEffect.None)
        if fired { Enemies[i].Strikes++ }
    }

    // The Cellar Watchman: once it sees her it calls the orderlies, then fights.
    -StepWatch(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        if Enemies[i].Strikes == 0 && distance < 6.0 {
            Enemies[i].Strikes = 1
            vec3 at = world.GetPosition(Enemies[i].Node)
            AddScripted(world, "HospiceOrderly", at.X - direction.X * 4.0, at.Z - direction.Z * 4.0)
            Banner.Show("Alarm!", 1.5)
        }
        StepStrike(world, i, direction, distance, deltaSeconds, 0.5, 0.0, HellfeatherShotEffect.Slow)
    }

    // The Ward Screamer keeps away and screams every few seconds: a pulse that
    // slows her if she is close.
    -StepScream(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        int visual = Enemies[i].VisualNode
        FaceAlong(world, visual, direction)
        if Attacking(world, i) {
            if StrikeNow(world, i) && distance < 5.0 {
                HitPlayer(world, i)
                Hindrance.Slow(2.0, 50)
                world.StartEffect(QuaxelEffectStyle.Dust(), world.GetPosition(Enemies[i].Node), vec3(0.0, 1.0, 0.0))
            }
            return
        }
        if distance < 3.0 {
            Stride(world, i, direction * -1.0, Enemies[i].Speed, deltaSeconds)
            world.PlayClip(visual, "walk")
        } else if distance > 6.0 {
            Stride(world, i, direction, Enemies[i].Speed, deltaSeconds)
            world.PlayClip(visual, "walk")
        } else if Enemies[i].Cooldown > 0.0 {
            world.PlayClip(visual, "idle")
        } else {
            WindUp(world, i, 0.9)
            Enemies[i].Cooldown = 4.0
        }
    }

    // Orderlies: a long lunge with the restraint pole that pins her, then a
    // body slam close in.
    -StepPin(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        bool pole = Enemies[i].Strikes % 2 == 0
        int visual = Enemies[i].VisualNode
        if Attacking(world, i) {
            if StrikeNow(world, i) {
                if pole { LandWith(world, i, Enemies[i].Reach + 1.0, Enemies[i].Damage, 0.0, HellfeatherShotEffect.Root) }
                else { LandWith(world, i, Enemies[i].Reach, Enemies[i].Damage * 3 / 2, 1.8, HellfeatherShotEffect.None) }
                Enemies[i].Strikes++
            }
            return
        }
        FaceAlong(world, visual, direction)
        float reach = pole ? Enemies[i].Reach + 0.9 | Enemies[i].Reach
        if distance > reach {
            Stride(world, i, direction, Enemies[i].Speed * Pace(i), deltaSeconds)
            world.PlayClip(visual, "walk")
        } else if Enemies[i].Cooldown > 0.0 {
            world.PlayClip(visual, "idle")
        } else {
            WindUp(world, i, pole ? 0.8 | 0.5)
            Enemies[i].Cooldown = EnemyPeckCooldown() + 0.6
        }
    }

    // The Lattice Host walks into her; its touch rots.
    -StepRot(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        int visual = Enemies[i].VisualNode
        if Attacking(world, i) {
            if StrikeNow(world, i) && PlayerGap(world, i) <= Enemies[i].Reach + PeckDodgeMargin() && HitPlayer(world, i) { Hindrance.RotSeconds = 5.0 }
            return
        }
        StepStrike(world, i, direction, distance, deltaSeconds, 0.4, 0.0, HellfeatherShotEffect.None)
    }

    // The Failed Loom weaves two shuttles every so often, and rams with its beam.
    -StepWeave(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        Enemies[i].MoveTimer += deltaSeconds
        if Enemies[i].MoveTimer > 9.0 {
            Enemies[i].MoveTimer = 0.0
            vec3 at = world.GetPosition(Enemies[i].Node)
            AddScripted(world, "AnimatedShuttle", at.X + 1.5, at.Z + 1.0)
            AddScripted(world, "AnimatedShuttle", at.X - 1.5, at.Z + 1.0)
            Banner.Show("The loom weaves", 1.5)
        }
        StepStrike(world, i, direction, distance, deltaSeconds, 0.9, 2.0, HellfeatherShotEffect.None)
    }

    // Sister Carmine: needle volleys from a few steps off, a bound stitch that
    // roots, and below a third of her health she draws on the bound patients.
    -StepWarden(QuaxelWorld& world, int i, vec3 direction, float distance, float deltaSeconds)
    {
        Enemies[i].MoveTimer += deltaSeconds
        if Enemies[i].Health * 10 < Enemies[i].MaxHealth * 3 && Enemies[i].MoveTimer > 3.0 {
            Enemies[i].MoveTimer = 0.0
            int bound = FramesBound()
            if bound > 0 {
                Enemies[i].Health = Math.Min(Enemies[i].MaxHealth, Enemies[i].Health + bound * Enemies[i].MaxHealth / 60)
                world.StartEffect(QuaxelEffectStyle.Sparks(), world.GetPosition(Enemies[i].Node) + vec3(0.0, 0.8, 0.0), vec3(0.0, 1.0, 0.0))
                Banner.Show("You become my problem", 1.5)
            }
        }
        bool bind = Enemies[i].Strikes % 3 == 2
        bool fired = Enemies[i].Phase == 1 && Enemies[i].PhaseTime >= 0.6
        StepVolley(world, i, direction, distance, deltaSeconds, 2.5, 7.0, bind ? 1 | 3, bind ? HellfeatherShotEffect.Root | HellfeatherShotEffect.Bleed)
        if fired { Enemies[i].Strikes++ }
    }
}

EnemyController
{
    // Seconds counted by an Act II move between its calls and weavings.
    float MoveTimer
}
