// Marks a node as player-controlled. Speed is in world units per second.
PlayerController
{
    int VisualNode
    int Node
    float Speed
}

HellfeatherMovement
#{
    -vec3 AlongGround(vec3 axis)
    {
        return Math.Normalize(vec3(axis.X, 0.0, axis.Z))
    }

    // Unit-length move direction on XZ, or zero when the input cancels out.
    vec3 Direction(QuaxelCamera camera, QuaxelInputState& input)
    {
        vec3 right = AlongGround(camera.Right()) * input.Axis(QuaxelKey.D, QuaxelKey.A)
        vec3 forward = AlongGround(camera.Forward()) * input.Axis(QuaxelKey.W, QuaxelKey.S)
        return Math.Normalize(right + forward)
    }

    // Keeps the whole footprint on the plane. Height never changes.
    vec3 Move(vec3 position, vec3 direction, float speed, float deltaSeconds, float limit)
    {
        vec3 moved = position + direction * (speed * deltaSeconds)
        return vec3(
            Math.Clamp(moved.X, -limit, limit),
            position.Y,
            Math.Clamp(moved.Z, -limit, limit))
    }
}
