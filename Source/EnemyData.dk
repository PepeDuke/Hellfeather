    // One respawning duck a few steps from the player, for tests of combat.
    markup BesideThePlayer()
    {
        return {
            <EnemyKind Name="EvilDuck" Model="Assets/EvilDuck.qvox" Height=72 VoxelSize=0.025 Radius=0.5 Speed=2.0 Reach=1.2 Notice=14.0 MaxHealth=60 Damage=10/>
            <EnemyPlacement Kind="EvilDuck" X=3.0 Z=-3.0 Respawns=true/>
        }
    }
}
T{
    // Every enemy in the real level comes from the group rolls and stays dead,
    // but for Old Greyneck's flock, the one unique of the Fenmarch.
    LevelHasNoHandPlacedOrRespawningEnemies()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        T.IsTrue(game.Enemies.Len > 0)
        for enemy : game.Enemies { T.IsFalse(enemy.Respawns) }
        int uniques = 0
        for encounter : game.Spawner.Encounters {
            if encounter.Group >= 0 { continue }
            uniques++
            T.IsTrue(game.Spawner.Table.Kinds[game.Enemies[encounter.First].Kind].Name == "OldGreyneck")
        }
        T.AreEqual(uniques, 1)
    }

    // A group only ever spawns in a clearing of its own zone, and every zone
    // outside Ravenford has groups.
    EachZoneRollsOnlyItsOwnGroups()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int [] zonesSeen
        for encounter : game.Spawner.Encounters {
            if encounter.Group < 0 { continue }
            int zone = game.Spawner.Table.Groups[encounter.Group].Zone
            float nearest = 1000000.0
            int found = -1
            for i : 0; i < game.Terrain.Layout.Sites.Len; i++ {
                vec3 middle = game.Terrain.WorldPoint(game.Terrain.Layout.Sites[i].X, game.Terrain.Layout.Sites[i].Z)
                float gap = Math.Hypot(middle.X - encounter.Center.X, middle.Z - encounter.Center.Z)
                if gap < nearest {
                    nearest = gap
                    found = i
                }
            }
            T.AreEqual(zone, game.Terrain.Layout.Sites[found].Module)
            bool seen = false
            for known : zonesSeen {
                if known == zone { seen = true }
            }
            if !seen { zonesSeen += zone }
        }
        // Lowland, crofts, road, marsh, hill and mill.
        T.AreEqual(zonesSeen.Len, 6)
    }

    // Until a kind's own model exists, it wears its stand-in's at its own scale.
    AMissingModelFallsBackToItsStandIn()
    {
        HellfeatherEnemySpawner spawner()
        spawner.Data = {
            <EnemyKind Name="EvilDuck" Model="Assets/EvilDuck.qvox" Height=72 VoxelSize=0.025/>
            <EnemyKind Name="Phantom" Model="Assets/NoSuchModel.qvox" StandIn="EvilDuck" StandInScale=2.0 Height=10 VoxelSize=0.1/>
            <EnemyKind Name="Real" Model="Assets/EvilDuck.qvox" StandIn="EvilDuck" StandInScale=3.0 Height=72 VoxelSize=0.03/>
        }
        QuaxelWorld world()
        T.IsTrue(spawner.Load(world))
        T.IsTrue(spawner.EnsureModel(world, 0) && spawner.EnsureModel(world, 1) && spawner.EnsureModel(world, 2))
        T.IsTrue(spawner.Table.Kinds[1].UsesStandIn)
        T.IsTrue(spawner.Table.Kinds[1].Model == "Assets/EvilDuck.qvox")
        T.AreEqual(spawner.Table.Kinds[1].Height, 72)
        T.AreEqual(spawner.Table.Kinds[1].VoxelSize, 0.05)
        T.AreEqual(spawner.Table.Kinds[1].Animation, spawner.Table.Kinds[0].Animation)
        T.IsFalse(spawner.Table.Kinds[2].UsesStandIn)
        T.AreEqual(spawner.Table.Kinds[2].VoxelSize, 0.03)
    }
}
