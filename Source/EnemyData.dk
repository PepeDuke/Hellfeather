    // One respawning duck a few steps from the player, for tests of combat.
    // Its accuracy is past any defense she can wear, so its pecks always land.
    markup BesideThePlayer()
    {
        return {
            <EnemyKind Name="EvilDuck" Model="Assets/EvilDuck.qvox" Height=72 VoxelSize=0.025 Radius=0.5 Speed=2.0 Reach=1.2 Notice=14.0 MaxHealth=60 Damage=10 Accuracy=500/>
            <EnemyPlacement Kind="EvilDuck" X=3.0 Z=-3.0 Respawns=true/>
        }
    }
}
T{
    // Every enemy in the real level comes from the group rolls and stays dead,
    // but for Old Greyneck's flock, the one unique of the Fenmarch.
    LevelHasNoHandPlacedOrRespawningEnemies()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        T.IsTrue(game.Enemies.Len > 0)
        for enemy : game.Enemies { T.IsFalse(enemy.Respawns) }
        int uniques = 0
        for encounter : game.Spawner.Encounters {
            if encounter.Group >= 0 { continue }
            uniques++
            T.IsTrue(game.Spawner.Table.Kinds[game.Enemies[encounter.First].Kind].Name == "OldGreyneck")
        }
        T.AreEqual(uniques, 1)
    }

    // The clearings just out of town hold one group each, so a first walk out
    // of the gate meets a few ducks and not a crowd. The Ford Road still holds
    // more than the dozen Reeve wants cleared.
    TheFirstClearingsOutOfTownAreGentle()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        vec3 start = game.Terrain.WorldPoint(game.Terrain.Layout.Sites[game.Terrain.SpawnSiteIndex].X, game.Terrain.Layout.Sites[game.Terrain.SpawnSiteIndex].Z)
        int gentle = 0
        for i : 0; i < game.Terrain.Layout.Sites.Len; i++ {
            if i == game.Terrain.SpawnSiteIndex { continue }
            QuaxelTerrainSite site = game.Terrain.Layout.Sites[i]
            vec3 middle = game.Terrain.WorldPoint(site.X, site.Z)
            if Math.Hypot(middle.X - start.X, middle.Z - start.Z) > game.Spawner.Table.Rules.GentleRadius { continue }
            gentle++
            int groups = 0
            for encounter : game.Spawner.Encounters {
                if encounter.Group >= 0 && Math.Hypot(encounter.Center.X - middle.X, encounter.Center.Z - middle.Z) <= site.Radius { groups++ }
            }
            T.IsTrue(groups <= game.Spawner.Table.Rules.GentleGroups)
        }
        T.IsTrue(gentle > 0)
        int ford = 0
        for encounter : game.Spawner.Encounters {
            if encounter.Group < 0 || game.Spawner.Table.Groups[encounter.Group].Zone != HellfeatherZone.FordRoad + 0 { continue }
            for i : encounter.First; i < encounter.First + encounter.Count; i++ {
                if game.Spawner.Table.Kinds[game.Enemies[i].Kind].Feathers > 0 { ford++ }
            }
        }
        T.IsTrue(ford >= HellfeatherQuests.DucksWanted + 4)
    }

    // A group only ever spawns in a clearing of its own zone, and every zone
    // outside Ravenford has groups.
    EachZoneRollsOnlyItsOwnGroups()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int [] zonesSeen
        for encounter : game.Spawner.Encounters {
            if encounter.Group < 0 { continue }
            int zone = game.Spawner.Table.Groups[encounter.Group].Zone
            float nearest = 1000000.0
            int found = -1
            for i : 0; i < game.Terrain.Layout.Sites.Len; i++ {
                vec3 middle = game.Terrain.WorldPoint(game.Terrain.Layout.Sites[i].X, game.Terrain.Layout.Sites[i].Z)
                float gap = Math.Hypot(middle.X - encounter.Center.X, middle.Z - encounter.Center.Z)
                if gap < nearest {
                    nearest = gap
                    found = i
                }
            }
            T.AreEqual(zone, game.Terrain.Layout.Sites[found].Module)
            bool seen = false
            for known : zonesSeen {
                if known == zone { seen = true }
            }
            if !seen { zonesSeen += zone }
        }
        // Lowland, crofts, road, marsh, hill and mill.
        T.AreEqual(zonesSeen.Len, 6)
    }

    // The duck drops of Ravenford's road never hold a late base, the Mill's hold
    // them all, and the starting hand axe is left behind in the early zones.
    LaterZonesRollBetterBases()
    {
        HellfeatherEnemySpawner spawner()
        QuaxelWorld world()
        spawner.Data = HellfeatherEnemyData.Build()
        T.IsTrue(spawner.Load(world))
        int loot = spawner.Table.LootNamed("Duck drops")
        T.IsTrue(loot >= 0)
        spawner.LootRandom.Begin((uint)77)
        int early = 0
        int late = 0
        int axes = 0
        for n : 0; n < 3000; n++ {
            item : spawner.RollLootAt(loot, HellfeatherZoneNames.Level(HellfeatherZone.FordRoad + 0))
            if item == HellfeatherItems.ScaleMail || item == HellfeatherItems.GreatHelm || item == HellfeatherItems.Falchion { early++ }
            mill : spawner.RollLootAt(loot, HellfeatherZoneNames.Level(HellfeatherZone.HobbsMill + 0))
            if mill == HellfeatherItems.ScaleMail || mill == HellfeatherItems.GreatHelm || mill == HellfeatherItems.FlangedMace { late++ }
            if mill == HellfeatherItems.HandAxe { axes++ }
        }
        T.AreEqual(early, 0)
        T.IsTrue(late > 0)
        T.AreEqual(axes, 0)
    }

    // The Undercroft's own bases never drop before zone level 10, and the
    // deep Undercroft drops each of them.
    TheUndercroftRollsItsOwnBases()
    {
        HellfeatherEnemySpawner spawner()
        QuaxelWorld world()
        spawner.Data = HellfeatherEnemyData.Build()
        T.IsTrue(spawner.Load(world))
        int loot = spawner.Table.LootNamed("Duck drops")
        spawner.LootRandom.Begin((uint)91)
        HellfeatherItems [] deep = {HellfeatherItems.WarHammer, HellfeatherItems.TowerShield, HellfeatherItems.VisoredHelm, HellfeatherItems.PlateMail, HellfeatherItems.SpikedGauntlets}
        int [5] seen
        int early = 0
        for n : 0; n < 4000; n++ {
            mill : spawner.RollLootAt(loot, HellfeatherZoneNames.Level(HellfeatherZone.HobbsMill + 0))
            below : spawner.RollLootAt(loot, HellfeatherZoneNames.Level(HellfeatherZone.UndercroftDeep + 0))
            for i : 0; i < 5; i++ {
                if mill == deep[i] { early++ }
                if below == deep[i] { seen[i]++ }
            }
        }
        T.AreEqual(early, 0)
        for count : seen { T.IsTrue(count > 0) }
    }

    // Every item base that can be worn drops somewhere, or is given.
    EveryWornBaseDropsSomewhere()
    {
        HellfeatherEnemySpawner spawner()
        QuaxelWorld world()
        spawner.Data = HellfeatherEnemyData.Build()
        T.IsTrue(spawner.Load(world))
        HellfeatherItems [] bases = {HellfeatherItems.HandAxe, HellfeatherItems.Falchion, HellfeatherItems.FlangedMace, HellfeatherItems.BattleAxe, HellfeatherItems.KiteShield, HellfeatherItems.ChainCoif, HellfeatherItems.GreatHelm, HellfeatherItems.RingMail, HellfeatherItems.ScaleMail, HellfeatherItems.ChainGloves, HellfeatherItems.Gauntlets, HellfeatherItems.ChainBoots, HellfeatherItems.PlateBoots, HellfeatherItems.HeavyBelt, HellfeatherItems.PlatedBelt, HellfeatherItems.GarnetRing, HellfeatherItems.RavenAmulet, HellfeatherItems.WarHammer, HellfeatherItems.TowerShield, HellfeatherItems.VisoredHelm, HellfeatherItems.PlateMail, HellfeatherItems.SpikedGauntlets}
        for wanted : bases {
            bool found = false
            for entry : spawner.Table.LootItems { if entry.Item == wanted { found = true } }
            T.IsTrue(found)
        }
    }

    // Until a kind's own model exists, it wears its stand-in's at its own scale.
    AMissingModelFallsBackToItsStandIn()
    {
        HellfeatherEnemySpawner spawner()
        spawner.Data = {
            <EnemyKind Name="EvilDuck" Model="Assets/EvilDuck.qvox" Height=72 VoxelSize=0.025/>
            <EnemyKind Name="Phantom" Model="Assets/NoSuchModel.qvox" StandIn="EvilDuck" StandInScale=2.0 Height=10 VoxelSize=0.1/>
            <EnemyKind Name="Real" Model="Assets/EvilDuck.qvox" StandIn="EvilDuck" StandInScale=3.0 Height=72 VoxelSize=0.03/>
        }
        QuaxelWorld world()
        T.IsTrue(spawner.Load(world))
        T.IsTrue(spawner.EnsureModel(world, 0) && spawner.EnsureModel(world, 1) && spawner.EnsureModel(world, 2))
        T.IsTrue(spawner.Table.Kinds[1].UsesStandIn)
        T.IsTrue(spawner.Table.Kinds[1].Model == "Assets/EvilDuck.qvox")
        T.AreEqual(spawner.Table.Kinds[1].Height, 72)
        T.AreEqual(spawner.Table.Kinds[1].VoxelSize, 0.05)
        T.AreEqual(spawner.Table.Kinds[1].Animation, spawner.Table.Kinds[0].Animation)
        T.IsFalse(spawner.Table.Kinds[2].UsesStandIn)
        T.AreEqual(spawner.Table.Kinds[2].VoxelSize, 0.03)
    }
}
