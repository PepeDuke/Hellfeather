        else if quest == 1 { PictureFord(p) }
        else if quest == 2 { PictureRooms(p) }
        else if quest == 3 { PictureSeamstress(p) }
        else if quest == 4 { PictureDark(p) }
        else if quest == 5 { PictureMillrace(p) }
    }

