// One drawing of an item in rows of color codes, '.' for empty. The inventory icon
// and the voxel model on the ground are both made from it, so an item is drawn once.
HellfeatherItemPicture
{
    string [] Rows

    Row(int row, string text)
    {
        while Rows.Len <= row { Rows += "" }
        Rows[row] = text
    }

    // The code at a cell, or '.' outside the drawing.
    int Code(int column, int row)
    {
        if row < 0 || row >= Rows.Len || column < 0 || column >= Length(Rows[row]) { return 46 }
        return (int)CodeUnitAt(Rows[row], (long)column)
    }

    int Width()
    {
        int widest = 0
        for row : 0; row < Rows.Len; row++ { widest = Math.Max(widest, (int)Length(Rows[row])) }
        return widest
    }

    bool RowIsEmpty(int row)
    {
        for column : 0; column < Width(); column++ {
            if Code(column, row) != 46 { return false }
        }
        return true
    }

    // The black outline belongs to the flat icon. A model has real edges, so only
    // the dark lines inside a shape survive.
    bool IsSolid(int column, int row)
    {
        int code = Code(column, row)
        if code == 46 { return false }
        if code != 107 { return true }
        return Code(column - 1, row) != 46 && Code(column + 1, row) != 46 && Code(column, row - 1) != 46 && Code(column, row + 1) != 46
    }
}

HellfeatherItemArt
#{
    // World units per picture cell of a model. Pictures are drawn at one screen
    // pixel per cell, so cells are half the size of the world's fine voxels.
    #float ModelVoxel = 0.03125
    // How many voxels a flat item rises at its thickest.
    #int Thickness = 8

    int ColorOf(int code)
    {
        if code == 107 { return 0x15110e } // k: outline
        if code == 83 { return 0xd9e1e4 } // S: bright steel
        if code == 115 { return 0x98a2a8 } // s: steel
        if code == 100 { return 0x565d62 } // d: dark steel
        if code == 87 { return 0x96683a } // W: light wood
        if code == 119 { return 0x6b4326 } // w: wood
        if code == 103 { return 0xdcae3e } // g: gold
        if code == 71 { return 0x8f6a1e } // G: dark gold
        if code == 82 { return 0xee4e3c } // R: bright red
        if code == 114 { return 0xa8231b } // r: red
        if code == 66 { return 0x5a90ee } // B: bright blue
        if code == 98 { return 0x2746a8 } // b: blue
        if code == 76 { return 0xa8794b } // L: light leather
        if code == 108 { return 0x75492b } // l: leather
        if code == 99 { return 0x3f2a1c } // c: dark cloth
        if code == 101 { return 0xd8cfb8 } // e: bone
        if code == 118 { return 0x52dcec } // v: gem
        if code == 109 { return 0x5a1610 } // m: maroon
        if code == 111 { return 0xe2561c } // o: ember
        if code == 121 { return 0xf6c64a } // y: flame
        if code == 97 { return 0xb8e0ff } // a: wind
        // Deeper and brighter steps, so each material shades in three or four tones.
        if code == 68 { return 0x33383c } // D: darkest steel
        if code == 110 { return 0x4a2c18 } // n: dark wood
        if code == 72 { return 0xfbe7a1 } // H: gold highlight
        if code == 81 { return 0xc99a64 } // Q: leather highlight
        if code == 69 { return 0xa8946c } // E: shaded bone
        if code == 80 { return 0xf9a08c } // P: red highlight
        if code == 65 { return 0xbfe0ff } // A: blue highlight
        if code == 117 { return 0x16245e } // u: deep blue
        if code == 86 { return 0x1f7d99 } // V: dark gem
        if code == 73 { return 0xd8fbff } // I: gem highlight
        // Old stone for runes, from lit faces down into the cracks, and moss.
        if code == 84 { return 0xa59a88 } // T: lit stone
        if code == 116 { return 0x7a7163 } // t: stone
        if code == 120 { return 0x524b42 } // x: shaded stone
        if code == 88 { return 0x2a2622 } // X: crack
        if code == 106 { return 0x5c6b3a } // j: moss
        return -1
    }

    // Potions and helmets stand up and are round. Everything else lies flat.
    bool Stands(HellfeatherItems item) { return item == HellfeatherItems.HealthPotion || item == HellfeatherItems.ManaPotion || item == HellfeatherItems.IronHelm || item == HellfeatherItems.MinersHelmet }

    // Puffs a flat item up toward its middle, with dark lines pressed in.
    // Cells within two of an edge rise half as high, within four three quarters.
    -int Relief(HellfeatherItemPicture& picture, int column, int row)
    {
        int rise = Thickness
        for ring : 4; ring >= 1; ring-- {
            for a : -ring; a <= ring; a++ {
                for b : -ring; b <= ring; b++ {
                    if !picture.IsSolid(column + a, row + b) { rise = ring <= 2 ? Thickness / 2 | Thickness * 3 / 4 }
                }
            }
        }
        return picture.Code(column, row) == 107 ? Math.Max(rise - 2, 2) | rise
    }

    -int FirstRow(HellfeatherItemPicture& picture)
    {
        int row = 0
        while row < picture.Rows.Len - 1 && picture.RowIsEmpty(row) { row++ }
        return row
    }

    -int LastRow(HellfeatherItemPicture& picture)
    {
        int row = (int)picture.Rows.Len - 1
        while row > 0 && picture.RowIsEmpty(row) { row-- }
        return row
    }

    -int Lay(QuaxelWorld& world, HellfeatherItemPicture& picture, int& height)
    {
        int first = FirstRow(picture)
        int last = LastRow(picture)
        int width = picture.Width()
        height = Thickness
        int volume = world.CreateVolume(width, height, last - first + 1)
        if volume < 0 { return -1 }
        for row : first; row <= last; row++ {
            for column : 0; column < width; column++ {
                if !picture.IsSolid(column, row) { continue }
                int rise = Relief(picture, column, row)
                int color = HellfeatherArt.Rgb(ColorOf(picture.Code(column, row)))
                for y : 0; y < rise; y++ { world.SetVoxel(volume, column, y, row - first, color) }
            }
        }
        return volume
    }

    // Spins the left half of the drawing around its center line.
    -int Revolve(QuaxelWorld& world, HellfeatherItemPicture& picture, int& height)
    {
        int first = FirstRow(picture)
        int last = LastRow(picture)
        int width = picture.Width()
        height = last - first + 1
        int volume = world.CreateVolume(width, height, width)
        if volume < 0 { return -1 }
        float middle = (float)width * 0.5
        for x : 0; x < width; x++ {
            for z : 0; z < width; z++ {
                int column = width / 2 - 1 - (int)Math.Hypot((float)x + 0.5 - middle, (float)z + 0.5 - middle)
                if column < 0 { continue }
                for row : first; row <= last; row++ {
                    if !picture.IsSolid(column, row) { continue }
                    world.SetVoxel(volume, x, last - row, z, HellfeatherArt.Rgb(ColorOf(picture.Code(column, row))))
                }
            }
        }
        return volume
    }

    // Act I's items borrow the drawing of the plain item they look most like,
    // until they have pictures of their own in Assets/ItemArt.
    HellfeatherItems Likeness(HellfeatherItems item)
    {
        if item == HellfeatherItems.BlackFeather || item == HellfeatherItems.LanternToken { return HellfeatherItems.Scroll }
        if item == HellfeatherItems.TitheBracelet || item == HellfeatherItems.MarrasThimble || item == HellfeatherItems.GreyKey { return HellfeatherItems.Ring }
        if item == HellfeatherItems.BlackHoney { return HellfeatherItems.ManaPotion }
        if item == HellfeatherItems.EddasQuillCharm || item == HellfeatherItems.MardrasRingShards || item == HellfeatherItems.GreyneckQuill { return HellfeatherItems.Amulet }
        if item == HellfeatherItems.JessasWaterwalkers { return HellfeatherItems.Boots }
        if item == HellfeatherItems.MillstoneMaul { return HellfeatherItems.BattleAxe }
        return item
    }

    // Draws an item, or the item it borrows its looks from.
    Picture(HellfeatherItems item, HellfeatherItemPicture& p) { Draw(Likeness(item), p) }

    // The volume for an item, or -1. Height is its size in voxels along Y.
    int BuildModel(QuaxelWorld& world, HellfeatherItems item, int& height)
    {
        HellfeatherItemPicture picture
        Picture(item, picture)
        if Stands(Likeness(item)) { return Revolve(world, picture, height) }
        return Lay(world, picture, height)
    }
}
