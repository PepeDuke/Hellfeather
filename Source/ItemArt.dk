        p.Row(2, "...GG...")
        p.Row(3, "..kggk..")
        p.Row(4, ".kgRrGk.")
        p.Row(5, ".kgrmGk.")
        p.Row(6, "..kGGk..")
        p.Row(7, "...kk...")
    }

    -Potion(HellfeatherItemPicture& p, bool health)
    {
        string bright = health ? "kRRrrrrk" | "kBBbbbbk"
        string middle = health ? "kRrrrrmk" | "kBbbbbck"
        string low = health ? ".krrrmk." | ".kbbbck."
        p.Row(0, "..kwwk..")
        p.Row(1, "..kkkk..")
        p.Row(2, "..kSsk..")
        p.Row(3, ".kSSssk.")
        p.Row(4, bright)
        p.Row(5, middle)
        p.Row(6, low)
        p.Row(7, "..kkkk..")
    }

    -KeyIcon(HellfeatherItemPicture& p)
    {
        p.Row(0, ".kggGk..")
        p.Row(1, "kgk.kGk.")
        p.Row(2, "kgk.kGk.")
        p.Row(3, ".kggGk..")
        p.Row(4, "..kgk...")
        p.Row(5, "..kgkk..")
        p.Row(6, "..kggGk.")
        p.Row(7, "..kkkk..")
    }

    -GoldIcon(HellfeatherItemPicture& p)
    {
        p.Row(0, "..kkk...")
        p.Row(1, ".kggGkk.")
        p.Row(2, ".kgGkggk")
        p.Row(3, "..kkkgGk")
        p.Row(4, ".kggkkk.")
        p.Row(5, "kgggGGk.")
        p.Row(6, "kgGGGGk.")
        p.Row(7, ".kkkkk..")
    }

    -ScrollIcon(HellfeatherItemPicture& p)
