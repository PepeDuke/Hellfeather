// One drawing of an item in rows of color codes, '.' for empty. The inventory icon
// and the voxel model on the ground are both made from it, so an item is drawn once.
HellfeatherItemPicture
{
    string [] Rows

    Row(int row, string text)
    {
        while Rows.Len <= row { Rows += "" }
        Rows[row] = text
    }

    // The code at a cell, or '.' outside the drawing.
    int Code(int column, int row)
    {
        if row < 0 || row >= Rows.Len || column < 0 || column >= Length(Rows[row]) { return 46 }
        return (int)CodeUnitAt(Rows[row], (long)column)
    }

    int Width()
    {
        int widest = 0
        for row : 0; row < Rows.Len; row++ { widest = Math.Max(widest, (int)Length(Rows[row])) }
        return widest
    }

    bool RowIsEmpty(int row)
    {
        for column : 0; column < Width(); column++ {
            if Code(column, row) != 46 { return false }
        }
        return true
    }

    // The black outline belongs to the flat icon. A model has real edges, so only
    // the dark lines inside a shape survive.
    bool IsSolid(int column, int row)
    {
        int code = Code(column, row)
        if code == 46 { return false }
        if code != 107 { return true }
        return Code(column - 1, row) != 46 && Code(column + 1, row) != 46 && Code(column, row - 1) != 46 && Code(column, row + 1) != 46
    }
}

HellfeatherItemArt
#{
    // World units per picture cell of a model.
    #float ModelVoxel = 0.0625

    int ColorOf(int code)
    {
        if code == 107 { return 0x15110e } // k: outline
        if code == 83 { return 0xd9e1e4 } // S: bright steel
        if code == 115 { return 0x98a2a8 } // s: steel
        if code == 100 { return 0x565d62 } // d: dark steel
        if code == 87 { return 0x96683a } // W: light wood
        if code == 119 { return 0x6b4326 } // w: wood
        if code == 103 { return 0xdcae3e } // g: gold
        if code == 71 { return 0x8f6a1e } // G: dark gold
        if code == 82 { return 0xee4e3c } // R: bright red
        if code == 114 { return 0xa8231b } // r: red
        if code == 66 { return 0x5a90ee } // B: bright blue
        if code == 98 { return 0x2746a8 } // b: blue
        if code == 76 { return 0xa8794b } // L: light leather
        if code == 108 { return 0x75492b } // l: leather
        if code == 99 { return 0x3f2a1c } // c: dark cloth
        if code == 101 { return 0xd8cfb8 } // e: bone
        if code == 118 { return 0x52dcec } // v: gem
        if code == 109 { return 0x5a1610 } // m: maroon
        if code == 111 { return 0xe2561c } // o: ember
        if code == 121 { return 0xf6c64a } // y: flame
        if code == 97 { return 0xb8e0ff } // a: wind
        return -1
    }

    Draw(HellfeatherItems item, HellfeatherItemPicture& p)
    {
        if item == HellfeatherItems.BattleAxe { Axe(p) }
        else if item == HellfeatherItems.ShortSword { Sword(p) }
        else if item == HellfeatherItems.RoundShield { Shield(p) }
        else if item == HellfeatherItems.IronHelm { Helm(p) }
        else if item == HellfeatherItems.LeatherArmor { Armor(p) }
        else if item == HellfeatherItems.Gloves { GloveIcon(p) }
        else if item == HellfeatherItems.Boots { BootIcon(p) }
        else if item == HellfeatherItems.Belt { BeltIcon(p) }
        else if item == HellfeatherItems.Ring { RingIcon(p) }
        else if item == HellfeatherItems.Amulet { AmuletIcon(p) }
        else if item == HellfeatherItems.HealthPotion { Potion(p, true) }
        else if item == HellfeatherItems.ManaPotion { Potion(p, false) }
        else if item == HellfeatherItems.RustyKey { KeyIcon(p) }
        else if item == HellfeatherItems.Scroll { ScrollIcon(p) }
        else if item == HellfeatherItems.Gold { GoldIcon(p) }
    }

    // Potions and helmets stand up and are round. Everything else lies flat.
    bool Stands(HellfeatherItems item) { return item == HellfeatherItems.HealthPotion || item == HellfeatherItems.ManaPotion || item == HellfeatherItems.IronHelm }

    // Puffs a flat item up toward its middle, with dark lines pressed in.
    -int Relief(HellfeatherItemPicture& picture, int column, int row)
    {
        int rise = 4
        for ring : 2; ring >= 1; ring-- {
            for a : -ring; a <= ring; a++ {
                for b : -ring; b <= ring; b++ {
                    if !picture.IsSolid(column + a, row + b) { rise = ring + 1 }
                }
            }
        }
        return picture.Code(column, row) == 107 ? Math.Max(rise - 1, 1) | rise
    }

    -int FirstRow(HellfeatherItemPicture& picture)
    {
        int row = 0
        while row < picture.Rows.Len - 1 && picture.RowIsEmpty(row) { row++ }
        return row
    }

    -int LastRow(HellfeatherItemPicture& picture)
    {
        int row = (int)picture.Rows.Len - 1
        while row > 0 && picture.RowIsEmpty(row) { row-- }
        return row
    }

    -int Lay(QuaxelWorld& world, HellfeatherItemPicture& picture, int& height)
    {
        int first = FirstRow(picture)
        int last = LastRow(picture)
        int width = picture.Width()
        height = 4
        int volume = world.CreateVolume(width, height, last - first + 1)
        if volume < 0 { return -1 }
        for row : first; row <= last; row++ {
            for column : 0; column < width; column++ {
                if !picture.IsSolid(column, row) { continue }
                int rise = Relief(picture, column, row)
                int color = HellfeatherArt.Rgb(ColorOf(picture.Code(column, row)))
                for y : 0; y < rise; y++ { world.SetVoxel(volume, column, y, row - first, color) }
            }
        }
        return volume
    }

    // Spins the left half of the drawing around its center line.
    -int Revolve(QuaxelWorld& world, HellfeatherItemPicture& picture, int& height)
    {
        int first = FirstRow(picture)
        int last = LastRow(picture)
        int width = picture.Width()
        height = last - first + 1
        int volume = world.CreateVolume(width, height, width)
        if volume < 0 { return -1 }
        float middle = (float)width * 0.5
        for x : 0; x < width; x++ {
            for z : 0; z < width; z++ {
                int column = width / 2 - 1 - (int)Math.Hypot((float)x + 0.5 - middle, (float)z + 0.5 - middle)
                if column < 0 { continue }
                for row : first; row <= last; row++ {
                    if !picture.IsSolid(column, row) { continue }
                    world.SetVoxel(volume, x, last - row, z, HellfeatherArt.Rgb(ColorOf(picture.Code(column, row))))
                }
            }
        }
        return volume
    }

    // The volume for an item, or -1. Height is its size in voxels along Y.
    int BuildModel(QuaxelWorld& world, HellfeatherItems item, int& height)
    {
        HellfeatherItemPicture picture
        Draw(item, picture)
        if Stands(item) { return Revolve(world, picture, height) }
        return Lay(world, picture, height)
    }

    -Axe(HellfeatherItemPicture& p)
    {
        p.Row(0, "..kk...kk...kk..")
        p.Row(1, ".kSSk.kWWk.kSSk.")
        p.Row(2, "kSSSSkkWWkkSSSSk")
        p.Row(3, "kSSsssgWWgsssSSk")
        p.Row(4, "kSsssdgWWgdsssSk")
        p.Row(5, "kSsddkkWWkkddsSk")
        p.Row(6, ".kddk.kWWk.kddk.")
        p.Row(7, "..kk..kWWk..kk..")
        for row : 8; row < 15; row++ { p.Row(row, "......kWwk......") }
        for row : 15; row < 21; row++ { p.Row(row, row % 2 == 0 ? "......kLlk......" | "......klLk......") }
        p.Row(21, ".....kggGGk.....")
        p.Row(22, "......kGGk......")
        p.Row(23, ".......kk.......")
    }

    -Sword(HellfeatherItemPicture& p)
    {
        p.Row(0, "...kk...")
        p.Row(1, "..kSsk..")
        for row : 2; row < 15; row++ { p.Row(row, "..kSsk..") }
        p.Row(15, "kkkkkkkk")
        p.Row(16, "kgggGGGk")
        p.Row(17, "kkkkkkkk")
        for row : 18; row < 22; row++ { p.Row(row, row % 2 == 0 ? "..kLlk.." | "..klLk..") }
        p.Row(22, "..kggk..")
        p.Row(23, "...kk...")
    }

    -Shield(HellfeatherItemPicture& p)
    {
        p.Row(0, "....kkkkkkkk....")
        p.Row(1, "..kkssssssddkk..")
        p.Row(2, ".ksswWWWWWwwddk.")
        p.Row(3, ".kswWWWwwWWWwdk.")
        p.Row(4, "ksWWWWwggwWWWwdk")
        p.Row(5, "ksWWWwgSSgwWWwdk")
        p.Row(6, "ksWWwgSssdgwWwdk")
        p.Row(7, "ksWWwgSsddgwWwdk")
        p.Row(8, "ksWWwgSsddgwWwdk")
        p.Row(9, "ksWWwgsdddgwWwdk")
        p.Row(10, "ksWWWwgddgwWWwdk")
        p.Row(11, "ksWWWWwggwWWWwdk")
        p.Row(12, ".kswWWWwwWWWwdk.")
        p.Row(13, ".ksswWWWWWwwddk.")
        p.Row(14, "..kkssssddddkk..")
        p.Row(15, "....kkkkkkkk....")
    }

    -Helm(HellfeatherItemPicture& p)
    {
        p.Row(1, ".......kk.......")
        p.Row(2, ".....kkSskk.....")
        p.Row(3, "...kkSSSssdkk...")
        p.Row(4, "..kSSSSsssddk...")
        p.Row(5, ".kSSSSssssdddk..")
        p.Row(6, ".kSSSsssssdddk..")
        p.Row(7, "kgggggggggGGGGk.")
        p.Row(8, "kSSsssgssssdddk.")
        p.Row(9, "kSsskkgkkksdddk.")
        p.Row(10, "kSskk.g..kksddk.")
        p.Row(11, "kSsk..g...ksddk.")
        p.Row(12, "kSsk..k...ksddk.")
        p.Row(13, ".kk.......kkkk..")
    }

    -Armor(HellfeatherItemPicture& p)
    {
        p.Row(0, "...kkk....kkk...")
        p.Row(1, "..klLLk..kLLlk..")
        p.Row(2, ".kLLLLLkkLLLllk.")
        p.Row(3, "kLLLLLLccLLLlllk")
        p.Row(4, "kLLLLlLccLlLlllk")
        p.Row(5, "kLLlkLLLLLLklllk")
        p.Row(6, "kLlkkLLLLlLkklck")
        p.Row(7, "kLlkkLgLLLgkklck")
        p.Row(8, "kLlkkLLLLlLkklck")
        p.Row(9, "kLlkkLgLLLgkklck")
        p.Row(10, ".kk.kLLLLlLk.kk.")
        p.Row(11, "....kLgLLLgk....")
        p.Row(12, "....kLLLLlLk....")
        p.Row(13, "....kLgLLLgk....")
        p.Row(14, "....kLLLLllk....")
        p.Row(15, "....kGggggGk....")
        p.Row(16, "...kLLLLLLllk...")
        p.Row(17, "...kLLLLlLllk...")
        p.Row(18, "...kLLLkklllk...")
        p.Row(19, "..kLLLlkkclllk..")
        p.Row(20, "..kLLlk..kcllk..")
        p.Row(21, "..kLllk..kcllk..")
        p.Row(22, "...kkk....kkk...")
    }

    -GloveIcon(HellfeatherItemPicture& p)
    {
        p.Row(1, "..kk.kk.kk.kk...")
        p.Row(2, ".kLLkLLkLLkLlk..")
        p.Row(3, ".kLlkLlkLlkLlk..")
        p.Row(4, ".kLlkLlkLlkLlk..")
        p.Row(5, ".kLlkLlkLlkLlkk.")
        p.Row(6, ".kLLLLLLLLLLlklk")
        p.Row(7, ".kLLLLLLLLLlllLk")
        p.Row(8, ".kLLLLLLLLllLlk.")
        p.Row(9, ".kLLLLLLLlllkk..")
        p.Row(10, "..kLLLLlllllk...")
        p.Row(11, "..kgggggGGGGk...")
        p.Row(12, "..kcclccclcck...")
        p.Row(13, "..kcclccclcck...")
        p.Row(14, "...kkkkkkkkk....")
    }

    -BootIcon(HellfeatherItemPicture& p)
