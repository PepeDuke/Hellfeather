// The people of Ravenford who trade, each with shelves of their own: Edda at
// the Rookery keeps potions, portals and charms, Marra at the Needlehouse
// coats, boots and mended armour, and Moth, once he is introduced, runes and
// blades. Trade is a reply in their conversation. The shop window shows one
// merchant's shelves at a time; the others wait in a stash, so what one sells
// or buys back stays with them.
HellfeatherMerchant : int
#@{
    None: -1,
    Edda,
    Marra,
    Moth,
    // Edda's ravens: base gear wrapped up, bought blind with black feathers.
    Ravens
}

HellfeatherMerchants
#{
    // World units along the ground beyond which a shop closes.
    #float LeaveReach = 4.5

    string Title(HellfeatherMerchant merchant)
    {
        if merchant == HellfeatherMerchant.Edda { return "THE ROOKERY" }
        if merchant == HellfeatherMerchant.Marra { return "SENN'S NEEDLEHOUSE" }
        if merchant == HellfeatherMerchant.Moth { return "THE LANTERN & MOTH" }
        if merchant == HellfeatherMerchant.Ravens { return "THE RAVENS' HOARD" }
        return "SHOP"
    }

    // Two short lines on what a merchant sells.
    string BlurbOne(HellfeatherMerchant merchant)
    {
        if merchant == HellfeatherMerchant.Edda { return "Potions, portals and" }
        if merchant == HellfeatherMerchant.Marra { return "Coats, boots, belts" }
        if merchant == HellfeatherMerchant.Moth { return "Runes and blades," }
        if merchant == HellfeatherMerchant.Ravens { return "Finds off the dead," }
        return ""
    }

    string BlurbTwo(HellfeatherMerchant merchant)
    {
        if merchant == HellfeatherMerchant.Edda { return "charms for the road." }
        if merchant == HellfeatherMerchant.Marra { return "and mended armour." }
        if merchant == HellfeatherMerchant.Moth { return "no questions asked." }
        if merchant == HellfeatherMerchant.Ravens { return "wrapped. For feathers." }
        return ""
    }

    HellfeatherPerson PersonOf(HellfeatherMerchant merchant)
    {
        if merchant == HellfeatherMerchant.Edda { return HellfeatherPerson.Edda }
        if merchant == HellfeatherMerchant.Marra { return HellfeatherPerson.Marra }
        if merchant == HellfeatherMerchant.Moth { return HellfeatherPerson.Moth }
        if merchant == HellfeatherMerchant.Ravens { return HellfeatherPerson.Edda }
        return HellfeatherPerson.None
    }

    HellfeatherMerchant Of(HellfeatherPerson person)
    {
        if person == HellfeatherPerson.Edda { return HellfeatherMerchant.Edda }
        if person == HellfeatherPerson.Marra { return HellfeatherMerchant.Marra }
        if person == HellfeatherPerson.Moth { return HellfeatherMerchant.Moth }
        return HellfeatherMerchant.None
    }
}

HellfeatherGame : QuaxelGameInstance
{
    // Whose shelves the shop window holds, or None before anyone traded.
    HellfeatherMerchant Trading = HellfeatherMerchant.None
    // Whether the bag was opened for trading, so it closes with the shop.
    bool BagForTrade

    // Fills every merchant's shelves and puts them all in the stash.
    StockMerchants(uint seed)
    {
        Shop.Shop.Stock.Clear()
        Shop.Shop.ClearStash()
        Trading = HellfeatherMerchant.None
        for merchant : HellfeatherMerchant {
            if merchant == HellfeatherMerchant.None { continue }
            Shop.Shop.RestockFor(merchant, seed + (uint)(merchant + 1) * (uint)7919)
            Shop.Shop.Stash(merchant + 0)
        }
    }

    // Whether a person trades with her yet. Moth opens only once he knows her.
    bool Sells(HellfeatherPerson person)
    {
        HellfeatherMerchant merchant = HellfeatherMerchants.Of(person)
        if merchant == HellfeatherMerchant.None { return false }
        if merchant == HellfeatherMerchant.Moth { return Quests.Dark >= 3 }
        return true
    }

    // Opens a merchant's shop on the right with the inventory beside it on the left.
    OpenShop(HellfeatherMerchant merchant)
    {
        if merchant == HellfeatherMerchant.None { return }
        if Trading != merchant {
            if Trading != HellfeatherMerchant.None { Shop.Shop.Stash(Trading + 0) }
            Shop.Shop.Unstash(merchant + 0)
            Trading = merchant
        }
        Shop.Shop.ForFeathers = merchant == HellfeatherMerchant.Ravens
        Shop.Title = HellfeatherMerchants.Title(merchant)
        Shop.BlurbOne = HellfeatherMerchants.BlurbOne(merchant)
        Shop.BlurbTwo = HellfeatherMerchants.BlurbTwo(merchant)
        Shop.Open = true
        // The shop takes the left side, so the panels there close, and the bag
        // opens in its place on the right.
        StatsScreen.Open = false
        Passives.Open = false
        Runes.Open = false
        QuestLog.Open = false
        BagForTrade = true
        if !Inventory.Open { Inventory.Toggle() }
    }

    // What the shop window's prices are paid from: gold, or feathers at the hoard.
    int Purse() { return Shop.Shop.ForFeathers ? Inventory.Items.FeatherCount() | Inventory.Items.Gold }

    // Buys a wrapped find from the hoard: its rarity is rolled only now, and
    // another find takes its place on the shelf.
    -BuyFromHoard(int index)
    {
        item : Shop.Shop.Stock[index].Item
        int price = Shop.Shop.PriceOf(index)
        HellfeatherItemMods mods = HellfeatherShop.RollHoard(item, Spawner.LootRandom.Unit(), Spawner.LootRandom.Below(1000000))
        if !Inventory.Items.AddWith(item, mods) {
            Shop.Say("No room in your bag")
            return
        }
        Inventory.Items.TakeStack(HellfeatherItems.BlackFeather, price)
        Shop.Shop.Take(index)
        Shop.Shop.AddHoardFind()
        HellfeatherItemKind kind = HellfeatherItems.Get(item)
        if mods.Rarity == HellfeatherRarity.Rare { Banner.Show("A rare " + kind.Name + "!", 2.5) }
        else if mods.Rarity == HellfeatherRarity.Magic { Banner.Show("A magic " + kind.Name, 2.0) }
        else { Banner.Show("Just a plain " + kind.Name, 2.0) }
    }

    // True when she has walked away from whoever she is trading with.
    -bool FarFromMerchant(QuaxelWorld& world) { return FarFromMerchantPerson(world, HellfeatherMerchants.PersonOf(Trading)) }

    -bool FarFromMerchantPerson(QuaxelWorld& world, HellfeatherPerson person)
    {
        int spot = People.FindPerson(person)
        if spot < 0 { return true }
        vec3 feet = People.Spots[spot].Feet
        vec3 player = world.GetPosition(PlayerNode)
        return Math.Hypot(feet.X - player.X, feet.Z - player.Z) > HellfeatherMerchants.LeaveReach
    }
}
T{
    EachMerchantSellsTheirOwnTrade()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.OpenShop(HellfeatherMerchant.Edda)
        T.IsTrue(game.Shop.Shop.Stock[0].Item == HellfeatherItems.HealthPotion)
        T.AreEqual(game.Shop.Title, "THE ROOKERY")
        game.OpenShop(HellfeatherMerchant.Marra)
        T.IsTrue(game.Shop.Shop.Stock[0].Item == HellfeatherItems.LeatherArmor)
        T.IsFalse(game.Shop.Shop.HasEndless(HellfeatherItems.HealthPotion))
        game.OpenShop(HellfeatherMerchant.Moth)
        T.IsTrue(game.Shop.Shop.Stock[0].Item == HellfeatherItems.RuneCleave)
    }

    WhatAMerchantSoldStaysSoldAfterVisitingAnother()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.OpenShop(HellfeatherMerchant.Marra)
        long shelved = game.Shop.Shop.Stock.Len
        game.Inventory.Items.Gold = 100000
        game.Shop.BuyRequest = 0
        game.ApplyShopRequests()
        T.AreEqual(game.Shop.Shop.Stock.Len, shelved - 1)
        game.OpenShop(HellfeatherMerchant.Edda)
        game.OpenShop(HellfeatherMerchant.Marra)
        T.AreEqual(game.Shop.Shop.Stock.Len, shelved - 1)
    }

    MothTradesOnlyOnceHeKnowsHer()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        T.IsTrue(game.Sells(HellfeatherPerson.Edda))
        T.IsTrue(game.Sells(HellfeatherPerson.Marra))
        T.IsFalse(game.Sells(HellfeatherPerson.Moth))
        T.IsFalse(game.Sells(HellfeatherPerson.Matthew))
        game.Quests.Dark = 3
        T.IsTrue(game.Sells(HellfeatherPerson.Moth))
        // Trade is a reply in a merchant's conversation, and opens their shop.
        int edda = game.People.FindPerson(HellfeatherPerson.Edda)
        game.Use(world, edda)
        int trade = -1
        for i : 0; i < game.Talk.Replies.Len; i++ {
            if game.Talk.Replies[i] == HellfeatherReply.Browse { trade = (int)i }
        }
        T.IsTrue(trade >= 0)
        game.Answer(world, HellfeatherReply.Browse)
        T.IsTrue(game.Shop.Open)
        T.IsTrue(game.Trading == HellfeatherMerchant.Edda)
    }

    TradingMovesGoldAndItems()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.OpenShop(HellfeatherMerchant.Edda)
        T.IsTrue(game.Shop.Open)
        T.IsTrue(game.Inventory.Open)
        T.IsTrue(game.BagForTrade)
        game.Inventory.Items.Gold = 100
        // Edda's first shelf holds endless health potions.
        game.Shop.BuyRequest = 0
        game.ApplyShopRequests()
        T.AreEqual(game.Inventory.Items.CountOf(HellfeatherItems.HealthPotion), 1)
        T.AreEqual(game.Inventory.Items.Gold, 100 - game.Shop.Shop.PriceOf(0))
        game.Inventory.Items.Gold = 5
        game.Shop.BuyRequest = 0
        game.ApplyShopRequests()
        T.AreEqual(game.Inventory.Items.CountOf(HellfeatherItems.HealthPotion), 1)
        game.Inventory.Items.Held = HellfeatherItems.Ring
        game.Shop.SellRequest = true
        game.ApplyShopRequests()
        T.AreEqual(game.Inventory.Items.Held, HellfeatherItems.None)
        T.AreEqual(game.Inventory.Items.Gold, 60)
    }

    WalkingAwayClosesBothWindows()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        vec3 feet = game.People.Spots[game.People.FindPerson(HellfeatherPerson.Edda)].Feet
        QuaxelTransform pose = world.GetTransform(game.PlayerNode)
        pose.Position = vec3(feet.X - 2.0, pose.Position.Y, feet.Z)
        world.SetTransform(game.PlayerNode, pose)
        game.OpenShop(HellfeatherMerchant.Edda)
        game.SyncShop(world)
        T.IsTrue(game.Shop.Open)
        pose.Position = vec3(feet.X - 8.0, pose.Position.Y, feet.Z)
        world.SetTransform(game.PlayerNode, pose)
        game.SyncShop(world)
        T.IsFalse(game.Shop.Open)
        T.IsFalse(game.Inventory.Open)
        T.IsFalse(game.BagForTrade)
    }

    // The price the bag shows while trading is what the merchant then pays.
    TheBagShowsWhatAMerchantPays()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.OpenShop(HellfeatherMerchant.Marra)
        HellfeatherItemMods magic = HellfeatherItemMods.RollAs(HellfeatherItems.Gloves, HellfeatherRarity.Magic, 7)
        int shown = HellfeatherShop.SellValue(HellfeatherItems.Gloves, magic)
        game.Inventory.Items.Gold = 0
        game.Inventory.Items.Held = HellfeatherItems.Gloves
        game.Inventory.Items.HeldMods = magic
        game.Shop.SellRequest = true
        game.ApplyShopRequests()
        T.AreEqual(game.Inventory.Items.Gold, shown)
        T.IsTrue(shown > HellfeatherShop.SellValue(HellfeatherItems.Gloves, game.Inventory.Items.HeldMods))
    }

    // The hoard shows plain bases priced in feathers, and buying one rolls it:
    // the feathers go, the item comes, and another find fills the shelf.
    TheRavensTradeWrappedFindsForFeathers()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.OpenShop(HellfeatherMerchant.Ravens)
        T.IsTrue(game.Shop.Shop.ForFeathers)
        long shelved = game.Shop.Shop.Stock.Len
        T.IsTrue(shelved >= 8)
        for entry : game.Shop.Shop.Stock { T.IsTrue(entry.Mods.Rarity == HellfeatherRarity.Common && entry.Mods.Count == 0) }
        int price = game.Shop.Shop.PriceOf(0)
        T.IsTrue(price >= 2)
        // Gold buys nothing here.
        long carried = game.Inventory.Items.Bag.Len
        game.Inventory.Items.Gold = 100000
        game.Shop.BuyRequest = 0
        game.ApplyShopRequests()
        T.AreEqual(game.Inventory.Items.Bag.Len, carried)
        game.Inventory.Items.AddStack(HellfeatherItems.BlackFeather, price + 2)
        item : game.Shop.Shop.Stock[0].Item
        int before = game.Inventory.Items.CountOf(item)
        game.Shop.BuyRequest = 0
        game.ApplyShopRequests()
        T.AreEqual(game.Inventory.Items.FeatherCount(), 2)
        T.AreEqual(game.Inventory.Items.Gold, 100000)
        T.AreEqual(game.Inventory.Items.CountOf(item), before + 1)
        T.AreEqual(game.Shop.Shop.Stock.Len, shelved)
        // The ravens don't buy, and other merchants don't take feathers.
        game.Inventory.Items.Held = HellfeatherItems.Ring
        game.Shop.SellRequest = true
        game.ApplyShopRequests()
        T.IsTrue(game.Inventory.Items.Held == HellfeatherItems.Ring)
        game.OpenShop(HellfeatherMerchant.Edda)
        T.IsFalse(game.Shop.Shop.ForFeathers)
        game.Inventory.Items.ClearHeld()
        game.Inventory.Items.Held = HellfeatherItems.BlackFeather
        game.Shop.SellRequest = true
        game.ApplyShopRequests()
        T.IsTrue(game.Inventory.Items.Held == HellfeatherItems.BlackFeather)
    }

    // Over many buys some finds come out magic and a few rare.
    HoardFindsAreSometimesMagicAndRarelyRare()
    {
        int magic = 0
        int rare = 0
        for n : 0; n < 400; n++ {
            HellfeatherItemMods mods = HellfeatherShop.RollHoard(HellfeatherItems.Ring, (float)n / 400.0, n)
            if mods.Rarity == HellfeatherRarity.Magic { magic++ }
            if mods.Rarity == HellfeatherRarity.Rare { rare++ }
        }
        T.IsTrue(rare > 20 && rare < 70)
        T.IsTrue(magic > 100 && magic < 200)
    }

    // Edda offers the hoard in every conversation.
    EddaOffersTheHoard()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.Use(world, game.People.FindPerson(HellfeatherPerson.Edda))
        bool offered = false
        for reply : game.Talk.Replies { if reply == HellfeatherReply.Hoard { offered = true } }
        T.IsTrue(offered)
        game.Answer(world, HellfeatherReply.Hoard)
        T.IsTrue(game.Shop.Open)
        T.IsTrue(game.Trading == HellfeatherMerchant.Ravens)
        T.AreEqual(game.Shop.Title, "THE RAVENS' HOARD")
    }

    ClosingTheInventoryClosesTheShop()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.OpenShop(HellfeatherMerchant.Edda)
        game.Inventory.Toggle()
        game.SyncShop(world)
        T.IsFalse(game.Shop.Open)
        T.IsFalse(game.BagForTrade)
    }
}
