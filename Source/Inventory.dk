// What kind of equipment an item is. None cannot be worn.
HellfeatherGear : int
#@{
    None,
    Head,
    Neck,
    Body,
    Weapon,
    Shield,
    Hands,
    Ring,
    Waist,
    Feet
}

// The ten places the warrior can wear something.
HellfeatherSlot : int
#@{
    Head,
    Neck,
    Body,
    MainHand,
    OffHand,
    Hands,
    LeftRing,
    Waist,
    RightRing,
    Feet
}

HellfeatherSlot
#{
    HellfeatherGear GearOf(HellfeatherSlot slot)
    {
        if slot == HellfeatherSlot.Head { return HellfeatherGear.Head }
        if slot == HellfeatherSlot.Neck { return HellfeatherGear.Neck }
        if slot == HellfeatherSlot.Body { return HellfeatherGear.Body }
        if slot == HellfeatherSlot.MainHand { return HellfeatherGear.Weapon }
        if slot == HellfeatherSlot.OffHand { return HellfeatherGear.Shield }
        if slot == HellfeatherSlot.Hands { return HellfeatherGear.Hands }
        if slot == HellfeatherSlot.LeftRing || slot == HellfeatherSlot.RightRing { return HellfeatherGear.Ring }
        if slot == HellfeatherSlot.Waist { return HellfeatherGear.Waist }
        if slot == HellfeatherSlot.Feet { return HellfeatherGear.Feet }
        return HellfeatherGear.None
    }
}

// Width and Height are in backpack cells.
HellfeatherItemKind
{
    string Name
    string Detail
    int Width = 1
    int Height = 1
    HellfeatherGear Gear
    // What the shopkeeper asks for it, in gold. He pays a quarter of this, or
    // all of it for a valuable.
    int Price
}

HellfeatherItems : int
#@{
    None,
    BattleAxe,
    ShortSword,
    RoundShield,
    IronHelm,
    LeatherArmor,
    Gloves,
    Boots,
    Belt,
    Ring,
    Amulet,
    HealthPotion,
    ManaPotion,
    // Valuables: they do nothing but sell well.
    GoldenKey,
    Scroll,
    // Only ever a pile on the ground. Taking it adds to the purse, not the bag.
    Gold,
    // Runes sit on the rune board, where each grants an active skill.
    RuneCleave,
    RuneWarCry,
    RuneDash,
    // Act I. Black feathers stack in the bag, FeatherStack to a cell. Edda
    // wants some, and her ravens trade their finds for more.
    BlackFeather,
    TitheBracelet,
    BlackHoney,
    LanternToken,
    GreyKey,
    EddasQuillCharm,
    JessasWaterwalkers,
    MarrasThimble,
    MardrasRingShards,
    GreyneckQuill,
    MillstoneMaul,
    // Wren's own cap from the mines, its lamp still lit. She starts in it.
    MinersHelmet,
    // Bought at the shop and kept as a count, as feathers are. Each opens one
    // portal home to Ravenford.
    RavenPortal,
    // Wren's own woodsman's axe. She starts with it.
    HandAxe,
    // Bases that drop only in later zones; the loot tables in Source/EnemyData.dk
    // give each the zone level it needs.
    Falchion,
    FlangedMace,
    KiteShield,
    ChainCoif,
    GreatHelm,
    RingMail,
    ScaleMail,
    ChainGloves,
    Gauntlets,
    ChainBoots,
    PlateBoots,
    HeavyBelt,
    PlatedBelt,
    GarnetRing,
    RavenAmulet,
    // Rare valuables. The orb is a holy relic best not counted to five; the egg
    // is from the white cormorants the fen folk fish with.
    HolyOrb,
    EggsileEgg
}

HellfeatherItems
#{
    -HellfeatherItemKind Make(string title, string detail, int width, int height, HellfeatherGear gear, int price)
    {
        HellfeatherItemKind kind
        kind.Name = title
        kind.Detail = detail
        kind.Width = width
        kind.Height = height
        kind.Gear = gear
        kind.Price = price
        return kind
    }

    HellfeatherItemKind Get(HellfeatherItems item)
    {
        if item == HellfeatherItems.BattleAxe { return Make("Battle Axe", "Damage 16-24", 2, 3, HellfeatherGear.Weapon, 300) }
        if item == HellfeatherItems.ShortSword { return Make("Short Sword", "Damage 9-15", 1, 3, HellfeatherGear.Weapon, 120) }
        if item == HellfeatherItems.RoundShield { return Make("Round Shield", "Defense 8", 2, 2, HellfeatherGear.Shield, 100) }
        if item == HellfeatherItems.IronHelm { return Make("Iron Helm", "Defense 5", 2, 2, HellfeatherGear.Head, 90) }
        if item == HellfeatherItems.LeatherArmor { return Make("Leather Armor", "Defense 12", 2, 3, HellfeatherGear.Body, 160) }
        if item == HellfeatherItems.Gloves { return Make("Hide Gloves", "Defense 2", 2, 2, HellfeatherGear.Hands, 45) }
        if item == HellfeatherItems.Boots { return Make("Worn Boots", "Defense 2", 2, 2, HellfeatherGear.Feet, 50) }
        if item == HellfeatherItems.Belt { return Make("Leather Belt", "Defense 1", 2, 1, HellfeatherGear.Waist, 35) }
        if item == HellfeatherItems.Ring { return Make("Silver Ring", "Luck 1", 1, 1, HellfeatherGear.Ring, 220) }
        if item == HellfeatherItems.Amulet { return Make("Ember Amulet", "Fire ward 3", 1, 1, HellfeatherGear.Neck, 260) }
        if item == HellfeatherItems.HealthPotion { return Make("Health Potion", "Restores 40 HP", 1, 1, HellfeatherGear.None, 30) }
        if item == HellfeatherItems.ManaPotion { return Make("Mana Potion", "Restores 30 MP", 1, 1, HellfeatherGear.None, 30) }
        if item == HellfeatherItems.GoldenKey { return Make("Golden Key", "Fits no lock. Collectors pay well", 1, 1, HellfeatherGear.None, 240) }
        if item == HellfeatherItems.Scroll { return Make("Old Scroll", "Faded writing. Scholars pay well", 1, 1, HellfeatherGear.None, 160) }
        if item == HellfeatherItems.Gold { return Make("Gold", "Coins", 1, 1, HellfeatherGear.None, 0) }
        if item == HellfeatherItems.RuneCleave { return Make("Cleave Rune", "War rune: Cleave", 2, 1, HellfeatherGear.None, 180) }
        if item == HellfeatherItems.RuneWarCry { return Make("War Cry Rune", "War rune: War Cry", 2, 2, HellfeatherGear.None, 260) }
        if item == HellfeatherItems.RuneDash { return Make("Dash Rune", "Wind rune: Dash", 1, 2, HellfeatherGear.None, 180) }
        if item == HellfeatherItems.BlackFeather { return Make("Black Feather", "Edda's ravens trade for these", 1, 1, HellfeatherGear.None, 0) }
        if item == HellfeatherItems.TitheBracelet { return Make("Tithe Bracelet", "Tin. Warm, somehow", 1, 1, HellfeatherGear.None, 5) }
        if item == HellfeatherItems.BlackHoney { return Make("Black Honey", "Double damage, 20 s", 1, 1, HellfeatherGear.None, 0) }
        if item == HellfeatherItems.LanternToken { return Make("Lantern Token", "Lantern & Moth", 1, 1, HellfeatherGear.None, 0) }
        if item == HellfeatherItems.GreyKey { return Make("Grey Key", "The Ringwright's ring", 1, 1, HellfeatherGear.None, 0) }
        if item == HellfeatherItems.EddasQuillCharm { return Make("Edda's Quill Charm", "Health 15, Defense 3", 1, 1, HellfeatherGear.Neck, 400) }
        if item == HellfeatherItems.JessasWaterwalkers { return Make("Jessa's Waterwalkers", "Defense 4, Speed 15%", 2, 2, HellfeatherGear.Feet, 450) }
        if item == HellfeatherItems.MarrasThimble { return Make("Marra's Thimble", "Defense 6, Strength 3", 1, 1, HellfeatherGear.Ring, 420) }
        if item == HellfeatherItems.MardrasRingShards { return Make("Mardra's Ring Shards", "Heal 2 per hit", 1, 1, HellfeatherGear.Neck, 600) }
        if item == HellfeatherItems.GreyneckQuill { return Make("Greyneck's Quill", "Agility 6", 1, 1, HellfeatherGear.Neck, 380) }
        if item == HellfeatherItems.MillstoneMaul { return Make("Millstone Maul", "Damage 24-40", 2, 3, HellfeatherGear.Weapon, 520) }
        if item == HellfeatherItems.MinersHelmet { return Make("Miner's Helmet", "Defense 2", 2, 2, HellfeatherGear.Head, 40) }
        if item == HellfeatherItems.RavenPortal { return Make("Raven Portal", "Opens a way to town: H", 1, 1, HellfeatherGear.None, 50) }
        if item == HellfeatherItems.HandAxe { return Make("Hand Axe", "Damage 10", 1, 3, HellfeatherGear.Weapon, 60) }
        if item == HellfeatherItems.Falchion { return Make("Falchion", "Damage 16", 1, 3, HellfeatherGear.Weapon, 220) }
        if item == HellfeatherItems.FlangedMace { return Make("Flanged Mace", "Damage 26", 1, 3, HellfeatherGear.Weapon, 400) }
        if item == HellfeatherItems.KiteShield { return Make("Kite Shield", "Defense 14", 2, 3, HellfeatherGear.Shield, 240) }
        if item == HellfeatherItems.ChainCoif { return Make("Chain Coif", "Defense 8", 2, 2, HellfeatherGear.Head, 150) }
        if item == HellfeatherItems.GreatHelm { return Make("Great Helm", "Defense 12", 2, 2, HellfeatherGear.Head, 320) }
        if item == HellfeatherItems.RingMail { return Make("Ring Mail", "Defense 20", 2, 3, HellfeatherGear.Body, 280) }
        if item == HellfeatherItems.ScaleMail { return Make("Scale Mail", "Defense 30", 2, 3, HellfeatherGear.Body, 480) }
        if item == HellfeatherItems.ChainGloves { return Make("Chain Gloves", "Defense 5", 2, 2, HellfeatherGear.Hands, 120) }
        if item == HellfeatherItems.Gauntlets { return Make("Gauntlets", "Defense 9", 2, 2, HellfeatherGear.Hands, 260) }
        if item == HellfeatherItems.ChainBoots { return Make("Chain Boots", "Defense 5", 2, 2, HellfeatherGear.Feet, 120) }
        if item == HellfeatherItems.PlateBoots { return Make("Plate Boots", "Defense 9", 2, 2, HellfeatherGear.Feet, 260) }
        if item == HellfeatherItems.HeavyBelt { return Make("Heavy Belt", "Defense 4", 2, 1, HellfeatherGear.Waist, 100) }
        if item == HellfeatherItems.PlatedBelt { return Make("Plated Belt", "Defense 7", 2, 1, HellfeatherGear.Waist, 220) }
        if item == HellfeatherItems.GarnetRing { return Make("Garnet Ring", "Strength 2", 1, 1, HellfeatherGear.Ring, 300) }
        if item == HellfeatherItems.RavenAmulet { return Make("Raven Amulet", "Mana 15", 1, 1, HellfeatherGear.Neck, 360) }
        if item == HellfeatherItems.HolyOrb { return Make("Holy Orb of Antioch", "Count to three. Five is right out", 1, 1, HellfeatherGear.None, 450) }
        if item == HellfeatherItems.EggsileEgg { return Make("White Cormorant Egg", "Found on the Path of Eggsile", 1, 1, HellfeatherGear.None, 300) }
        return Make("", "", 1, 1, HellfeatherGear.None, 0)
    }

    // Quest items carry the story: clues and keys. They show in their own
    // color and no merchant will buy them, so none is sold by mistake.
    bool IsQuest(HellfeatherItems item)
    {
        return item == HellfeatherItems.LanternToken || item == HellfeatherItems.GreyKey || item == HellfeatherItems.TitheBracelet || item == HellfeatherItems.BlackHoney
    }

    // Valuables do nothing themselves: they are found to be sold, and merchants
    // pay their full price for them rather than a quarter.
    bool IsValuable(HellfeatherItems item)
    {
        return item == HellfeatherItems.GoldenKey || item == HellfeatherItems.Scroll || item == HellfeatherItems.HolyOrb || item == HellfeatherItems.EggsileEgg
    }

    // How many of an item one bag cell holds. Only black feathers stack.
    int StackMost(HellfeatherItems item) { return item == HellfeatherItems.BlackFeather ? FeatherStack | 1 }
    #int FeatherStack = 5
}

// An item in the backpack. X and Y are its top-left cell.
HellfeatherBagEntry
{
    HellfeatherItems Item
    HellfeatherItemMods Mods
    int X
    int Y
}

// What the warrior carries. Held is the item on the mouse cursor. Each item's
// mods sit beside it: EquippedMods for each slot and HeldMods for the cursor.
HellfeatherInventory
{
    HellfeatherItems [10] Equipped
    HellfeatherItemMods [10] EquippedMods
    HellfeatherBagEntry [] Bag
    HellfeatherItems Held
    HellfeatherItemMods HeldMods
    int Gold
    // Raven portals, counted like feathers, at most MaxPortals.
    int Portals

    // Adds portals up to the most she can carry. False if she has no room for one.
    bool AddPortals(int count)
    {
        if Portals >= HellfeatherInventory.MaxPortals { return false }
        Portals = Math.Min(HellfeatherInventory.MaxPortals, Portals + count)
        return true
    }

    // The index of the bag entry covering a cell, or -1.
    int EntryAt(int x, int y)
    {
        for i : 0; i < Bag.Len; i++ {
            HellfeatherItemKind kind = HellfeatherItems.Get(Bag[i].Item)
            if x >= Bag[i].X && y >= Bag[i].Y && x < Bag[i].X + kind.Width && y < Bag[i].Y + kind.Height { return i }
        }
        return -1
    }

    bool InBounds(HellfeatherItems item, int x, int y)
    {
        HellfeatherItemKind kind = HellfeatherItems.Get(item)
        return x >= 0 && y >= 0 && x + kind.Width <= Columns && y + kind.Height <= Rows
    }

    // How many separate bag entries an item would overlap at this position.
    int CountOverlaps(HellfeatherItems item, int x, int y, int& only)
    {
        HellfeatherItemKind kind = HellfeatherItems.Get(item)
        int count = 0
        only = -1
        for i : 0; i < Bag.Len; i++ {
            HellfeatherItemKind other = HellfeatherItems.Get(Bag[i].Item)
            if x < Bag[i].X + other.Width && Bag[i].X < x + kind.Width && y < Bag[i].Y + other.Height && Bag[i].Y < y + kind.Height {
                count++
                only = i
            }
        }
        return count
    }

    bool IsFree(HellfeatherItems item, int x, int y)
    {
        int only = -1
        return InBounds(item, x, y) && CountOverlaps(item, x, y, only) == 0
    }

    PutAt(HellfeatherItems item, int x, int y)
    {
        HellfeatherItemMods none
        none.Clear()
        PutWithAt(item, none, x, y)
    }

    PutWithAt(HellfeatherItems item, HellfeatherItemMods mods, int x, int y)
    {
        HellfeatherBagEntry entry
        entry.Item = item
        entry.Mods = mods
        entry.X = x
        entry.Y = y
        Bag += entry
    }

    // Puts an item on the cursor. A different item does not keep the old mods.
    ReplaceHeld(HellfeatherItems item)
    {
        if item == Held { return }
        Held = item
        HeldMods.Clear()
    }

    ClearHeld()
    {
        Held = HellfeatherItems.None
        HeldMods.Clear()
    }

    -RemoveEntry(int index)
    {
        Bag[index] = Bag[(int)Bag.Len - 1]
        Bag--
    }

    // Finds the first space that fits, scanning columns from the left.
    bool Add(HellfeatherItems item)
    {
        HellfeatherItemMods none
        none.Clear()
        return AddWith(item, none)
    }

    // A stacking item tops up a stack that has room for all of it first.
    bool AddWith(HellfeatherItems item, HellfeatherItemMods mods)
    {
        int most = HellfeatherItems.StackMost(item)
        if most > 1 {
            for i : 0; i < Bag.Len; i++ {
                if Bag[i].Item != item || Bag[i].Mods.Amount() + mods.Amount() > most { continue }
                Bag[i].Mods.Stack = Bag[i].Mods.Amount() + mods.Amount()
                return true
            }
        }
        return PlaceNew(item, mods)
    }

    -bool PlaceNew(HellfeatherItems item, HellfeatherItemMods mods)
    {
        for x : 0; x < Columns; x++ {
            for y : 0; y < Rows; y++ {
                if IsFree(item, x, y) {
                    PutWithAt(item, mods, x, y)
                    return true
                }
            }
        }
        return false
    }

    // Adds a number of a stacking item, filling the stacks there are and then
    // new cells. Returns how many did not fit.
    int AddStack(HellfeatherItems item, int amount)
    {
        int most = HellfeatherItems.StackMost(item)
        for i : 0; i < Bag.Len; i++ {
            if amount <= 0 { break }
            if Bag[i].Item != item || Bag[i].Mods.Amount() >= most { continue }
            int take = Math.Min(most - Bag[i].Mods.Amount(), amount)
            Bag[i].Mods.Stack = Bag[i].Mods.Amount() + take
            amount -= take
        }
        while amount > 0 {
            HellfeatherItemMods stack
            stack.Clear()
            stack.Stack = Math.Min(most, amount)
            if !PlaceNew(item, stack) { return amount }
            amount -= stack.Stack
        }
        return 0
    }

    // How many of an item the bag and the cursor hold, stacks counted in full.
    int AmountOf(HellfeatherItems item)
    {
        int amount = 0
        for entry : Bag {
            if entry.Item == item { amount += entry.Mods.Amount() }
        }
        if Held == item { amount += HeldMods.Amount() }
        return amount
    }

    int FeatherCount() { return AmountOf(HellfeatherItems.BlackFeather) }

    // Takes a number of an item out of the bag, from the last stacks first.
    // False, taking nothing, if the bag holds fewer.
    bool TakeStack(HellfeatherItems item, int amount)
    {
        int inBag = 0
        for entry : Bag {
            if entry.Item == item { inBag += entry.Mods.Amount() }
        }
        if inBag < amount { return false }
        int i = (int)Bag.Len - 1
        while i >= 0 && amount > 0 {
            if Bag[i].Item == item {
                int take = Math.Min(Bag[i].Mods.Amount(), amount)
                amount -= take
                if take == Bag[i].Mods.Amount() { RemoveEntry(i) }
                else { Bag[i].Mods.Stack = Bag[i].Mods.Amount() - take }
            }
            i--
        }
        return true
    }

    // Picks up the item covering a cell. Does nothing while already holding one.
    bool PickUp(int x, int y)
    {
        int index = EntryAt(x, y)
        if Held != HellfeatherItems.None || index < 0 { return false }
        Held = Bag[index].Item
        HeldMods = Bag[index].Mods
        RemoveEntry(index)
        return true
    }

    // True if the held item could go here, alone or by swapping with one item.
    bool CanDrop(int x, int y)
    {
        int only = -1
        return Held != HellfeatherItems.None && InBounds(Held, x, y) && CountOverlaps(Held, x, y, only) <= 1
    }

    // Places the held item with its top-left at a cell, swapping if it covers one item.
    bool Drop(int x, int y)
    {
        if !CanDrop(x, y) { return false }
        int only = -1
        CountOverlaps(Held, x, y, only)
        // A stack dropped on a stack of the same fills it, and keeps the rest.
        int most = HellfeatherItems.StackMost(Held)
        if only >= 0 && most > 1 && Bag[only].Item == Held && Bag[only].Mods.Amount() < most {
            int move = Math.Min(most - Bag[only].Mods.Amount(), HeldMods.Amount())
            Bag[only].Mods.Stack = Bag[only].Mods.Amount() + move
            if move >= HeldMods.Amount() { ClearHeld() }
            else { HeldMods.Stack = HeldMods.Amount() - move }
            return true
        }
        swapped : HellfeatherItems.None
        HellfeatherItemMods swappedMods
        swappedMods.Clear()
        if only >= 0 {
            swapped = Bag[only].Item
            swappedMods = Bag[only].Mods
            RemoveEntry(only)
        }
        PutWithAt(Held, HeldMods, x, y)
        Held = swapped
        HeldMods = swappedMods
        return true
    }

    bool Accepts(HellfeatherSlot slot, HellfeatherItems item)
    {
        HellfeatherItemKind kind = HellfeatherItems.Get(item)
        return item != HellfeatherItems.None && kind.Gear == HellfeatherSlot.GearOf(slot)
    }

    // Takes from, fills or swaps an equipment slot, as one click on it would.
    bool ClickSlot(HellfeatherSlot slot)
    {
        if Held != HellfeatherItems.None && !Accepts(slot, Held) { return false }
        if Held == HellfeatherItems.None && Equipped[slot] == HellfeatherItems.None { return false }
        previous : Equipped[slot]
        previousMods : EquippedMods[slot]
        Equipped[slot] = Held
        EquippedMods[slot] = HeldMods
        Held = previous
        HeldMods = previousMods
        return true
    }

    // How many of an item the bag holds.
    int CountOf(HellfeatherItems item)
    {
        int count = 0
        for entry : Bag {
            if entry.Item == item { count++ }
        }
        return count
    }

    // Removes one of an item from the bag. False if there is none.
    bool Consume(HellfeatherItems item)
    {
        for i : 0; i < Bag.Len; i++ {
            if Bag[i].Item == item {
                RemoveEntry(i)
                return true
            }
        }
        return false
    }

    // Puts the held item back in the bag, if it fits.
    StowHeld()
    {
        if Held != HellfeatherItems.None && AddWith(Held, HeldMods) { ClearHeld() }
    }
}
#{
    #int Columns = 10
    #int Rows = 4
    #int MaxPortals = 20
}
T{
    FeathersStackFiveToACell()
    {
        HellfeatherInventory bag
        T.AreEqual(bag.AddStack(HellfeatherItems.BlackFeather, 7), 0)
        T.AreEqual(bag.Bag.Len, 2)
        T.AreEqual(bag.FeatherCount(), 7)
        T.AreEqual(bag.AddStack(HellfeatherItems.BlackFeather, 3), 0)
        T.AreEqual(bag.Bag.Len, 2)
        T.AreEqual(bag.FeatherCount(), 10)
        T.IsFalse(bag.TakeStack(HellfeatherItems.BlackFeather, 11))
        T.AreEqual(bag.FeatherCount(), 10)
        T.IsTrue(bag.TakeStack(HellfeatherItems.BlackFeather, 6))
        T.AreEqual(bag.FeatherCount(), 4)
        T.AreEqual(bag.Bag.Len, 1)
    }

    // Black feathers lie on the ground as thin feathers of their own, a few
    // voxels high and mostly open ground, not a puffed-up copy of an icon.
    BlackFeathersHaveTheirOwnThinModel()
    {
        QuaxelWorld world()
        int height = 0
        int volume = HellfeatherItemArt.BuildModel(world, HellfeatherItems.BlackFeather, height)
        T.IsTrue(volume >= 0)
        T.AreEqual(height, 3)
        int filled = 0
        int size = HellfeatherItemArt.FeatherModel
        for x : 0; x < size; x++ {
            for z : 0; z < size; z++ {
                for y : 0; y < height; y++ {
                    if world.GetVoxel(volume, x, y, z) >= 0 { filled++ }
                }
            }
        }
        T.IsTrue(filled > 60)
        T.IsTrue(filled < size * size / 2)
    }

    // A held stack fills a stack it is dropped on, and keeps what is left over.
    AHeldStackFillsAStackItIsDroppedOn()
    {
        HellfeatherInventory bag
        bag.AddStack(HellfeatherItems.BlackFeather, 2)
        bag.Held = HellfeatherItems.BlackFeather
        bag.HeldMods.Clear()
        bag.HeldMods.Stack = 4
        T.IsTrue(bag.Drop(bag.Bag[0].X, bag.Bag[0].Y))
        T.AreEqual(bag.Bag[0].Mods.Amount(), 5)
        T.IsTrue(bag.Held == HellfeatherItems.BlackFeather)
        T.AreEqual(bag.HeldMods.Amount(), 1)
        T.AreEqual(bag.FeatherCount(), 6)
    }

    ItemsFillTheBagWithoutOverlapping()
    {
        HellfeatherInventory bag
        T.IsTrue(bag.Add(HellfeatherItems.LeatherArmor))
        T.IsTrue(bag.Add(HellfeatherItems.HealthPotion))
        T.AreEqual(bag.EntryAt(1, 2), 0)
        T.AreEqual(bag.EntryAt(0, 3), 1)
        T.AreEqual(bag.EntryAt(2, 0), -1)
    }

    AFullBagRefusesMoreItems()
    {
        HellfeatherInventory bag
        for i : 0; i < 40; i++ { T.IsTrue(bag.Add(HellfeatherItems.HealthPotion)) }
        T.IsFalse(bag.Add(HellfeatherItems.HealthPotion))
        T.AreEqual(bag.Bag.Len, 40)
    }

    TallItemsNeedATallGap()
    {
        HellfeatherInventory bag
        for x : 0; x < 10; x++ { bag.PutAt(HellfeatherItems.HealthPotion, x, 1) }
        T.IsFalse(bag.Add(HellfeatherItems.ShortSword))
        T.IsTrue(bag.Add(HellfeatherItems.Belt))
    }

    PickingUpAndDroppingMovesAnItem()
    {
        HellfeatherInventory bag
        bag.PutAt(HellfeatherItems.BattleAxe, 0, 0)
        T.IsTrue(bag.PickUp(1, 2))
        T.AreEqual(bag.Held, HellfeatherItems.BattleAxe)
        T.AreEqual(bag.Bag.Len, 0)
        T.IsTrue(bag.Drop(4, 1))
        T.AreEqual(bag.Held, HellfeatherItems.None)
        T.AreEqual(bag.EntryAt(5, 3), 0)
    }

    DroppingOnOneItemSwapsAndOnTwoIsRefused()
    {
        HellfeatherInventory bag
        bag.PutAt(HellfeatherItems.HealthPotion, 0, 0)
        bag.PutAt(HellfeatherItems.ManaPotion, 1, 1)
        bag.Held = HellfeatherItems.IronHelm
        T.IsFalse(bag.Drop(0, 0))
        T.AreEqual(bag.Held, HellfeatherItems.IronHelm)
        HellfeatherInventory swap
        swap.PutAt(HellfeatherItems.HealthPotion, 0, 0)
        swap.Held = HellfeatherItems.IronHelm
        T.IsTrue(swap.Drop(0, 0))
        T.AreEqual(swap.Held, HellfeatherItems.HealthPotion)
    }

    ItemsCannotHangOffTheBag()
    {
        HellfeatherInventory bag
        bag.Held = HellfeatherItems.LeatherArmor
        T.IsFalse(bag.CanDrop(9, 0))
        T.IsFalse(bag.CanDrop(0, 2))
        T.IsFalse(bag.CanDrop(-1, 0))
        T.IsTrue(bag.CanDrop(8, 1))
    }

    SlotsOnlyAcceptMatchingGear()
    {
        HellfeatherInventory bag
        bag.Held = HellfeatherItems.HealthPotion
        T.IsFalse(bag.ClickSlot(HellfeatherSlot.Head))
        bag.Held = HellfeatherItems.IronHelm
        T.IsFalse(bag.ClickSlot(HellfeatherSlot.Feet))
        T.IsTrue(bag.ClickSlot(HellfeatherSlot.Head))
        T.AreEqual(bag.Equipped[HellfeatherSlot.Head], HellfeatherItems.IronHelm)
        T.AreEqual(bag.Held, HellfeatherItems.None)
    }

    EitherRingSlotTakesARing()
    {
        HellfeatherInventory bag
        bag.Held = HellfeatherItems.Ring
        T.IsTrue(bag.ClickSlot(HellfeatherSlot.RightRing))
        bag.Held = HellfeatherItems.Ring
        T.IsTrue(bag.ClickSlot(HellfeatherSlot.LeftRing))
    }

    EquippingOverAnItemSwapsIt()
    {
        HellfeatherInventory bag
        bag.Equipped[HellfeatherSlot.MainHand] = HellfeatherItems.BattleAxe
        bag.Held = HellfeatherItems.ShortSword
        T.IsTrue(bag.ClickSlot(HellfeatherSlot.MainHand))
        T.AreEqual(bag.Equipped[HellfeatherSlot.MainHand], HellfeatherItems.ShortSword)
        T.AreEqual(bag.Held, HellfeatherItems.BattleAxe)
    }

    StowingNeedsRoom()
    {
        HellfeatherInventory bag
        bag.Held = HellfeatherItems.Belt
        bag.StowHeld()
        T.AreEqual(bag.Held, HellfeatherItems.None)
        T.AreEqual(bag.Bag.Len, 1)
        HellfeatherInventory full
        for i : 0; i < 40; i++ { full.Add(HellfeatherItems.HealthPotion) }
        full.Held = HellfeatherItems.Belt
        full.StowHeld()
        T.AreEqual(full.Held, HellfeatherItems.Belt)
    }
}
