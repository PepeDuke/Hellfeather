// Scatters the vale's dead trees, rocks and ruins through a clearing, staying
// off the middle where the roads meet.
HellfeatherScatter
#{
    -Offer(HellfeatherProps props, QuaxelTerrainSite site, QuaxelTerrainPlacer& placer, QuaxelRandom& random, int group, int kind)
    {
        for attempt : 0; attempt < 10; attempt++ {
            float angle = random.Range(0.0, 6.2831853)
            float distance = random.Range(6.5, site.Radius - 1.5)
            float x = Math.Cos(angle) * distance
            float z = Math.Sin(angle) * distance
            float size = HellfeatherArt.FineVoxel
            if kind == 0 { placer.OfferProp(group, props.Trees[random.Below(3)], x, z, 5, 40, size) }
            else if kind == 1 { placer.OfferProp(group, props.Rocks[random.Below(3)], x, z, 7, 10, size) }
            else if kind == 2 { placer.OfferProp(group, props.Walls[random.Below(2)], x, z, 14, 13, size) }
            else if kind == 3 { placer.OfferProp(group, props.Banner, x, z, 5, 36, size) }
            else {
                placer.OfferProp(group, props.Brazier, x, z, 4, 20, size)
                placer.AddLight(0, 0, 44)
            }
        }
    }

    Place(HellfeatherProps props, QuaxelTerrainSite site, QuaxelTerrainPlacer& placer)
    {
        QuaxelRandom random
        random.Begin(site.Seed ^ (uint)0x51ED270B)
        int group = 100
        int [5] counts = {9, 8, 3, 2, 2}
        for kind : 0; kind < 5; kind++ {
            for n : 0; n < counts[kind]; n++ {
                Offer(props, site, placer, random, group, kind)
                group++
            }
        }
    }
}

// The default clearing, plain Fenmarch lowland: bare earth, dead trees and old stones.
AshenValley : QuaxelTerrainModule
{
    HellfeatherProps Props

    Place(QuaxelTerrainSite site, QuaxelTerrainPlacer& placer) { HellfeatherScatter.Place(Props, site, placer) }
}

// The Ford Road: a river across the clearing, close to Ravenford. It only paints water; the generator turns the
// parts on a reserved path into a bridge.
RiverCrossing : QuaxelTerrainModule
{
    HellfeatherProps Props

    QuaxelTerrainModuleRules Rules()
    {
        QuaxelTerrainModuleRules rules
        rules.MinRadius = 14.0
        rules.MinPorts = 2
        rules.Isolated = true
        rules.Share = 0.2
        rules.MinDepth = 1
        rules.MaxDepth = 3
        return rules
    }

    Column(QuaxelTerrainSite site, float x, float z, QuaxelTerrainColumn& column)
    {
        if Math.Hypot(x, z) >= site.Radius + 3.0 { return }
        // The river runs across the axis between the two farthest exits, so it
        // always separates them.
        float across = x * site.AxisX + z * site.AxisZ
        float along = z * site.AxisX - x * site.AxisZ
        float meander = QuaxelNoise.SignedFbm(site.Seed, along / 9.0, 0.0, 2) * 2.5
        if Math.Abs(across + meander) < 2.0 { column.MakeWater(5) }
    }

    // Offers props only well clear of the water, which runs through the middle.
    Place(QuaxelTerrainSite site, QuaxelTerrainPlacer& placer)
    {
        QuaxelRandom random
        random.Begin(site.Seed ^ (uint)0x2F0B4C77)
        int group = 100
        for n : 0; n < 16; n++ {
            float side = (n & 1) == 0 ? 1.0 | -1.0
            float across = side * random.Range(7.5, site.Radius - 1.5)
            float along = random.Range(-8.0, 8.0)
            float x = across * site.AxisX - along * site.AxisZ
            float z = across * site.AxisZ + along * site.AxisX
            if n < 8 { placer.OfferProp(group, Props.Trees[n % 3], x, z, 5, 40, HellfeatherArt.FineVoxel) }
            else { placer.OfferProp(group, Props.Rocks[n % 3], x, z, 7, 10, HellfeatherArt.FineVoxel) }
            group++
        }
    }
}

// A croft: one ruined cottage, placed somewhere off the paths.
ValleyHouse : QuaxelTerrainModule
{
    HellfeatherProps Props
    int Volume

    QuaxelTerrainModuleRules Rules()
    {
        QuaxelTerrainModuleRules rules
        rules.MinRadius = 15.0
        rules.Isolated = true
        rules.Share = 0.15
        rules.MinDepth = 2
        return rules
    }

    Place(QuaxelTerrainSite site, QuaxelTerrainPlacer& placer)
    {
        QuaxelRandom random
        random.Begin(site.Seed)
        for attempt : 0; attempt < 60; attempt++ {
            float angle = random.Range(0.0, 6.2831853)
            float distance = random.Range(0.0, site.Radius - 6.0)
            placer.Offer(0, Volume, Math.Cos(angle) * distance, Math.Sin(angle) * distance, HellfeatherHouse.Half, HellfeatherHouse.Height)
        }
        HellfeatherScatter.Place(Props, site, placer)
    }
}

// Routes clearings to Hellfeather's modules and colors the vale. Module IDs are
// the values of HellfeatherZone. To change the default clearing, change the
// Valley field's type.
HellfeatherTerrain : QuaxelTerrain
{
    AshenValley Valley
    HobbsMill Mill
    OrrasHill Hill
    RiverCrossing River
    FennickWater Marsh
    ValleyHouse House
    Ravenford Town
    UndercroftHall Hall
    UndercroftLanding Landing
    // The level being built. Below the Fenmarch, only the Undercroft's modules
    // claim clearings: its halls take every one but the landing.
    HellfeatherRealm Realm

    int ModuleCount() { return HellfeatherZone.Count - 1 }

    int SpawnModule() { return Realm == HellfeatherRealm.Fenmarch ? HellfeatherZone.Ravenford + 0 | HellfeatherZone.UndercroftLanding + 0 }

    // The zone the Undercroft's halls count as on the current level.
    int HallZone() { return Realm == HellfeatherRealm.UndercroftDeep ? HellfeatherZone.UndercroftDeep + 0 | HellfeatherZone.Undercroft + 0 }

    QuaxelTerrainModuleRules ModuleRules(int id)
    {
        if Realm != HellfeatherRealm.Fenmarch {
            if id == HallZone() { return Hall.Rules() }
            if id == HellfeatherZone.UndercroftLanding + 0 { return Landing.Rules() }
            QuaxelTerrainModuleRules none
            return none
        }
        if id >= HellfeatherZone.Undercroft + 0 {
            QuaxelTerrainModuleRules none
            return none
        }
        if id == HellfeatherZone.HobbsMill + 0 { return Mill.Rules() }
        if id == HellfeatherZone.OrrasHill + 0 { return Hill.Rules() }
        if id == HellfeatherZone.FordRoad + 0 { return River.Rules() }
        if id == HellfeatherZone.FennickWater + 0 { return Marsh.Rules() }
        if id == HellfeatherZone.Croft + 0 { return House.Rules() }
        if id == HellfeatherZone.Ravenford + 0 { return Town.Rules() }
        return Valley.Rules()
    }

    ModuleColumn(int id, QuaxelTerrainSite site, float x, float z, QuaxelTerrainColumn& column)
    {
        if id == HellfeatherZone.Undercroft + 0 || id == HellfeatherZone.UndercroftDeep + 0 { Hall.Column(site, x, z, column) }
        else if id == HellfeatherZone.UndercroftLanding + 0 { Landing.Column(site, x, z, column) }
        else if id == HellfeatherZone.HobbsMill + 0 { Mill.Column(site, x, z, column) }
        else if id == HellfeatherZone.OrrasHill + 0 { Hill.Column(site, x, z, column) }
        else if id == HellfeatherZone.FordRoad + 0 { River.Column(site, x, z, column) }
        else if id == HellfeatherZone.FennickWater + 0 { Marsh.Column(site, x, z, column) }
        else if id == HellfeatherZone.Croft + 0 { House.Column(site, x, z, column) }
        else if id == HellfeatherZone.Ravenford + 0 { Town.Column(site, x, z, column) }
        else { Valley.Column(site, x, z, column) }
    }

    ModulePlace(int id, QuaxelTerrainSite site, QuaxelTerrainPlacer& placer)
    {
        if id == HellfeatherZone.Undercroft + 0 || id == HellfeatherZone.UndercroftDeep + 0 { Hall.Place(site, placer) }
        else if id == HellfeatherZone.UndercroftLanding + 0 { Landing.Place(site, placer) }
        else if id == HellfeatherZone.HobbsMill + 0 { Mill.Place(site, placer) }
        else if id == HellfeatherZone.OrrasHill + 0 { Hill.Place(site, placer) }
        else if id == HellfeatherZone.FordRoad + 0 { River.Place(site, placer) }
        else if id == HellfeatherZone.FennickWater + 0 { Marsh.Place(site, placer) }
        else if id == HellfeatherZone.Croft + 0 { House.Place(site, placer) }
        else if id == HellfeatherZone.Ravenford + 0 { Town.Place(site, placer) }
        else { Valley.Place(site, placer) }
    }

    // Colors are chosen as they should look, then converted to linear at the end.
    int SurfaceColor(QuaxelTerrainCell cell)
    {
        int color = 0x3b3128
        if Realm != HellfeatherRealm.Fenmarch && cell.Surface == QuaxelTerrainSurface.Rock { color = CryptColor(cell) }
        else if Realm != HellfeatherRealm.Fenmarch && cell.Surface != HellfeatherSurface.Wire && cell.Surface != HellfeatherSurface.Millpond { color = FlagstoneColor(cell) }
        else if cell.Surface == HellfeatherSurface.Wire { color = WireColor(cell) }
        else if cell.Surface == QuaxelTerrainSurface.Rock { color = RockColor(cell) }
        else if cell.Surface == QuaxelTerrainSurface.Water { color = (cell.Hash % 13) == 0 ? 0x39505a | 0x1e2d36 }
        else if cell.Surface == QuaxelTerrainSurface.Bridge { color = BridgeColor(cell) }
        else if cell.Surface == QuaxelTerrainSurface.Yard { color = EarthColor(cell) }
        else if cell.Surface == QuaxelTerrainSurface.Path { color = RoadColor(cell) }
        else if cell.Surface == HellfeatherSurface.Cobble { color = CobbleColor(cell) }
        else if cell.Surface == HellfeatherSurface.Earth { color = EarthColor(cell) }
        else if cell.Surface == HellfeatherSurface.Mud { color = MudColor(cell) }
        else if cell.Surface == HellfeatherSurface.Millpond { color = MillpondColor(cell) }
        else { color = GroundColor(cell) }
        int light = 100 - (int)(cell.Wall * 42.0)
        return HellfeatherArt.Rgb(HellfeatherArt.Shade(color, light))
    }

    // Rows of stones three columns deep, each row offset from the last.
    -int CobbleColor(QuaxelTerrainCell cell)
    {
        if !cell.Top { return 0x2b2622 }
        int course = cell.Row / 3
        int along = cell.Column + (course & 1) * 2
        if cell.Row % 3 == 0 || along % 4 == 0 { return 0x211d19 }
        int stone = HellfeatherArt.Hash(along / 4, course, 61)
        int tone = (stone & 3) == 0 ? 0x77695a | 0x5f5549
        return HellfeatherArt.Shade(tone, 86 + stone % 26)
    }

    -int EarthColor(QuaxelTerrainCell cell)
    {
        if !cell.Top { return 0x352b21 }
        float patch = QuaxelNoise.Fbm((uint)419, (float)cell.Column / 9.0, (float)cell.Row / 9.0, 2)
        return HellfeatherArt.Shade(0x5f4c38, 70 + (int)(patch * 44.0) + cell.Hash % 8)
    }

    // Wet black earth around Fennick's ponds, with standing water in the hollows.
    -int MudColor(QuaxelTerrainCell cell)
    {
        if !cell.Top { return 0x2a241c }
        if cell.Hash % 7 == 0 { return 0x26322f }
        return HellfeatherArt.Shade(0x3d3326, 72 + cell.Hash % 24)
    }

    // The millpond is fed by the bearers below. Its water carries a faint
    // silver sheen that the plain river does not.
    -int MillpondColor(QuaxelTerrainCell cell)
    {
        if cell.Hash % 9 == 0 { return 0x8fa5ae }
        if cell.Hash % 4 == 0 { return 0x3b5560 }
        return 0x24363d
    }

    -int RoadColor(QuaxelTerrainCell cell)
    {
        if !cell.Top { return 0x382c21 }
        if cell.Hash % 37 == 0 { return 0x8d8373 }
        if cell.Hash % 11 == 0 { return 0x3f3225 }
        float ruts = QuaxelNoise.Fbm((uint)901, (float)cell.Column / 7.0, (float)cell.Row / 7.0, 2)
        return HellfeatherArt.Shade(0x7b654b, 72 + (int)(ruts * 42.0) + cell.Hash % 7)
    }

    -int GroundColor(QuaxelTerrainCell cell)
    {
        float patch = QuaxelNoise.Fbm((uint)773, (float)cell.Column / 26.0, (float)cell.Row / 26.0, 3)
        // Column sides match the ground so small bumps do not draw lines.
        int shade = 74 + (int)(patch * 50.0) + cell.Hash % 8
        if !cell.Top { return HellfeatherArt.Shade(0x4e4233, shade * 84 / 100) }
        if cell.Hash % 89 == 0 { return 0x736d63 }
        // Dry grass thickens gradually toward the middle of each drift.
        if cell.Hash % 100 < (int)(Math.Clamp((patch - 0.42) * 2.4, 0.0, 0.42) * 100.0) {
            return HellfeatherArt.Shade(0x756238, 78 + cell.Hash % 42)
        }
        return HellfeatherArt.Shade(0x4e4233, shade)
    }

    -int RockColor(QuaxelTerrainCell cell)
    {
        if cell.Top {
            if cell.Y >= 88 && cell.Hash % 3 != 0 { return 0x6f6b66 }
            if cell.Hash % 19 == 0 { return 0x5e543f }
            return HellfeatherArt.Shade(0x3c3631, 78 + cell.Hash % 36)
        }
        // Strata, wandering with position so bands do not read as straight lines.
        int band = (cell.Y + (cell.Column + cell.Row) / 23) / 5
        if cell.Hash % 17 == 0 { return 0x171412 }
        int tone = 0x2d2926
        if (band & 3) == 1 { tone = 0x3a342e }
        if (band & 3) == 3 { tone = 0x25211f }
        return HellfeatherArt.Shade(tone, 90 + cell.Hash % 22)
    }

    // Square flags two columns wide, worn and damp, in the Undercroft.
    -int FlagstoneColor(QuaxelTerrainCell cell)
    {
        if !cell.Top { return 0x1d1a17 }
        if cell.Column % 4 == 0 || cell.Row % 4 == 0 { return 0x141210 }
        int stone = HellfeatherArt.Hash(cell.Column / 4, cell.Row / 4, 17)
        int tone = (stone & 3) == 0 ? 0x3a3530 | 0x302c28
        return HellfeatherArt.Shade(tone, 80 + stone % 24 + cell.Hash % 6)
    }

    // Silver wire stapled to the floor. It glints.
    -int WireColor(QuaxelTerrainCell cell)
    {
        if !cell.Top { return 0x1d1a17 }
        return cell.Hash % 5 == 0 ? 0xdfe8ee | 0x8e9aa2
    }

    // The Undercroft's walls: dressed stone low down, bare rock above.
    -int CryptColor(QuaxelTerrainCell cell)
    {
        if cell.Top { return HellfeatherArt.Shade(0x1c1917, 80 + cell.Hash % 20) }
        int course = (cell.Y / 3) & 1
        if cell.Y % 3 == 0 || (cell.Column + cell.Row + course * 3) % 6 == 0 { return 0x0f0d0c }
        return HellfeatherArt.Shade(0x34302b, 74 + cell.Hash % 24)
    }

    -int BridgeColor(QuaxelTerrainCell cell)
    {
        if !cell.Top { return 0x2a2622 }
        if cell.Column % 9 == 0 || cell.Row % 6 == 0 { return 0x24201c }
        return HellfeatherArt.Shade(0x5c544a, 84 + cell.Hash % 30)
    }
}

// A ruined cottage generated in code. One cell matches one terrain column.
HellfeatherHouse
#{
    #int Half = 20
    #int Height = 24
    #int WallHeight = 14

    int Build(QuaxelWorld& world)
    {
        int width = Half * 2
        int volume = world.CreateVolume(width, Height, width)
        if volume < 0 { return -1 }
        for y : 0; y < WallHeight; y++ {
            for x : 0; x < width; x++ {
                for z : 0; z < width; z++ { world.SetVoxel(volume, x, y, z, WallColor(x, y, z, width)) }
            }
        }
        // A gable that narrows by two cells a side per layer, with its ridge along X.
        for y : WallHeight; y < Height; y++ {
            int inset = (y - WallHeight) * 2
            for z : inset; z < width - inset; z++ {
                for x : 0; x < width; x++ {
                    world.SetVoxel(volume, x, y, z, HellfeatherArt.SlateColor(x * 2, (y - WallHeight) * 5 + 1))
                }
            }
        }
        return volume
    }

    // The door and windows face the camera, on the +Z side.
    -int WallColor(int x, int y, int z, int width)
    {
        bool front = z == width - 1
        bool door = front && x >= 17 && x < 23 && y < 10
        bool window = front && y >= 5 && y < 10 && ((x >= 6 && x < 12) || (x >= 28 && x < 34))
        if door { return HellfeatherArt.Rgb(0x2c1a0e) }
        if window { return HellfeatherArt.Rgb(0xd9782a) }
        return HellfeatherArt.StoneColor((x + z) * 2, y * 2, x)
    }
}
