// Live flames and smoke on the braziers and campfires near the player. Fires
// light and go out as the terrain streams their props in and out of range.
HellfeatherFires
{
    -int [] Sources
    -int [] Flames
    -int [] Smokes
    -float Countdown

    // Props farther than this along the ground from the player go out. It
    // matches HellfeatherSpots.WakeRadius, so fires stay lit to the screen corners.
    float Range() { return HellfeatherSpots.WakeRadius }

    // Leaves most of the engine's 64 effects for blood and dust.
    int MaxFires() { return 12 }

    int Burning() { return (int)Sources.Len }

    Step(QuaxelWorld& world, int brazier, int campfire, vec3 player, float deltaSeconds)
    {
        Countdown -= deltaSeconds
        if Countdown > 0.0 { return }
        Countdown = 0.25
        for i : (int)Sources.Len - 1; i >= 0; i-- {
            int source = Sources[i]
            if world.Has(source, QuaxelComponents.Voxels) && Near(world.WorldPosition(source), player) { continue }
            world.StopEffect(Flames[i])
            world.StopEffect(Smokes[i])
            Sources -= [i]
            Flames -= [i]
            Smokes -= [i]
        }
        int mask = QuaxelComponents.Transform | QuaxelComponents.Voxels
        for id : world.NextWith(0, mask); id != 0; id = world.NextWith(id, mask) {
            if Sources.Len >= MaxFires() { return }
            int volume = world.VolumeOf(id)
            if volume < 0 || (volume != brazier && volume != campfire) { continue }
            if Tracking(id) || !Near(world.WorldPosition(id), player) { continue }
            Light(world, id, volume == campfire)
        }
    }

    -bool Tracking(int id)
    {
        for source : Sources {
            if source == id { return true }
        }
        return false
    }

    -bool Near(vec3 a, vec3 b)
    {
        return vec3(b.X - a.X, 0.0, b.Z - a.Z).Length() <= Range()
    }

    // Both props are 40 voxels tall. Flames rise from the brazier's bowl at
    // voxel 17 and from the campfire's logs at voxel 5.
    -Light(QuaxelWorld& world, int id, bool campfire)
    {
        mat4 model = world.VolumeModel(id)
        float base = campfire ? 5.0 | 17.0
        vec3 point = vec3(model * vec4(vec3(0.0, base / 40.0 - 0.5, 0.0), 1.0))
        float cell = vec3(model[1][0], model[1][1], model[1][2]).Length() / 40.0
        vec3 up = vec3(0.0, 1.0, 0.0)

        QuaxelEffectStyle flame = QuaxelEffectStyle.Fire()
        flame.SpawnRadius = cell * (campfire ? 7.0 | 4.5)
        flame.Rate = campfire ? 60.0 | 40.0
        flame.SizeStart = campfire ? 2.4 | 1.8
        flame.LifeMax = campfire ? 0.9 | 0.7

        QuaxelEffectStyle smoke = QuaxelEffectStyle.Smoke()
        smoke.Rate = campfire ? 7.0 | 3.5
        smoke.DensityStart = 0.6

        Sources += id
        Flames += world.StartEffect(flame, point, up)
        Smokes += world.StartEffect(smoke, point + vec3(0.0, 0.3, 0.0), up)
    }
}
