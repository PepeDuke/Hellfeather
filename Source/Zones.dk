// Which zone the warrior stands in, named in the top left corner.
HellfeatherZoneNames
#{
    // The name shown for a clearing of the Fenmarch, by its module.
    string Name(int zone)
    {
        if zone == HellfeatherZone.Ravenford { return "Ravenford" }
        if zone == HellfeatherZone.HobbsMill { return "Hobb's Mill" }
        if zone == HellfeatherZone.OrrasHill { return "Orra's Hill" }
        if zone == HellfeatherZone.FordRoad { return "The Ford Road" }
        if zone == HellfeatherZone.FennickWater { return "Fennick Water" }
        if zone == HellfeatherZone.Croft { return "The Crofts" }
        if zone == HellfeatherZone.Encampment { return HellfeatherQuests.CampName }
        if zone == HellfeatherZone.HospiceRoad { return "The Hospice Road" }
        if zone == HellfeatherZone.Shallows { return "Thornmere Shallows" }
        if zone == HellfeatherZone.Thornwick { return "Thornwick" }
        if zone == HellfeatherZone.Heath { return "The Thornmere" }
        return "The Fenmarch"
    }

    // The area level of a zone, which decides what item bases drop there (the
    // MinLevel and MaxLevel of each LootItem in Source/EnemyData.dk). It rises
    // with the way the story walks Act I, from Ravenford out to the Undercroft.
    int Level(int zone)
    {
        if zone == HellfeatherZone.Croft { return 2 }
        if zone == HellfeatherZone.FordRoad { return 3 }
        if zone == HellfeatherZone.FennickWater { return 5 }
        if zone == HellfeatherZone.OrrasHill { return 7 }
        if zone == HellfeatherZone.HobbsMill { return 9 }
        if zone == HellfeatherZone.Undercroft || zone == HellfeatherZone.UndercroftLanding { return 10 }
        if zone == HellfeatherZone.UndercroftDeep { return 12 }
        if zone == HellfeatherZone.Encampment || zone == HellfeatherZone.Thornwick { return 13 }
        if zone == HellfeatherZone.HospiceRoad { return 13 }
        if zone == HellfeatherZone.Heath { return 14 }
        if zone == HellfeatherZone.Shallows { return 15 }
        if zone == HellfeatherZone.Cloister { return 16 }
        if zone == HellfeatherZone.RecordsCellar { return 17 }
        if zone == HellfeatherZone.SouthWing { return 18 }
        if zone == HellfeatherZone.SouthWingDeep { return 19 }
        if zone == HellfeatherZone.RelayChapel { return 20 }
        return 1
    }

    // Below the Fenmarch a level has one name, wherever she stands in it.
    string RealmName(HellfeatherRealm realm)
    {
        if realm == HellfeatherRealm.Undercroft { return "The Millrace Undercroft" }
        if realm == HellfeatherRealm.UndercroftDeep { return "The Undercroft, deeper" }
        if realm == HellfeatherRealm.Hospice { return "Orra's Hospice" }
        if realm == HellfeatherRealm.Mill { return "Hobb's Mill" }
        if realm == HellfeatherRealm.Garret { return "Jessa's garret" }
        if realm == HellfeatherRealm.RavenfordHouse { return HellfeatherHome.Title(HellfeatherResidence.RavenfordHouse) }
        if realm == HellfeatherRealm.PilgrimTent { return HellfeatherHome.Title(HellfeatherResidence.PilgrimTent) }
        if realm == HellfeatherRealm.Cloister { return "The Cloister of Looms" }
        if realm == HellfeatherRealm.RecordsCellar { return "Saint Orra's: Records Cellar" }
        if realm == HellfeatherRealm.SouthWing { return "Saint Orra's: South Wing" }
        if realm == HellfeatherRealm.SouthWingDeep { return "The South Wing, lower wards" }
        if realm == HellfeatherRealm.RelayChapel { return "The Relay Chapel" }
        return ""
    }

    // The zone name alone, in the top left corner.
    Draw(QuaxelUi& ui, string title)
    {
        if Length(title) == 0 { return }
        ui.OverlayRect(4, 6, (int)Length(title) * 6 + 5, 9, 0x80000000)
        ui.OverlayText(6, 7, title, 0xFFE0B860)
    }
}

HellfeatherGame : QuaxelGameInstance
{
    // The clearing she was last found in, and the time until the next look.
    -int ZoneSite = -1
    -float ZoneCountdown

    // Looks a few times a second, since it walks every clearing of the level.
    StepZone(vec3 player, float deltaSeconds)
    {
        ZoneCountdown -= deltaSeconds
        if ZoneCountdown > 0.0 { return }
        ZoneCountdown = 0.25
        ZoneSite = SiteNear(player)
    }

    // The clearing whose middle is nearest, measured in its own radii, so a
    // big clearing reaches farther than a small one beside it. -1 without a layout.
    int SiteNear(vec3 player)
    {
        int best = -1
        float bestShare = 0.0
        for i : 0; i < Terrain.Layout.Sites.Len; i++ {
            vec3 middle = Terrain.WorldPoint(Terrain.Layout.Sites[i].X, Terrain.Layout.Sites[i].Z)
            float radius = Math.Max(Terrain.Layout.Sites[i].Radius, 1.0)
            float share = Math.Hypot(middle.X - player.X, middle.Z - player.Z) / radius
            if best < 0 || share < bestShare {
                best = (int)i
                bestShare = share
            }
        }
        return best
    }

    // The area level where she stands: below ground the level's, above it the
    // clearing's.
    int AreaLevel()
    {
        if !HellfeatherRealm.IsOverland(Terrain.Realm) { return HellfeatherZoneNames.Level(Terrain.HallZone()) }
        if ZoneSite < 0 || ZoneSite >= Terrain.Layout.Sites.Len { return 1 }
        return HellfeatherZoneNames.Level(Terrain.Layout.Sites[ZoneSite].Module)
    }

    // The area level an enemy's loot rolls at: its group's zone, or where she
    // stands for one outside the rolled groups, such as a boss.
    int LootLevel(int i)
    {
        int zone = ZoneOf(i)
        return zone >= 0 ? HellfeatherZoneNames.Level(zone) | AreaLevel()
    }

    // What the corner says: the level's name below, the clearing's above.
    string ZoneName()
    {
        string below = HellfeatherZoneNames.RealmName(Terrain.Realm)
        if Length(below) > 0 { return below }
        if ZoneSite < 0 || ZoneSite >= Terrain.Layout.Sites.Len { return "" }
        return HellfeatherZoneNames.Name(Terrain.Layout.Sites[ZoneSite].Module)
    }
}
T{
    // Each zone along the story's road is at least as deep as the one before.
    AreaLevelsRiseAlongTheRoad()
    {
        int [] road = {HellfeatherZone.Ravenford, HellfeatherZone.Croft, HellfeatherZone.FordRoad, HellfeatherZone.FennickWater, HellfeatherZone.OrrasHill, HellfeatherZone.HobbsMill, HellfeatherZone.Undercroft, HellfeatherZone.UndercroftDeep}
        for i : 1; i < road.Len; i++ { T.IsTrue(HellfeatherZoneNames.Level(road[i]) > HellfeatherZoneNames.Level(road[i - 1])) }
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.StepZone(world.GetPosition(game.PlayerNode), 1.0)
        T.AreEqual(game.AreaLevel(), 1)
    }

    SheStartsInRavenfordAndTheMillIsHobbs()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.StepZone(world.GetPosition(game.PlayerNode), 1.0)
        T.AreEqual(game.ZoneName(), "Ravenford")
        for site : game.Terrain.Layout.Sites {
            if site.Module != HellfeatherZone.HobbsMill { continue }
            vec3 middle = game.Terrain.WorldPoint(site.X, site.Z)
            game.StepZone(middle, 1.0)
            T.AreEqual(game.ZoneName(), "Hobb's Mill")
        }
    }
}
