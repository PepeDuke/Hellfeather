// The generated score (Quaxel's QuaxelMusic) told what surrounds her: the
// ground nearby, whether she is under a roof or below ground, how dangerous
// the enemies around her are, and each one she kills.
HellfeatherGame : QuaxelGameInstance
{
    // What the score was last told. The ground is sampled every second.
    -QuaxelMusicContext MusicContext
    -float MusicSampleTimer
    // Each place's band (Source/MusicPalettes.dk), and the place whose band
    // is playing: a HellfeatherZone value, MenuPlace, or NoPlace before any.
    -HellfeatherMusicTable MusicTable
    -int MusicPlace = HellfeatherGame.NoPlace

    -StartMusic(QuaxelWorld& world)
    {
        MusicTable = HellfeatherMusicTable.Read()
        MusicPlace = HellfeatherGame.NoPlace
        StepMusicPalette(world)
        world.Music.Start(WorldSeed)
        MusicSampleTimer = 0.0
    }

    // Where the music is, for its palette: the main menu, a building's room,
    // a level's halls below ground, or the clearing she stands in.
    int MusicZone()
    {
        if Screen == HellfeatherScreen.MainMenu { return HellfeatherGame.MenuPlace }
        if HellfeatherRealm.IsInterior(Terrain.Realm) { return HellfeatherZone.Interior.Value }
        if !HellfeatherRealm.IsOverland(Terrain.Realm) { return Terrain.HallZone() }
        if ZoneSite >= 0 && ZoneSite < Terrain.Layout.Sites.Len { return Terrain.Layout.Sites[ZoneSite].Module }
        return Terrain.Realm == HellfeatherRealm.Thornmere ? HellfeatherZone.Heath.Value | HellfeatherZone.Fenmarch.Value
    }

    // Gives the score the band of the place she is in when that changes,
    // heard from its next section.
    -StepMusicPalette(QuaxelWorld& world)
    {
        int place = MusicZone()
        if place == MusicPlace { return }
        MusicPlace = place
        if place == HellfeatherGame.MenuPlace {
            MusicTable.Menu.ApplyTo(world.Music)
            return
        }
        int found = MusicTable.Find(place)
        if found >= 0 { MusicTable.Palettes[found].ApplyTo(world.Music) }
        else {
            world.Music.ClearPreferences()
            world.Music.SetMode(QuaxelMusicMode.Major)
            world.Music.SetTempo(72.0)
        }
    }

    // Tells the score her surroundings, once each step.
    -StepMusic(QuaxelWorld& world, float deltaSeconds)
    {
        if PlayerNode == 0 { return }
        vec3 at = world.GetPosition(PlayerNode)
        MusicSampleTimer -= deltaSeconds
        if MusicSampleTimer <= 0.0 {
            MusicSampleTimer = 1.0
            QuaxelMusicContext sampled = MusicContext
            Terrain.SampleSurroundings(at.X, at.Z, HellfeatherGame.MusicReach, sampled)
            MusicContext = sampled
        }
        bool roofed = HellfeatherRealm.IsInterior(Terrain.Realm) || HellfeatherRealm.IsBelow(Terrain.Realm)
        MusicContext.Interior = roofed ? 1.0 | 0.0
        MusicContext.Danger = MusicDanger(world, at)
        world.Music.SetSurroundings(MusicContext)
    }

    // From 0 alone to 1 in a hard fight: each living enemy near her counts by
    // its rank, more once it has noticed her, less the further it is, and a
    // fight goes harder as her health runs low.
    -float MusicDanger(QuaxelWorld& world, vec3 at)
    {
        float danger = 0.0
        for i : 0; i < Enemies.Len; i++ {
            if !Enemies[i].Awake || Enemies[i].Node == 0 || Enemies[i].Health <= 0 { continue }
            vec3 enemy = world.GetPosition(Enemies[i].Node)
            float gap = Math.Hypot(enemy.X - at.X, enemy.Z - at.Z)
            if gap >= HellfeatherGame.MusicReach { continue }
            float near = 1.0 - gap / HellfeatherGame.MusicReach
            float weight = HellfeatherGame.MusicThreat(Spawner.Table.Kinds[Enemies[i].Kind].Rank)
            if Enemies[i].Provoked { weight *= 2.0 }
            danger += weight * near
        }
        if danger > 0.0 && PlayerMaxHealth() > 0 {
            float hurt = 1.0 - Math.Clamp((float)PlayerHealth / (float)PlayerMaxHealth(), 0.0, 1.0)
            danger *= 1.0 + hurt
        }
        return Math.Clamp(danger, 0.0, 1.0)
    }

    // A kill turns the score sombre once the fight is over.
    -MusicMourn(QuaxelWorld& world, int i)
    {
        HellfeatherEnemyRank rank = Spawner.Table.Kinds[Enemies[i].Kind].Rank
        float weight = 0.1
        if rank == HellfeatherEnemyRank.Magic { weight = 0.2 }
        if rank == HellfeatherEnemyRank.Rare { weight = 0.5 }
        if rank == HellfeatherEnemyRank.Unique { weight = 1.0 }
        world.Music.EnemyDied(weight)
    }
}
#{
    // World units around her that count for the music.
    #float MusicReach = 18.0
    #int MenuPlace = -2
    #int NoPlace = -3

    // How much one enemy that has not noticed her adds to the danger, at her side.
    float MusicThreat(HellfeatherEnemyRank rank)
    {
        if rank == HellfeatherEnemyRank.Magic { return 0.12 }
        if rank == HellfeatherEnemyRank.Rare { return 0.35 }
        if rank == HellfeatherEnemyRank.Unique { return 0.8 }
        return 0.06
    }
}
T{
    AnEnemyBesideHerRaisesTheDanger()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        T.IsTrue(world.Music.IsPlaying())
        QuaxelInputState input
        game.Simulate(world, input, 5)
        // Two seconds of audio for the score to hear it.
        int16 [1600] block
        for b : 0; b < 120; b++ { world.MixAudio(block) }
        heard : world.Music.Surroundings()
        T.IsTrue(heard.Danger > 0.02)
    }
}
