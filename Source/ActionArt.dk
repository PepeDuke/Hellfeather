HellfeatherHudPanel : int
#@{
    Runes,
    Inventory,
    Quests,
    Stats,
    Passives
}

// The iron HUD frame, its raven reliefs, and the sprites for its controls.
HellfeatherActionArt
#{
    #int BarAtlasY = 364
    #int BarWidth = 243
    #int BarHeight = 54
    #int BodyLeft = 20
    #int BodyRight = 222
    #int Icon = 16
    #int IconAtlasY = 440
    #int LockX = 120
    #int LockWidth = 12
    #int LockHeight = 14
    #int KeyWidth = 14
    #int KeyHeight = 9
    #int KeyY = 39
    #int SmallSlot = 16
    #int SmallGap = 1
    #int RackX = 123
    #int RackY = 3
    #int MouseIcon = 24
    #int MouseAtlasY = 462
    #int NumberIcon = 12
    #int NumberAtlasY = 492
    // Left edges of the three raised iron bars that split the bar into sections.
    #int DividerOne = 50
    #int DividerTwo = 118
    #int DividerThree = 191
    #int DividerWidth = 4

    int IconX(int action) { return 2 + (action - 1) * 18 }

    int IconY(int action) { return IconAtlasY }

    // A slot's well on the bar, in pixels from the bar's top left. The two mouse
    // slots are larger, like the slots the axe and shout sit in.
    SlotRect(int slot, int& x, int& y, int& width, int& height)
    {
        x = 0
        y = 0
        width = 0
        height = 0
        if slot == HellfeatherActionSlot.Left { Set(56, 6, 28, x, y, width, height) }
        if slot == HellfeatherActionSlot.Right { Set(88, 6, 28, x, y, width, height) }
        if slot == HellfeatherActionSlot.Q { Set(123, 26, 22, x, y, width, height) }
        if slot == HellfeatherActionSlot.E { Set(146, 26, 21, x, y, width, height) }
        if slot == HellfeatherActionSlot.F { Set(168, 26, 22, x, y, width, height) }
        if IsSmall(slot) { Set(RackX + (slot - HellfeatherActionSlot.One) * (SmallSlot + SmallGap), RackY, SmallSlot, x, y, width, height) }
        if IsSmall(slot) { height = 20 }
        // Q, E and F reach down to the bottom rim; their keys are in the slot.
        else if slot >= HellfeatherActionSlot.Q { height = 23 }
    }

    // The number-key slots above the bar, drawn by the bar rather than painted into its sprite.
    bool IsSmall(int slot) { return slot >= HellfeatherActionSlot.One }

    -Set(int a, int b, int size, int& x, int& y, int& width, int& height)
    {
        x = a
        y = b
        width = size
        height = size
    }

    // The slot under a point on the bar, or -1.
    int SlotAt(int px, int py)
    {
        for slot : HellfeatherActionSlot {
            int x = 0
            int y = 0
            int width = 0
            int height = 0
            SlotRect(slot, x, y, width, height)
            if px >= x && py >= y && px < x + width && py < y + height { return slot }
            if slot < HellfeatherActionSlot.Q && py >= KeyY && py < KeyY + KeyHeight {
                int key = x + width / 2 - KeyWidth / 2
                if px >= key && px < key + KeyWidth { return slot }
            }
        }
        return -1
    }

    // Left edge of the key plate under a slot.
    int KeyX(int slot)
    {
        int x = 0
        int y = 0
        int width = 0
        int height = 0
        SlotRect(slot, x, y, width, height)
        return x + width / 2 - KeyWidth / 2
    }

    Paint(QuaxelUi& ui)
    {
        HellfeatherHudFrame.Paint(ui)
        for action : HellfeatherAction { if action != HellfeatherAction.None { PaintIcon(ui, action, IconX(action), IconY(action)) } }
        // Full icon art at each slot size, including the small numbered keys.
        for action : HellfeatherAction {
            if action == HellfeatherAction.None { continue }
            ResizeIcon(ui, action, MouseIcon, MouseAtlasY)
            ResizeIcon(ui, action, NumberIcon, NumberAtlasY)
        }
        PaintLock(ui, LockX, IconAtlasY)
    }

    -ResizeIcon(QuaxelUi& ui, int action, int side, int atlasY)
    {
        for y : 0; y < side; y++ {
            for x : 0; x < side; x++ {
                uint pixel = ui.AtlasTexel(IconX(action) + x * Icon / side, IconAtlasY + y * Icon / side)
                ui.SetAtlasTexel(action * side + x, atlasY + y, pixel)
            }
        }
    }

    #int PanelX = 23
    #int PanelY = 1
    #int PanelStep = 10
    #int PanelWidth = 26
    #int PanelHeight = 10

    int PanelAt(int x, int y)
    {
        if x < 0 || x >= PanelWidth || y < 0 { return -1 }
        int panel = y / PanelStep
        if y % PanelStep >= PanelHeight || !IsValid((HellfeatherHudPanel)panel) { return -1 }
        return panel
    }

    string PanelName(int panel)
    {
        string [5] names = {"Runes", "Inventory", "Quests", "Stats", "Passives"}
        return names[panel]
    }

    string PanelKey(int panel)
    {
        string [5] keys = {"R", "I", "L", "C", "P"}
        return keys[panel]
    }

    -int TintOf(int action)
    {
        if action == HellfeatherAction.Attack { return 0xe2561c }
        if action == HellfeatherAction.Cleave { return 0xf08a2a }
        if action == HellfeatherAction.WarCry { return 0xc0281c }
        if action == HellfeatherAction.Dash { return 0x3f8dff }
        if action == HellfeatherAction.HealthPotion { return 0xa8231b }
        return 0x2746a8
    }

    // The glow behind an icon, brightest in the middle, one shade per voxel.
    -PaintGlow(QuaxelUi& ui, int action, int x, int y)
    {
        int tint = TintOf(action)
        for row : 0; row < 8; row++ {
            for column : 0; column < 8; column++ {
                float distance = Math.Hypot((float)column - 3.5, (float)row - 3.5) / 5.5
                int percent = (int)(Math.Pow(Math.Max(0.0, 1.0 - distance), 1.6) * 85.0) + 8
                int rgb = HellfeatherArt.Shade(tint, percent)
                HellfeatherInventoryArt.Fill(ui, x + column * 2, y + row * 2, 2, 2, rgb)
            }
        }
    }

    -PaintIcon(QuaxelUi& ui, int action, int x, int y)
    {
        PaintGlow(ui, action, x, y)
        if action == HellfeatherAction.HealthPotion || action == HellfeatherAction.ManaPotion {
            // The potions are the inventory's own drawings, sixteen pixels square too.
            HellfeatherInventoryArt.Picture(ui, action == HellfeatherAction.HealthPotion ? HellfeatherItems.HealthPotion | HellfeatherItems.ManaPotion, x, y)
            return
        }
        HellfeatherItemPicture picture
        if action == HellfeatherAction.Cleave { Sweep(picture) }
        if action == HellfeatherAction.Attack || action == HellfeatherAction.Cleave { Axe(picture) }
        if action == HellfeatherAction.WarCry { Horn(picture) }
        if action == HellfeatherAction.Dash { Boot(picture) }
        for row : 0; row < picture.Rows.Len; row++ { HellfeatherInventoryArt.V(ui, x, y, row, picture.Rows[row]) }
    }

    // Writes text over a row, leaving the cells under its '.' as they were.
    -Over(HellfeatherItemPicture& p, int row, string text)
    {
        while p.Rows.Len <= row { p.Rows += "........" }
        string merged = ""
        for i : (long)0; i < 8; i++ {
            int mine = i < Length(text) ? (int)CodeUnitAt(text, i) | 46
            int below = i < Length(p.Rows[row]) ? (int)CodeUnitAt(p.Rows[row], i) | 46
            merged = merged + (string)char(mine == 46 ? below | mine)
        }
        p.Rows[row] = merged
    }

    // A bearded axe, blade up and to the left.
    -Axe(HellfeatherItemPicture& p)
    {
        Over(p, 0, ".kkk..k.")
        Over(p, 1, "kSSskkWk")
        Over(p, 2, "kSssdWk.")
        Over(p, 3, "kSsdWk..")
        Over(p, 4, ".kkWk...")
        Over(p, 5, "..kWk...")
        Over(p, 6, ".kwk....")
        Over(p, 7, "kwk.....")
    }

    // A ring of fire sweeping around the lower right, drawn under the axe.
    -Sweep(HellfeatherItemPicture& p)
    {
        for row : 0; row < 8; row++ {
            string text = ""
            for column : 0; column < 8; column++ {
                float distance = Math.Hypot((float)column - 1.5, (float)row - 1.5)
                bool inArc = column >= 2 && row >= 2 && distance >= 4.4 && distance < 6.2
                text = text + (!inArc ? "." | (distance >= 5.3 ? "y" | "o"))
            }
            Over(p, row, text)
        }
    }

    // A bone war horn, its call rising as lines of flame.
    -Horn(HellfeatherItemPicture& p)
    {
        Over(p, 0, "....kk.y")
        Over(p, 1, "...keGk.")
        Over(p, 2, "..keeGky")
        Over(p, 3, "kkeLeGk.")
        Over(p, 4, "keLeeGky")
        Over(p, 5, ".kkkkGk.")
    }

    // A leather boot trailing streaks of wind.
    -Boot(HellfeatherItemPicture& p)
    {
        Over(p, 0, "..kkk...")
        Over(p, 1, "a.kLk...")
        Over(p, 2, ".akLk...")
        Over(p, 3, "a.kLkk..")
        Over(p, 4, ".akLlLk.")
        Over(p, 5, "a.kLllLk")
        Over(p, 6, "..kcccck")
        Over(p, 7, "...kkkk.")
    }

    // Laid over the icon of an action not yet learned.
    -PaintLock(QuaxelUi& ui, int x, int y)
    {
        HellfeatherInventoryArt.V(ui, x, y, 0, "..kk..")
        HellfeatherInventoryArt.V(ui, x, y, 1, ".kssk.")
        HellfeatherInventoryArt.V(ui, x, y, 2, "ks..sk")
        HellfeatherInventoryArt.V(ui, x, y, 3, "kggggk")
        HellfeatherInventoryArt.V(ui, x, y, 4, "kgkkgk")
        HellfeatherInventoryArt.V(ui, x, y, 5, "kggGgk")
        HellfeatherInventoryArt.V(ui, x, y, 6, ".kkkk.")
    }
}
T{
    SlotsSitOnTheBarWithoutOverlapping()
    {
        for a : HellfeatherActionSlot {
            int x = 0
            int y = 0
            int width = 0
            int height = 0
            HellfeatherActionArt.SlotRect(a, x, y, width, height)
            T.IsTrue(width >= HellfeatherActionArt.NumberIcon && height >= HellfeatherActionArt.NumberIcon)
            if HellfeatherActionArt.IsSmall(a) {
                // The number row sits inside the frame, above Q/E/F.
                T.IsTrue(x >= HellfeatherActionArt.BodyLeft && x + width <= HellfeatherActionArt.BodyRight)
                T.IsTrue(y + height <= 29)
                T.IsTrue(width < 22)
            }
            else {
                T.IsTrue(x >= HellfeatherActionArt.BodyLeft + 4 && x + width < HellfeatherActionArt.BodyRight - 4)
                // The mouse slots stand over their key plates; Q, E and F stop at the bottom rim.
                if a < HellfeatherActionSlot.Q { T.IsTrue(y + height < HellfeatherActionArt.KeyY) }
                else { T.IsTrue(y + height <= HellfeatherHudVoxelArt.BodyBottom - 2) }
            }
            T.AreEqual(HellfeatherActionArt.SlotAt(x, y), a)
            T.AreEqual(HellfeatherActionArt.SlotAt(x + width - 1, y + height - 1), a)
        }
        // The small row sits over the key slots.
        int qx = 0
        int fx = 0
        int firstX = 0
        int lastX = 0
        int y = 0
        int w = 0
        int h = 0
        HellfeatherActionArt.SlotRect(HellfeatherActionSlot.Q, qx, y, w, h)
        HellfeatherActionArt.SlotRect(HellfeatherActionSlot.F, fx, y, w, h)
        HellfeatherActionArt.SlotRect(HellfeatherActionSlot.One, firstX, y, w, h)
        HellfeatherActionArt.SlotRect(HellfeatherActionSlot.Four, lastX, y, w, h)
        T.IsTrue(firstX <= qx && lastX + w >= fx + 18)
    }

    TheBarAndIconsFitBelowTheInventoryArt()
    {
        QuaxelUi ui()
        HellfeatherInventoryArt.Paint(ui)
        T.IsTrue(HellfeatherActionArt.BarAtlasY >= HellfeatherInventoryArt.PanelHeight)
        T.IsTrue(HellfeatherActionArt.IconAtlasY >= HellfeatherActionArt.BarAtlasY + HellfeatherActionArt.BarHeight)
        int last = 0
        for action : HellfeatherAction { last = Math.Max(last, HellfeatherActionArt.IconX(action) + HellfeatherActionArt.Icon) }
        T.IsTrue(last <= HellfeatherActionArt.LockX)
        // The rune button's gem and the axe icon are both painted, and the iron
        // around them is left to the voxel frame.
        T.IsTrue(ui.AtlasTexel(28, HellfeatherActionArt.BarAtlasY + 4) != (uint)0)
        T.AreEqual(ui.AtlasTexel(HellfeatherActionArt.BodyLeft + 6, HellfeatherActionArt.BarAtlasY + 30), (uint)0)
        T.IsTrue(ui.AtlasTexel(HellfeatherActionArt.IconX(HellfeatherAction.Attack) + 1, HellfeatherActionArt.IconAtlasY + 1) != (uint)0)
    }
}
