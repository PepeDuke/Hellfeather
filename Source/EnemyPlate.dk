// How rare an enemy is, which colors its name on the nameplate the way item
// rarity colors item titles. Normal enemies are the plain flock, Magic and
// Rare the stronger birds that lead it, and Unique the named foes.
HellfeatherEnemyRank : int
#@{
    Normal,
    Magic,
    Rare,
    Unique
}

EnemyKind
{
    // Set in the enemy data; see HellfeatherEnemyRank.
    HellfeatherEnemyRank Rank
    // The name on the nameplate. Empty spells out Name, "OldGreyneck" as "Old Greyneck".
    string Title
}

// The plate at the top of the screen naming the enemy under the mouse. Its
// border doubles as the health bar: lit from the top left corner clockwise
// around the plate in proportion to the enemy's health. Coordinates are UI pixels.
HellfeatherEnemyPlate
#{
    #int Top = 4
    #int Height = 15
    #int PaddingX = 10
    #int MinWidth = 90
    // Border rings, each one UI pixel thick.
    #int Rings = 2
    #uint Lit = 0xFFC0281C
    #uint Drained = 0xFF3A1410
    #uint Fill = 0xD0100C0A

    // Inserts a space before each capital that follows a small letter.
    string Spaced(string word)
    {
        string spaced = ""
        int previous = 0
        for i : (long)0; i < Length(word); i++ {
            int unit = (int)CodeUnitAt(word, i)
            if unit >= 65 && unit <= 90 && previous >= 97 && previous <= 122 { spaced = spaced + " " }
            spaced = spaced + (string)char(unit)
            previous = unit
        }
        return spaced
    }

    string TitleOf(EnemyKind kind) { return Length(kind.Title) > 0 ? kind.Title | Spaced(kind.Name) }

    uint ColorOf(HellfeatherEnemyRank rank)
    {
        if rank == HellfeatherEnemyRank.Magic { return 0xFF6E9CFF }
        if rank == HellfeatherEnemyRank.Rare { return 0xFFE8C04A }
        if rank == HellfeatherEnemyRank.Unique { return 0xFFD08A3A }
        return 0xFFEDE6D8
    }

    // Pixels of a ring of this perimeter to light. Any health left lights at least one.
    int LitPixels(int perimeter, int health, int maxHealth)
    {
        if health <= 0 || maxHealth <= 0 { return 0 }
        if health >= maxHealth { return perimeter }
        return Math.Clamp((int)Math.Ceil((float)perimeter * (float)health / (float)maxHealth), 1, perimeter)
    }

    int Perimeter(int width, int height) { return 2 * width + 2 * height - 4 }

    // The first `lit` pixels of the one-pixel ring around a rectangle, clockwise
    // from its top left corner: along the top, down the right, back along the
    // bottom and up the left.
    Ring(QuaxelUi& ui, int x, int y, int width, int height, int lit, uint color)
    {
        int left = lit
        int run = Math.Min(left, width)
        ui.OverlayRect(x, y, run, 1, color)
        left -= run
        run = Math.Min(left, height - 1)
        ui.OverlayRect(x + width - 1, y + 1, 1, run, color)
        left -= run
        run = Math.Min(left, width - 1)
        ui.OverlayRect(x + width - 1 - run, y + height - 1, run, 1, color)
        left -= run
        run = Math.Min(left, height - 2)
        ui.OverlayRect(x, y + height - 1 - run, 1, run, color)
    }

    Draw(QuaxelUi& ui, int gridWidth, string title, uint color, int health, int maxHealth)
    {
        int width = Math.Max(MinWidth, (int)Length(title) * 6 - 1 + PaddingX * 2)
        int x = (gridWidth - width) / 2
        ui.OverlayRect(x + Rings, Top + Rings, width - Rings * 2, Height - Rings * 2, Fill)
        for ring : 0; ring < Rings; ring++ {
            int w = width - ring * 2
            int h = Height - ring * 2
            int perimeter = Perimeter(w, h)
            Ring(ui, x + ring, Top + ring, w, h, perimeter, Drained)
            Ring(ui, x + ring, Top + ring, w, h, LitPixels(perimeter, health, maxHealth), Lit)
        }
        ui.OverlayText(x + (width - ((int)Length(title) * 6 - 1)) / 2 + 1, Top + 5, title, 0xFF000000)
        ui.OverlayText(x + (width - ((int)Length(title) * 6 - 1)) / 2, Top + 4, title, color)
    }
}

HellfeatherGame : QuaxelGameInstance
{
    // The enemy under the mouse as of the last DrawEnemyPlate, or -1.
    int HoveredEnemy = -1

    // Finds the living enemy under the mouse, nearest the camera first, and
    // names it at the top of the screen. MouseFree is false while a panel or
    // something else in the world has the mouse.
    DrawEnemyPlate(QuaxelUi& ui, QuaxelWorld& world, int width, int height, int mouseX, int mouseY, bool mouseFree)
    {
        HoveredEnemy = -1
        if !mouseFree { return }
        QuaxelCamera camera = world.GetCamera(CameraNode)
        camera.UpdateBounds(width, height)
        mat4 screen = camera.ViewProjection(world.WorldPosition(CameraNode))
        int scale = ui.ScaleFor(width, height)
        int gridWidth = width / scale
        int gridHeight = height / scale
        int x = mouseX / scale
        int y = mouseY / scale
        int nearest = -1000000
        for i : 0; i < Enemies.Len; i++ {
            if Enemies[i].Health <= 0 || !world.Exists(Enemies[i].Node) { continue }
            // The node sits at the middle of the enemy's collision circle, Radius above its feet.
            vec3 feet = world.GetPosition(Enemies[i].Node) - vec3(0.0, Enemies[i].Radius, 0.0)
            EnemyKind kind = Spawner.Table.Kinds[Enemies[i].Kind]
            vec4 low = screen * vec4(feet, 1.0)
            vec4 high = screen * vec4(feet + vec3(0.0, (float)kind.Height * kind.VoxelSize, 0.0), 1.0)
            // Written to also skip a point that is not a number, which cannot be cast.
            if !(Math.Abs(low.X) <= 1.1 && Math.Abs(low.Y) <= 1.1 && Math.Abs(high.Y) <= 4.0) { continue }
            int footX = (int)((low.X + 1.0) * 0.5 * (float)gridWidth)
            int footY = (int)((low.Y + 1.0) * 0.5 * (float)gridHeight)
            int headY = (int)((high.Y + 1.0) * 0.5 * (float)gridHeight)
            // Birds are about as wide as they are tall; a little slack makes small ones easier to point at.
            int halfWide = Math.Max(5, (footY - headY) / 2)
            bool onBody = Math.Abs(x - footX) <= halfWide && y >= headY - 2 && y <= footY + 2
            if onBody && footY > nearest {
                nearest = footY
                HoveredEnemy = i
            }
        }
        if HoveredEnemy < 0 { return }
        EnemyKind hovered = Spawner.Table.Kinds[Enemies[HoveredEnemy].Kind]
        HellfeatherEnemyPlate.Draw(ui, gridWidth, HellfeatherEnemyPlate.TitleOf(hovered), HellfeatherEnemyPlate.ColorOf(hovered.Rank), Enemies[HoveredEnemy].Health, Enemies[HoveredEnemy].MaxHealth)
    }
}
T{
    NamesAreSpelledOutAndRanksColored()
    {
        T.IsTrue(HellfeatherEnemyPlate.Spaced("OldGreyneck") == "Old Greyneck")
        T.IsTrue(HellfeatherEnemyPlate.Spaced("BlackHoneyLeech") == "Black Honey Leech")
        T.IsTrue(HellfeatherEnemyPlate.Spaced("Mardra") == "Mardra")
        T.AreNotEqual(HellfeatherEnemyPlate.ColorOf(HellfeatherEnemyRank.Normal), HellfeatherEnemyPlate.ColorOf(HellfeatherEnemyRank.Rare))
        T.AreNotEqual(HellfeatherEnemyPlate.ColorOf(HellfeatherEnemyRank.Magic), HellfeatherEnemyPlate.ColorOf(HellfeatherEnemyRank.Unique))
    }

    TheBorderLightsInProportionToHealth()
    {
        T.AreEqual(HellfeatherEnemyPlate.LitPixels(100, 60, 60), 100)
        T.AreEqual(HellfeatherEnemyPlate.LitPixels(100, 30, 60), 50)
        T.AreEqual(HellfeatherEnemyPlate.LitPixels(100, 1, 1000), 1)
        T.AreEqual(HellfeatherEnemyPlate.LitPixels(100, 0, 60), 0)
        // A full ring covers each edge pixel once.
        QuaxelUi ui()
        HellfeatherEnemyPlate.Ring(ui, 10, 10, 20, 8, HellfeatherEnemyPlate.Perimeter(20, 8), 0xFFFFFFFF)
        ui.Layout(960, 540, 0, 0, false)
        int covered = 0
        for i : 0; i < ui.CommandCount; i++ {
            QuaxelUiCommand command = ui.GetCommand(i)
            covered += command.Width * command.Height
        }
        T.AreEqual(covered, HellfeatherEnemyPlate.Perimeter(20, 8))
    }

    TheEnemyUnderTheMouseIsNamedAtTheTop()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        game.Spawner.Data = HellfeatherEnemyData.BesideThePlayer()
        T.IsTrue(game.Prepare(world))
        T.IsTrue(game.Enemies.Len > 0)
        QuaxelUi ui()
        game.ConfigureUi(ui)
        vec3 player = world.GetPosition(game.PlayerNode)
        QuaxelTransform placed = world.GetTransform(game.Enemies[0].Node)
        placed.Position = player + vec3(0.0, game.Enemies[0].Radius, 0.0)
        world.SetTransform(game.Enemies[0].Node, placed)
        game.Enemies[0].Health = game.Enemies[0].MaxHealth / 2
        // The view centers on the player, so the enemy stands just above the middle.
        game.DrawEnemyPlate(ui, world, 960, 540, 480, 262, true)
        T.AreEqual(game.HoveredEnemy, 0)
        ui.Layout(960, 540, 0, 0, false)
        QuaxelUiCommand fill = ui.GetCommand(0)
        T.AreEqual(fill.Y, (HellfeatherEnemyPlate.Top + HellfeatherEnemyPlate.Rings) * 2)
        T.IsTrue(fill.X < 480 && fill.X + fill.Width > 480)
        // Nothing while a panel has the mouse, or away from the enemy.
        game.DrawEnemyPlate(ui, world, 960, 540, 480, 262, false)
        T.AreEqual(game.HoveredEnemy, -1)
        game.DrawEnemyPlate(ui, world, 960, 540, 20, 20, true)
        T.AreEqual(game.HoveredEnemy, -1)
    }
}
