// Wren Carrow, built by Tools/Models/player.py. Assets/Warrior.qvox is her in
// her basic attire and Assets/WarriorLeatherArmor.qvox in Leather Armor; both
// share one box, clips and sockets, so one can replace the other. Helmets,
// weapons and shields are models of their own that ride her `head`, `hand_r`
// and `hand_l` sockets (Tools/Models/gear.py). Local +Z is forward. Height is
// the box height, which the game stands her by.
HellfeatherWarrior
#{
    #int Height = 81
    #float VoxelSize = 0.025

    // Height of the volume's center when she lies on her back: half the box's
    // 68 cells less the depth of her back, which the coat brings out from cell
    // 28 to 25.
    float LyingCenterHeight(HellfeatherItems body)
    {
        return body != HellfeatherItems.None ? 0.225 | 0.15
    }

    // The clip an action plays: attack for a swing, cleave for the level sweep
    // and shout for the war cry. Each has a twin ending in "_walk" with the
    // walk's legs under the same upper body, so she can act on the move.
    string ActionClip(HellfeatherAction action, bool moving)
    {
        string clip = "attack"
        if action == HellfeatherAction.Cleave { clip = "cleave" }
        if action == HellfeatherAction.WarCry { clip = "shout" }
        return moving ? clip + "_walk" | clip
    }

    // Swings strike on AxeStrikeFrame and cannot be interrupted.
    bool IsSwingClip(string clip) { return clip == "attack" || clip == "attack_walk" || clip == "cleave" || clip == "cleave_walk" }

    // The war cry plays over walking and standing until it ends or a swing starts.
    bool IsShoutClip(string clip) { return clip == "shout" || clip == "shout_walk" }

    // Her body model for what she wears: the mail coats have their own, the
    // same coat in rings, bronze scales or steel bands, and every other body
    // armor shows as the Leather Armor. Before Jessa gives her the Tithe-mark,
    // her forearm is bare.
    string BodyModel(HellfeatherItems body, bool marked)
    {
        string unmarked = marked ? "" | "Unmarked"
        if body == HellfeatherItems.RingMail { return "Assets/WarriorRingMail" + unmarked + ".qvox" }
        if body == HellfeatherItems.ScaleMail { return "Assets/WarriorScaleMail" + unmarked + ".qvox" }
        if body == HellfeatherItems.PlateMail { return "Assets/WarriorPlateMail" + unmarked + ".qvox" }
        if body != HellfeatherItems.None { return "Assets/WarriorLeatherArmor" + unmarked + ".qvox" }
        return "Assets/Warrior" + unmarked + ".qvox"
    }

    // The model an item shows when worn or held, or "" for none.
    string GearModel(HellfeatherItems item)
    {
        if item == HellfeatherItems.HandAxe { return "Assets/HandAxe.qvox" }
        if item == HellfeatherItems.BattleAxe { return "Assets/BattleAxe.qvox" }
        if item == HellfeatherItems.Falchion { return "Assets/Falchion.qvox" }
        if item == HellfeatherItems.FlangedMace { return "Assets/FlangedMace.qvox" }
        if item == HellfeatherItems.ShortSword { return "Assets/ShortSword.qvox" }
        if item == HellfeatherItems.MillstoneMaul { return "Assets/MillstoneMaul.qvox" }
        if item == HellfeatherItems.RoundShield { return "Assets/RoundShield.qvox" }
        if item == HellfeatherItems.KiteShield { return "Assets/KiteShield.qvox" }
        if item == HellfeatherItems.IronHelm { return "Assets/IronHelm.qvox" }
        if item == HellfeatherItems.MinersHelmet { return "Assets/MinersHelmet.qvox" }
        if item == HellfeatherItems.ChainCoif { return "Assets/ChainCoif.qvox" }
        if item == HellfeatherItems.GreatHelm { return "Assets/GreatHelm.qvox" }
        if item == HellfeatherItems.WarHammer { return "Assets/WarHammer.qvox" }
        if item == HellfeatherItems.TowerShield { return "Assets/TowerShield.qvox" }
        if item == HellfeatherItems.VisoredHelm { return "Assets/VisoredHelm.qvox" }
        if item == HellfeatherItems.SwanboneBuckler { return "Assets/SwanboneBuckler.qvox" }
        if item == HellfeatherItems.CarminesQuill { return "Assets/CarminesQuill.qvox" }
        return ""
    }
}

// What Wren shows of her gear: the body model for her armor and a node on a
// socket for her weapon, shield and helmet. Dress puts on whatever changed.
HellfeatherWardrobe
{
    // Whether her forearm shows the Tithe-mark. Dress puts on the body to match.
    bool Marked = true
    -HellfeatherItems Body
    -bool BodyMarked
    -HellfeatherItems MainHand
    -HellfeatherItems OffHand
    -HellfeatherItems Head
    -int MainHandNode
    -int OffHandNode
    -int HeadNode
    -bool Dressed
    // Each model is read once per world.
    -string [] Paths
    -int [] Loaded

    // Dresses the visual node to match what is equipped. Returns false if a
    // model would not load.
    bool Dress(QuaxelWorld& world, int visual, HellfeatherItems body, HellfeatherItems mainHand, HellfeatherItems offHand, HellfeatherItems head)
    {
        if !Dressed || body != Body || Marked != BodyMarked {
            int animation = Load(world, HellfeatherWarrior.BodyModel(body, Marked), true)
            if animation < 0 { return false }
            // A new body starts on its first frame; carry on with the clip she was in.
            string clip = Dressed ? world.CurrentClipName(visual) | "idle"
            if !world.AttachAnimator(visual, animation) || !world.PlayClip(visual, clip) { return false }
            Body = body
            BodyMarked = Marked
        }
        // The weapon first, so it is her first socket follower.
        if !Dressed || mainHand != MainHand {
            MainHandNode = Wear(world, visual, mainHand, "hand_r", MainHandNode)
            if MainHandNode < 0 { return false }
            MainHand = mainHand
        }
        if !Dressed || offHand != OffHand {
            OffHandNode = Wear(world, visual, offHand, "hand_l", OffHandNode)
            if OffHandNode < 0 { return false }
            OffHand = offHand
        }
        if !Dressed || head != Head {
            HeadNode = Wear(world, visual, head, "head", HeadNode)
            if HeadNode < 0 { return false }
            Head = head
        }
        Dressed = true
        return true
    }

    // Forgets the visual it dressed, whose nodes are gone, so the next Dress
    // starts over on a new one. Loaded models are kept.
    Forget()
    {
        Dressed = false
        MainHandNode = 0
        OffHandNode = 0
        HeadNode = 0
    }

    // Takes the old node off the socket and puts the item's model there.
    // Returns the new node, 0 when the item shows nothing, or -1 on failure.
    -int Wear(QuaxelWorld& world, int visual, HellfeatherItems item, string socket, int old)
    {
        if old > 0 { world.DestroyNode(old) }
        string path = HellfeatherWarrior.GearModel(item)
        if Length(path) == 0 { return 0 }
        int volume = Load(world, path, false)
        if volume < 0 { return -1 }
        int node = world.CreateNode()
        if !world.AttachVoxels(node, volume) || !world.AttachToSocket(node, visual, socket) { return -1 }
        return node
    }

    // Loads an animated model ahead of need, so putting it on later does not
    // stall: her body is large, and a stall would skip the clip she is in.
    bool Preload(QuaxelWorld& world, string path) { return Load(world, path, true) >= 0 }

    // The model already loaded from a path, or -1.
    int LoadedAs(string path)
    {
        for i : 0; i < Paths.Len; i++ {
            if Paths[i] == path { return Loaded[i] }
        }
        return -1
    }

    // Takes a model another wardrobe loaded in the same world, rather than
    // loading it a second time.
    Know(string path, int made)
    {
        if made < 0 || LoadedAs(path) >= 0 { return }
        Paths += path
        Loaded += made
    }

    -int Load(QuaxelWorld& world, string path, bool animated)
    {
        for i : 0; i < Paths.Len; i++ {
            if Paths[i] == path { return Loaded[i] }
        }
        int made = animated ? QuaxelAssets.LoadVoxelAnimation(world, path) | QuaxelAssets.LoadVoxelModel(world, path)
        if made < 0 { return -1 }
        Paths += path
        Loaded += made
        return made
    }
}
T{
    EachMailCoatHasItsOwnBodyModel()
    {
        T.AreEqual(HellfeatherWarrior.BodyModel(HellfeatherItems.LeatherArmor, true), "Assets/WarriorLeatherArmor.qvox")
        T.AreEqual(HellfeatherWarrior.BodyModel(HellfeatherItems.RingMail, true), "Assets/WarriorRingMail.qvox")
        T.AreEqual(HellfeatherWarrior.BodyModel(HellfeatherItems.ScaleMail, false), "Assets/WarriorScaleMailUnmarked.qvox")
        T.AreEqual(HellfeatherWarrior.BodyModel(HellfeatherItems.PlateMail, true), "Assets/WarriorPlateMail.qvox")
        QuaxelWorld world()
        HellfeatherItems [3] mail = {HellfeatherItems.RingMail, HellfeatherItems.ScaleMail, HellfeatherItems.PlateMail}
        for body : mail {
            T.IsTrue(QuaxelAssets.LoadVoxelAnimation(world, HellfeatherWarrior.BodyModel(body, true)) >= 0)
            T.IsTrue(QuaxelAssets.LoadVoxelAnimation(world, HellfeatherWarrior.BodyModel(body, false)) >= 0)
        }
    }
}
