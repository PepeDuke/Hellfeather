// Solid voxel sculpt stored in Assets/Warrior.qvox. Local +Z is forward.
HellfeatherWarrior
#{
    #int Height = 78
    #float VoxelSize = 0.025

    bool Attach(QuaxelWorld& world, int node)
    {
        int animation = QuaxelAssets.LoadVoxelAnimation(world, "Assets/Warrior.qvox")
        if !world.AttachAnimator(node, animation) || !world.PlayClip(node, "idle") { return false }

        int volume = QuaxelAssets.LoadVoxelModel(world, "Assets/BattleAxe.qvox")
        if volume < 0 { return false }
        int axe = world.CreateNode()
        return world.AttachVoxels(axe, volume) && world.AttachToSocket(axe, node, "hand_r")
    }
}
