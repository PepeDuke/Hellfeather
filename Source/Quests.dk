// Act I, The Moult, as six quests. Each is a number that counts up as it goes,
// and talking to someone looks at the numbers to decide what they say.
//
// I-1 The Dead Woman's Reason   Moult      Matthew, Sister Carmine, Jessa
// I-2 Feathers on the Ford      Ford       Reeve Hollan, Edda
// I-3 Rooms Remember            Rooms      Jessa's garret, Sister Vale, the ambush
// I-4 The Seamstress's Grudge   Seamstress Marra Senn
// I-5 Things Sold in the Dark   Dark       Moth, the raid
// I-6 The Millrace Door         Millrace   Old Hobb, the Undercroft, Mardra, Lise
HellfeatherReply : int
#@{
    None,
    Leave,
    TakeCommission,
    GoToJessa,
    JessaDies,
    MatthewPays,
    TakeBounty,
    ClaimBounty,
    GiveFeathers,
    SearchGarret,
    ValeWarns,
    TakeThimble,
    MothRaid,
    TakeKey,
    Browse,
    // Opens the ravens' hoard at Edda's, bought with black feathers.
    Hoard,
    // Takes Jessa's boots from the dry outline in her garret.
    TakeBoots,
    OpenMillrace,
    Sever,
    LiseWindow,
    Interlude,
    FreeBearer,
    // Asks about a topic; the dialogue's ChosenTopic says which.
    Topic,
    // Travels to a lit waypoint; ChosenTopic is its index in Waypoints.
    Waypoint,
    // Act II.
    HeskRoad,
    HeskPays,
    CutDown,
    AgnetFile,
    ReadFile,
    AgnetTutorial,
    Inscribe,
    Carve,
    PayTithe,
    BluffCuffs,
    FightCuffs,
    StealLedgers,
    OpenArchive,
    MatthewQuarrel,
    ValeRecords,
    ReadTransferred,
    ValeKey,
    FreeCorvin,
    SeverRelay,
    CutFrame,
    ValeBox,
    TellPilgrims,
    TakeTheRoad
}

HellfeatherQuests
{
    // I-1: 1 to the hospice, 2 to Jessa, 3 back to Matthew, 4 done.
    int Moult
    // I-2: 1 taken, 2 done. Ducks slain on the Ford Road count once it is taken.
    int Ford
    int DucksCleared
    bool FeathersGiven
    // How many feathers she carries, for the log. The game sets it.
    int FeathersHeld
    // Whether Edda has told her what the ravens trade.
    bool HoardTold
    // Whether she took Jessa's Waterwalkers from the garret floor.
    bool BootsTaken
    bool ReevePaid
    // I-3: 1 the garret is open, 2 searched, 3 the Red Cuffs, 4 done.
    int Rooms
    int AmbushFirst = -1
    // I-4: 1 done.
    int Seamstress
    // I-5: 1 the raid, 2 it is over, 3 done.
    int Dark
    int RaidFirst = -1
    // I-6: 1 the door is open, 2 below, 3 Mardra is dead, 4 severed, 5 Lise, the end of the act.
    int Millrace
    bool TitheMark
    bool SeveringKnown
    bool PondWoke
    bool MardraMoulted
    // The cutscenes she has seen, a bit for each HellfeatherCutscene.
    int CutscenesSeen
    int ThrallsSpared
    int BearersFreed
    bool GreyneckSlain

    // Where a quest of the act stands in the log. A quest shows up once it is
    // taken, or once something found points to it.
    HellfeatherQuestState State(int quest)
    {
        if quest == 0 { return Moult == 0 ? HellfeatherQuestState.Unknown | (Moult >= 4 ? HellfeatherQuestState.Done | HellfeatherQuestState.Active) }
        if quest == 1 {
            if Ford == 0 && !FeathersGiven { return HellfeatherQuestState.Unknown }
            return Ford >= 2 ? HellfeatherQuestState.Done | HellfeatherQuestState.Active
        }
        if quest == 2 { return Rooms == 0 ? HellfeatherQuestState.Unknown | (Rooms >= 4 ? HellfeatherQuestState.Done | HellfeatherQuestState.Active) }
        // Jessa's death points to the seamstress, and her token to Moth.
        if quest == 3 {
            if Seamstress >= 1 { return HellfeatherQuestState.Done }
            return Moult >= 3 ? HellfeatherQuestState.Active | HellfeatherQuestState.Unknown
        }
        if quest == 4 {
            if Dark >= 3 { return HellfeatherQuestState.Done }
            return Dark >= 1 || Rooms >= 2 ? HellfeatherQuestState.Active | HellfeatherQuestState.Unknown
        }
        if quest == 5 {
            if Millrace >= 5 { return HellfeatherQuestState.Done }
            return Millrace >= 1 || Dark >= 3 ? HellfeatherQuestState.Active | HellfeatherQuestState.Unknown
        }
        return HellfeatherQuestState.Unknown
    }

    // What the log says about a quest as it stands. Lines are at most
    // HellfeatherQuestLogArt.LineChars long, and there are at most LineCount of them.
    string [] Journal(int quest)
    {
        string [] lines
        if quest == 0 {
            if Moult == 1 {
                lines += "Matthew, a journeyman at"
                lines += "the Crooked Raven, paid"
                lines += "half to see a dying"
                lines += "weaver, Jessa Brune."
                lines += ""
                lines += "Ask for Sister Carmine at"
                lines += "Saint Orra's Hospice, up"
                lines += "the pilgrim road."
            } else if Moult == 2 {
                lines += "Sister Carmine let you in"
                lines += "for ten minutes."
                lines += ""
                lines += "Jessa lies in the outer"
                lines += "ward, by the window."
            } else if Moult == 3 {
                lines += "Jessa died holding your"
                lines += "arm. Her mark lives in"
                lines += "you now: silver threads"
                lines += "running to the mountains."
                lines += ""
                lines += "Return to Matthew at the"
                lines += "Crooked Raven."
            } else if Moult >= 4 {
                lines += "Jessa gave you her reason"
                lines += "and Matthew paid the"
                lines += "rest. Her garret above"
                lines += "Pell's stands open."
            }
        } else if quest == 1 {
            if Ford >= 2 {
                lines += "The Ford Road is clear"
                lines += "and the ravens are fed."
            } else {
                if Ford == 0 {
                    lines += "Reeve Hollan wants the"
                    lines += "Ford Road cleared of"
                    lines += "ducks. Ask him."
                } else {
                    lines += "Reeve Hollan pays for"
                    lines += "ducks cleared off the"
                    lines += "Ford Road."
                    if ReevePaid { lines += "The Reeve has paid." }
                    else if DucksCleared < DucksWanted { lines += "Ducks cleared: " + QuaxelUi.FormatInt(DucksCleared) + "/" + QuaxelUi.FormatInt(DucksWanted) }
                    else {
                        lines += "The road is clear. Tell"
                        lines += "the Reeve."
                    }
                }
                lines += ""
                if FeathersGiven { lines += "Edda has her feathers." }
                else {
                    lines += "Edda at the Rookery wants"
                    lines += "twelve black feathers."
                    lines += "Carrying " + QuaxelUi.FormatInt(Math.Min(FeathersHeld, HellfeatherQuests.FeathersWanted)) + "/" + QuaxelUi.FormatInt(HellfeatherQuests.FeathersWanted) + "."
                }
            }
        } else if quest == 2 {
            if Rooms == 1 {
                lines += "Matthew says Jessa kept a"
                lines += "garret above Pell's."
                lines += ""
                lines += "Search it."
            } else if Rooms == 2 {
                lines += "In the garret: a journal,"
                lines += "black honey and a token"
                lines += "stamped with a lantern"
                lines += "and a moth."
                lines += ""
                lines += "Someone waits on the"
                lines += "stair outside."
            } else if Rooms == 3 {
                lines += "Sister Vale warned you"
                lines += "not to drink the honey."
                lines += ""
                lines += "The Red Cuffs have come"
                lines += "for you. Survive them."
            } else if Rooms >= 4 {
                lines += "The Red Cuffs lie dead."
                lines += "The rooms remember what"
                lines += "Jessa left in them."
            }
        } else if quest == 3 {
            if Seamstress >= 1 {
                lines += "Marra gave you Jessa's"
                lines += "thimble, and a warning:"
                lines += ""
                lines += "When you sever, the"
                lines += "closing stroke faces the"
                lines += "bearer. Never the heart."
            } else {
                lines += "Jessa Brune was a weaver."
                lines += "Marra Senn, who mends"
                lines += "clothes in town, may have"
                lines += "known her."
            }
        } else if quest == 4 {
            if Dark == 0 {
                lines += "Jessa's token bears a"
                lines += "lantern and a moth."
                lines += ""
                lines += "Moth, a dealer in town,"
                lines += "might know what it opens."
            } else if Dark == 1 {
                lines += "Red Cuffs raided Moth's"
                lines += "shop while you talked."
                lines += ""
                lines += "Fight off the raiders."
            } else if Dark == 2 {
                lines += "The raiders are down."
                lines += ""
                lines += "Moth is waiting to talk."
            } else {
                lines += "Moth gave you a grey"
                lines += "ring. It opens what the"
                lines += "Tithe keeps shut."
            }
        } else if quest == 5 {
            if Millrace == 0 {
                lines += "Moth's grey ring opens"
                lines += "doors the Tithe keeps"
                lines += "shut."
                lines += ""
                lines += "Old Hobb at the mill"
                lines += "knows a low door at the"
                lines += "water."
            } else if Millrace == 1 {
                lines += "Old Hobb opened the"
                lines += "millrace door."
                lines += ""
                lines += "Go down beneath the mill."
            } else if Millrace == 2 {
                lines += "The Undercroft runs deep"
                lines += "under Hobb's Mill."
                lines += ""
                lines += "Find Mardra below."
            } else if Millrace == 3 {
                lines += "Mardra is dead and her"
                lines += "ring cracked through."
                lines += ""
                lines += "Sever the ring on its"
                lines += "pedestal."
            } else if Millrace == 4 {
                lines += "The first Severing is"
                lines += "done."
                lines += ""
                lines += "Someone watches from the"
                lines += "mill stair."
            } else {
                lines += "Lise Hobb knew you from"
                lines += "an inn window, two years"
                lines += "ago."
                lines += ""
                lines += "Act I is over."
            }
            if Millrace >= 1 && BearersFreed > 0 {
                lines += ""
                lines += "Bearers freed: " + QuaxelUi.FormatInt(BearersFreed)
            }
        }
        return lines
    }
}
#{
    #int DucksWanted = 12
    #int FeathersWanted = 12
    // Every act has this many quests, one for each slot of the log.
    #int PerAct = 6

    string Title(int quest)
    {
        if quest == 0 { return "The Dead Woman's Reason" }
        if quest == 1 { return "Feathers on the Ford" }
        if quest == 2 { return "Rooms Remember" }
        if quest == 3 { return "The Seamstress's Grudge" }
        if quest == 4 { return "Things Sold in the Dark" }
        if quest == 5 { return "The Millrace Door" }
        return ""
    }
}

HellfeatherQuestState : int
#@{
    Unknown, Active, Done
}

HellfeatherGame : QuaxelGameInstance
{
    HellfeatherQuests Quests
    HellfeatherSpots People
    HellfeatherDialogue Talk
    HellfeatherBanner Banner

    // A quest item or reward: into the bag, or at her feet if it is full.
    Give(QuaxelWorld& world, HellfeatherItems item)
    {
        HellfeatherItemMods none
        none.Clear()
        if Inventory.Items.AddWith(item, none) { return }
        Ground.PlaceWith(world, item, none, DropSpotAround(world.GetPosition(PlayerNode)))
    }

    -bool Carries(HellfeatherItems item) { return Inventory.Items.CountOf(item) > 0 }

    // Whether a spot has something new to say, for the mark over its name.
    bool HasNews(int spot)
    {
        HellfeatherPerson person = People.Spots[spot].Person
        HellfeatherQuests q = Quests
        if IsActTwoPerson(person) || HellfeatherRealm.IsActTwo(People.Spots[spot].Realm) || People.Spots[spot].Kind >= HellfeatherSpotKind.Road { return NewsTwo(spot) }
        if person == HellfeatherPerson.Matthew { return q.Moult == 0 || q.Moult == 3 }
        if person == HellfeatherPerson.Carmine { return q.Moult == 1 }
        if person == HellfeatherPerson.Jessa { return q.Moult == 2 }
        if person == HellfeatherPerson.Reeve { return q.Ford == 0 || (q.Ford == 1 && q.DucksCleared >= HellfeatherQuests.DucksWanted && !q.ReevePaid) }
        if person == HellfeatherPerson.Edda { return !q.FeathersGiven && Inventory.Items.FeatherCount() >= HellfeatherQuests.FeathersWanted }
        if person == HellfeatherPerson.Marra { return q.Moult >= 3 && q.Seamstress == 0 }
        if person == HellfeatherPerson.Moth { return (q.Dark == 0 && Carries(HellfeatherItems.LanternToken)) || q.Dark == 2 }
        if person == HellfeatherPerson.Vale { return q.Rooms == 2 }
        if person == HellfeatherPerson.OldHobb { return q.Millrace == 0 && Carries(HellfeatherItems.GreyKey) }
        if person == HellfeatherPerson.Lise { return q.Millrace == 4 }
        if People.Spots[spot].Kind == HellfeatherSpotKind.Garret { return q.Rooms == 1 }
        if People.Spots[spot].Kind == HellfeatherSpotKind.Boots { return !q.BootsTaken }
        if People.Spots[spot].Kind == HellfeatherSpotKind.Pedestal { return q.Millrace == 3 }
        return false
    }

    // What a click on a spot within reach does: a conversation, or a door.
    Use(QuaxelWorld& world, int spot)
    {
        if UseActTwo(world, spot) { return }
        HellfeatherSpotKind kind = People.Spots[spot].Kind
        if kind == HellfeatherSpotKind.Entrance {
            if People.Spots[spot].Leads == HellfeatherRealm.Garret && Quests.Rooms == 0 {
                Talk.Begin("Jessa's garret", spot, false)
                Talk.Narrate("A narrow door at the top of Pell's stair. Locked. Whoever lives here is not home.")
                Talk.Offer("Leave", HellfeatherReply.Leave)
                return
            }
            EnterInterior(world, spot)
            return
        }
        if kind == HellfeatherSpotKind.Exit {
            LeaveInterior(world)
            return
        }
        if kind == HellfeatherSpotKind.Door {
            if Quests.Millrace >= 1 { Travel(world, HellfeatherRealm.Undercroft, true) }
            else {
                Talk.Begin("The millrace hatch", spot, false)
                Talk.Narrate("A hatch banded with iron, over the sound of the race. Bolted from below.")
                Talk.Offer("Leave it", HellfeatherReply.Leave)
            }
            return
        }
        if kind == HellfeatherSpotKind.StairsDown {
            Travel(world, HellfeatherRealm.UndercroftDeep, true)
            return
        }
        if kind == HellfeatherSpotKind.StairsUp {
            Travel(world, Terrain.Realm == HellfeatherRealm.UndercroftDeep ? HellfeatherRealm.Undercroft | HellfeatherRealm.Mill, false)
            return
        }
        if kind == HellfeatherSpotKind.Bearer {
            Talk.Begin("Hollowed Bearer", spot, false)
            Talk.Narrate("Chained to the frame, silver wire at both wrists. The mark on your arm knows the wire.")
            if Quests.TitheMark { Talk.Offer("Sever the wire and free them", HellfeatherReply.FreeBearer) }
            Talk.Offer("Leave them", HellfeatherReply.Leave)
            return
        }
        if kind == HellfeatherSpotKind.Garret {
            TalkGarret(spot)
            return
        }
        if kind == HellfeatherSpotKind.Boots {
            Talk.Begin("Jessa's boots", spot, false)
            Talk.Narrate("Water has dried on the floor in a curve, as if it went around a pair of boots on purpose.")
            Talk.Narrate("The boots are still standing in the dry. Tall, close-stitched, cold to the touch.")
            Talk.Offer("Take the boots", HellfeatherReply.TakeBoots)
            Talk.Offer("Leave them", HellfeatherReply.Leave)
            return
        }
        if kind == HellfeatherSpotKind.Pedestal {
            TalkPedestal(spot)
            return
        }
        if kind == HellfeatherSpotKind.Portal {
            UsePortal(world, spot)
            return
        }
        if kind == HellfeatherSpotKind.MillPortal {
            UseMillPortal(world)
            return
        }
        if kind == HellfeatherSpotKind.Stash {
            OpenChest()
            return
        }
        if kind == HellfeatherSpotKind.Waypoint {
            UseWaypoint(spot)
            return
        }
        TalkTo(world, spot)
        People.SetTalking(world, spot)
        FacePlayerToward(world, People.Spots[spot].Feet)
    }

    // Turns Wren to look at a point, as when she starts talking to someone.
    -FacePlayerToward(QuaxelWorld& world, vec3 point)
    {
        for controller : Controllers {
            vec3 at = world.GetPosition(controller.Node)
            vec3 facing = Math.Normalize(vec3(point.X - at.X, 0.0, point.Z - at.Z))
            if (facing.X == 0.0 && facing.Z == 0.0) || !world.Has(controller.VisualNode, QuaxelComponents.Transform) { continue }
            QuaxelTransform pose = world.GetTransform(controller.VisualNode)
            pose.FacingX = facing.X
            pose.FacingZ = facing.Z
            world.SetTransform(controller.VisualNode, pose)
        }
    }

    -TalkGarret(int spot)
    {
        Talk.Begin("Jessa's desk", spot, false)
        if Quests.Rooms == 0 {
            Talk.Narrate("Her desk. Nothing here you have a reason to touch yet.")
            Talk.Offer("Leave", HellfeatherReply.Leave)
            return
        }
        if Quests.Rooms == 1 {
            Talk.Narrate("A journal in a hand that slopes uphill. A vial of black honey, stoppered with wax. A token stamped with a lantern and a moth.")
            Talk.Offer("Take them", HellfeatherReply.SearchGarret)
            Talk.Offer("Leave them", HellfeatherReply.Leave)
            return
        }
        Talk.Narrate("Loose papers, a cold candle. Nothing left that she would want found.")
        Talk.Offer("Leave", HellfeatherReply.Leave)
    }

    -TalkPedestal(int spot)
    {
        Talk.Begin("The ring pedestal", spot, false)
        if Quests.Millrace != 3 {
            Talk.Narrate("Cracked stone, and wire that goes nowhere now.")
            Talk.Offer("Leave", HellfeatherReply.Leave)
            return
        }
        Talk.Narrate("Mardra's ring lies on the stone, cracked through. Silver wire runs out of it into the floor and away to every frame. Release. Return. Close.")
        if Quests.SeveringKnown { Talk.Narrate("You face the bearers, not the heart.") }
        else { Talk.Narrate("You face the heart, and it nearly goes wrong.") }
        Talk.Offer("Sever", HellfeatherReply.Sever)
    }

    // People with a model of their own are talked to in a close-up.
    -BeginTalk(string speaker, int spot)
    {
        Talk.Begin(speaker, spot, Length(People.Spots[spot].Model) > 0)
    }

    // The topics a person will talk about, the trade if they keep a shop, and
    // the farewell. A Forced conversation has one reply that must be made.
    -EndTalk(HellfeatherPerson person, bool forced)
    {
        if forced { return }
        AddTopics(person)
        if Sells(person) { Talk.Offer("Trade", HellfeatherReply.Browse) }
        if person == HellfeatherPerson.Edda { Talk.Offer("What have the ravens found?", HellfeatherReply.Hoard) }
        Talk.Offer("Farewell", HellfeatherReply.Leave)
    }

    -TalkTo(QuaxelWorld& world, int spot)
    {
        if TalkActTwo(world, spot) { return }
        HellfeatherPerson person = People.Spots[spot].Person
        HellfeatherQuests q = Quests
        bool forced = false
        if person == HellfeatherPerson.Matthew {
            BeginTalk("Matthew the Journeyman", spot)
            if q.Moult == 0 {
                Talk.Say("A thief-taker. Good. Sit. I won't keep you.")
                Talk.Say("A weaver, Jessa Brune, is dying at Saint Orra's Hospice, up the pilgrim road. She has something to give, and only someone like you can take it.")
                Talk.Reply("Someone like me?")
                Talk.Say("Half now, half after. Ask for Sister Carmine at the gate.")
                Talk.Offer("Take the commission", HellfeatherReply.TakeCommission)
            } else if q.Moult == 3 {
                Talk.Say("So it's done. You have her reason now, whether you wanted it or not.")
                Talk.Say("The other half, as promised. Mind the arm.")
                Talk.Offer("Take the silver", HellfeatherReply.MatthewPays)
                forced = true
            } else if q.Moult < 3 {
                Talk.Say("Past the Ford Road and the marsh, up Orra's Hill. Sister Carmine is expecting you.")
            } else {
                Talk.Narrate("He polishes a cup he never drinks from. His breath does not mist.")
            }
        } else if person == HellfeatherPerson.Carmine {
            BeginTalk("Sister Carmine", spot)
            if q.Moult == 1 {
                Talk.Say("You'll be the one he sent. Ten minutes. Outer ward, the bed by the window.")
                Talk.Narrate("Click, click goes the steel pen.")
                Talk.Offer("Go to Jessa", HellfeatherReply.GoToJessa)
            } else {
                Talk.Say("Visiting hours are over. Stay, and you become my problem.")
                Talk.Narrate("Click. Click.")
            }
        } else if person == HellfeatherPerson.Jessa {
            BeginTalk("Jessa Brune", spot)
            if q.Moult == 2 {
                Talk.Narrate("Her eyes open. Black at the lips, black under the nails. She knows you before you speak.")
                Talk.Say("Matthew's thief-taker. Good. I haven't long, and it won't wait for me to finish.")
                Talk.Say("They'll tell you I killed them. Twenty-seven at the mill. Write it down if it helps you.")
                Talk.Say("It isn't why. Nobody ever asks why.")
                Talk.Narrate("Her hand finds your right forearm and closes. Cold, then not cold at all.")
                Talk.Narrate("The pain goes in without breaking the skin. Silver threads run out of every bed in the ward, toward the mountains.")
                Talk.Say("Find the Grey Sister. Sever the bearers first. Then the heart. Don't break the box.")
                Talk.Say("I'm sorry. It had to be someone who could carry it.")
                Talk.Offer("...", HellfeatherReply.JessaDies)
                forced = true
            } else if q.Moult > 2 {
                Talk.Narrate("She looks smaller than she did. Her hand lies open on the blanket, where it let go of you.")
            } else {
                Talk.Narrate("Asleep, black-stained lips moving. A sister in red is watching you.")
            }
        } else if person == HellfeatherPerson.Reeve {
            BeginTalk("Reeve Hollan", spot)
            if q.Ford == 0 {
                Talk.Say("Ah. You'll be the one with the sword. Splendid.")
                Talk.Say("Those wretched ducks have taken the Ford Road, and with it our only line to Bellhaven. Not a cart in or out for a fortnight.")
                Talk.Say("No trade, no grain, no coin. Ravenford is going hungry, and I am running out of polite ways to say so.")
                Talk.Say("Clear a dozen of the beasts off it and the Hall will pay handsomely. Edda at the Rookery wants their black feathers, should you have the stomach for picking them up.")
                Talk.Offer("Take the bounty", HellfeatherReply.TakeBounty)
            } else if q.Ford == 1 && !q.ReevePaid && q.DucksCleared >= HellfeatherQuests.DucksWanted {
                Talk.Say("The road's gone quiet, and the carters have noticed. First wagon for Bellhaven left this morning. Your bounty, with the Hall's thanks.")
                Talk.Offer("Take the bounty", HellfeatherReply.ClaimBounty)
                forced = true
            } else if q.Ford == 1 && !q.ReevePaid {
                Talk.Say("A dozen, I believe we said. You've managed " + QuaxelUi.FormatInt(q.DucksCleared) + ". The road is still very much theirs.")
            } else {
                Talk.Say("Copies of everything, mind. Always copies.")
            }
        } else if person == HellfeatherPerson.Edda {
            BeginTalk("Edda the Ravenkeeper", spot)
            if Carries(HellfeatherItems.TitheBracelet) {
                Talk.Say("That bracelet. Tin, off the tithe rolls. They put them on the ones sent to the mill.")
            }
            if !q.FeathersGiven && Inventory.Items.FeatherCount() >= HellfeatherQuests.FeathersWanted {
                Talk.Say("Twelve. Good. The ravens eat what we can't.")
                Talk.Say("Take this. It knows more about feathers than about people. Like me.")
                Talk.Offer("Hand over twelve feathers", HellfeatherReply.GiveFeathers)
            } else if !q.FeathersGiven {
                Talk.Say("Black feathers. Twelve of them. They come off the ducks, thicker when the sky rains them.")
                Talk.Reply("I have " + QuaxelUi.FormatInt(Inventory.Items.FeatherCount()) + ".")
            } else {
                Talk.Say("The ravens know you now. That isn't always a kindness.")
            }
            if !Quests.HoardTold {
                Quests.HoardTold = true
                Talk.Say("Any feathers past that, the ravens trade for. They bring me what they pick off the dead, wrapped up. I don't open the bundles.")
                Talk.Say("Mostly it's plain. Now and then there's something in it that still hums.")
            }
        } else if person == HellfeatherPerson.Marra {
            BeginTalk("Marra Senn", spot)
            if q.Moult >= 3 && q.Seamstress == 0 {
                Talk.Narrate("At Jessa's name Marra drives a needle through her own thumb, and doesn't look at it.")
                Talk.Say("The Cloister of Looms threw her out. Instability of retention, they wrote.")
                Talk.Say("If you sever anything, the closing stroke faces the bearer. Not the heart. Never.")
                Talk.Offer("Take the thimble she holds out", HellfeatherReply.TakeThimble)
            } else {
                Talk.Say("Mending's two silver a seam. Talking's more.")
            }
        } else if person == HellfeatherPerson.Moth {
            BeginTalk("Moth", spot)
            if q.Dark == 0 && Carries(HellfeatherItems.LanternToken) {
                Talk.Say("Jessa's token. And a mark on your arm.")
                Talk.Narrate("He reads it through his loupe.")
                Talk.Say("Carrier lattice. Mister Journeyman described you.")
                Talk.Narrate("A grey ring on the counter, an eye inside it. Boots on the stair. Red at the cuffs.")
                Talk.Offer("Turn to meet them", HellfeatherReply.MothRaid)
                forced = true
            } else if q.Dark == 1 {
                Talk.Say("Later. Later!")
            } else if q.Dark == 2 {
                Talk.Say("They'll be back, and so will I. Take the ring. It opens what the Tithe keeps shut.")
                Talk.Offer("Take the grey ring", HellfeatherReply.TakeKey)
                forced = true
            } else if q.Dark == 3 {
                Talk.Say("Desperation is an excellent teacher and a terrible curriculum.")
            } else {
                Talk.Say("Closed to people without introductions.")
            }
        } else if person == HellfeatherPerson.Vale {
            BeginTalk("Sister Vale", spot)
            if q.Rooms == 2 {
                Talk.Narrate("A tall woman in a grey coat on the stair. Her shadow leans the wrong way.")
                Talk.Say("Do not drink what you found.")
                Talk.Offer("...", HellfeatherReply.ValeWarns)
                forced = true
            } else {
                Talk.Narrate("A blade passes through her like smoke. She does not seem to notice.")
            }
        } else if person == HellfeatherPerson.OldHobb {
            BeginTalk("Old Hobb", spot)
            if q.Millrace == 0 && Carries(HellfeatherItems.GreyKey) {
                Talk.Narrate("He twists his cap.")
                Talk.Say("They have my boy. They said if I opened it for anyone...")
                Talk.Narrate("He sees the grey ring and goes still.")
                Talk.Say("Then you're the one. The low door, at the water.")
                Talk.Offer("Open the millrace door", HellfeatherReply.OpenMillrace)
            } else if q.Millrace == 0 {
                Talk.Say("Nothing down there but the wheel. Go home.")
            } else if q.Millrace < 4 {
                Talk.Say("Go on, then. Please.")
                if q.ThrallsSpared > 0 { Talk.Say("Some of my millhands ran. Thank you.") }
            } else {
                Talk.Say("It's quiet below. First time in twelve years.")
            }
        } else if person == HellfeatherPerson.Lise {
            BeginTalk("Lise Hobb", spot)
            if q.Millrace == 4 {
                Talk.Narrate("Mardra's daughter watches from the mill stair, on a crutch, her hip set wrong.")
                Talk.Narrate("Two years ago. An inn. A window. You threw her through the glass, in Matthew's rescue.")
                Talk.Say("You.")
                Talk.Narrate("Nothing else.")
                Talk.Offer("...", HellfeatherReply.LiseWindow)
                forced = true
            } else {
                Talk.Narrate("She does not look away.")
            }
        }
        EndTalk(person, forced)
    }

    // Carries out a reply picked in the dialogue.
    Answer(QuaxelWorld& world, HellfeatherReply reply)
    {
        int spot = Talk.Spot
        // A topic is answered in the same conversation.
        if reply == HellfeatherReply.Topic {
            if spot >= 0 && spot < People.Spots.Len { Discuss(People.Spots[spot].Person, Talk.ChosenTopic) }
            return
        }
        int chosen = Talk.ChosenTopic
        Talk.Close()
        People.SetTalking(world, -1)
        if reply == HellfeatherReply.Waypoint {
            TravelToWaypoint(world, chosen)
            return
        }
        vec3 player = world.GetPosition(PlayerNode)
        if AnswerActTwo(world, reply, spot) { return }
        if reply == HellfeatherReply.TakeCommission {
            Quests.Moult = 1
            Inventory.Items.Gold += 25
            Banner.Show("The Dead Woman's Reason", 3.0)
        } else if reply == HellfeatherReply.GoToJessa {
            Quests.Moult = 2
        } else if reply == HellfeatherReply.JessaDies {
            Quests.Moult = 3
            Quests.TitheMark = true
            // She lets go and dies, and the mark takes in Wren's arm.
            int jessa = People.FindPerson(HellfeatherPerson.Jessa)
            if jessa >= 0 {
                People.Spots[jessa].Title = "Jessa Brune, dead"
                People.Spots[jessa].Rest = "dead"
                if People.Spots[jessa].Visual != 0 { world.PlayClip(People.Spots[jessa].Visual, "death") }
            }
            TakeMark(world)
            Banner.Show("The Tithe-mark lives in you now", 3.5)
            GainExperience(60)
            // In the close-up she dies before Wren's eyes, and the mark takes
            // there, before the conversation lets her go.
            if CloseUp.Shown && spot >= 0 {
                CloseUp.ThemRest = "dead"
                CloseUp.PlayThem(world, "death")
                CloseUp.Mark(world)
                SetMarkLight(world, 0.0)
                Talk.Begin("Jessa Brune", spot, true)
                Talk.Narrate("Her grip tightens once, hard enough to bruise, and lets go. Her hand falls open on the blanket.")
                Talk.Narrate("Under your skin the silver goes on burning, a lattice from wrist to elbow, long after she is still.")
                Talk.Offer("...", HellfeatherReply.Leave)
            }
        } else if reply == HellfeatherReply.MatthewPays {
            Quests.Moult = 4
            Quests.Rooms = Math.Max(Quests.Rooms, 1)
            Inventory.Items.Gold += 25
            GainExperience(100)
            Banner.Show("Jessa's garret is open above Pell's", 3.0)
        } else if reply == HellfeatherReply.TakeBounty {
            Quests.Ford = 1
            Banner.Show("Feathers on the Ford", 3.0)
        } else if reply == HellfeatherReply.ClaimBounty {
            Quests.ReevePaid = true
            Inventory.Items.Gold += 80
            GainExperience(60)
            if Quests.FeathersGiven { Quests.Ford = 2 }
        } else if reply == HellfeatherReply.GiveFeathers {
            Inventory.Items.TakeStack(HellfeatherItems.BlackFeather, HellfeatherQuests.FeathersWanted)
            Quests.FeathersGiven = true
            Give(world, HellfeatherItems.EddasQuillCharm)
            GainExperience(60)
            if Quests.ReevePaid { Quests.Ford = 2 }
        } else if reply == HellfeatherReply.SearchGarret {
            Quests.Rooms = 2
            Give(world, HellfeatherItems.BlackHoney)
            Give(world, HellfeatherItems.LanternToken)
            int vale = People.FindPerson(HellfeatherPerson.Vale)
            if vale >= 0 {
                People.Spots[vale].Shown = true
                People.Spots[vale].Feet = HellfeatherCast.ValeOnTheStair()
            }
            Banner.Show("Someone is on the stair", 2.5)
        } else if reply == HellfeatherReply.ValeWarns {
            Quests.Rooms = 3
            int vale = People.FindPerson(HellfeatherPerson.Vale)
            if vale >= 0 { People.Spots[vale].Shown = false }
            // The Red Cuffs come calling, and the guards look away.
            Quests.AmbushFirst = (int)Enemies.Len
            AddScripted(world, "SergeantOttar", player.X + 4.0, player.Z + 3.0)
            AddScripted(world, "Cuffman", player.X - 3.5, player.Z + 3.5)
            AddScripted(world, "Cuffman", player.X + 3.5, player.Z - 3.0)
            Banner.Show("The Red Cuffs come calling", 3.0)
        } else if reply == HellfeatherReply.TakeThimble {
            Quests.Seamstress = 1
            Quests.SeveringKnown = true
            Give(world, HellfeatherItems.MarrasThimble)
            GainExperience(80)
        } else if reply == HellfeatherReply.MothRaid {
            Quests.Dark = 1
            Quests.RaidFirst = (int)Enemies.Len
            AddScripted(world, "Cuffman", player.X + 4.0, player.Z + 2.0)
            AddScripted(world, "Cuffman", player.X - 3.0, player.Z + 4.0)
            AddScripted(world, "BladelockArbalist", player.X + 1.0, player.Z + 7.0)
            int vale = People.FindPerson(HellfeatherPerson.Vale)
            if vale >= 0 {
                People.Spots[vale].Shown = true
                People.Spots[vale].Feet = HellfeatherCast.ValeAtTheMoth()
            }
            Banner.Show("Moth's raid", 3.0)
        } else if reply == HellfeatherReply.TakeKey {
            Quests.Dark = 3
            Give(world, HellfeatherItems.GreyKey)
            GainExperience(120)
            int vale = People.FindPerson(HellfeatherPerson.Vale)
            if vale >= 0 { People.Spots[vale].Shown = false }
        } else if reply == HellfeatherReply.TakeBoots {
            // The boots leave the dry outline in the stain, which stays.
            Quests.BootsTaken = true
            int boots = People.FindKind(HellfeatherSpotKind.Boots, HellfeatherRealm.Garret)
            if boots >= 0 { People.Spots[boots].Shown = false }
            Give(world, HellfeatherItems.JessasWaterwalkers)
        } else if reply == HellfeatherReply.Hoard {
            OpenShop(HellfeatherMerchant.Ravens)
        } else if reply == HellfeatherReply.Browse {
            if spot >= 0 && spot < People.Spots.Len { OpenShop(HellfeatherMerchants.Of(People.Spots[spot].Person)) }
        } else if reply == HellfeatherReply.OpenMillrace {
            Quests.Millrace = 1
            Banner.Show("The Millrace Door", 3.0)
        } else if reply == HellfeatherReply.Sever {
            Quests.Millrace = 4
            Give(world, HellfeatherItems.RuneDash)
            Give(world, HellfeatherItems.MardrasRingShards)
            GainExperience(300)
            int lise = People.FindPerson(HellfeatherPerson.Lise)
            if lise >= 0 { People.Spots[lise].Shown = true }
            // The wire's light opens a way out, up to the mill.
            ShowMillPortal()
            Banner.Show("The first Severing", 3.5)
        } else if reply == HellfeatherReply.LiseWindow {
            Quests.Millrace = 5
            Talk.Begin("Interlude I", spot, false)
            Talk.Narrate("A stone room, one candle. Inquisitor Rahel Dar.")
            Talk.Say("You say Jessa gave it to you.")
            Talk.Reply("She gave it. I took it. The difference was the only thing I still owned.")
            Talk.Offer("End of Act I", HellfeatherReply.Interlude)
        } else if reply == HellfeatherReply.FreeBearer {
            FreeBearer(world, spot)
        }
    }

    // A Hollowed Bearer let out of its frame: worth more than killing it.
    -FreeBearer(QuaxelWorld& world, int spot)
    {
        if spot < 0 || spot >= People.Spots.Len { return }
        int i = People.Spots[spot].Enemy
        if i < 0 || i >= Enemies.Len || Enemies[i].Health <= 0 { return }
        Enemies[i].Health = 0
        Enemies[i].Freed = true
        Enemies[i].LootDropped = true
        world.PlayClip(Enemies[i].VisualNode, "death")
        GainExperience(Spawner.Table.Kinds[Enemies[i].Kind].Experience * 2)
        Quests.BearersFreed++
        People.Spots[spot].Shown = false
    }

    // Moves quests along on what happened in the world this step.
    StepQuests(QuaxelWorld& world)
    {
        if Quests.Rooms == 3 && Quests.AmbushFirst >= 0 && AllFallenFrom(Quests.AmbushFirst) {
            Quests.Rooms = 4
            GainExperience(120)
            Banner.Show("Rooms Remember: done", 3.0)
        }
        if Quests.Dark == 1 && Quests.RaidFirst >= 0 && AllFallenFrom(Quests.RaidFirst) {
            Quests.Dark = 2
            Banner.Show("The raiders are down. Moth is waiting", 3.0)
        }
        // The Bearer spot follows the nearest chained bearer beside her.
        int bearerSpot = People.FindKind(HellfeatherSpotKind.Bearer, Terrain.Realm)
        if bearerSpot >= 0 {
            vec3 player = world.GetPosition(PlayerNode)
            int nearest = -1
            float best = 2.6
            for i : 0; i < Enemies.Len; i++ {
                if !Enemies[i].Awake || Enemies[i].Health <= 0 || Enemies[i].Move != HellfeatherMove.Chained { continue }
                vec3 at = world.GetPosition(Enemies[i].Node)
                float gap = Math.Hypot(at.X - player.X, at.Z - player.Z)
                if gap < best {
                    best = gap
                    nearest = i
                }
            }
            People.Spots[bearerSpot].Shown = nearest >= 0
            People.Spots[bearerSpot].Enemy = nearest
            if nearest >= 0 {
                vec3 at = world.GetPosition(Enemies[nearest].Node)
                People.Spots[bearerSpot].Feet = vec3(at.X, at.Y - Enemies[nearest].Radius, at.Z)
            }
        }
    }

    // A kill counts toward the quests: ducks off the Ford, and Mardra.
    CountKill(QuaxelWorld& world, int i)
    {
        CountActTwoKill(world, i)
        if Enemies[i].Move == HellfeatherMove.Brood {
            Quests.Millrace = Math.Max(Quests.Millrace, 3)
            int pedestal = People.FindKind(HellfeatherSpotKind.Pedestal, HellfeatherRealm.UndercroftDeep)
            if pedestal >= 0 { People.Spots[pedestal].Shown = true }
            Banner.Show("Mardra falls. Her ring cracks", 3.5)
            return
        }
        if Spawner.Table.Kinds[Enemies[i].Kind].Name == "OldGreyneck" {
            Quests.GreyneckSlain = true
            Banner.Show("Old Greyneck is dead", 3.0)
        }
        if Quests.Ford == 1 && Spawner.Table.Kinds[Enemies[i].Kind].Feathers > 0 && ZoneOf(i) == HellfeatherZone.FordRoad { Quests.DucksCleared++ }
    }

    // The zone of the group an enemy came with, or -1.
    int ZoneOf(int i)
    {
        for encounter : Spawner.Encounters {
            if i >= encounter.First && i < encounter.First + encounter.Count {
                return encounter.Group >= 0 ? Spawner.Table.Groups[encounter.Group].Zone | -1
            }
        }
        return -1
    }
}
