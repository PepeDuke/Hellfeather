// What a passive adds to. ManaRegen is in tenths of mana per second.
HellfeatherPassiveStat : int
#@{
    Strength,
    Agility,
    Health,
    Mana,
    DamagePercent,
    Defense,
    HitChance,
    MoveSpeed,
    ManaRegen
}

// The four corners of the tree, in the order they are numbered.
HellfeatherPassiveQuadrant : int
#@{
    Vitality,
    Mana,
    Agility,
    Strength
}

HellfeatherPassiveTier : int
#@{
    Start,
    Minor,
    Notable,
    Keystone
}

// One passive for showing. X and Y are grid cells from the middle of the
// tree, X to the right and Y downward.
HellfeatherPassiveNode
{
    int X
    int Y
    HellfeatherPassiveQuadrant Quadrant
    HellfeatherPassiveTier Tier
    HellfeatherPassiveStat Stat
    int Amount
    string Name
    string Effect
}

// Which passives the warrior has taken. Node 0 is the start in the middle and is
// always taken. Each quadrant holds the same fifteen passives, mirrored into its
// corner: vitality top left, mana top right, agility bottom left and strength
// bottom right. A passive can be taken when it links to one already taken.
HellfeatherPassiveTree
{
    // One for each node; Count says how many there are.
    bool [61] Allocated

    bool IsAllocated(int index) { return index == 0 || Allocated[index] }

    // Passives taken, not counting the start.
    int Spent()
    {
        int spent = 0
        for i : 1; i < HellfeatherPassiveTree.Count; i++ { if Allocated[i] { spent++ } }
        return spent
    }

    bool TouchesAllocated(int index)
    {
        for i : 0; i < HellfeatherPassiveTree.Count; i++ {
            if i != index && IsAllocated(i) && HellfeatherPassiveTree.Linked(index, i) { return true }
        }
        return false
    }

    bool CanAllocate(int index, int points)
    {
        if index <= 0 || index >= HellfeatherPassiveTree.Count || points <= 0 || Allocated[index] { return false }
        return TouchesAllocated(index)
    }

    bool Allocate(int index, int points)
    {
        if !CanAllocate(index, points) { return false }
        Allocated[index] = true
        return true
    }

    // A passive can be given back when everything else taken still links to the start.
    bool CanRefund(int index)
    {
        if index <= 0 || index >= HellfeatherPassiveTree.Count || !Allocated[index] { return false }
        bool [61] reached
        int [] frontier = {0}
        reached[0] = true
        int found = 0
        while frontier.Len > 0 {
            int at = (frontier--)
            for i : 1; i < HellfeatherPassiveTree.Count; i++ {
                if i == index || reached[i] || !Allocated[i] || !HellfeatherPassiveTree.Linked(at, i) { continue }
                reached[i] = true
                found++
                frontier += i
            }
        }
        return found == Spent() - 1
    }

    bool Refund(int index)
    {
        if !CanRefund(index) { return false }
        Allocated[index] = false
        return true
    }

    // Adds every taken passive to the warrior's stats.
    ApplyTo(HellfeatherStats& stats)
    {
        for i : 1; i < HellfeatherPassiveTree.Count; i++ {
            if !Allocated[i] { continue }
            HellfeatherPassiveStat stat = HellfeatherPassiveStat.Strength
            int amount = 0
            HellfeatherPassiveTree.EffectOf(i, stat, amount)
            if stat == HellfeatherPassiveStat.Strength { stats.Strength += amount }
            if stat == HellfeatherPassiveStat.Agility { stats.Agility += amount }
            if stat == HellfeatherPassiveStat.Health { stats.MaxHealth += amount }
            if stat == HellfeatherPassiveStat.Mana { stats.MaxMana += amount }
            if stat == HellfeatherPassiveStat.DamagePercent { stats.DamagePercent += amount }
            if stat == HellfeatherPassiveStat.Defense { stats.Defense += amount }
            if stat == HellfeatherPassiveStat.HitChance { stats.HitBonus += amount }
            if stat == HellfeatherPassiveStat.MoveSpeed { stats.MoveSpeed += amount }
            if stat == HellfeatherPassiveStat.ManaRegen { stats.ManaPerSecond += (float)amount * 0.1 }
        }
    }
}
#{
    #int PerQuadrant = 15
    #int Count = 61

    // Where each of a quadrant's fifteen passives sits, counted from the middle
    // toward its corner. Four and eight end the two arms and are notables; the
    // keystone fourteen sits deepest in the corner.
    -int TemplateX(int slot)
    {
        int [15] x = {1, 2, 3, 4, 5, 1, 1, 1, 1, 3, 3, 2, 4, 3, 4}
        return x[slot]
    }

    -int TemplateY(int slot)
    {
        int [15] y = {1, 1, 1, 1, 1, 2, 3, 4, 5, 2, 3, 3, 3, 4, 4}
        return y[slot]
    }

    -int SlotOf(int index) { return (index - 1) % PerQuadrant }

    HellfeatherPassiveQuadrant QuadrantOf(int index)
    {
        if index <= 0 { return HellfeatherPassiveQuadrant.Vitality }
        return (HellfeatherPassiveQuadrant)((index - 1) / PerQuadrant)
    }

    HellfeatherPassiveTier TierOf(int index)
    {
        if index <= 0 { return HellfeatherPassiveTier.Start }
        int slot = SlotOf(index)
        if slot == 14 { return HellfeatherPassiveTier.Keystone }
        if slot == 4 || slot == 8 { return HellfeatherPassiveTier.Notable }
        return HellfeatherPassiveTier.Minor
    }

    int GridX(int index)
    {
        if index <= 0 { return 0 }
        quadrant : QuadrantOf(index)
        bool right = quadrant == HellfeatherPassiveQuadrant.Mana || quadrant == HellfeatherPassiveQuadrant.Strength
        return TemplateX(SlotOf(index)) * (right ? 1 | -1)
    }

    int GridY(int index)
    {
        if index <= 0 { return 0 }
        quadrant : QuadrantOf(index)
        bool lower = quadrant == HellfeatherPassiveQuadrant.Agility || quadrant == HellfeatherPassiveQuadrant.Strength
        return TemplateY(SlotOf(index)) * (lower ? 1 | -1)
    }

    // Neighbors in the same quadrant link, and each quadrant's first passive links
    // to the start.
    bool Linked(int a, int b)
    {
        if a == b { return false }
        if a == 0 || b == 0 { return SlotOf(a + b) == 0 }
        if QuadrantOf(a) != QuadrantOf(b) { return false }
        return Math.Abs(GridX(a) - GridX(b)) + Math.Abs(GridY(a) - GridY(b)) == 1
    }

    // What a passive gives, without building its text.
    EffectOf(int index, HellfeatherPassiveStat& stat, int& amount)
    {
        stat = HellfeatherPassiveStat.Strength
        amount = 0
        if index <= 0 { return }
        quadrant : QuadrantOf(index)
        tier : TierOf(index)
        bool firstArm = SlotOf(index) == 4
        if quadrant == HellfeatherPassiveQuadrant.Vitality {
            stat = HellfeatherPassiveStat.Health
            amount = 8
            if tier == HellfeatherPassiveTier.Notable && firstArm {
                stat = HellfeatherPassiveStat.Defense
                amount = 6
            }
            else if tier == HellfeatherPassiveTier.Notable { amount = 25 }
            else if tier == HellfeatherPassiveTier.Keystone { amount = 60 }
        }
        else if quadrant == HellfeatherPassiveQuadrant.Mana {
            stat = HellfeatherPassiveStat.Mana
            amount = 6
            if tier == HellfeatherPassiveTier.Notable && firstArm {
                stat = HellfeatherPassiveStat.ManaRegen
                amount = 5
            }
            else if tier == HellfeatherPassiveTier.Notable { amount = 20 }
            else if tier == HellfeatherPassiveTier.Keystone {
                stat = HellfeatherPassiveStat.ManaRegen
                amount = 15
            }
        }
        else if quadrant == HellfeatherPassiveQuadrant.Agility {
            stat = HellfeatherPassiveStat.Agility
            amount = 2
            if tier == HellfeatherPassiveTier.Notable && firstArm {
                stat = HellfeatherPassiveStat.MoveSpeed
                amount = 8
            }
            else if tier == HellfeatherPassiveTier.Notable {
                stat = HellfeatherPassiveStat.HitChance
                amount = 5
            }
            else if tier == HellfeatherPassiveTier.Keystone { amount = 12 }
        }
        else {
            stat = HellfeatherPassiveStat.Strength
            amount = 2
            if tier == HellfeatherPassiveTier.Notable && firstArm {
                stat = HellfeatherPassiveStat.DamagePercent
                amount = 10
            }
            else if tier == HellfeatherPassiveTier.Notable { amount = 6 }
            else if tier == HellfeatherPassiveTier.Keystone {
                stat = HellfeatherPassiveStat.DamagePercent
                amount = 25
            }
        }
    }

    string NameOf(int index)
    {
        tier : TierOf(index)
        if tier == HellfeatherPassiveTier.Start { return "Origin" }
        quadrant : QuadrantOf(index)
        bool firstArm = SlotOf(index) == 4
        if quadrant == HellfeatherPassiveQuadrant.Vitality {
            if tier == HellfeatherPassiveTier.Keystone { return "Colossus" }
            if tier == HellfeatherPassiveTier.Notable { return firstArm ? "Thick Skin" | "Stout Heart" }
            return "Vitality"
        }
        if quadrant == HellfeatherPassiveQuadrant.Mana {
            if tier == HellfeatherPassiveTier.Keystone { return "Font of Power" }
            if tier == HellfeatherPassiveTier.Notable { return firstArm ? "Clarity" | "Deep Well" }
            return "Spirit"
        }
        if quadrant == HellfeatherPassiveQuadrant.Agility {
            if tier == HellfeatherPassiveTier.Keystone { return "Wind Dancer" }
            if tier == HellfeatherPassiveTier.Notable { return firstArm ? "Fleet Foot" | "Keen Eye" }
            return "Agility"
        }
        if tier == HellfeatherPassiveTier.Keystone { return "Executioner" }
        if tier == HellfeatherPassiveTier.Notable { return firstArm ? "Heavy Blows" | "Brawn" }
        return "Strength"
    }

    // A line such as "+8 maximum health".
    string EffectText(HellfeatherPassiveStat stat, int amount)
    {
        if stat == HellfeatherPassiveStat.ManaRegen { return "+" + HellfeatherStats.FormatTenths((float)amount * 0.1) + " mana per second" }
        string value = "+" + QuaxelUi.FormatInt(amount)
        if stat == HellfeatherPassiveStat.Strength { return value + " strength" }
        if stat == HellfeatherPassiveStat.Agility { return value + " agility" }
        if stat == HellfeatherPassiveStat.Health { return value + " maximum health" }
        if stat == HellfeatherPassiveStat.Mana { return value + " maximum mana" }
        if stat == HellfeatherPassiveStat.DamagePercent { return value + "% damage" }
        if stat == HellfeatherPassiveStat.Defense { return value + " defense" }
        if stat == HellfeatherPassiveStat.HitChance { return value + "% hit chance" }
        return value + "% move speed"
    }

    HellfeatherPassiveNode Node(int index)
    {
        HellfeatherPassiveNode node
        node.X = GridX(index)
        node.Y = GridY(index)
        node.Quadrant = QuadrantOf(index)
        node.Tier = TierOf(index)
        HellfeatherPassiveStat stat = HellfeatherPassiveStat.Strength
        int amount = 0
        EffectOf(index, stat, amount)
        node.Stat = stat
        node.Amount = amount
        node.Name = NameOf(index)
        node.Effect = index == 0 ? "Where every path begins" | EffectText(stat, amount)
        return node
    }
}
T{
    EveryPassiveHasItsOwnCellInsideItsCorner()
    {
        for a : 0; a < HellfeatherPassiveTree.Count; a++ {
            int x = HellfeatherPassiveTree.GridX(a)
            int y = HellfeatherPassiveTree.GridY(a)
            T.IsTrue(Math.Abs(x) <= 5 && Math.Abs(y) <= 5)
            if a > 0 {
                quadrant : HellfeatherPassiveTree.QuadrantOf(a)
                T.AreEqual(x < 0, quadrant == HellfeatherPassiveQuadrant.Vitality || quadrant == HellfeatherPassiveQuadrant.Agility)
                T.AreEqual(y < 0, quadrant == HellfeatherPassiveQuadrant.Vitality || quadrant == HellfeatherPassiveQuadrant.Mana)
            }
            for b : a + 1; b < HellfeatherPassiveTree.Count; b++ {
                T.IsFalse(x == HellfeatherPassiveTree.GridX(b) && y == HellfeatherPassiveTree.GridY(b))
            }
        }
    }

    TheStrengthCornerIsBottomRightAndVitalityTopLeft()
    {
        int strength = 1 + 3 * HellfeatherPassiveTree.PerQuadrant
        T.AreEqual(HellfeatherPassiveTree.QuadrantOf(strength), HellfeatherPassiveQuadrant.Strength)
        T.IsTrue(HellfeatherPassiveTree.GridX(strength) > 0 && HellfeatherPassiveTree.GridY(strength) > 0)
        T.IsTrue(HellfeatherPassiveTree.GridX(1) < 0 && HellfeatherPassiveTree.GridY(1) < 0)
        T.AreEqual(HellfeatherPassiveTree.QuadrantOf(1), HellfeatherPassiveQuadrant.Vitality)
    }

    LinksGoBothWaysAndReachEveryPassive()
    {
        HellfeatherPassiveTree tree
        for a : 0; a < HellfeatherPassiveTree.Count; a++ {
            for b : 0; b < HellfeatherPassiveTree.Count; b++ {
                T.AreEqual(HellfeatherPassiveTree.Linked(a, b), HellfeatherPassiveTree.Linked(b, a))
            }
        }
        // Taking whatever is in reach, again and again, takes the whole tree.
        bool grew = true
        while grew {
            grew = false
            for i : 1; i < HellfeatherPassiveTree.Count; i++ {
                if tree.Allocate(i, 1) { grew = true }
            }
        }
        T.AreEqual(tree.Spent(), HellfeatherPassiveTree.Count - 1)
    }

    APassiveNeedsAPointAndALinkToOneTaken()
    {
        HellfeatherPassiveTree tree
        int first = 1
        int second = 2
        T.IsFalse(tree.Allocate(second, 5))
        T.IsFalse(tree.Allocate(first, 0))
        T.IsTrue(tree.Allocate(first, 1))
        T.IsFalse(tree.Allocate(first, 1))
        T.IsTrue(tree.Allocate(second, 1))
        T.AreEqual(tree.Spent(), 2)
    }

    OnlyPassivesThatLeaveTheRestLinkedCanBeRefunded()
    {
        HellfeatherPassiveTree tree
        tree.Allocate(1, 1)
        tree.Allocate(2, 1)
        tree.Allocate(3, 1)
        T.IsFalse(tree.CanRefund(1))
        T.IsFalse(tree.CanRefund(2))
        T.IsTrue(tree.Refund(3))
        T.IsTrue(tree.Refund(2))
        T.IsTrue(tree.Refund(1))
        T.AreEqual(tree.Spent(), 0)
        T.IsFalse(tree.Refund(0))
    }

    PassivesAddToTheWarriorsStats()
    {
        HellfeatherPassiveTree tree
        HellfeatherInventory items
        int strength = 1 + 3 * HellfeatherPassiveTree.PerQuadrant
        int vitality = 1
        tree.Allocate(strength, 1)
        tree.Allocate(vitality, 1)
        stats : items.Stats()
        tree.ApplyTo(stats)
        T.AreEqual(stats.Strength, HellfeatherStats.BaseStrength + 2)
        T.AreEqual(stats.MaxHealth, HellfeatherStats.BaseHealth + 8)
        // Percent damage applies after strength.
        stats.WeaponDamage = 20
        stats.DamagePercent = 10
        T.AreEqual(stats.Damage(), (20 + stats.Strength) * 110 / 100)
    }

    EveryPassiveDescribesItself()
    {
        for i : 0; i < HellfeatherPassiveTree.Count; i++ {
            node : HellfeatherPassiveTree.Node(i)
            T.IsTrue(Length(node.Name) > 0)
            T.IsTrue(Length(node.Effect) > 0 && Length(node.Effect) <= 26)
            if i > 0 { T.IsTrue(node.Amount > 0) }
        }
        clarity : HellfeatherPassiveTree.Node(1 + HellfeatherPassiveTree.PerQuadrant + 4)
        T.AreEqual(clarity.Name, "Clarity")
        T.AreEqual(clarity.Effect, "+0.5 mana per second")
    }
}
