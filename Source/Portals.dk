// Raven portals. H, or the button beside the action bar, spends one to open a
// pair: one where she stands and one in Ravenford. Stepping through the first
// takes her to town; stepping back through the town one returns her to where
// she cast it, and both close.
HellfeatherPortals
#{
    #string FieldTitle = "Portal to Ravenford"
    #string TownTitle = "Portal back"
    #string MillTitle = "Portal to Hobb's Mill"
    // Where the mill portal stands from the ring pedestal's level's deepest
    // point, beside the pedestal, which is 2 up the screen from it.
    #float MillPortalX = 2.6
    #float MillPortalZ = -2.2
    // Where the town end opens, near the square, and how far in front of a
    // portal she steps out. Portals face the camera, down the screen.
    #float TownX = 2.5
    #float TownZ = 1.5
    #float StepOut = 1.1
    // The middle of the oval, above the portal's feet.
    #float Middle = 1.2
    // How long a portal takes to grow open and to shrink shut, in seconds. It
    // starts to grow as the first ravens reach it.
    #float OpenSeconds = 0.8
    #float OpenDelay = 0.45
    #float CloseSeconds = 0.5
    // The ravens that fly in from all sides to make a portal, and burst out of
    // it as it shuts: how many, how far out they start or end, how high above
    // the middle, how fast they fly in world units per second, and the most
    // one waits after the first before it sets off, in seconds.
    #int RavenCount = 6
    #float RavenReach = 4.5
    #float RavenRiseMin = 0.8
    #float RavenRiseMax = 2.6
    #float RavenSpeed = 8.0
    #float RavenStagger = 0.35

    // Magenta motes drifting up and around the oval until it closes.
    QuaxelEffectStyle Swirl()
    {
        QuaxelEffectStyle style
        style.VoxelSize = 0.04
        style.Floor = 0.5
        style.MaxParticles = 220
        style.Rate = 70.0
        style.EmitSeconds = -1.0
        style.SpawnRadius = 0.55
        style.SpeedMin = 0.1
        style.SpeedMax = 0.5
        style.Spread = 180.0
        style.Gravity = 0.25
        style.Drag = 1.5
        style.Wander = 2.0
        style.LifeMin = 0.6
        style.LifeMax = 1.2
        style.SizeStart = 1.2
        style.SizeEnd = 0.3
        style.ColorStart = 0xffd2ff
        style.ColorMiddle = 0xf03cf0
        style.ColorEnd = 0x8c1a9c
        style.MiddleAt = 0.4
        style.Shade = 0.15
        style.Flicker = true
        style.Contact = QuaxelEffectContact.Pass
        return style
    }

    // The mill portal's motes: silver and pale teal, the severed wire's light.
    QuaxelEffectStyle MillSwirl()
    {
        QuaxelEffectStyle style = Swirl()
        style.ColorStart = 0xf2fbff
        style.ColorMiddle = 0x8fd6e6
        style.ColorEnd = 0x2a6f86
        return style
    }
}

// One raven of a portal's flock, flying a straight line into or out of its middle.
HellfeatherPortalRaven
{
    HellfeatherRealm Realm
    vec3 From
    vec3 To
    // Seconds before it sets off, and since it was sent.
    float Delay
    float Timer
    float Seconds
    // Flying out of a closing portal rather than into an opening one.
    bool Leaving
    int Node
    int Visual
}

HellfeatherGame : QuaxelGameInstance
{
    -HellfeatherPortalRaven [] PortalRavens

    // Sends the flock in to a portal's middle, or out of it, on her level.
    SendPortalRavens(QuaxelWorld& world, int spot, bool leaving)
    {
        if People.Spots[spot].Realm != Terrain.Realm || !Ravens.Load(world) { return }
        vec3 middle = People.Spots[spot].Feet + vec3(0.0, HellfeatherPortals.Middle, 0.0)
        int count = HellfeatherPortals.RavenCount
        float start = Ravens.Random.Range(0.0, 6.2831853)
        for k : 0; k < count; k++ {
            float angle = start + (float)k * 6.2831853 / (float)count + Ravens.Random.Range(-0.3, 0.3)
            float reach = HellfeatherPortals.RavenReach * Ravens.Random.Range(0.8, 1.2)
            vec3 far = middle + vec3(Math.Cos(angle) * reach, Ravens.Random.Range(HellfeatherPortals.RavenRiseMin, HellfeatherPortals.RavenRiseMax), Math.Sin(angle) * reach)
            HellfeatherPortalRaven bird
            bird.Realm = Terrain.Realm
            bird.Leaving = leaving
            bird.From = leaving ? middle | far
            bird.To = leaving ? far | middle
            bird.Seconds = (far - middle).Length() / HellfeatherPortals.RavenSpeed
            bird.Delay = Ravens.Random.Range(0.0, HellfeatherPortals.RavenStagger)
            PortalRavens += bird
        }
    }

    // Flies the flocks along. One coming in shrinks into the portal as it
    // reaches it; one leaving grows out of it and dwindles into the distance.
    // A flock left behind on another level is dropped.
    StepPortalRavens(QuaxelWorld& world, float deltaSeconds)
    {
        for -bird : PortalRavens {
            bird.Timer += deltaSeconds
            float t = (bird.Timer - bird.Delay) / bird.Seconds
            if bird.Realm != Terrain.Realm || t >= 1.0 {
                if bird.Node != 0 { world.DestroyNode(bird.Node) }
                PortalRavens -= bird
                continue
            }
            if t < 0.0 { continue }
            if bird.Node == 0 {
                bird.Node = world.CreateNode()
                world.AttachTransform(bird.Node, QuaxelTransform.Make(bird.From, vec3(1.0, 1.0, 1.0)))
                world.SetCatchesEffects(bird.Node, false)
                bird.Visual = world.CreateChild(bird.Node)
                world.AttachTransform(bird.Visual, QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)))
                world.AttachAnimator(bird.Visual, Ravens.Animation)
                world.PlayClip(bird.Visual, "fly")
            }
            // Swooping: in fast and easing at the portal, or out fast from it.
            float along = bird.Leaving ? t * t | 1.0 - (1.0 - t) * (1.0 - t)
            vec3 at = bird.From.Lerp(bird.To, along)
            float size = 1.0
            if bird.Leaving { size = Math.Min(t / 0.2, 1.0) * Math.Min((1.0 - t) / 0.4, 1.0) }
            else { size = Math.Min((1.0 - t) / 0.35, 1.0) }
            size = Math.Max(size, 0.01)
            world.SetTransform(bird.Node, QuaxelTransform.Make(at, vec3(1.0, 1.0, 1.0)))
            float voxel = HellfeatherRavens.Voxel * size
            // Centred on the line, so it shrinks into the middle of the oval.
            QuaxelTransform pose = QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), vec3(voxel, voxel, voxel))
            vec3 heading = bird.To - bird.From
            float flat = Math.Hypot(heading.X, heading.Z)
            if flat > 0.001 {
                pose.FacingX = heading.X / flat
                pose.FacingZ = heading.Z / flat
            }
            world.SetTransform(bird.Visual, pose)
        }
    }

    // How many portal ravens are in flight, for tests.
    int PortalRavensFlying() { return (int)PortalRavens.Len }

    // The open pair, if any: the level and spot she cast it from, and the town end.
    -bool PortalOpen
    -HellfeatherRealm PortalRealm
    -vec3 PortalFeet
    -vec3 TownPortalFeet
    -int PortalEffect = -1
    -int TownPortalEffect = -1
    -bool PortalKeyHeld
    -int MillPortalEffect = -1
    // Set while a new pair is placed, so both ends grow open.
    -bool PortalCast

    bool IsPortalOpen() { return PortalOpen }

    // Inside Ravenford's walls a portal home has nowhere to go.
    bool InTown(vec3 player) { return Terrain.Realm == HellfeatherRealm.Fenmarch && Math.Hypot(player.X, player.Z) <= Ravenford.Wall + 6.0 }

    // Spends a portal and opens the pair, closing any pair already open.
    // False, with a word on the banner, when she cannot.
    bool OpenPortal(QuaxelWorld& world)
    {
        vec3 player = world.GetPosition(PlayerNode)
        if PlayerHealth <= 0 { return false }
        if Inventory.Items.Portals <= 0 {
            Banner.Show("No raven portals left", 2.0)
            return false
        }
        if InTown(player) || InCamp(player) {
            Banner.Show(InCamp(player) ? "You are already at the encampment" | "You are already in Ravenford", 2.0)
            return false
        }
        ClosePortals(world)
        Inventory.Items.Portals--
        PortalOpen = true
        PortalRealm = Terrain.Realm
        // Up the screen from her, so she stands in front of it.
        PortalFeet = OpenNear(player + vec3(-HellfeatherPortals.StepOut, 0.0, -HellfeatherPortals.StepOut))
        PortalFeet.Y = Terrain.GroundY(PortalFeet.X, PortalFeet.Z)
        // In Act II's levels a portal goes home to the encampment instead.
        TownRealm = HellfeatherRealm.IsActTwo(Terrain.Realm) && Quests.ActTwo ? HellfeatherRealm.Thornmere | HellfeatherRealm.Fenmarch
        TownPortalFeet = TownRealm == HellfeatherRealm.Thornmere ? HellfeatherCastTwo.Camp(2.5, -2.5) | vec3(HellfeatherPortals.TownX, 0.0, HellfeatherPortals.TownZ)
        PortalCast = true
        SyncPortals(world)
        PortalCast = false
        return true
    }

    // Takes her through a portal: from the field to town, or from town back to
    // where she opened it, which closes both.
    bool UsePortal(QuaxelWorld& world, int spot)
    {
        if !PortalOpen || spot < 0 || spot >= People.Spots.Len { return false }
        bool toTown = People.Spots[spot].Title == HellfeatherPortals.FieldTitle
        if toTown {
            vec3 arrival = TownPortalFeet + vec3(HellfeatherPortals.StepOut, 0.0, HellfeatherPortals.StepOut)
            if !TravelTo(world, TownRealm, arrival, false) { return false }
            // Now the town has streamed in, the portal can stand on open ground.
            TownPortalFeet = OpenNear(TownPortalFeet)
            TownPortalFeet.Y = Terrain.GroundY(TownPortalFeet.X, TownPortalFeet.Z)
            SyncPortals(world)
            Banner.Show(TownRealm == HellfeatherRealm.Thornmere ? HellfeatherQuests.CampName | "Ravenford", 2.5)
            return true
        }
        vec3 back = PortalFeet + vec3(HellfeatherPortals.StepOut, 0.0, HellfeatherPortals.StepOut)
        if !TravelTo(world, PortalRealm, back, false) { return false }
        // The level was rebuilt without it: stand it back up, open, so she
        // sees it shut behind her.
        SyncPortals(world)
        ClosePortals(world)
        StepZone(world.GetPosition(PlayerNode), 1.0)
        Banner.Show(ZoneName(), 2.5)
        return true
    }

    // Closes the pair: each end shrinks shut, and the spots stay in the list,
    // hidden, for the next one.
    ClosePortals(QuaxelWorld& world)
    {
        PortalOpen = false
        for i : 0; i < People.Spots.Len; i++ {
            if People.Spots[i].Kind != HellfeatherSpotKind.Portal || !People.Spots[i].Shown || People.IsClosing((int)i) { continue }
            People.CloseDown((int)i, HellfeatherPortals.CloseSeconds)
            SendPortalRavens(world, (int)i, true)
        }
        if PortalEffect >= 0 { world.StopEffect(PortalEffect) }
        if TownPortalEffect >= 0 { world.StopEffect(TownPortalEffect) }
        PortalEffect = -1
        TownPortalEffect = -1
    }

    // Keeps both ends standing while the pair is open. A level is rebuilt on
    // each journey and takes its spots with it, so a missing end is added back.
    // Each end's motes run only on the level she is on.
    SyncPortals(QuaxelWorld& world)
    {
        if !PortalOpen { return }
        int field = PlacePortal(world, HellfeatherPortals.FieldTitle, PortalRealm, PortalFeet)
        int town = PlacePortal(world, HellfeatherPortals.TownTitle, TownRealm, TownPortalFeet)
        PortalEffect = KeepSwirl(world, PortalEffect, field)
        TownPortalEffect = KeepSwirl(world, TownPortalEffect, town)
    }

    // An end added back to a rebuilt level stands already open. A new cast,
    // or a move to another place, grows it open from nothing.
    -int PlacePortal(QuaxelWorld& world, string title, HellfeatherRealm realm, vec3 feet)
    {
        int index = FindPortal(title)
        if index < 0 { index = People.AddModel(HellfeatherSpotKind.Portal, title, realm, feet, Landmarks.Portal, HellfeatherArt.FineVoxel, HellfeatherLandmarks.PortalHeight) }
        bool moved = People.Spots[index].Realm != realm || Math.Hypot(People.Spots[index].Feet.X - feet.X, People.Spots[index].Feet.Z - feet.Z) > 0.01
        if moved {
            People.Spots[index].Realm = realm
            People.Spots[index].Feet = feet
        }
        if PortalCast || moved || !People.Spots[index].Shown || People.IsClosing(index) {
            People.OpenUp(world, index, HellfeatherPortals.OpenDelay, HellfeatherPortals.OpenSeconds)
            SendPortalRavens(world, index, false)
        }
        return index
    }

    int FindPortal(string title)
    {
        for i : 0; i < People.Spots.Len; i++ {
            if People.Spots[i].Kind == HellfeatherSpotKind.Portal && People.Spots[i].Title == title { return (int)i }
        }
        return -1
    }

    // Starts an end's motes once its model stands on this level, and stops them
    // when she leaves the level.
    -int KeepSwirl(QuaxelWorld& world, int effect, int spot)
    {
        bool here = People.Spots[spot].Realm == Terrain.Realm && People.Spots[spot].Node != 0
        if !here {
            if effect >= 0 { world.StopEffect(effect) }
            return -1
        }
        if effect >= 0 && world.IsEffectPlaying(effect) { return effect }
        vec3 middle = People.Spots[spot].Feet + vec3(0.0, HellfeatherPortals.Middle, 0.0)
        return world.StartEffect(HellfeatherPortals.Swirl(), middle, vec3(0.0, 1.0, 0.0))
    }

    // Once the ring is severed, a portal stands beside its pedestal, out to
    // Hobb's Mill, where Lise waits. It costs nothing and never closes. The
    // level below is rebuilt on each visit, so its spot is added back.
    ShowMillPortal()
    {
        if Quests.Millrace < 4 { return }
        HellfeatherRealm deep = HellfeatherRealm.UndercroftDeep
        int index = People.FindKind(HellfeatherSpotKind.MillPortal, deep)
        if index < 0 {
            if Terrain.Realm != deep { return }
            vec3 feet = OpenNear(Deepest() + vec3(HellfeatherPortals.MillPortalX, 0.0, HellfeatherPortals.MillPortalZ))
            index = People.AddModel(HellfeatherSpotKind.MillPortal, HellfeatherPortals.MillTitle, deep, feet, Landmarks.MillPortal, HellfeatherArt.FineVoxel, HellfeatherLandmarks.PortalHeight)
        }
        People.Spots[index].Shown = true
    }

    // Steps her out through the mill portal, to the mill's door.
    bool UseMillPortal(QuaxelWorld& world)
    {
        if Quests.Millrace < 4 { return false }
        if !TravelTo(world, HellfeatherRealm.Fenmarch, MillDoor + vec3(0.0, 0.0, 1.6), false) { return false }
        StepZone(world.GetPosition(PlayerNode), 1.0)
        Banner.Show("Hobb's Mill", 2.5)
        return true
    }

    // Keeps the mill portal's motes running while she is on its level.
    -SyncMillPortal(QuaxelWorld& world)
    {
        int index = People.FindKind(HellfeatherSpotKind.MillPortal, HellfeatherRealm.UndercroftDeep)
        bool here = index >= 0 && People.Spots[index].Shown && People.Spots[index].Realm == Terrain.Realm && People.Spots[index].Node != 0
        if !here {
            if MillPortalEffect >= 0 { world.StopEffect(MillPortalEffect) }
            MillPortalEffect = -1
            return
        }
        if MillPortalEffect >= 0 && world.IsEffectPlaying(MillPortalEffect) { return }
        vec3 middle = People.Spots[index].Feet + vec3(0.0, HellfeatherPortals.Middle, 0.0)
        MillPortalEffect = world.StartEffect(HellfeatherPortals.MillSwirl(), middle, vec3(0.0, 1.0, 0.0))
    }

    // H opens a portal, like the button beside the bar.
    StepPortalKey(QuaxelWorld& world, QuaxelInputState& input)
    {
        bool key = input.IsDown(QuaxelKey.H)
        if key && !PortalKeyHeld { OpenPortal(world) }
        PortalKeyHeld = key
    }
}
T{
    // Severing the ring opens a silver portal beside its pedestal, not hers:
    // it costs no raven portal, survives her own pair closing, takes her out
    // to the mill where Lise waits, and stands there again when she returns.
    SeveringTheRingOpensAPortalToTheMill()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        HellfeatherRealm deep = HellfeatherRealm.UndercroftDeep
        game.Quests.Millrace = 3
        T.IsTrue(game.Travel(world, deep, true))
        T.IsTrue(game.People.FindKind(HellfeatherSpotKind.MillPortal, deep) < 0)
        int pedestal = game.People.FindKind(HellfeatherSpotKind.Pedestal, deep)
        game.Use(world, pedestal)
        int portals = game.Inventory.Items.Portals
        game.Answer(world, HellfeatherReply.Sever)
        T.AreEqual(game.Quests.Millrace, 4)
        int portal = game.People.FindKind(HellfeatherSpotKind.MillPortal, deep)
        T.IsTrue(portal >= 0)
        T.IsTrue(game.People.Spots[portal].Shown)
        T.AreEqual(game.People.Spots[portal].Title, HellfeatherPortals.MillTitle)
        T.AreEqual(game.Inventory.Items.Portals, portals)
        // Beside the pedestal, on open floor.
        vec3 feet = game.People.Spots[portal].Feet
        vec3 ring = game.People.Spots[pedestal].Feet
        T.IsTrue(Math.Hypot(feet.X - ring.X, feet.Z - ring.Z) < 5.0)
        int calls = 0
        while !game.Terrain.IsReady(feet) && calls < 4000 {
            T.IsTrue(game.Terrain.Stream(world, feet, 100000))
            calls++
        }
        T.IsFalse(game.Terrain.IsBlocked(feet.X, feet.Z))
        // Closing her own raven portals leaves it standing.
        game.ClosePortals(world)
        T.IsTrue(game.People.Spots[portal].Shown)
        // Through it, to the mill's door.
        game.Use(world, portal)
        T.AreEqual(game.Terrain.Realm, HellfeatherRealm.Fenmarch)
        vec3 at = world.GetPosition(game.PlayerNode)
        T.IsTrue(Math.Hypot(at.X - game.MillDoor.X, at.Z - game.MillDoor.Z) < 4.0)
        int lise = game.People.FindPerson(HellfeatherPerson.Lise)
        T.IsTrue(game.People.Spots[lise].Shown)
        // Back down, it is there again.
        game.Quests.Millrace = 4
        T.IsTrue(game.Travel(world, deep, true))
        portal = game.People.FindKind(HellfeatherSpotKind.MillPortal, deep)
        T.IsTrue(portal >= 0 && game.People.Spots[portal].Shown)
    }

    APortalNeedsOneInHandAndTheWild()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        // She starts in Ravenford with one.
        T.AreEqual(game.Inventory.Items.Portals, 1)
        T.IsFalse(game.OpenPortal(world))
        T.AreEqual(game.Inventory.Items.Portals, 1)
        game.Quests.Millrace = 1
        T.IsTrue(game.Travel(world, HellfeatherRealm.Undercroft, true))
        game.Inventory.Items.Portals = 0
        T.IsFalse(game.OpenPortal(world))
        T.IsFalse(game.IsPortalOpen())
    }

    APortalGoesToTownAndBackThenCloses()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.Quests.Millrace = 1
        T.IsTrue(game.Travel(world, HellfeatherRealm.Undercroft, true))
        vec3 cast = world.GetPosition(game.PlayerNode)
        game.Inventory.Items.Portals = 3
        T.IsTrue(game.OpenPortal(world))
        T.AreEqual(game.Inventory.Items.Portals, 2)
        int field = game.FindPortal(HellfeatherPortals.FieldTitle)
        int town = game.FindPortal(HellfeatherPortals.TownTitle)
        T.IsTrue(field >= 0 && town >= 0)
        // Ravens fly in from all sides and it grows open from nothing.
        T.IsTrue(game.People.Spots[field].Open < 0.5)
        T.AreEqual(game.PortalRavensFlying(), HellfeatherPortals.RavenCount)
        QuaxelInputState input
        game.Simulate(world, input, 120)
        T.IsTrue(game.People.Spots[field].Open (0.0)== 1.0)
        T.AreEqual(game.PortalRavensFlying(), 0)
        T.AreEqual(game.People.Spots[field].Realm, HellfeatherRealm.Undercroft)
        T.AreEqual(game.People.Spots[town].Realm, HellfeatherRealm.Fenmarch)
        // Through to Ravenford, beside the town end.
        T.IsTrue(game.UsePortal(world, field))
        T.AreEqual(game.Terrain.Realm, HellfeatherRealm.Fenmarch)
        vec3 there = world.GetPosition(game.PlayerNode)
        T.IsTrue(game.InTown(there))
        town = game.FindPortal(HellfeatherPortals.TownTitle)
        T.IsTrue(game.People.Spots[town].Shown)
        T.IsTrue(game.IsPortalOpen())
        // And back to where she cast it, which closes the pair.
        T.IsTrue(game.UsePortal(world, town))
        T.AreEqual(game.Terrain.Realm, HellfeatherRealm.Undercroft)
        vec3 back = world.GetPosition(game.PlayerNode)
        T.IsTrue(Math.Hypot(back.X - cast.X, back.Z - cast.Z) < 4.0)
        T.IsFalse(game.IsPortalOpen())
        // It shrinks shut behind her, then is gone.
        field = game.FindPortal(HellfeatherPortals.FieldTitle)
        T.IsTrue(field >= 0 && game.People.IsClosing(field))
        T.AreEqual(game.PortalRavensFlying(), HellfeatherPortals.RavenCount)
        game.Simulate(world, input, 120)
        T.IsFalse(game.People.Spots[field].Shown)
        T.AreEqual(game.PortalRavensFlying(), 0)
    }

    // A trip home and back leaves the level as she left it: the slain stay
    // slain and nothing new is rolled, out in the Fenmarch and below it alike.
    APortalTripKeepsTheLevelsEnemies()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.Inventory.Items.Portals = 3
        // Out in the Fenmarch, by the mill.
        vec3 mill = game.MillDoor + vec3(0.0, 0.0, 2.5)
        HellfeatherActOne.Stand(game, world, mill.X, mill.Z, 2)
        long fen = game.Enemies.Len
        game.Enemies[0].Health = 0
        T.IsTrue(game.OpenPortal(world))
        T.IsTrue(game.UsePortal(world, game.FindPortal(HellfeatherPortals.FieldTitle)))
        T.IsTrue(game.UsePortal(world, game.FindPortal(HellfeatherPortals.TownTitle)))
        T.AreEqual(game.Enemies.Len, fen)
        T.AreEqual(game.Enemies[0].Health, 0)
        // Down in the Undercroft, with the pond's brood among the rolled ones.
        game.Quests.Millrace = 1
        T.IsTrue(game.Travel(world, HellfeatherRealm.Undercroft, true))
        long below = game.Enemies.Len
        int slain = (int)below - 1
        game.Enemies[slain].Health = 0
        T.IsTrue(game.OpenPortal(world))
        T.IsTrue(game.UsePortal(world, game.FindPortal(HellfeatherPortals.FieldTitle)))
        // Ravenford's level is the one she left.
        T.AreEqual(game.Enemies.Len, fen)
        T.AreEqual(game.Enemies[0].Health, 0)
        T.IsTrue(game.UsePortal(world, game.FindPortal(HellfeatherPortals.TownTitle)))
        T.AreEqual(game.Enemies.Len, below)
        T.AreEqual(game.Enemies[slain].Health, 0)
    }

    TheHKeyOpensAPortal()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.Quests.Millrace = 1
        T.IsTrue(game.Travel(world, HellfeatherRealm.Undercroft, true))
        QuaxelInputState input
        input.SetDown(QuaxelKey.H, true)
        game.Simulate(world, input, 2)
        T.IsTrue(game.IsPortalOpen())
        T.AreEqual(game.Inventory.Items.Portals, 0)
    }

    PortalsComeFromTheShopUpToTwenty()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.OpenShop(HellfeatherMerchant.Edda)
        int index = -1
        for i : 0; i < game.Shop.Shop.Stock.Len; i++ {
            if game.Shop.Shop.Stock[i].Item == HellfeatherItems.RavenPortal { index = (int)i }
        }
        T.IsTrue(index >= 0)
        long bag = game.Inventory.Items.Bag.Len
        game.Inventory.Items.Gold = 5000
        game.Inventory.Items.Portals = HellfeatherInventory.MaxPortals - 1
        game.Shop.BuyRequest = index
        game.ApplyShopRequests()
        T.AreEqual(game.Inventory.Items.Portals, HellfeatherInventory.MaxPortals)
        T.AreEqual(game.Inventory.Items.Bag.Len, bag)
        int gold = game.Inventory.Items.Gold
        game.Shop.BuyRequest = index
        game.ApplyShopRequests()
        T.AreEqual(game.Inventory.Items.Portals, HellfeatherInventory.MaxPortals)
        T.AreEqual(game.Inventory.Items.Gold, gold)
    }
}
