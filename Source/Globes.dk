// Colors of one globe, as they should appear on screen.
HellfeatherGlobeTint
{
    int Main
    int Bright
    int Surface
    int Glass
    int Feather
    int FeatherTip
}
#{
    HellfeatherGlobeTint Blood()
    {
        HellfeatherGlobeTint tint
        tint.Main = 0xc01a20
        tint.Bright = 0xf4503a
        tint.Surface = 0xc4262a
        tint.Glass = 0x34141a
        tint.Feather = 0x2b2626
        tint.FeatherTip = 0xe2561c
        return tint
    }

    HellfeatherGlobeTint Mana()
    {
        HellfeatherGlobeTint tint
        tint.Main = 0x2140d0
        tint.Bright = 0x5a86ff
        tint.Surface = 0x2c4cd8
        tint.Glass = 0x141a3a
        tint.Feather = 0x262a33
        tint.FeatherTip = 0x3f8dff
        return tint
    }
}

// Sculpts the globes. The frame is modeled in screen axes, because the camera
// never turns: U runs right, V up and W toward the viewer, all in voxels from the
// center of the orb. Outward is U flipped so that it points to the near window edge.
HellfeatherGlobeArt
#{
    #float Cell = 0.0625
    #int FrameGrid = 112
    #int LiquidGrid = 52
    #float Radius = 27.0
    #float LiquidRadius = 26.0

    -int RimColor(float outward, float v, float r, int x, int y, int z)
    {
        float along = Math.Atan2(v, outward) * r
        float spacing = r * 0.5235988 // A rivet every 30 degrees.
        float offset = Math.Abs(Math.Mod(along + spacing * 0.5 + spacing * 24.0, spacing) - spacing * 0.5)
        if offset < 1.7 && r > Radius + 0.4 && r < Radius + 3.0 { return HellfeatherArt.Rgb(0x9b8a6a) }
        if r < Radius { return HellfeatherArt.Rgb(0x151312) }
        if r >= Radius + 3.0 { return HellfeatherArt.Rgb(0x5d564d) }
        return HellfeatherArt.Rgb(HellfeatherArt.Shade(0x3d3935, 85 + HellfeatherArt.Hash(x, y, z) % 30))
    }

    // Three iron talons rise past the rim and curl over the front of the glass.
    -int TalonColor(float outward, float v, float w, float r, float distance)
    {
        float share = (Radius + 10.0 - r) / 20.0
        if share < 0.0 || share > 1.0 { return -1 }
        if r >= Radius {
            if Math.Abs(w) > 4.5 { return -1 }
        }
        else if w <= 0.0 || distance < Radius || distance >= Radius + 3.5 { return -1 }
        float angle = Math.Atan2(v, outward) * 57.29578
        float [3] roots = {-128.0, -90.0, -52.0}
        for i : 0; i < 3; i++ {
            float center = roots[i] + (roots[i] + 90.0) * 0.35 * share
            float arc = Math.Abs(angle - center) * 0.01745329 * r
            float half = 5.0 * Math.Pow(1.0 - share, 0.7) + 0.6
            if arc > half { continue }
            if share > 0.78 { return HellfeatherArt.Rgb(0xc4b596) }
            if Math.Abs(share - 0.3) < 0.03 || Math.Abs(share - 0.55) < 0.03 { return HellfeatherArt.Rgb(0x141211) }
            return HellfeatherArt.Rgb(arc < half * 0.4 ? 0x6a6156 | 0x2e2a27)
        }
        return -1
    }

    // A fan of black feathers on the outer side, its tips smoldering.
    -int FeatherColor(float outward, float v, float w, HellfeatherGlobeTint tint)
    {
        int result = -1
        float [6] angles = {-64.0, -43.0, -22.0, -2.0, 17.0, 36.0}
        float [6] lengths = {15.0, 19.0, 21.0, 20.0, 16.0, 11.0}
        for i : 0; i < 6; i++ {
            if Math.Abs(w - ((float)i * 1.2 - 3.0)) > 1.3 { continue }
            float radians = angles[i] * 0.01745329
            float axisX = Math.Cos(radians)
            float axisY = Math.Sin(radians)
            float offsetX = outward - axisX * (Radius + 3.0)
            float offsetY = v - axisY * (Radius + 3.0)
            float along = offsetX * axisX + offsetY * axisY
            if along < 0.0 || along > lengths[i] { continue }
            float share = along / lengths[i]
            float across = offsetY * axisX - offsetX * axisY + share * share * 3.0
            float half = 4.4 * Math.Sin(3.1415927 * Math.Pow(share, 0.62)) + 0.4
            if Math.Abs(across) > half { continue }
            if Math.Abs(across) < 0.7 { result = HellfeatherArt.Rgb(0xa89f88) }
            else if share > 0.74 { result = HellfeatherArt.Rgb(HellfeatherArt.Shade(tint.FeatherTip, (int)(share * 120.0))) }
            else {
                int barb = (int)((along + Math.Abs(across) * 1.4) / 2.4)
                result = HellfeatherArt.Rgb(HellfeatherArt.Shade(tint.Feather, (barb & 1) == 0 ? 85 | 125))
            }
        }
        return result
    }

    // RGB of the frame at a voxel, or -1 where it is empty.
    -int FrameColor(int x, int y, int z, int side, HellfeatherGlobeTint tint)
    {
        int half = FrameGrid / 2
        float px = (float)(x - half) + 0.5
        float py = (float)(y - half) + 0.5
        float pz = (float)(z - half) + 0.5
        float distance = Math.Sqrt(px * px + py * py + pz * pz)
        float w = (px + py + pz) * 0.57735027
        if distance < Radius - 2.0 || distance > 54.0 { return -1 }
        if distance >= Radius + 3.5 && Math.Abs(w) > 7.0 { return -1 }
        float u = (px - pz) * 0.70710678
        float v = (2.0 * py - px - pz) * 0.40824829
        float outward = u * (float)side
        float r = Math.Hypot(u, v)
        if r >= Radius - 1.0 && r < Radius + 4.0 && Math.Abs(w) <= 3.0 { return RimColor(outward, v, r, x, y, z) }
        int talon = TalonColor(outward, v, w, r, distance)
        if talon >= 0 { return talon }
        float below = -v - (Radius + 6.0)
        if below >= 0.0 && below <= 10.0 && Math.Abs(u) <= 7.0 + below * 1.1 && Math.Abs(w) <= 7.0 {
            if below < 2.0 { return HellfeatherArt.Rgb(0x4a443d) }
            return HellfeatherArt.StoneColor(x + z, y, x - z)
        }
        if r >= Radius + 2.0 && outward > 0.0 {
            int feather = FeatherColor(outward, v, w, tint)
            if feather >= 0 { return feather }
        }
        // Only the far half of the glass exists, so the liquid inside stays visible.
        if w < 0.0 && distance < Radius {
            int percent = 55 + (int)(Math.Pow(r / Radius, 3.0) * 120.0)
            return HellfeatherArt.Rgb(HellfeatherArt.Shade(tint.Glass, percent + HellfeatherArt.Hash(x, y, z) % 9))
        }
        return -1
    }

    int BuildFrame(QuaxelWorld& world, int side, HellfeatherGlobeTint tint)
    {
        int volume = world.CreateVolume(FrameGrid, FrameGrid, FrameGrid)
        if volume < 0 { return -1 }
        for x : 0; x < FrameGrid; x++ {
            for y : 0; y < FrameGrid; y++ {
                for z : 0; z < FrameGrid; z++ {
                    int color = FrameColor(x, y, z, side, tint)
                    if color >= 0 { world.SetVoxel(volume, x, y, z, color) }
                }
            }
        }
        return volume
    }

    // Depends only on height and the voxel's own position, because the liquid
    // turns about Y and any light baked in here would turn with it.
    int BodyColor(HellfeatherGlobeTint tint, int a, int layer, int b)
    {
        float x = (float)a
        float y = (float)layer
        float z = (float)b
        float swirl = Math.Sin(x * 0.21 + Math.Sin(y * 0.17 + z * 0.13) * 1.8) + Math.Sin(z * 0.19 - y * 0.11 + Math.Sin(x * 0.16) * 1.6)
        int percent = 74 + layer * 2 / 3 + (int)(swirl * 14.0) + HellfeatherArt.Hash(a, layer, b) % 8
        if swirl > 1.2 { return HellfeatherArt.Rgb(HellfeatherArt.Shade(tint.Bright, percent)) }
        return HellfeatherArt.Rgb(HellfeatherArt.Shade(tint.Main, percent))
    }

    int SurfaceColor(HellfeatherGlobeTint tint, int a, int layer, int b, float rimShare)
    {
        if rimShare > 0.86 { return HellfeatherArt.Rgb(HellfeatherArt.Shade(tint.Bright, 100 + HellfeatherArt.Hash(a, layer, b) % 14)) }
        float swirl = Math.Sin((float)a * 0.27 + Math.Sin((float)b * 0.19) * 2.2) + Math.Sin((float)b * 0.23 + Math.Sin((float)a * 0.17) * 1.9)
        int percent = 84 + (int)(swirl * 16.0) + HellfeatherArt.Hash(a, layer, b) % 8
        if swirl > 1.1 { return HellfeatherArt.Rgb(HellfeatherArt.Shade(tint.Bright, percent)) }
        return HellfeatherArt.Rgb(HellfeatherArt.Shade(tint.Surface, percent))
    }
}

// One orb and its frame. The fill is stored as voxel layers counted up from the
// bottom, so only the layers that change are repainted and uploaded.
HellfeatherGlobe
{
    int Root
    int Frame
    int Liquid
    int LiquidVolume
    int Layers
    -float Shown
    -float Spin
    -HellfeatherGlobeTint Tint

    bool Build(QuaxelWorld& world, int camera, int side, HellfeatherGlobeTint tint)
    {
        Tint = tint
        int frameVolume = HellfeatherGlobeArt.BuildFrame(world, side, tint)
        int size = HellfeatherGlobeArt.LiquidGrid
        LiquidVolume = world.CreateVolume(size, size, size)
        if frameVolume < 0 || LiquidVolume < 0 { return false }
        Root = world.CreateChild(camera)
        world.AttachTransform(Root, QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)))
        float cell = HellfeatherGlobeArt.Cell
        Frame = world.CreateChild(Root)
        world.AttachTransform(Frame, QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), vec3(cell, cell, cell)))
        Liquid = world.CreateChild(Root)
        world.AttachTransform(Liquid, QuaxelTransform.Make(vec3(0.0, 0.0, 0.0), vec3(cell, cell, cell)))
        if !world.AttachVoxels(Frame, frameVolume) || !world.AttachVoxels(Liquid, LiquidVolume) { return false }
        Shown = 1.0
        SetLayers(world, size)
        return true
    }

    // Any liquid at all shows at least the bottom layer.
    int LayersFor(float share)
    {
        if share <= 0.0 { return 0 }
        int size = HellfeatherGlobeArt.LiquidGrid
        return Math.Clamp((int)(share * (float)size + 0.5), 1, size)
    }

    -PaintLayer(QuaxelWorld& world, int layer, bool filled, bool top)
    {
        int size = HellfeatherGlobeArt.LiquidGrid
        float radius = HellfeatherGlobeArt.LiquidRadius
        float height = (float)layer + 0.5 - (float)size * 0.5
        float limit = radius * radius - height * height
        if limit <= 0.0 { return }
        for a : 0; a < size; a++ {
            for b : 0; b < size; b++ {
                float x = (float)a + 0.5 - (float)size * 0.5
                float z = (float)b + 0.5 - (float)size * 0.5
                float spread = x * x + z * z
                if spread > limit { continue }
                int color = -1
                // A tiny disc at the very top of a full orb would read as a dimple.
                if top && limit > 150.0 { color = HellfeatherGlobeArt.SurfaceColor(Tint, a, layer, b, spread / limit) }
                else if filled { color = HellfeatherGlobeArt.BodyColor(Tint, a, layer, b) }
                world.SetVoxel(LiquidVolume, a, layer, b, color)
            }
        }
    }

    // Also repaints the layer that stops or starts being the surface.
    -SetLayers(QuaxelWorld& world, int layers)
    {
        if layers == Layers { return }
        int first = Math.Max(Math.Min(Layers, layers) - 1, 0)
        int end = Math.Max(Layers, layers)
        for layer : first; layer < end; layer++ { PaintLayer(world, layer, layer < layers, layer == layers - 1) }
        Layers = layers
    }

    // Share is 0..1. Eases toward it, and turns the liquid so that it never looks frozen.
    Step(QuaxelWorld& world, float share, float deltaSeconds)
    {
        float reach = HellfeatherGlobes.FillPerSecond * deltaSeconds
        Shown = Shown + Math.Clamp(Math.Clamp(share, 0.0, 1.0) - Shown, -reach, reach)
        SetLayers(world, LayersFor(Shown))
        Spin = Math.Mod(Spin + HellfeatherGlobes.SwirlPerSecond * deltaSeconds, 6.2831853)
        QuaxelTransform pose = world.GetTransform(Liquid)
        pose.FacingX = Math.Sin(Spin)
        pose.FacingZ = Math.Cos(Spin)
        world.SetTransform(Liquid, pose)
    }

    Place(QuaxelWorld& world, vec3 position)
    {
        QuaxelTransform pose = world.GetTransform(Root)
        pose.Position = position
        world.SetTransform(Root, pose)
    }
}

// The health and mana globes, held in the bottom corners of the view.
HellfeatherGlobes
{
    HellfeatherGlobe Health
    HellfeatherGlobe Mana
    -int CameraNode

    bool Spawn(QuaxelWorld& world, int camera)
    {
        CameraNode = camera
        return Health.Build(world, camera, -1, HellfeatherGlobeTint.Blood()) && Mana.Build(world, camera, 1, HellfeatherGlobeTint.Mana())
    }

    Step(QuaxelWorld& world, float healthShare, float manaShare, float deltaSeconds)
    {
        Health.Step(world, healthShare, deltaSeconds)
        Mana.Step(world, manaShare, deltaSeconds)
    }

    // Offsets are from the center of the view along the camera's own axes.
    // ClearWidth is how many pixels from the left a panel leaves uncovered.
    Anchor(QuaxelWorld& world, int width, int height, int clearWidth)
    {
        QuaxelCamera camera = world.GetCamera(CameraNode)
        camera.UpdateBounds(width, height)
        float halfWidth = camera.BoundsHalfWidth
        vec3 forward = camera.Forward()
        vec3 right = camera.Right()
        vec3 up = right.Cross(forward)
        float rightEdge = halfWidth
        float panelEdge = (float)clearWidth * (2.0 * halfWidth / (float)width) - halfWidth
        // When there is no room beside the panel, the panel simply covers the globe.
        if panelEdge >= -halfWidth + SideInset * 4.0 && panelEdge < halfWidth { rightEdge = panelEdge }
        float floor = BottomInset - camera.BoundsHalfHeight
        vec3 depth = forward * Depth
        Health.Place(world, right * (SideInset - halfWidth) + up * floor + depth)
        Mana.Place(world, right * (rightEdge - SideInset) + up * floor + depth)
    }
}
#{
    // Along the view from the eye. Negative puts the globes behind the eye and
    // past the tallest mountain, so nothing in the world can cover them.
    #float Depth = -30.0
    // From the window edges to the center of an orb, in world units.
    #float SideInset = 3.35
    #float BottomInset = 2.85
    // A share of the whole globe per second.
    #float FillPerSecond = 1.2
    // Radians per second.
    #float SwirlPerSecond = 0.35
}
T{
    GlobesCoverTheBottomCornersAtEveryWindowShape()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        int [3] widths = {960, 1800, 700}
        int [3] heights = {540, 600, 900}
        for shape : 0; shape < 3; shape++ {
            game.Globes.Anchor(world, widths[shape], heights[shape], widths[shape])
            QuaxelCamera camera = world.GetCamera(game.CameraNode)
            camera.UpdateBounds(widths[shape], heights[shape])
            mat4 matrix = camera.ViewProjection(world.WorldPosition(game.CameraNode))
            vec4 health = matrix * vec4(world.WorldPosition(game.Globes.Health.Root), 1.0)
            vec4 mana = matrix * vec4(world.WorldPosition(game.Globes.Mana.Root), 1.0)
            T.IsTrue(health.X < -0.5 && health.X > -1.0)
            T.IsTrue(mana.X > 0.5 && mana.X < 1.0)
            T.IsTrue(health.Y > 0.5 && health.Y < 1.0)
            T.IsTrue(Math.Abs(mana.Y - health.Y) < 0.0001)
            // In front of the near end of the view, and fully inside the depth range.
            T.IsTrue(health.Z > 0.0 && health.Z < 0.2)
        }
    }

    GlobesStandClearOfAnOpenPanelWhenThereIsRoom()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        game.Globes.Anchor(world, 960, 540, 600)
        QuaxelCamera camera = world.GetCamera(game.CameraNode)
        camera.UpdateBounds(960, 540)
        mat4 matrix = camera.ViewProjection(world.WorldPosition(game.CameraNode))
        vec4 mana = matrix * vec4(world.WorldPosition(game.Globes.Mana.Root), 1.0)
        float pixel = (mana.X + 1.0) * 480.0
        T.IsTrue(pixel < 600.0 && pixel > 400.0)
        game.Globes.Anchor(world, 960, 540, 100)
        vec4 corner = matrix * vec4(world.WorldPosition(game.Globes.Mana.Root), 1.0)
        T.IsTrue(corner.X > 0.5)
    }

    TheLiquidFallsAndRisesWithTheStatInWholeLayers()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        HellfeatherGlobe health = game.Globes.Health
        int full = HellfeatherGlobeArt.LiquidGrid
        int middle = full / 2
        T.AreEqual(game.Globes.Health.Layers, full)
        T.IsTrue(world.GetVoxel(game.Globes.Health.LiquidVolume, middle, full - 1, middle) >= 0)
        game.PlayerHealth = game.PlayerMaxHealth() / 2
        QuaxelInputState input
        game.Simulate(world, input, 40)
        T.AreEqual(game.Globes.Health.Layers, full / 2)
        T.AreEqual(world.GetVoxel(game.Globes.Health.LiquidVolume, middle, full / 2, middle), -1)
        T.IsTrue(world.GetVoxel(game.Globes.Health.LiquidVolume, middle, full / 2 - 1, middle) >= 0)
        T.AreEqual(game.Globes.Mana.Layers, full)
        game.PlayerHealth = game.PlayerMaxHealth()
        game.Simulate(world, input, 40)
        T.AreEqual(game.Globes.Health.Layers, full)
        T.IsTrue(world.GetVoxel(game.Globes.Health.LiquidVolume, middle, full - 1, middle) >= 0)
    }

    ADeadWarriorEmptiesTheOrbAndAnyHealthStillShows()
    {
        HellfeatherGlobe globe
        T.AreEqual(globe.LayersFor(0.0), 0)
        T.AreEqual(globe.LayersFor(0.001), 1)
        T.AreEqual(globe.LayersFor(1.0), HellfeatherGlobeArt.LiquidGrid)
    }

    TheSwirlTurnsWithoutLeavingTheOrbOrReuploading()
    {
        HellfeatherGame game()
        QuaxelWorld world()
        T.IsTrue(game.Prepare(world))
        world.SetVolumeHandle(game.Globes.Health.LiquidVolume, 0)
        QuaxelInputState input
        game.Simulate(world, input, 30)
        T.IsFalse(world.NeedsVolumeUpload(game.Globes.Health.LiquidVolume))
        QuaxelTransform pose = world.GetTransform(game.Globes.Health.Liquid)
        T.IsTrue(pose.FacingX > 0.1)
        T.IsTrue(Math.Abs(pose.FacingX * pose.FacingX + pose.FacingZ * pose.FacingZ - 1.0) < 0.0001)
    }
}
